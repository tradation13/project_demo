@model IPTS.ViewModels.ResetPasswordViewModel
@{
    Layout = ViewBag.HasDashboard
                ? "~/Views/Shared/Layouts/_DashboardLayout.cshtml"
                : "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Shared_ResetPassword"];
}

<div class="flex min-h-[calc(100vh-8rem)] items-start justify-center px-4 py-8">
    <style>
        @@keyframes fadeInUp { from { opacity: 0; transform: translateY(26px) scale(.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
        .animate-fade-in-up { animation: fadeInUp 820ms cubic-bezier(.2,.85,.25,1) both; }
    </style>

    <div class="mx-auto w-full rounded-[1rem] border border-gray-100 bg-white/95 p-6 shadow-[0_24px_65px_-25px_rgba(15,23,42,0.35)] backdrop-blur-sm sm:p-8 animate-fade-in-up">
        <div class="mb-6 text-center sm:mb-8">
            <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary shadow-sm sm:h-16 sm:w-16">
                <i class="fa-solid fa-lock text-xl sm:text-2xl" aria-hidden="true"></i>
            </div>
            <h2 class="text-2xl font-bold tracking-tight text-gray-800 sm:text-3xl">@SharedLocalizer["Shared_ResetPassword"]</h2>
        </div>

        <form class="space-y-6 text-left sm:space-y-7" asp-action="ResetPassword" method="post" autocomplete="off" x-data="{ showCurrent:false, showNew:false, showConfirm:false, strength:0, evaluate(pw){ let s=0; if(!pw){ this.strength=0; return;} if(pw.length>=8) s++; if(/[A-Z]/.test(pw)) s++; if(/[0-9]/.test(pw)) s++; if(/[^A-Za-z0-9]/.test(pw)) s++; this.strength=s } }">

            <div class="flex flex-col">
                <label asp-for="CurrentPassword" class="mb-1.5 block text-sm font-bold text-gray-700">@SharedLocalizer["ResetPass_Label_Current"]</label>
                <div class="relative">
                    <input :type="showCurrent ? 'text' : 'password'" asp-for="CurrentPassword"
                           class="w-full rounded-2xl border border-gray-200 bg-gray-50/70 px-4 py-3 pr-12 text-sm text-gray-900 shadow-sm outline-none transition-all duration-200 placeholder:text-gray-400 hover:border-gray-300 focus:border-primary focus:bg-white focus:ring-4 focus:ring-primary/10"
                           placeholder="@SharedLocalizer["ResetPass_Placeholder_Current"]" />
                    <button type="button" @@click="showCurrent = !showCurrent" class="absolute inset-y-0 right-0 flex items-center justify-center pr-4 text-gray-400 transition-colors hover:text-primary" aria-label="Toggle current password visibility">
                        <i class="fa-solid" :class="showCurrent ? 'fa-eye' : 'fa-eye-slash'"></i>
                    </button>
                </div>
                <span asp-validation-for="CurrentPassword" class="mt-1.5 block text-xs font-normal text-red-500"></span>
            </div>

            <div class="flex flex-col">
                <label asp-for="NewPassword" class="mb-1.5 block text-sm font-bold text-gray-700">@SharedLocalizer["Shared_NewPassword"]</label>
                <div class="relative">
                    <input :type="showNew ? 'text' : 'password'" asp-for="NewPassword" @@input="evaluate($event.target.value)"
                           class="w-full rounded-2xl border border-gray-200 bg-gray-50/70 px-4 py-3 pr-12 text-sm text-gray-900 shadow-sm outline-none transition-all duration-200 placeholder:text-gray-400 hover:border-gray-300 focus:border-primary focus:bg-white focus:ring-4 focus:ring-primary/10"
                           placeholder="@SharedLocalizer["Shared_EnterNewPassword"]" />
                    <button type="button" @@click="showNew = !showNew" class="absolute inset-y-0 right-0 flex items-center justify-center pr-4 text-gray-400 transition-colors hover:text-primary" aria-label="Toggle new password visibility">
                        <i class="fa-solid" :class="showNew ? 'fa-eye' : 'fa-eye-slash'"></i>
                    </button>
                </div>
                <div class="mt-2">
                    <div class="flex items-center gap-2">
                        <div class="flex w-full gap-1">
                            <template x-for="i in 4" :key="i">
                                <div :class="{ 'bg-green-500': strength >= i, 'bg-gray-200': strength < i }" class="h-1 flex-1 rounded"></div>
                            </template>
                        </div>
                        <div class="text-xs text-gray-600" x-text="strength === 0 ? '' : (strength <=1 ? 'Weak' : (strength==2 ? 'Fair' : (strength==3 ? 'Good' : 'Strong'))) "></div>
                    </div>
                    @SharedLocalizer["ResetPass_PasswordStrength"]
                </div>
                <span asp-validation-for="NewPassword" class="mt-1.5 block text-xs font-normal text-red-500"></span>
            </div>

            <div class="flex flex-col">
                <label asp-for="ConfirmPassword" class="mb-1.5 block text-sm font-bold text-gray-700">@SharedLocalizer["Shared_ConfirmPassword"]</label>
                <div class="relative">
                    <input :type="showConfirm ? 'text' : 'password'" asp-for="ConfirmPassword"
                           class="w-full rounded-2xl border border-gray-200 bg-gray-50/70 px-4 py-3 pr-12 text-sm text-gray-900 shadow-sm outline-none transition-all duration-200 placeholder:text-gray-400 hover:border-gray-300 focus:border-primary focus:bg-white focus:ring-4 focus:ring-primary/10"
                           placeholder="@SharedLocalizer["Shared_ConfirmNewPassword"]" />
                    <button type="button" @@click="showConfirm = !showConfirm" class="absolute inset-y-0 right-0 flex items-center justify-center pr-4 text-gray-400 transition-colors hover:text-primary" aria-label="Toggle confirm password visibility">
                        <i class="fa-solid" :class="showConfirm ? 'fa-eye' : 'fa-eye-slash'"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="mt-1.5 block text-xs font-normal text-red-500"></span>
            </div>

            <button type="submit" class="bg-gradient-to-r from-primary to-indigo-600 w-full rounded-2xl bg-primary py-3.5 text-sm font-bold uppercase tracking-widest text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-dark active:scale-95">@SharedLocalizer["ResetPass_UpdateBtn"]</button>

            @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
        </form>
    </div>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")