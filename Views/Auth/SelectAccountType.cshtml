@using IPTS.Controllers
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Auth_SelectAccountTitle"];
}

<div class="auth-ui-card auth-ui-pad relative mx-auto w-full max-w-md overflow-hidden rounded-[2rem] border border-white/70 bg-white/85 p-8 shadow-[0_24px_80px_rgba(15,23,42,0.12)] backdrop-blur-xl sm:p-10">
    <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[2rem]">
        <div class="auth-ui-orb auth-ui-orb-a absolute -left-10 -top-10 h-32 w-32 rounded-full bg-emerald-500/10 blur-3xl"></div>
        <div class="auth-ui-orb auth-ui-orb-b absolute -bottom-12 -right-8 h-36 w-36 rounded-full bg-blue-500/10 blur-3xl"></div>
    </div>

    <div class="relative z-10">
        <div class="mb-8 text-center">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-500 to-blue-600 text-white shadow-lg shadow-emerald-500/20 ring-1 ring-white/60">
                <i class="fas fa-users text-lg" aria-hidden="true"></i>
            </div>
            <h2 class="auth-ui-title text-3xl font-extrabold tracking-tight sm:text-[2rem]">
                @SharedLocalizer["Auth_ChooseAccountHeading"]
            </h2>
            <p class="mt-3 text-sm leading-6 text-slate-500 sm:text-[0.95rem]">
                @SharedLocalizer["Auth_ChooseAccountSubheading"]
            </p>
        </div>

        <div class="space-y-4">
            <a asp-controller="Auth" asp-action="Register" asp-route-accountType="doctor"
               class="group block w-full rounded-2xl border border-sky-200/80 bg-sky-50/40 p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-sky-400 hover:bg-sky-50 hover:shadow-md">
                <div class="flex items-center gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-sky-500 to-blue-600 text-white shadow-md shadow-sky-500/20 transition-transform group-hover:scale-105">
                        <i class="fas fa-user-md text-lg" aria-hidden="true"></i>
                    </div>
                    <div class="min-w-0 flex-1">
                        <h3 class="text-base font-bold text-slate-800 transition-colors group-hover:text-sky-700">
                            @SharedLocalizer["Auth_DoctorAccount"]
                        </h3>
                        <p class="mt-0.5 text-sm text-slate-500">
                            @SharedLocalizer["Auth_DoctorDescription"]
                        </p>
                    </div>
                    <i class="fas fa-chevron-right shrink-0 text-slate-300 transition-colors group-hover:text-sky-500" aria-hidden="true"></i>
                </div>
            </a>

            <a asp-controller="Auth" asp-action="Register" asp-route-accountType="patient"
               class="group block w-full rounded-2xl border border-emerald-200/80 bg-emerald-50/40 p-5 transition-all duration-200 hover:-translate-y-0.5 hover:border-emerald-400 hover:bg-emerald-50 hover:shadow-md">
                <div class="flex items-center gap-4">
                    <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white shadow-md shadow-emerald-500/20 transition-transform group-hover:scale-105">
                        <i class="fas fa-user text-lg" aria-hidden="true"></i>
                    </div>
                    <div class="min-w-0 flex-1">
                        <h3 class="text-base font-bold text-slate-800 transition-colors group-hover:text-emerald-700">
                            @SharedLocalizer["Auth_PatientAccount"]
                        </h3>
                        <p class="mt-0.5 text-sm text-slate-500">
                            @SharedLocalizer["Auth_PatientDescription"]
                        </p>
                    </div>
                    <i class="fas fa-chevron-right shrink-0 text-slate-300 transition-colors group-hover:text-emerald-500" aria-hidden="true"></i>
                </div>
            </a>
        </div>

        <p class="mt-8 text-center text-sm text-slate-500">
            @SharedLocalizer["Auth_AlreadyHaveAccount"]
            <a href="@Url.Action("Login", "Auth")"
               class="font-semibold text-emerald-600 transition-colors hover:text-emerald-700 hover:underline">
                @SharedLocalizer["Auth_SignInHere"]
            </a>
        </p>
    </div>
</div>
