@model DashboardStatisticsViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100 animate-fade-slide-up">
    <div class="mb-6 flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <i class="fas fa-chart-line"></i>
        </span>
        <div>
            <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Dashboard_Eyebrow"]</p>
            <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["Dashboard_Title"]</h4>
            <p class="text-sm text-slate-500">@SharedLocalizer["Dashboard_Subtitle"]</p>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">

        <a asp-area="Admin" asp-controller="Users" asp-action="Index"
           class="group block overflow-hidden rounded-2xl border border-slate-100 bg-white transition-all duration-150 hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md hover:shadow-primary/10">
            <div class="h-1 bg-gradient-to-r from-primary to-indigo-600"></div>
            <div class="p-4 pb-3">
                <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-white">
                    <i class="fas fa-users text-sm"></i>
                </div>
                <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Dashboard_TotalPatients"]</p>
                <p class="text-2xl font-bold leading-none text-slate-800">@Model.TotalPatients</p>
            </div>
            <div class="border-t border-slate-100 px-4 py-2 text-xs text-slate-400">
                @SharedLocalizer["Dashboard_Patients_Description"]
            </div>
        </a>

        <a asp-area="Admin" asp-controller="Users" asp-action="Index"
           class="group block overflow-hidden rounded-2xl border border-slate-100 bg-white transition-all duration-150 hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md hover:shadow-primary/10">
            <div class="h-1 bg-gradient-to-r from-primary to-indigo-600"></div>
            <div class="p-4 pb-3">
                <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-blue-500 transition-colors group-hover:bg-blue-500 group-hover:text-white">
                    <i class="fas fa-user-md text-sm"></i>
                </div>
                <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Dashboard_TotalDoctors"]</p>
                <p class="text-2xl font-bold leading-none text-slate-800">@Model.TotalDoctors</p>
            </div>
            <div class="border-t border-slate-100 px-4 py-2 text-xs text-slate-400">
                @SharedLocalizer["Dashboard_Doctors_Description"]
            </div>
        </a>

        <a asp-area="Admin" asp-controller="Users" asp-action="Index"
           class="group block overflow-hidden rounded-2xl border border-slate-100 bg-white transition-all duration-150 hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md hover:shadow-primary/10">
            <div class="h-1 bg-gradient-to-r from-primary to-indigo-600"></div>
            <div class="p-4 pb-3">
                <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-slate-600 transition-colors group-hover:bg-slate-600 group-hover:text-white">
                    <i class="fas fa-shield-alt text-sm"></i>
                </div>
                <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Dashboard_TotalAdmins"]</p>
                <p class="text-2xl font-bold leading-none text-slate-800">@Model.TotalAdmins</p>
            </div>
            <div class="border-t border-slate-100 px-4 py-2 text-xs text-slate-400">
                @SharedLocalizer["Dashboard_Admins_Description"]
            </div>
        </a>

        <div class="overflow-hidden rounded-2xl border border-slate-100 bg-white transition-all duration-150">
            <div class="h-1 bg-gradient-to-r from-primary to-indigo-600"></div>
            <div class="p-4 pb-3">
                <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-red-50 text-red-500">
                    <i class="fas fa-file-medical text-sm"></i>
                </div>
                <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Dashboard_TotalCases"]</p>
                <p class="text-2xl font-bold leading-none text-slate-800">@Model.TotalMedicalCases</p>
            </div>
            <div class="border-t border-slate-100 px-4 py-2 text-xs text-slate-400">
                @SharedLocalizer["Dashboard_Cases_Description"]
            </div>
        </div>

        <a asp-area="Admin" asp-controller="Tests" asp-action="Index"
           class="group block overflow-hidden rounded-2xl border border-slate-100 bg-white transition-all duration-150 hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md hover:shadow-primary/10">
            <div class="h-1 bg-gradient-to-r from-primary to-indigo-600"></div>
            <div class="p-4 pb-3">
                <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-yellow-50 text-yellow-500 transition-colors group-hover:bg-yellow-500 group-hover:text-white">
                    <i class="fas fa-vial text-sm"></i>
                </div>
                <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Dashboard_TotalTests"]</p>
                <p class="text-2xl font-bold leading-none text-slate-800">@Model.TotalTests</p>
            </div>
            <div class="border-t border-slate-100 px-4 py-2 text-xs text-slate-400">
                @SharedLocalizer["Dashboard_Tests_Description"]
            </div>
        </a>

        <a asp-area="Admin" asp-controller="TestGroups" asp-action="Index"
           class="group block overflow-hidden rounded-2xl border border-slate-100 bg-white transition-all duration-150 hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md hover:shadow-primary/10">
            <div class="h-1 bg-gradient-to-r from-primary to-indigo-600"></div>
            <div class="p-4 pb-3">
                <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-blue-50 text-blue-500 transition-colors group-hover:bg-blue-500 group-hover:text-white">
                    <i class="fas fa-layer-group text-sm"></i>
                </div>
                <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Dashboard_TestGroups"]</p>
                <p class="text-2xl font-bold leading-none text-slate-800">@Model.TotalTestGroups</p>
            </div>
            <div class="border-t border-slate-100 px-4 py-2 text-xs text-slate-400">
                @SharedLocalizer["Dashboard_TestGroups_Description"]
            </div>
        </a>

        <a asp-area="Admin" asp-controller="UsersTypes" asp-action="Index"
           class="group block overflow-hidden rounded-2xl border border-slate-100 bg-white transition-all duration-150 hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md hover:shadow-primary/10">
            <div class="h-1 bg-gradient-to-r from-primary to-indigo-600"></div>
            <div class="p-4 pb-3">
                <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-slate-100 text-slate-600 transition-colors group-hover:bg-slate-600 group-hover:text-white">
                    <i class="fas fa-id-badge text-sm"></i>
                </div>
                <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Dashboard_UserTypes"]</p>
                <p class="text-2xl font-bold leading-none text-slate-800">@Model.TotalUserTypes</p>
                <p class="mt-1 text-xs text-slate-400">@SharedLocalizer["Dashboard_UserTypes_Types"]</p>
            </div>
            <div class="border-t border-slate-100 px-4 py-2 text-xs text-slate-400">
                @SharedLocalizer["Dashboard_UserTypes_Description"]
            </div>
        </a>

        <a asp-area="Admin" asp-controller="ChatConversations" asp-action="Index"
           class="group block overflow-hidden rounded-2xl border border-slate-100 bg-white transition-all duration-150 hover:-translate-y-0.5 hover:border-primary/30 hover:shadow-md hover:shadow-primary/10">
            <div class="h-1 bg-gradient-to-r from-primary to-indigo-600"></div>
            <div class="p-4 pb-3">
                <div class="mb-3 flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary transition-colors group-hover:bg-primary group-hover:text-white">
                    <i class="fas fa-comments text-sm"></i>
                </div>
                <p class="mb-1.5 text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Dashboard_ChatConversations"]</p>
                <p class="text-2xl font-bold leading-none text-slate-800">@Model.TotalChatConversations</p>
            </div>
            <div class="border-t border-slate-100 px-4 py-2 text-xs text-slate-400">
                @SharedLocalizer["Dashboard_ChatConversations_Description"]
            </div>
        </a>
    </div>

    <div class="mt-4 flex items-start gap-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-4">
        <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <i class="fas fa-info-circle text-sm"></i>
        </div>
        <div>
            <h3 class="mb-0.5 text-sm font-bold text-slate-800">@SharedLocalizer["Dashboard_Info_Title"]</h3>
            <p class="text-xs leading-relaxed text-slate-500">@SharedLocalizer["Dashboard_Info_Description"]</p>
        </div>
    </div>
</div>
