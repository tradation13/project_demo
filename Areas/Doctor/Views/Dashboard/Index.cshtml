@model IPTS.Areas.Doctor.ViewsModels.DoctorDashboardStatsViewModel

@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewData["Title"] = @SharedLocalizer["Dash_DoctorHeader"];
    string nextAppt = Model.NextAppointmentUtc.HasValue
        ? Model.NextAppointmentUtc.Value.ToLocalTime().ToString("ddd, dd MMM yyyy - HH:mm")
        : "—";
}



<div class="mx-auto max-w-7xl space-y-6 py-8">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold">@SharedLocalizer["Dash_DoctorHeader"]</h1>
@*         <div class="text-sm text-gray-500">Next Appointment: <span class="font-normal text-gray-700">@nextAppt</span></div>
 *@    </div>

    <!-- KPI Grid -->
    <div class="rounded-2xl bg-white p-4 shadow-sm">
        <div class="grid grid-cols-1 gap-5 sm:grid-cols-2 lg:grid-cols-3">
       <a href="@Url.Action("Index", "Appointments", new { area = "Doctor" })" class="block transition-all hover:opacity-95">
    @await Html.PartialAsync("~/Areas/Doctor/Views/_StatCard.cshtml",
        new IPTS.Areas.Doctor.ViewsModels.StatCardViewModel(
            @SharedLocalizer["Dash_TotalAppts"], 
            Model.TotalAppointments.ToString("N0"), 
            null, 
            "fa-solid fa-calendar-check", 
            "bg-emerald-50 text-emerald-600"
        ))
</a>
        @await Html.PartialAsync("~/Areas/Doctor/Views/_StatCard.cshtml",
                 new IPTS.Areas.Doctor.ViewsModels.StatCardViewModel(@SharedLocalizer["Dash_Upcoming"], Model.UpcomingAppointments.ToString("N0"), @SharedLocalizer["Dash_UpcomingDesc"], "fa-solid fa-calendar-plus", "bg-emerald-50 text-emerald-600"))
        @await Html.PartialAsync("~/Areas/Doctor/Views/_StatCard.cshtml",
                 new IPTS.Areas.Doctor.ViewsModels.StatCardViewModel(@SharedLocalizer["Dash_CompletedMonth"], Model.CompletedThisMonth.ToString("N0"), null, "fa-solid fa-clipboard-check", "bg-indigo-50 text-indigo-600"))
        @await Html.PartialAsync("~/Areas/Doctor/Views/_StatCard.cshtml",
                 new IPTS.Areas.Doctor.ViewsModels.StatCardViewModel(@SharedLocalizer["Dash_CancelledMonth"], Model.CancelledThisMonth.ToString("N0"), null, "fa-solid fa-ban", "bg-rose-50 text-rose-600"))
        @await Html.PartialAsync("~/Areas/Doctor/Views/_StatCard.cshtml",
                 new IPTS.Areas.Doctor.ViewsModels.StatCardViewModel(@SharedLocalizer["Dash_UniquePatients"], Model.UniquePatientsAllTime.ToString("N0"), null, "fa-solid fa-user-group", "bg-amber-50 text-amber-600"))
        @await Html.PartialAsync("~/Areas/Doctor/Views/_StatCard.cshtml",
                 new IPTS.Areas.Doctor.ViewsModels.StatCardViewModel(@SharedLocalizer["Dash_ActiveCases"], Model.ActiveMedicalCases.ToString("N0"), null, "fa-solid fa-file-medical", "bg-sky-50 text-sky-600"))
        @await Html.PartialAsync("~/Areas/Doctor/Views/_StatCard.cshtml",
                 new IPTS.Areas.Doctor.ViewsModels.StatCardViewModel(@SharedLocalizer["Dash_TestsMonth"], Model.TestsOrderedThisMonth.ToString("N0"), null, "fa-solid fa-vials", "bg-fuchsia-50 text-fuchsia-600"))
        @await Html.PartialAsync("~/Areas/Doctor/Views/_StatCard.cshtml",
                 new IPTS.Areas.Doctor.ViewsModels.StatCardViewModel(@SharedLocalizer["Dash_CompletionRate"], $"{Model.CompletionRateThisMonthPercent:0.0}%", @SharedLocalizer["Dash_RateDesc"], "fa-solid fa-percent", "bg-teal-50 text-teal-600"))
        @* Moved AvgAppts card into the KPI group so it appears with other summaries *@
        @await Html.PartialAsync("~/Areas/Doctor/Views/_StatCard.cshtml",
                 new IPTS.Areas.Doctor.ViewsModels.StatCardViewModel(@SharedLocalizer["Dash_AvgAppts7d"], $"{Model.AvgAppointmentsPerDayLast7Days:0.00}", null, "fa-solid fa-clock", "bg-lime-50 text-lime-600"))
        </div>
    </div>

    <!-- Enhanced Row: mini chart, progress ring, next appt -->
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-3 mt-4">
        <!-- Mini bars: appointments breakdown -->
        <div class="rounded-lg bg-white/80 p-4 shadow-sm">
            <div class="flex items-center justify-between mb-3">
                <h3 class="text-sm font-semibold text-gray-700">@SharedLocalizer["Dash_AppointmentsBreakdown"]</h3>
                <span class="text-xs text-gray-500">@SharedLocalizer["Dash_LastMonth"]</span>
            </div>
            <div class="space-y-3">
                @{ 
                    var max = new[] { Model.TotalAppointments, Model.UpcomingAppointments, Model.CompletedThisMonth, Model.CancelledThisMonth }.Max();
                    if (max == 0) { max = 1; }
                }
                <div class="text-xs text-gray-600">@SharedLocalizer["Dash_TotalAppts"] <span class="font-medium text-gray-800">@Model.TotalAppointments</span></div>
                <div class="w-full bg-gray-100 h-3 rounded overflow-hidden">
                    <div class="h-3 rounded bg-emerald-400" style="width:@(100.0 * Model.TotalAppointments / max)%"></div>
                </div>

                <div class="text-xs text-gray-600">@SharedLocalizer["Dash_Upcoming"] <span class="font-medium text-gray-800">@Model.UpcomingAppointments</span></div>
                <div class="w-full bg-gray-100 h-3 rounded overflow-hidden">
                    <div class="h-3 rounded bg-amber-400" style="width:@(100.0 * Model.UpcomingAppointments / max)%"></div>
                </div>

                <div class="text-xs text-gray-600">@SharedLocalizer["Dash_CompletedMonth"] <span class="font-medium text-gray-800">@Model.CompletedThisMonth</span></div>
                <div class="w-full bg-gray-100 h-3 rounded overflow-hidden">
                    <div class="h-3 rounded bg-indigo-400" style="width:@(100.0 * Model.CompletedThisMonth / max)%"></div>
                </div>

                <div class="text-xs text-gray-600">@SharedLocalizer["Dash_CancelledMonth"] <span class="font-medium text-gray-800">@Model.CancelledThisMonth</span></div>
                <div class="w-full bg-gray-100 h-3 rounded overflow-hidden">
                    <div class="h-3 rounded bg-rose-400" style="width:@(100.0 * Model.CancelledThisMonth / max)%"></div>
                </div>
            </div>
        </div>

        <!-- Completion rate: SVG progress ring -->
        <div class="rounded-lg bg-white/80 p-6 shadow-sm flex items-center justify-center">
            <div class="text-center">
                @{ var pct = (int)Math.Round(Model.CompletionRateThisMonthPercent); var circumference = 2 * Math.PI * 36; var offset = circumference * (1 - pct / 100.0); }
                <svg width="110" height="110" viewBox="0 0 100 100" class="mx-auto">
                    <defs>
                        <linearGradient id="g1" x1="0%" x2="100%">
                            <stop offset="0%" stop-color="#06b6d4" />
                            <stop offset="100%" stop-color="#06d6a0" />
                        </linearGradient>
                    </defs>
                    <circle cx="50" cy="50" r="36" stroke="#e6eef8" stroke-width="12" fill="none" />
                    <circle cx="50" cy="50" r="36" stroke="url(#g1)" stroke-width="12" fill="none"
                        stroke-dasharray="@circumference" stroke-dashoffset="@offset" stroke-linecap="round" transform="rotate(-90 50 50)" />
                    <text x="50" y="54" font-size="18" text-anchor="middle" class="text-gray-800 font-semibold">@pct%</text>
                </svg>
                <div class="mt-3 text-sm text-gray-600">@SharedLocalizer["Dash_CompletionRate"]</div>
                <div class="text-xs text-gray-500 mt-1">@SharedLocalizer["Dash_RateDesc"]</div>
            </div>
        </div>

        <!-- Next appointment + pending requests -->
        <div class="rounded-lg bg-white/80 p-4 shadow-sm">
            <div>
                <div class="flex items-center justify-between">
                    <h3 class="text-sm font-semibold text-gray-700">@SharedLocalizer["Dash_NextAppointment"]</h3>
                    <a href="@Url.Action("Index", "Appointments", new { area = "Doctor" })" class="text-sm text-blue-600 hover:underline">
                        @SharedLocalizer["Dash_ViewAppointments"]
                    </a>
                </div>

                <div class="mt-2 text-sm text-gray-600">@(
                    Model.NextAppointmentUtc.HasValue 
                    ? Model.NextAppointmentUtc.Value.ToLocalTime().ToString("ddd, dd MMM yyyy - HH:mm") 
                    : "—")
                </div>

                <div class="mt-4">
                    <div class="text-xs text-gray-500 mb-2">@SharedLocalizer["Dash_PendingRequestsShort"]</div>
                    @if (Model.LatestPendingRequests != null && Model.LatestPendingRequests.Any())
                    {
                        <ul class="space-y-2">
                            @foreach (var req in Model.LatestPendingRequests)
                            {
                                <li class="flex items-center justify-between">
                                    <div class="text-sm text-gray-700">@req.PatientName</div>
                                    <div class="text-xs px-2 py-0.5 rounded-full @(req.Status == IPTS.Models.Entites.AppointmentStatus.Pending ? "bg-amber-100 text-amber-800" : "bg-gray-100 text-gray-700")">@req.StatusDisplay</div>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <div class="text-sm text-gray-500">@SharedLocalizer["Dash_NoPendingRequests"]</div>
                    }
                </div>
            </div>
        </div>
    </div>

    @* AvgAppts card moved into KPI container above to keep summaries grouped together *@
</div>
