@model IPTS.ViewModels.ResetPasswordViewModel
@{
    Layout = ViewBag.HasDashboard
                ? "~/Views/Shared/Layouts/_DashboardLayout.cshtml"
                : "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Shared_ResetPassword"];
}

<section class="mb-10 rounded bg-white p-6 shadow">
    <h2 class="text-center text-2xl font-bold tracking-wide text-gray-800">
        @SharedLocalizer["Shared_ResetPassword"]
    </h2>

    <form asp-action="ResetPassword" method="post" class="my-8 text-sm">
        
        <div class="my-4 flex flex-col">
            <label asp-for="CurrentPassword" class="text-gray-700">@SharedLocalizer["Shared_NewPassword"]</label>
            <div x-data="{ show: false }" class="relative mt-2 flex items-center">
                <input :type=" show ? 'text' : 'password' "
                       asp-for="CurrentPassword"
                       class="flex-1 rounded border-gray-300 py-2 pr-10 text-sm text-gray-900 focus:border-gray-300 focus:outline-none focus:ring-0"
                       placeholder="@SharedLocalizer["ResetPass_Placeholder_Current"]" />
                <button x-on:click="show = !show" type="button"
                        class="absolute right-2 flex items-center justify-center bg-transparent text-gray-700">
                    <i class="fa-solid" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                </button>
            </div>
            <span asp-validation-for="CurrentPassword" class="text-sm text-red-500"></span>
        </div>

        <div class="my-4 flex flex-col">
            <label asp-for="NewPassword" class="text-gray-700">@SharedLocalizer["Shared_NewPassword"]</label>
            <div x-data="{ show: false }" class="relative mt-2 flex items-center">
                <input :type=" show ? 'text' : 'password' "
                       asp-for="NewPassword"
                       class="flex-1 rounded border-gray-300 py-2 pr-10 text-sm text-gray-900 focus:border-gray-300 focus:outline-none focus:ring-0"
                       placeholder="@SharedLocalizer["Shared_EnterNewPassword"]" />
                <button x-on:click="show = !show" type="button"
                        class="absolute right-2 flex items-center justify-center bg-transparent text-gray-700">
                    <i class="fa-solid" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="text-sm text-red-500"></span>
        </div>

        <div class="my-4 flex flex-col">
            <label asp-for="ConfirmPassword" class="text-gray-700">@SharedLocalizer["Shared_ConfirmPassword"]</label>
            <div x-data="{ show: false }" class="relative mt-2 flex items-center">
                <input :type=" show ? 'text' : 'password' "
                       asp-for="ConfirmPassword"
                       class="flex-1 rounded border-gray-300 py-2 pr-10 text-sm text-gray-900 focus:border-gray-300 focus:outline-none focus:ring-0"
                       placeholder="@SharedLocalizer["Shared_ConfirmNewPassword"]" />
                <button x-on:click="show = !show" type="button"
                        class="absolute right-2 flex items-center justify-center bg-transparent text-gray-700">
                    <i class="fa-solid" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-sm text-red-500"></span>
        </div>

        <div class="mt-6 flex gap-2">
            <button type="submit"
                    class="rounded-lg bg-primary px-6 py-1.5 text-white transition duration-150 hover:bg-primary-dark hover:shadow-xl">
                @SharedLocalizer["ResetPass_UpdateBtn"]
            </button>
        </div>

        <div asp-validation-summary="All" class="mt-4 text-sm text-red-500"></div>
    </form>
</section>