@model IdentityRole
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}
<form asp-action="Edit" method="post" class="space-y-4">
    <input type="hidden" asp-for="Id" />
    <div>
        <label asp-for="Name" class="block text-sm font-normal text-gray-700"></label>
        <input asp-for="Name" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
        <span asp-validation-for="Name" class="text-sm text-red-500"></span>
    </div>
    <div class="mt-6 flex gap-2">
        <a href="@Url.Action("Index")"
           class="rounded-lg bg-secondary bg-opacity-20 px-6 py-1.5 text-primary transition duration-150 hover:bg-opacity-40 hover:shadow-xl">
            @SharedLocalizer["Shared_Cancel"]
        </a>

        <button type="submit"
                class="rounded-lg bg-primary px-6 py-1.5 text-white transition duration-150 hover:bg-primary-dark hover:shadow-xl">
            @SharedLocalizer["Shared_Update"]
        </button>
    </div>

</form>
    