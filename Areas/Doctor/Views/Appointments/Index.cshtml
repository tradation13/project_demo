@using IPTS.ViewModels
@model IPTS.Areas.Doctor.ViewsModels.AppointmentListViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div x-data="{ filter: false }" class="mx-auto w-full rounded-2xl border border-gray-100 bg-white p-6 shadow-[0_20px_60px_rgba(15,23,42,0.06)]">
    <div class="mb-6 flex flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
            <h3 class="text-lg font-bold text-gray-900">@SharedLocalizer["Appointments"]</h3>
            <div class="text-sm text-green-500">@SharedLocalizer["Appt_ActiveMembers"]</div>
        </div>

        <div class="flex w-full items-center justify-end sm:w-auto">
            <a href="@Url.Action("SearchPatient", "Appointments", new { area = "doctor" })" class="inline-flex items-center rounded-lg bg-primary px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-primary-dark">
                @SharedLocalizer["Appt_AddNew"]
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 rounded border border-green-400 bg-green-100 p-4 text-green-700">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="mb-4 rounded border border-yellow-400 bg-yellow-100 p-4 text-yellow-700">
            @TempData["WarningMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-4 rounded border border-red-400 bg-red-100 p-4 text-red-700">
            @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="mb-4 rounded border border-blue-400 bg-blue-100 p-4 text-blue-700">
            @TempData["InfoMessage"]
        </div>
    }

    <div class="mb-3 mt-8">
        <div class="flex items-center justify-between">
            <div class="flex items-center gap-4">
                <button x-on:click="filter = !filter" class="flex items-center gap-2 text-sm font-semibold text-primary">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-gray-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01.293.707l-6 6V21l-4-2v-8l-6-6A1 1 0 013 6V4z" />
                    </svg>
                    @SharedLocalizer["Appt_Filters"]
                </button>
            </div>
        </div>

        <div x-show="filter" x-collapse.duration.300ms class="mt-4">
            <div class="rounded-lg bg-gray-50/80 px-6 py-5 border border-gray-100">
                <h5 class="mb-3 text-sm font-semibold text-gray-700">@SharedLocalizer["Appt_FilterResults"]</h5>
                <form method="get" asp-action="Index" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    <input type="text" name="patientName" value="@Model.PatientName" placeholder="@SharedLocalizer["Appt_PatientName"]" class="w-full rounded-2xl border border-gray-200 bg-gray-50/70 px-4 py-3 text-sm placeholder:text-gray-400 focus:border-primary focus:bg-white focus:ring-4 focus:ring-primary/10" />

                    <div>
                        <label class="sr-only">Status</label>
                        <select name="status" class="w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm focus:border-primary focus:ring-0">
                            <option value="">@SharedLocalizer["Appt_Status_Select"]</option>
                            @if (Model.Status == "Pending")
                            {
                                <option value="Pending" selected>@SharedLocalizer["Status_Pending"]</option>
                            }
                            else
                            {
                                <option value="Pending">@SharedLocalizer["Status_Pending"]</option>
                            }

                            @if (Model.Status == "Confirmed")
                            {
                                <option value="Confirmed" selected>@SharedLocalizer["Status_Confirmed"]</option>
                            }
                            else
                            {
                                <option value="Confirmed">@SharedLocalizer["Status_Confirmed"]</option>
                            }

                            @if (Model.Status == "Completed")
                            {
                                <option value="Completed" selected>@SharedLocalizer["Status_Completed"]</option>
                            }
                            else
                            {
                                <option value="Completed">@SharedLocalizer["Status_Completed"]</option>
                            }

                            @if (Model.Status == "Cancelled")
                            {
                                <option value="Cancelled" selected>@SharedLocalizer["Status_Cancelled"]</option>
                            }
                            else
                            {
                                <option value="Cancelled">@SharedLocalizer["Status_Cancelled"]</option>
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs text-gray-600">@SharedLocalizer["Appt_FromDate"]</label>
                        <input type="date" name="fromDate" value="@Model.FromDate" class="mt-1 w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm focus:border-primary focus:ring-0" />
                    </div>

                    <div>
                        <label class="block text-xs text-gray-600">@SharedLocalizer["Appt_ToDate"]</label>
                        <input type="date" name="toDate" value="@Model.ToDate" class="mt-1 w-full rounded-2xl border border-gray-200 bg-white px-4 py-3 text-sm focus:border-primary focus:ring-0" />
                    </div>

                    <div class="sm:col-span-2 lg:col-span-4 flex items-center gap-3 mt-2">
                        <button type="submit" class="rounded-2xl bg-primary px-5 py-2 text-sm font-semibold text-white shadow-md hover:bg-primary-dark">@SharedLocalizer["Appt_FilterBtn"]</button>
                        <a href="@Url.Action("Index")" class="inline-flex items-center text-sm text-gray-600 hover:underline">@SharedLocalizer["Appt_ClearFilters"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="overflow-x-auto">
        <table class="mb-6 w-full table-auto">
            <thead>
                <tr class="text-left text-sm text-gray-500">
                    <th class="px-4 py-3">#</th>
                    <th class="px-4 py-3">@SharedLocalizer["Appt_PatientName"]</th>
                    <th class="px-4 py-3">@SharedLocalizer["Appt_ScheduledTime"]</th>
                    <th class="px-4 py-3">@SharedLocalizer["Appt_Status"]</th>
                    <th class="px-4 py-3">@SharedLocalizer["Appt_Actions"]</th>
                </tr>
            </thead>
            <tbody class="text-sm text-gray-700">
            @{int x = (Model.Page - 1) * Model.PageSize;}
                @foreach (var appointment in Model.Items)
                {
                var scheduledUtcIsoStart = DateTime.SpecifyKind(appointment.ScheduledTime, DateTimeKind.Utc).ToString("o");
                var scheduledUtcIsoEnd = DateTime.SpecifyKind(appointment.ScheduledTime.AddMinutes(appointment.TotalDurationMinutes), DateTimeKind.Utc).ToString("o");
                var nowUtc = DateTime.UtcNow;
                var isPast = DateTime.SpecifyKind(appointment.ScheduledTime, DateTimeKind.Utc) <= nowUtc;

                string badgeText = string.Empty;
                string badgeClass = appointment.Status switch
                {
                    AppointmentStatus.Confirmed => "bg-green-100 text-green-800",
                    AppointmentStatus.Pending => "bg-yellow-100 text-yellow-800",
                    AppointmentStatus.Completed => "bg-blue-100 text-blue-800",
                    AppointmentStatus.Cancelled => "bg-red-100 text-red-800",
                    _ => "bg-gray-100 text-gray-800"
                };

                if (isPast && appointment.Status == AppointmentStatus.Pending)
                {
                    badgeText = SharedLocalizer["Appt_Status_Expired"];
                    badgeClass = "bg-orange-100 text-orange-800";
                }
                else if (isPast && appointment.Status == AppointmentStatus.Confirmed)
                {
                    badgeText = SharedLocalizer["Dash_CompletedMonth"];
                    badgeClass = "bg-blue-100 text-blue-800";
                }
                else
                {
                    badgeText = appointment.Status switch
                    {
                        AppointmentStatus.Pending => SharedLocalizer["Status_Pending"],
                        AppointmentStatus.Confirmed => SharedLocalizer["Status_Confirmed"],
                        AppointmentStatus.Completed => SharedLocalizer["Status_Completed"],
                        AppointmentStatus.Cancelled => SharedLocalizer["Status_Cancelled"],
                        _ => appointment.StatusDisplay
                    };
                }

                <tr class="border-t last:border-b hover:bg-gray-50">
                    <td class="px-4 py-3 align-middle">@(++x)</td>
                    <td class="px-4 py-3 align-middle">@appointment.PatientName</td>
                    @* <td class="text-center">@appointment.DoctorName</td> *@
                    <td class="px-4 py-3 align-middle">
                        <span class="appt-datetime" data-utc-start="@scheduledUtcIsoStart" data-utc-end="@scheduledUtcIsoEnd">@appointment.ScheduledTime.ToString("MMM dd, yyyy HH:mm")</span>
                    </td>
                    <td class="px-4 py-3 align-middle">
                        <span class="inline-flex items-center rounded-md px-3 py-1 text-xs font-medium" style="background-color:transparent">
                            @if(badgeClass.Contains("green") || badgeClass.Contains("Green") || appointment.Status==AppointmentStatus.Confirmed)
                            {
                                <span class="inline-block rounded-md bg-green-50 text-green-700 px-2 py-0.5 border border-green-100">@badgeText</span>
                            }
                            else if(badgeClass.Contains("red") || appointment.Status==AppointmentStatus.Cancelled)
                            {
                                <span class="inline-block rounded-md bg-red-50 text-red-700 px-2 py-0.5 border border-red-100">@badgeText</span>
                            }
                            else if(badgeClass.Contains("yellow") || appointment.Status==AppointmentStatus.Pending)
                            {
                                <span class="inline-block rounded-md bg-yellow-50 text-yellow-700 px-2 py-0.5 border border-yellow-100">@badgeText</span>
                            }
                            else
                            {
                                <span class="inline-block rounded-md bg-gray-50 text-gray-700 px-2 py-0.5 border border-gray-100">@badgeText</span>
                            }
                        </span>
                    </td>
                    <td class="px-4 py-3 align-middle text-center">
                        <a asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.Id" asp-area="doctor">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary hover:text-primary-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </a>
                     @*    <a href="@Url.Action("Edit", "Appointments", new { id = appointment.Id, area = "doctor" })"> *@
                     @*        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-500 hover:text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"> *@
                     @*            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /> *@
                     @*        </svg> *@
                     @*    </a> *@

                     @*    <form asp-action="Delete" asp-controller="Appointments" asp-route-id="@appointment.Id" asp-area="doctor" method="post" onsubmit="return confirm('Are you sure you want to delete this appointment?');" class="inline"> *@
                     @*        <button type="submit"> *@
                     @*            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 hover:text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"> *@
                     @*                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" *@
                     @*                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4 *@
                     @* a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /> *@
                     @*            </svg> *@
                     @*        </button> *@
                     @*    </form> *@
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>

    <div class="mt-4 flex items-center justify-between">
        @{ 
            var showingStart = Model.TotalCount == 0 ? 0 : ((Model.Page - 1) * Model.PageSize) + 1;
            var showingEnd = Model.TotalCount == 0 ? 0 : showingStart + Model.Items.Count - 1;
        }
       
        <nav class="inline-flex items-center space-x-1">
            @if(Model.Page > 1)
            {
                <a class="rounded border border-gray-200 px-2 py-1 text-sm" href="@Url.Action("Index", new { page = Model.Page - 1, patientName = Model.PatientName, status = Model.Status, fromDate = Model.FromDate, toDate = Model.ToDate })">&lt;</a>
            }
            else
            {
                <span class="rounded border border-gray-200 px-2 py-1 text-sm text-gray-400">&lt;</span>
            }

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                if (p == Model.Page)
                {
                    <span class="rounded bg-primary px-3 py-1 text-sm text-white">@p</span>
                }
                else
                {
                    <a class="rounded border border-gray-200 px-3 py-1 text-sm" href="@Url.Action("Index", new { page = p, patientName = Model.PatientName, status = Model.Status, fromDate = Model.FromDate, toDate = Model.ToDate })">@p</a>
                }
            }

            @if(Model.Page < Model.TotalPages)
            {
                <a class="rounded border border-gray-200 px-2 py-1 text-sm" href="@Url.Action("Index", new { page = Model.Page + 1, patientName = Model.PatientName, status = Model.Status, fromDate = Model.FromDate, toDate = Model.ToDate })">&gt;</a>
            }
            else
            {
                <span class="rounded border border-gray-200 px-2 py-1 text-sm text-gray-400">&gt;</span>
            }
        </nav>
    </div>
</div>

<script>
// Format UTC time to user's browser timezone (dynamic)
const browserTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;

function formatUtcTime(date, options = {}) {
    if (!date || Number.isNaN(date.getTime())) return '';
    const defaults = {
        timeZone: browserTimeZone,
        hour12: false
    };
    return new Intl.DateTimeFormat('en-GB', { ...defaults, ...options }).format(date);
}

document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.appt-datetime').forEach(el => {
        const utcStart = el.getAttribute('data-utc-start');
        const utcEnd = el.getAttribute('data-utc-end');
        if (!utcStart) return;

        const start = new Date(utcStart);
        if (!utcEnd) {
            const datePart = formatUtcTime(start, { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            el.textContent = datePart;
            return;
        }

        const end = new Date(utcEnd);

        // If same day, show date once + time range. Otherwise show full start and end datetimes.
        if (start.toDateString() === end.toDateString()) {
            const datePart = formatUtcTime(start, { year: 'numeric', month: 'short', day: '2-digit' });
            const startTime = formatUtcTime(start, { hour: '2-digit', minute: '2-digit' });
            const endTime = formatUtcTime(end, { hour: '2-digit', minute: '2-digit' });
            el.textContent = `${datePart} ${startTime} - ${endTime}`;
        } else {
            const startFull = formatUtcTime(start, { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            const endFull = formatUtcTime(end, { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            el.textContent = `${startFull} - ${endFull}`;
        }
    });
});
</script>
