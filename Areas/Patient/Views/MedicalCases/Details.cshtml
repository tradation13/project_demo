@model IPTS.Models.Entites.MedicalCase
@{
    ViewData["Title"] = "Medical Case Details";
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";

    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
}

<section class="py-16" aria-label="Medical Case Details">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

        <!-- Title + Back Button -->
        <div class="mb-12 flex flex-col gap-4 sm:flex-row sm:items-center sm:gap-6">
            <a href="@Url.Action("Index", "MedicalCases", new { area = "patient" })"
               class="inline-flex w-fit items-center gap-2 self-start rounded-lg border border-slate-300 bg-slate-100 px-5 py-2.5 font-medium text-slate-700 transition hover:border-slate-400 hover:bg-slate-200 sm:self-auto">
                <i class="fa-solid fa-arrow-left text-sm"></i>@SharedLocalizer["Shared_Back"]
            </a>
            <h2 class="w-full text-center text-2xl font-bold leading-tight sm:flex-1 sm:text-3xl">@SharedLocalizer["MedCase_Det_Title"] : @Model.Name</h2>
        </div>


        <!-- Tests Section -->
        @if (Model.MedicalCaseTests == null || !Model.MedicalCaseTests.Any())
        {
                <div class="mx-auto w-1/2 rounded border-l-4 border-yellow-400 bg-yellow-50 p-6 text-center">
                    <p class="text-yellow-800">@SharedLocalizer["MedCase_Det_NoTests"]</p>
                </div>
        }
        else
        {
            var grouped = Model.MedicalCaseTests
                .Where(t => t.Test != null && t.Test.TestGroup != null)
                .GroupBy(t => t.Test.TestGroup.Name)
                .OrderBy(g => g.Key);

            foreach (var group in grouped)
            {
                        <div class="mb-8">
                            <h3 class="mb-4 border-b border-teal-300 pb-1 text-center text-lg font-bold text-teal-700">@group.Key</h3>

                            <div class="flex flex-wrap justify-center gap-6">
                        @foreach (var test in group.OrderBy(t => t.Test.Name))
                        {
                            var hasResult = !string.IsNullOrWhiteSpace(test.Result);

                                        <div class="flex w-80 flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition-all duration-200 hover:shadow-md">
                                            <div class="text-center">
                                                <div class="font-semibold text-gray-800">@test.Test.Name</div>
                                                <div class="mt-1 text-sm text-gray-600">
                                                    @SharedLocalizer["Shared_Result"]: @(hasResult ? test.Result : @SharedLocalizer["MedCase_Det_NotSet"])
                                                </div>
                                                <div class="mt-1 text-xs text-gray-400">
                                                    @SharedLocalizer["Shared_Added"]: @test.CreatedAt.ToString("yyyy-MM-dd")
                                                </div>
                                            </div>
                                        </div>
                        }
                            </div>
                        </div>
            }
        }
    </div>
</section>
