@model List<IPTS.ViewModels.AppointmentViewModel>
@using IPTS.Models.Entites
@{
    ViewData["Title"] = @SharedLocalizer["Req_Title"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="mx-auto max-w-5xl py-8">
    <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-bold">@SharedLocalizer["Req_PendingHeader"]</h2>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="mb-4 rounded border-l-4 border-yellow-400 bg-yellow-50 p-4">
            <p class="text-yellow-800">@SharedLocalizer["Req_NoPendingFound"].</p>
        </div>
    }
    else
    {
        <div class="grid gap-6">
            @foreach (var appt in Model)
            {
                <div class="flex flex-col rounded-lg bg-white p-6 shadow md:flex-row md:items-center md:justify-between">
                    <div>
                        <div class="mb-2 flex items-center gap-2">
                            <span class="text-lg font-semibold">@appt.PatientName</span>
                            <span class="ml-2 rounded-full bg-yellow-100 px-3 py-1 text-xs font-bold text-yellow-800">
                               @SharedLocalizer["Status_Pending"]
                            </span>
                        </div>
                        <div class="mb-1 text-sm text-gray-600">
                            <span class="font-medium">@SharedLocalizer["Shared_Date"]:</span> @appt.ScheduledTime.ToString("MMMM dd, yyyy")
                            <span class="mx-2">|</span>
                            <span class="font-medium">@SharedLocalizer["Shared_Time"]:</span> @appt.ScheduledTime.ToString("HH:mm")
                        </div>
                        <div class="text-xs text-gray-500">
                            @SharedLocalizer["Req_Duration"]: @appt.TotalDurationMinutes @SharedLocalizer["Shared_Min"]
                        </div>
                        @if (!string.IsNullOrWhiteSpace(appt.Notes))
                        {
                            <div class="mt-2 text-sm text-gray-700">
                                <span class="font-medium">@SharedLocalizer["Shared_Notes"]:</span> @appt.Notes
                            </div>
                        }
                    </div>
                    <div class="mt-4 flex flex-col gap-2 md:mt-0 md:flex-row">
                        <form asp-action="AcceptRequest" asp-controller="Appointments" asp-area="Doctor" method="get" class="inline">
                            <input type="hidden" name="id" value="@appt.Id" />
                            <button type="submit" class="rounded bg-green-600 px-4 py-2 text-sm text-white hover:bg-green-700">@SharedLocalizer["Shared_Accept"]</button>
                        </form>
                        <form asp-action="RejectRequest" asp-controller="Appointments" asp-area="Doctor" method="get" class="inline">
                            <input type="hidden" name="id" value="@appt.Id" />
                            <button type="submit" class="rounded bg-red-600 px-4 py-2 text-sm text-white hover:bg-red-700">@SharedLocalizer["Shared_Reject"]</button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
</div>
