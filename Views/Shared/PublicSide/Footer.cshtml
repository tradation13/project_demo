@using Microsoft.AspNetCore.Localization

<style>
.pt-footer {
    background: #0b1110;
    color: #f8fafc;
    font-family: 'Segoe UI', system-ui, sans-serif;
    position: relative;
    overflow: hidden;
}

/* top green glow line */
.pt-footer::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, #16a34a, #4ade80, #16a34a, transparent);
}

/* subtle grid bg */
.pt-footer__grid {
    position: absolute;
    inset: 0;
    background-image:
        linear-gradient(rgba(22,163,74,.04) 1px, transparent 1px),
        linear-gradient(90deg, rgba(22,163,74,.04) 1px, transparent 1px);
    background-size: 56px 56px;
    pointer-events: none;
}

.pt-footer__inner {
    position: relative;
    max-width: 1280px;
    margin: 0 auto;
    padding: 4rem 1.5rem 2rem;
}

/* ── Top row ── */
.pt-footer__top {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1fr;
    gap: 2.5rem;
    margin-bottom: 3rem;
}

/* Brand col */
.pt-footer__brand {}
.pt-footer__logo { height: 56px; width: auto; margin-bottom: 1rem; filter: brightness(1.1); }
.pt-footer__tagline {
    font-size: .85rem;
    color: #f8fafc;
    line-height: 1.75;
    max-width: 280px;
    margin-bottom: 1.5rem;
}

/* social row */
.pt-footer__socials {
    display: flex;
    gap: .6rem;
}
.pt-social {
    width: 34px; height: 34px;
    border-radius: 9px;
    border: 1px solid rgba(255,255,255,.16);
    background: rgba(255,255,255,.08);
    color: #ffffff;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px;
    text-decoration: none;
    transition: background .2s, color .2s, border-color .2s, transform .2s;
}
.pt-social:hover {
    background: rgba(22,163,74,.2);
    border-color: rgba(22,163,74,.45);
    color: #ffffff;
    transform: translateY(-2px);
}

/* column headers */
.pt-footer__col-title {
    font-size: .72rem;
    font-weight: 700;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: #f8fafc;
    margin-bottom: 1.25rem;
    display: flex;
    align-items: center;
    gap: .5rem;
}
.pt-footer__col-title::after {
    content: '';
    flex: 1;
    height: 1px;
    background: rgba(255,255,255,.12);
}

/* links */
.pt-footer__links { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: .5rem; }
.pt-footer__links a {
    display: flex;
    align-items: center;
    gap: .6rem;
    font-size: .84rem;
    color: #f8fafc;
    text-decoration: none;
    transition: color .2s, gap .2s;
}
.pt-footer__links a:hover { color: #ffffff; gap: .85rem; }
.pt-footer__links a i { font-size: 10px; color: #4ade80; transition: transform .2s; }
.pt-footer__links a:hover i { transform: translateX(2px); }

/* contact items */
.pt-footer__contact { display: flex; flex-direction: column; gap: .85rem; }
.pt-contact-item {
    display: flex;
    align-items: flex-start;
    gap: .75rem;
    font-size: .84rem;
    color: #f8fafc;
}
.pt-contact-item a { color: #f8fafc; text-decoration: none; transition: color .2s; }
.pt-contact-item a:hover { color: #ffffff; }
.pt-contact-icon {
    width: 30px; height: 30px;
    flex-shrink: 0;
    border-radius: 8px;
    background: rgba(22,163,74,.1);
    border: 1px solid rgba(22,163,74,.2);
    display: flex; align-items: center; justify-content: center;
    color: #4ade80;
    font-size: 13px;
    margin-top: 1px;
}

/* ── Bottom bar ── */
.pt-footer__bottom {
    border-top: 1px solid rgba(255,255,255,.12);
    padding-top: 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
}
.pt-footer__copy {
    font-size: .78rem;
    color: #f1f5f9;
}
.pt-footer__copy span { color: #4ade80; }

.pt-footer__badges {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem;
}
.pt-footer__badge {
    display: inline-flex;
    align-items: center;
    gap: .4rem;
    padding: .3rem .75rem;
    border-radius: 9999px;
    border: 1px solid rgba(22,163,74,.2);
    background: rgba(22,163,74,.06);
    font-size: .7rem;
    font-weight: 600;
    color: #4ade80;
    letter-spacing: .04em;
}
.pt-footer__badge i { font-size: 10px; }

/* ── Responsive ── */
@@media (max-width: 1100px) {
    .pt-footer__top {
        grid-template-columns: 1fr 1fr;
        gap: 2rem;
    }
    .pt-footer__brand { grid-column: 1 / -1; }
}
@@media (max-width: 560px) {
    .pt-footer__top { grid-template-columns: 1fr; }
    .pt-footer__brand { grid-column: auto; text-align: center; }
    .pt-footer__tagline { margin-left: auto; margin-right: auto; }
    .pt-footer__socials { justify-content: center; }
    .pt-footer__logo { margin-left: auto; margin-right: auto; display: block; }

    .pt-footer__col-title {
        justify-content: center;
        text-align: center;
    }
    .pt-footer__col-title::after { display: none; }

    /* Links: wrap across lines, centered */
    .pt-footer__links {
        flex-direction: row;
        flex-wrap: wrap;
        justify-content: center;
        gap: .55rem .9rem;
    }
    .pt-footer__links a {
        gap: .4rem;
    }
    .pt-footer__links a:hover { gap: .55rem; }

    .pt-footer__bottom { flex-direction: column; text-align: center; }
}
</style>

