@model List<IPTS.ViewModels.AppointmentViewModel>
@using IPTS.Models.Entites
@{
    ViewData["Title"] = "My Appointments";
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
    var nowUtc = DateTime.UtcNow;
    string BadgeClass(AppointmentViewModel appt, out string display)
    {
        var isPast = appt.ScheduledTime <= nowUtc;

        display = appt.StatusDisplay;

        if (isPast && appt.Status == AppointmentStatus.Pending)
        {
            display = @SharedLocalizer["Appt_Status_Expired"];
            return "bg-orange-100 text-orange-800";
        }
        if (isPast && appt.Status == AppointmentStatus.Confirmed)
        {
            display =  @SharedLocalizer["Dash_CompletedMonth"];
            return "bg-blue-100 text-blue-800";
        }
        return appt.Status switch
        {
            AppointmentStatus.Confirmed => "bg-green-100 text-green-800",
            AppointmentStatus.Pending => "bg-yellow-100 text-yellow-800",
            AppointmentStatus.Completed => "bg-blue-100 text-blue-800",
            AppointmentStatus.Cancelled => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }
}

<div class="mx-auto max-w-4xl py-8">
    <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-bold"> @SharedLocalizer["MyAppointments"]</h2>
        <a href="/home/therapies"
           class="inline-flex items-center rounded-md bg-green-600 px-4 py-2 text-sm font-medium text-white shadow transition hover:bg-green-700">
            <i class="fa-solid fa-plus mr-2"></i> @SharedLocalizer["Appt_New"]
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="mb-4 rounded border-l-4 border-yellow-400 bg-yellow-50 p-4">
            <p class="text-yellow-800">@SharedLocalizer["Appt_NoAppointments"]</p>
        </div>
    }
    else
    {
        <div class="grid gap-6">
            @foreach (var appt in Model)
            {
                var isPast = appt.ScheduledTime <= nowUtc;
                var badgeText = "";
                var badgeClass = BadgeClass(appt, out badgeText);

                <div class="flex flex-col rounded-lg bg-white p-6 shadow md:flex-row md:items-center md:justify-between">
                    <div>
                        <div class="mb-2 flex items-center gap-2">
                            <span class="text-lg font-semibold">@appt.DoctorName</span>

                            <span class="@badgeClass ml-2 rounded-full px-3 py-1 text-xs font-bold">
                                @badgeText
                            </span>

                            @if (isPast)
                            {
                                <span class="ml-1 rounded-full border border-gray-200 bg-gray-100 px-2 py-0.5 text-[10px] text-gray-700">
                                    @SharedLocalizer["Appt_Past"]
                                </span>
                            }
                        </div>

                        <div class="mb-1 text-sm text-gray-600">
                            <span class="font-medium"> @SharedLocalizer["Shared_Date"]:</span> @appt.ScheduledTime.ToString("MMMM dd, yyyy")
                            <span class="mx-2">|</span>
                            <span class="font-medium"> @SharedLocalizer["Shared_Time"]:</span> @appt.ScheduledTime.ToString("HH:mm")
                        </div>

                        <div class="text-xs text-gray-500">
                             @SharedLocalizer["Req_Duration"]: @appt.TotalDurationMinutes  @SharedLocalizer["Shared_Min"]
                        </div>

                        @if (!string.IsNullOrWhiteSpace(appt.Notes))
                        {
                            <div class="mt-2 text-sm text-gray-700">
                                <span class="font-medium"> @SharedLocalizer["Shared_Notes"]:</span> @appt.Notes
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(appt.PrescriptionFileName))
                        {
                            <div class="mt-2 text-sm">
                                <span class="font-medium">@SharedLocalizer["Shared_Prescription"]:</span>
                                <a href="@Url.Action("DownloadPrescription", "Appointment", new { area = "Patient", id = appt.Id })" target="_blank" rel="noopener noreferrer" class="ml-1 inline-block rounded bg-blue-100 px-2 py-1 text-blue-700 hover:bg-blue-200">
                                    <img src="~/images/logo.png" class="inline-block w-4 h-4" alt="logo" /> @appt.PrescriptionDisplayName
                                </a>
                            </div>
                        }
                    </div>
                    <div class="mt-4 flex flex-col gap-2 md:mt-0 md:flex-row">
                        <a href="@Url.Action("my-appointments", "Appointment", new { area = "Patient", id = appt.Id })"
                           class="rounded bg-blue-600 px-4 py-2 text-center text-sm text-white hover:bg-blue-700">
                             @SharedLocalizer["Shared_Details"]
                        </a>

                        @* نسمح بالتعديل فقط إن كانت الحالة Pending ولم ينته وقت الموعد *@
                        @if (appt.Status == AppointmentStatus.Pending && !isPast)
                        {
                            <a href="@Url.Action("Edit", "Appointment", new { area = "Patient", id = appt.Id })"
                               class="rounded bg-yellow-500 px-4 py-2 text-center text-sm text-white hover:bg-yellow-600">
                                 @SharedLocalizer["Shared_Edit"]
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
