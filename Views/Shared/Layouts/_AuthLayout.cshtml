@{
    Layout = "~/Views/Shared/Layouts/_MainLayout.cshtml";
}

<style>
    .auth-bg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        z-index: 0;
        overflow: hidden;
    }

    .auth-orb {
        position: absolute;
        border-radius: 50%;
        opacity: 0.10;
        animation: orbFloat 9s ease-in-out infinite;
    }

    .auth-orb-1 {
        width: 340px;
        height: 340px;
        background: #0F9B7A;
        top: -100px;
        left: -100px;
        animation-delay: 0s;
    }

    .auth-orb-2 {
        width: 220px;
        height: 220px;
        background: #0D7A62;
        bottom: -60px;
        right: -60px;
        animation-delay: -4s;
    }

    .auth-orb-3 {
        width: 100px;
        height: 100px;
        background: #0F9B7A;
        top: 45%;
        right: 12%;
        animation-delay: -7s;
    }

    .auth-grid {
        position: fixed;
        inset: 0;
        background-image: radial-gradient(circle, #0F9B7A1A 1px, transparent 1px);
        background-size: 30px 30px;
        pointer-events: none;
        z-index: 0;
    }

    @@keyframes orbFloat {
        0%, 100% { transform: translate(0, 0) scale(1); }
        33%       { transform: translate(14px, -20px) scale(1.04); }
        66%       { transform: translate(-10px, 12px) scale(0.97); }
    }

    .auth-logo-wrap {
        animation: authSlideDown 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
        position: relative;
        z-index: 1;
    }

    @@keyframes authSlideDown {
        from { opacity: 0; transform: translateY(-22px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .auth-logo-wrap img {
        filter: drop-shadow(0 4px 12px #0F9B7A33);
        transition: transform 0.3s ease, filter 0.3s ease;
    }

    .auth-logo-wrap img:hover {
        transform: scale(1.06);
        filter: drop-shadow(0 6px 18px #0F9B7A55);
    }

    .auth-card-wrap {
        position: relative;
        z-index: 1;
        width: 100%;
        display: flex;
        justify-content: center;
        animation: authCardUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.1s both;
    }

    .auth-card-wrap > * {
        width: 100%;
        background: rgba(255, 255, 255, 0.92) !important;
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        border: 1px solid rgba(15, 155, 122, 0.10) !important;
        border-radius: 20px !important;
        box-shadow: 0 8px 40px rgba(15, 155, 122, 0.08), 0 1px 0 rgba(255,255,255,0.8) inset !important;
    }

    @@keyframes authCardUp {
        from { opacity: 0; transform: translateY(28px) scale(0.97); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* Shared Auth UI identity */
    @@keyframes authUiFloatA {
        0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(20px, -18px, 0) scale(1.05); }
    }

    @@keyframes authUiFloatB {
        0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
        50% { transform: translate3d(-18px, 16px, 0) scale(0.96); }
    }

    @@keyframes authUiCardIn {
        from { opacity: 0; transform: translateY(18px) scale(0.985); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }

    .auth-ui-card {
        position: relative;
        animation: authUiCardIn 700ms ease-out both;
    }

    .auth-ui-card::after {
        content: "";
        position: absolute;
        inset: 0;
        border-radius: inherit;
        padding: 1px;
        background: linear-gradient(135deg, rgba(16, 185, 129, 0.22), rgba(37, 99, 235, 0.16), rgba(255, 255, 255, 0.35));
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
    }

    .auth-ui-title {
        background: linear-gradient(90deg, #0f172a 0%, #0f766e 45%, #2563eb 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
    }

    .auth-ui-orb {
        animation-iteration-count: infinite;
        animation-timing-function: ease-in-out;
        will-change: transform;
    }

    .auth-ui-orb-a { animation: authUiFloatA 9s ease-in-out infinite; }
    .auth-ui-orb-b { animation: authUiFloatB 11s ease-in-out infinite; }

    .auth-ui-input {
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.7);
    }

    @@media (max-width: 639.98px) {
        .auth-ui-card.auth-ui-pad { padding: 1.25rem; }
    }
</style>

<div class="auth-grid"></div>
<div class="auth-bg">
    <div class="auth-orb auth-orb-1"></div>
    <div class="auth-orb auth-orb-2"></div>
    <div class="auth-orb auth-orb-3"></div>
</div>

<div class="bg-gray-100 w-full min-h-screen flex items-center justify-center">
    <div class="relative w-full max-w-7xl mx-auto flex flex-col items-center px-4 py-12">

        <div class="auth-logo-wrap mb-6">
            <img src="/images/logo.svg"
                 alt="Logo"
                 class="w-60 sm:w-72 h-auto">
        </div>

        <div class="auth-card-wrap">
            @RenderBody()
        </div>

    </div>
</div>
