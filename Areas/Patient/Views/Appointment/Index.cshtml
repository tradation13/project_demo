@using IPTS.ViewModels
@using iText.Layout.Element
@model DoctorScheduleViewModel
@{
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
    ViewData["Title"] = @SharedLocalizer["Shared_Available"] + " " + @SharedLocalizer["Appt_Header"];

    var doctor = Model?.Doctor;
    var slots = Model?.TimeSlots ?? new List<AppointmentTimeSlotViewModel>();
    if (doctor == null) 
    {
        <div class="py-10 text-center text-red-600">
            <p>@SharedLocalizer["Error_PatientProfileNotFound"]</p>
        </div>
        return;
    }
}

<section class="py-10" aria-label="@SharedLocalizer["Shared_Available"] @SharedLocalizer["Appt_Header"]">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

        <!-- Doctor + Date Filter -->
        <section class="mb-8 overflow-hidden rounded-3xl border border-gray-100 bg-white shadow-xl">
            <header class="p-6">
                <div class="flex flex-col gap-4 sm:flex-row sm:items-center">
                    <div class="flex h-16 w-16 items-center justify-center overflow-hidden rounded-2xl bg-gray-100">
                        @if (!string.IsNullOrWhiteSpace(doctor?.PhotoUrl))
                        {
                            <img src="@doctor.PhotoUrl" alt="@doctor.FullName" class="h-full w-full object-cover" />
                        }
                        else
                        {
                            <i class="fa-solid fa-user-doctor text-2xl text-gray-500"></i>
                        }
                    </div>
                    <div class="flex-1">
                        <h1 class="flex flex-wrap items-center gap-2 text-2xl font-bold text-gray-900">
                            @doctor?.FullName
                            @if (doctor?.IsAvailable == true)
                            {
                                <span class="inline-flex items-center gap-1 rounded-full bg-green-100 px-2 py-1 text-xs text-green-700">
                                    <i class="fa-solid fa-circle-check"></i> @SharedLocalizer["Shared_Available"]
                                </span>
                            }
                        </h1>
                        <div class="mt-2 flex flex-wrap items-center gap-3 text-sm text-gray-600">
                            @if (!string.IsNullOrWhiteSpace(doctor?.Specialty))
                            {
                                <span class="inline-flex items-center gap-1">
                                    <i class="fa-solid fa-stethoscope text-gray-500"></i> @doctor.Specialty
                                </span>
                            }
                            @if (doctor?.YearsOfExperience != null)
                            {
                                <span class="inline-flex items-center gap-1">
                                    <i class="fa-regular fa-clock text-gray-500"></i> @doctor.YearsOfExperience @SharedLocalizer["Appt_Exp_Years"]
                                </span>
                            }
                            @if (doctor?.Rating != null)
                            {
                                <span class="inline-flex items-center gap-1">
                                    <i class="fa-solid fa-star text-yellow-400"></i> @doctor.Rating
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </header>

            <form method="get" class="border-t border-gray-100 bg-gray-50/70 p-6">
                <div class="grid grid-cols-1 gap-4 md:grid-cols-[minmax(220px,1fr)_auto_1fr] md:items-end">
                    <div>
                        <label for="date" class="mb-2 block text-sm font-medium text-gray-700">@SharedLocalizer["Shared_Date"]</label>
                        <input id="date" name="date" type="date"
                               value="@Model?.SelectedDate.ToString("yyyy-MM-dd")"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               class="w-full rounded-md border border-gray-300 bg-white px-3 py-2 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-blue-600" />
                    </div>

                    <div class="flex items-end">
                        <button type="submit"
                                class="inline-flex h-10 items-center justify-center rounded-md bg-blue-600 px-5 text-white transition hover:bg-blue-700">
                            @SharedLocalizer["Shared_Search"]
                        </button>
                    </div>

                    <div class="flex items-end text-sm text-gray-500 md:justify-end">
                        @SharedLocalizer["Shared_WorkingHours"]: @SharedLocalizer["Appt_Sched_WorkingHoursRange"]
                    </div>
                </div>
            </form>
        </section>

        <!-- Booking Form -->
        <form asp-area="patient"
              asp-controller="Appointment"
              asp-action="Book"
              asp-route-doctorId="@doctor?.Id"
              method="post"
              enctype="multipart/form-data"
              class="rounded-3xl border border-gray-100 bg-white p-6 shadow-xl">

            @Html.AntiForgeryToken()

            <input type="hidden" name="ScheduledDate" value="@Model?.SelectedDate.ToString("yyyy-MM-dd")" />
            <input type="hidden" id="time" name="Time" />

            <div class="mb-4">
                <h5 class="font-semibold text-gray-800">@SharedLocalizer["Appt_Booking_Title"]</h5>
            </div>

            <!-- Slots Grid -->
            <div class="grid grid-cols-2 gap-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6">
                @if (!slots.Any())
                {
                    <div class="col-span-6 py-8 text-center text-sm text-gray-500">
                        <i class="fas fa-calendar-times mb-2 text-2xl text-red-400"></i>
                        <p>@SharedLocalizer["Appt_NoSlots"]</p>
                    </div>
                }
                else
                {
                    foreach (var s in slots)
                    {
                        var disabled = !s.IsAvailable;
                        <label class="@(!disabled ?"relative block min-h-[72px] cursor-pointer rounded border-2 p-3 text-center text-sm transition peer-checked:border-blue-700 peer-checked:ring-2 peer-checked:ring-blue-400 bg-green-50 hover:bg-green-100 border-green-300 text-green-800 hover:border-green-400" : "bg-red-50 text-red-700 border-red-300 opacity-75 cursor-not-allowed")">

                            <!-- ✅ يربط مباشرة مع SlotIndex -->
                            <input type="radio"
                                   name="SlotIndex"
                                   value="@s.SlotIndex"
                                   data-time="@s.Time"
                                   class="peer sr-only"
                            @(disabled ? "disabled" : "") />

                            <div class="mb-1 text-base font-bold peer-checked:text-white">@s.Time</div>
                            <div class="@(disabled ?"text-xs text-red-500" : "text-green-600") peer-checked:text-white">
                                @(disabled ? "Booked" : "Available")
                            </div>

                            <div class="pointer-events-none absolute inset-0 rounded peer-checked:bg-blue-600 peer-checked:shadow-lg"></div>
                        </label>
                    }
                }
            </div>

            <!-- Summary -->
            <div class="mt-4 grid grid-cols-2 gap-4 rounded-lg bg-gray-50 p-4 text-sm text-gray-700 md:grid-cols-4">
                <div><span class="font-medium">@SharedLocalizer["Appt_Selected"]:</span> <span id="selectedCount" class="font-bold text-blue-600">0</span></div>
                <div><span class="font-medium">@SharedLocalizer["Req_Duration"]:</span> <span id="totalDuration" class="font-bold text-green-600">0</span> @SharedLocalizer["Shared_Minutes"]</div>
                <div class="col-span-2 md:col-span-2"><span class="font-medium">@SharedLocalizer["Shared_Time"]:</span> <span id="timeRange" class="font-bold text-purple-600">-</span></div>
            </div>

            <!-- Notes -->
            <div class="mt-6">
                <label for="Notes" class="mb-2 block text-sm font-medium text-gray-700">@SharedLocalizer["Shared_Notes"]</label>
                <textarea id="Notes" name="Notes" rows="3"
                          class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-blue-600"
                          placeholder=@SharedLocalizer["Shared_Optional"]></textarea>
            </div>

            <!-- Prescription File Upload Section -->
            <div class="mt-6 space-y-6 rounded-2xl border border-slate-200 bg-gradient-to-br from-slate-50 to-blue-50 p-5 shadow-sm sm:p-6">
                <div class="flex items-start gap-4">
                    <div class="mt-0.5 flex h-10 w-10 items-center justify-center rounded-xl bg-blue-100 text-blue-700">
                        <i class="fa-solid fa-file-medical"></i>
                    </div>
                    <div class="space-y-1.5">
                        <h3 class="text-base font-bold text-slate-800">@SharedLocalizer["UploadMedicalPrescription"]</h3>
                        <p class="text-sm text-slate-600">@SharedLocalizer["FileFormatAndSizeLimit"]</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                    <label class="group flex cursor-pointer items-center gap-3 rounded-xl border border-slate-300 bg-white px-4 py-3.5 transition hover:border-slate-400 hover:shadow-sm">
                        <input type="radio" name="hasPrescription" value="no" class="h-4 w-4 text-blue-600 focus:ring-blue-500"
                               onclick="togglePrescriptionUpload(false)" checked>
                        <span class="text-sm font-medium text-slate-700">@SharedLocalizer["Shared_No"]</span>
                    </label>

                    <label class="group flex cursor-pointer items-center gap-3 rounded-xl border border-blue-200 bg-blue-50 px-4 py-3.5 transition hover:border-blue-300 hover:shadow-sm">
                        <input type="radio" name="hasPrescription" value="yes" class="h-4 w-4 text-blue-600 focus:ring-blue-500"
                               onclick="togglePrescriptionUpload(true)">
                        <span class="text-sm font-medium text-blue-800">@SharedLocalizer["Shared_Yes"]</span>
                    </label>
                </div>

                <div id="prescriptionUploadSection" class="hidden space-y-4">
                    <label for="PrescriptionFile"
                           class="flex min-h-[200px] w-full cursor-pointer flex-col items-center justify-center gap-1.5 rounded-2xl border-2 border-dashed border-blue-300 bg-white px-6 py-8 text-center transition-all hover:border-blue-500 hover:bg-blue-50">
                        <div class="mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-blue-100 text-blue-700">
                            <i class="fa-solid fa-cloud-arrow-up text-xl"></i>
                        </div>
                        <p class="text-sm font-semibold text-blue-700">@SharedLocalizer["ClickToUploadOrDragAndDrop"]</p>
                        <p class="text-xs text-slate-500">@SharedLocalizer["FileFormatAndSizeLimit"]</p>
                        <span class="mt-4 inline-flex rounded-lg border border-blue-300 bg-blue-600 px-4 py-2 text-xs font-semibold text-white">
                            @SharedLocalizer["UploadMedicalPrescription"]
                        </span>
                        <input id="PrescriptionFile" type="file" name="PrescriptionFile" class="hidden"
                               accept="image/jpeg,image/png,application/pdf" onchange="updateFileDisplay(this, '@SharedLocalizer["FileSelected"]')" />
                    </label>

                    <div id="fileNameDisplay" class="hidden items-start gap-2 rounded-lg border border-green-200 bg-green-50 px-3 py-2 text-sm text-green-700">
                        <i class="fa-solid fa-circle-check mt-0.5" id="fileCheckIcon"></i>
                        <span id="fileNameText" class="break-all"></span>
                    </div>
                </div>
            </div>





    

            <!-- Actions -->
            <div class="mt-6 flex justify-end gap-3">
                <a asp-area="" asp-controller="Home" asp-action="Therapies"
                   class="rounded-md bg-gray-500 px-6 py-2 text-white transition hover:bg-gray-600">@SharedLocalizer["Shared_Cancel"]</a>
                <button type="submit" id="submitBtn" disabled
                        class="rounded-md bg-blue-600 px-6 py-2 text-white transition hover:bg-blue-700 disabled:cursor-not-allowed disabled:opacity-50">
                    @SharedLocalizer["Therapies_BookNow"]
                </button>
            </div>
        </form>
    </div>
</section>

<script>
    const radios = document.querySelectorAll('input[type="radio"][name="SlotIndex"]');
    const selectedCount = document.getElementById('selectedCount');
    const totalDuration = document.getElementById('totalDuration');
    const timeRange = document.getElementById('timeRange');
    const submitBtn = document.getElementById('submitBtn');
    const hTime = document.getElementById('time');

    function resetSummary() {
        selectedCount.textContent = '0';
        totalDuration.textContent = '0';
        timeRange.textContent = '-';
        hTime.value = '';
        submitBtn.disabled = true;
    }

    function onChangeRadio(e) {
        const input = e.target;
        if (!input || input.disabled) return;

        const time = input.dataset.time || '';
        selectedCount.textContent = '1';
        totalDuration.textContent = '20';
        timeRange.textContent = time;
        hTime.value = time;
        submitBtn.disabled = false;
    }

    // Prescription file upload handling
    function togglePrescriptionUpload(show) {
        const uploadSection = document.getElementById('prescriptionUploadSection');
        if (show) {
            uploadSection.classList.remove('hidden');
        } else {
            uploadSection.classList.add('hidden');
            // Clear file selection
            const fileInput = document.getElementById('PrescriptionFile');
            fileInput.value = '';
            updateFileDisplay(fileInput);
        }
    }

    function updateFileDisplay(input, selectedText) {
        const fileNameDisplay = document.getElementById('fileNameDisplay');
        const fileNameText = document.getElementById('fileNameText');

        if (input.files && input.files[0]) {
            const fileName = input.files[0].name;
            const fileSize = (input.files[0].size / 1024).toFixed(2);

            // استخدام النص المترجم الممرر من الـ View
            fileNameText.textContent = `${selectedText}: ${fileName} (${fileSize} KB)`;
            fileNameDisplay.classList.remove('hidden');
            fileNameDisplay.classList.add('flex');
        } else {
            fileNameText.textContent = '';
            fileNameDisplay.classList.remove('flex');
            fileNameDisplay.classList.add('hidden');
        }
    }

    resetSummary();
    radios.forEach(r => r.addEventListener('change', onChangeRadio));
</script>
