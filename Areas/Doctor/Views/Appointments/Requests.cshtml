@model List<IPTS.ViewModels.AppointmentViewModel>
@using IPTS.Models.Entites
@{
    ViewData["Title"] = SharedLocalizer["Req_Title"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="prac-page space-y-6">

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
            <div class="avatar-lg">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-gray-900 leading-tight">@SharedLocalizer["Req_PendingHeader"]</h2>
                <p class="text-sm text-gray-500 mt-0.5">@SharedLocalizer["Req_Title"]</p>
            </div>
        </div>
        @if (Model != null && Model.Any())
        {
            <span class="status-chip status-pending">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                @Model.Count @SharedLocalizer["Req_Title"]
            </span>
        }
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <span class="empty-icon">📭</span>
            <p class="empty-text">@SharedLocalizer["Req_NoPendingFound"]</p>
        </div>
    }
    else
    {
        <div class="prac-section">
            <div class="group-divider">
                <div class="group-divider-line"></div>
                <span class="group-label">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    @SharedLocalizer["Status_Pending"]
                    <span class="group-count">@Model.Count</span>
                </span>
                <div class="group-divider-line"></div>
            </div>

            <div class="prac-list">
                @foreach (var appt in Model)
                {
                    var scheduledUtcIso = DateTime.SpecifyKind(appt.ScheduledTime, DateTimeKind.Utc).ToString("o");
                    var initials = string.IsNullOrWhiteSpace(appt.PatientName)
                        ? "P"
                        : string.Join("", appt.PatientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0].ToString().ToUpper()));

                    <div class="prac-row">
                        <div class="prac-row-main">
                            <div class="avatar-sm">@initials</div>
                            <div class="prac-row-body">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="test-name !mb-0">@appt.PatientName</p>
                                    <span class="status-chip status-pending">@SharedLocalizer["Status_Pending"]</span>
                                </div>
                                <div class="test-date mt-1.5">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                    </svg>
                                    <span class="appt-date" data-utc="@scheduledUtcIso">@appt.ScheduledTime.ToString("MMMM dd, yyyy")</span>
                                    ·
                                    <span class="appt-time" data-utc="@scheduledUtcIso">@appt.ScheduledTime.ToString("HH:mm")</span>
                                    · @appt.TotalDurationMinutes @SharedLocalizer["Shared_Min"]
                                </div>

                                @if (!string.IsNullOrWhiteSpace(appt.Notes))
                                {
                                    <p class="mt-2 text-xs text-gray-500 leading-relaxed rounded-lg bg-gray-50 border border-gray-100 px-3 py-2">@appt.Notes</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(appt.PrescriptionFileName))
                                {
                                    <a href="@Url.Action("DownloadPrescription", "Appointments", new { id = appt.Id, area = "Doctor" })"
                                       class="btn-prac-indigo mt-2 inline-flex"
                                       target="_blank" rel="noopener noreferrer">
                                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.172 7l-6.586 6.586a2 2 0 102.828 2.828l6.414-6.586a4 4 0 00-5.656-5.656l-6.415 6.585a6 6 0 108.486 8.486L20.5 13"/>
                                        </svg>
                                        @appt.PrescriptionDisplayName
                                    </a>
                                }
                            </div>
                        </div>

                        <div class="prac-row-actions">
                            <form asp-action="AcceptRequest" asp-controller="Appointments" asp-area="Doctor" method="get" class="inline">
                                <input type="hidden" name="id" value="@appt.Id" />
                                <button type="submit" class="btn-prac-accept">
                                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                                    </svg>
                                    @SharedLocalizer["Shared_Accept"]
                                </button>
                            </form>
                            <form asp-action="RejectRequest" asp-controller="Appointments" asp-area="Doctor" method="get" class="inline">
                                <input type="hidden" name="id" value="@appt.Id" />
                                <button type="submit" class="btn-prac-danger">
                                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                                    </svg>
                                    @SharedLocalizer["Shared_Reject"]
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

<script>
const browserTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;
function formatUtcTime(date, options = {}) {
    if (!date || Number.isNaN(date.getTime())) return '';
    return new Intl.DateTimeFormat('en-GB', { timeZone: browserTimeZone, hour12: false, ...options }).format(date);
}
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('[data-utc]').forEach(el => {
        const d = new Date(el.getAttribute('data-utc'));
        if (el.classList.contains('appt-date')) {
            el.textContent = formatUtcTime(d, { year: 'numeric', month: 'long', day: '2-digit' });
        } else if (el.classList.contains('appt-time')) {
            el.textContent = formatUtcTime(d, { hour: '2-digit', minute: '2-digit' });
        }
    });
});
</script>
