                            <i class="fas fa-chart-line text-primary-600 text-xl"></i>
                        </div>
                        <p class="text-sm font-medium text-gray-700">Smart Tracking</p>
                    </div>
                    <div class="text-center">
                        <div class="inline-flex items-center justify-center w-12 h-12 bg-white rounded-lg shadow-md mb-2">
                            <i class="fas fa-user-md text-primary-600 text-xl"></i>
                        </div>
                        <p class="text-sm font-medium text-gray-700">Expert Care</p>
