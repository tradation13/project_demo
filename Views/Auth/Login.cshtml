@model LoginViewModel
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Login_PageTitle"];
}

<div class="auth-ui-card auth-ui-pad relative mx-auto w-full max-w-md overflow-hidden rounded-[2rem] border border-white/70 bg-white/85 p-8 shadow-[0_24px_80px_rgba(15,23,42,0.12)] backdrop-blur-xl sm:p-10">
    <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[2rem]">
        <div class="auth-ui-orb auth-ui-orb-a absolute -left-10 -top-10 h-32 w-32 rounded-full bg-emerald-500/10 blur-3xl"></div>
        <div class="auth-ui-orb auth-ui-orb-b absolute -bottom-12 -right-8 h-36 w-36 rounded-full bg-blue-500/10 blur-3xl"></div>
    </div>

    <div class="relative z-10">
        <div class="mb-10 text-center">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-500 to-blue-600 text-white shadow-lg shadow-emerald-500/20 ring-1 ring-white/60">
                <i class="fas fa-user-lock text-lg" aria-hidden="true"></i>
            </div>
            <h2 class="auth-ui-title text-3xl font-extrabold tracking-tight sm:text-[2rem]">
                @SharedLocalizer["Shared_SignIn"]
            </h2>
            <p class="mt-3 text-sm leading-6 text-slate-500 sm:text-[0.95rem]">
                @SharedLocalizer["Login_NoAccount"]
                <a href="@Url.Action("Register", "Auth")"
                   class="font-semibold text-emerald-600 transition-colors hover:text-emerald-700 hover:underline"
                   title="@SharedLocalizer["Login_SignUp_Title"]">
                    @SharedLocalizer["Login_SignUp_Link"]
                </a>
            </p>
        </div>

        <form asp-controller="auth" asp-action="login" method="post" autocomplete="off" class="space-y-6 text-sm">
            <input asp-for="ReturnUrl" type="hidden" />

            <div class="space-y-2">
                <label asp-for="UsernameOrEmail" class="ml-1 block text-sm font-medium text-slate-700">
                    @SharedLocalizer["Login_Label_UserEmail"]
                </label>
                <input asp-for="UsernameOrEmail"
                       class="auth-ui-input w-full rounded-2xl border border-slate-200 bg-white/90 px-4 py-3.5 text-[15px] text-slate-900 outline-none transition-all placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10"
                       placeholder="Leo@gmail.com" />
                <span asp-validation-for="UsernameOrEmail" class="mt-1 block text-xs text-red-500"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="Password" class="ml-1 block text-sm font-medium text-slate-700">
                    @SharedLocalizer["Shared_Password"]
                </label>
                <div x-data="{ show: false }" class="relative">
                    <input :type="show ? 'text' : 'password'"
                           asp-for="Password"
                           class="auth-ui-input w-full rounded-2xl border border-slate-200 bg-white/90 px-4 py-3.5 pr-12 text-[15px] text-slate-900 outline-none transition-all placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10"
                           placeholder="••••••••" />
                    <button x-on:click="show = !show" type="button"
                            class="absolute right-4 top-1/2 flex -translate-y-1/2 items-center justify-center text-slate-400 transition-colors hover:text-slate-600">
                        <i :class="show ? 'fas fa-eye' : 'fas fa-eye-slash'" class="text-sm"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="mt-1 block text-xs text-red-500"></span>
            </div>

            <div class="flex flex-col gap-4 pt-1 text-sm text-slate-600">
                <label for="remember_me" class="flex items-center gap-2">
                    <input asp-for="RememberMe" type="checkbox" id="remember_me"
                           class="rounded border-slate-300 text-emerald-600 focus:ring-emerald-600" />
                    <span>@SharedLocalizer["Login_RememberMe"]</span>
                </label>

                <a href="@Url.Action("ForgotPassword","auth")"
                   class="font-medium transition-colors hover:text-slate-900 hover:underline">
                    @SharedLocalizer["Shared__ForgotPassword"]
                </a>
            </div>

            <div class="flex flex-col gap-3 pt-3">
                <button type="submit"
                        class="inline-flex w-full items-center justify-center rounded-2xl bg-gradient-to-r from-emerald-600 to-emerald-500 px-8 py-3.5 font-semibold text-white shadow-lg shadow-emerald-600/20 transition-all duration-200 hover:-translate-y-0.5 hover:from-emerald-700 hover:to-emerald-600 hover:shadow-xl hover:shadow-emerald-700/25"
                        aria-label='@SharedLocalizer["Shared_SignIn"]'>
                    @SharedLocalizer["Shared_SignIn"]
                </button>

                <a asp-controller="Home" asp-action="Index"
                   class="inline-flex w-full items-center justify-center rounded-2xl border border-slate-200 bg-white px-6 py-3.5 font-semibold text-slate-600 transition-all duration-200 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-900">
                    ← Back to PhysioTech Home
                </a>
            </div>

            @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
        </form>

        @await Html.PartialAsync("_ValidationScriptsPartial")
    </div>
</div>
