@model IPTS.ViewModels.MedicalCaseViewModel
@using IPTS.Models.Enums
@{
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    ViewData["Title"] = SharedLocalizer["MedCase_Create_Title"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";

    var firstName = patient?.User?.FirstName ?? "";
    var lastName = patient?.User?.LastName ?? "";
    var fullName = $"{firstName} {lastName}".Trim();
    var initials = $"{(firstName.Length > 0 ? firstName[0].ToString() : "")}{(lastName.Length > 0 ? lastName[0].ToString() : "")}".ToUpper();
    if (string.IsNullOrWhiteSpace(initials)) { initials = "?"; }
}

<style>
    @@keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(16px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes popIn {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }

    .animate-fade-slide-up {
        animation: fadeSlideUp 0.5s ease-out both;
    }

    .animate-pop-in {
        animation: popIn 0.2s ease-out both;
    }
</style>

<div class="mx-auto max-w-7xl">
    <form asp-action="Create" method="post" class="space-y-6">
        <input type="hidden" asp-for="PatientId" />

        <!-- Patient identity merged directly into the form as its header -->
        <div class="animate-fade-slide-up overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-sm">
            <div class="relative bg-gradient-to-r from-indigo-600 via-indigo-500 to-violet-500 px-6 py-6 sm:px-8 sm:py-7">
                <div class="flex flex-wrap items-center gap-4">
                    <div class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-white/15 text-xl font-bold text-white ring-2 ring-white/40 backdrop-blur-sm">
                        @initials
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-semibold uppercase tracking-wider text-indigo-100/80">@SharedLocalizer["MedCase_Create_Header"]</p>
                        <h2 class="truncate text-xl font-bold leading-tight text-white sm:text-2xl">@fullName</h2>
                    </div>
                    <span class="ms-auto inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1.5 text-xs font-semibold text-white ring-1 ring-white/30">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-3.5 w-3.5">
                            <path d="M12 4.5v15m7.5-7.5h-15" />
                        </svg>
                        @SharedLocalizer["MedCase_Create_Title"]
                    </span>
                </div>
            </div>

            <div class="grid gap-5 p-6 sm:p-8 lg:grid-cols-2">
                <div>
                    <label asp-for="Name" class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["MedCase_Create_Name"]</label>
                    <input asp-for="Name" class="w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm text-gray-900 outline-none transition-all duration-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200" />
                    <span asp-validation-for="Name" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
                </div>

                <div>
                    <label asp-for="Description" class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["MedCase_Create_Desc"]</label>
                    <input asp-for="Description" class="w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm text-gray-900 outline-none transition-all duration-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200" />
                    <span asp-validation-for="Description" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
                </div>
            </div>
        </div>

        <!-- Wide two-column layout: vitals beside clinical history, instead of one long stacked column -->
        <div class="grid gap-6 lg:grid-cols-2">

            <div class="animate-fade-slide-up rounded-2xl border border-gray-100 bg-white p-6 shadow-sm sm:p-7" style="animation-delay:60ms">
                <h3 class="mb-5 flex items-center gap-2 border-b border-gray-100 pb-4 text-sm font-bold text-gray-800">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-indigo-500">
                        <path d="M12 21s-6.5-4.35-9.3-8.1C1 10.2 1.7 6.8 4.8 6c2.1-.5 3.9.7 4.7 2.1C10.3 6.7 12.1 5.5 14.2 6c3.1.8 3.8 4.2 2.1 6.9C13.5 16.65 12 21 12 21z" />
                    </svg>
                    @SharedLocalizer["MedCase_PhysicalVitals_Header"]
                </h3>

                <div class="grid gap-5 sm:grid-cols-2">
                    <div>
                        <label asp-for="Weight" class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["MedCase_Weight"]</label>
                        <div class="relative">
                            <input asp-for="Weight" type="number" step="0.1" placeholder="70" class="w-full rounded-lg border border-gray-200 px-3 py-2.5 pe-12 text-sm text-gray-900 outline-none transition-all duration-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200" />
                            <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-xs font-medium text-gray-400">kg</span>
                        </div>
                        <span asp-validation-for="Weight" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
                    </div>

                    <div>
                        <label asp-for="Height" class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["MedCase_Height"]</label>
                        <div class="relative">
                            <input asp-for="Height" type="number" step="0.1" placeholder="175" class="w-full rounded-lg border border-gray-200 px-3 py-2.5 pe-12 text-sm text-gray-900 outline-none transition-all duration-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200" />
                            <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-xs font-medium text-gray-400">cm</span>
                        </div>
                        <span asp-validation-for="Height" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
                    </div>

                    <div id="bmiBadge" class="hidden sm:col-span-2">
                        <span id="bmiPill" class="inline-flex items-center gap-1.5 rounded-full border border-teal-200 bg-teal-50 px-3 py-1 text-xs font-semibold text-teal-700">
                            BMI <span id="bmiValue">0</span>
                        </span>
                    </div>

                    <div>
                        <label asp-for="DominantSide" class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["MedCase_DominantSide"]</label>
                        <div class="relative">
                            <select asp-for="DominantSide" asp-items="Html.GetEnumSelectList<EnDominantSide>()" class="w-full appearance-none rounded-lg border border-gray-200 bg-white px-3 py-2.5 pe-9 text-sm text-gray-900 outline-none transition-all duration-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200">
                                <option value="">@SharedLocalizer["Shared_Select"]</option>
                            </select>
                            <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-gray-400">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                                    <path d="m6 9 6 6 6-6" />
                                </svg>
                            </span>
                        </div>
                        <span asp-validation-for="DominantSide" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
                    </div>

                    <div>
                        <label asp-for="ActivityLevel" class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-gray-700">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-gray-400">
                                <path d="M13 3 4 14h6l-1 7 9-11h-6l1-7z" />
                            </svg>
                            @SharedLocalizer["MedCase_ActivityLevel"]
                        </label>
                        <div class="relative">
                            <select asp-for="ActivityLevel" asp-items="Html.GetEnumSelectList<EnActivityLevel>()" class="w-full appearance-none rounded-lg border border-gray-200 bg-white px-3 py-2.5 pe-9 text-sm text-gray-900 outline-none transition-all duration-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200">
                                <option value="">@SharedLocalizer["Shared_Select"]</option>
                            </select>
                            <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-gray-400">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                                    <path d="m6 9 6 6 6-6" />
                                </svg>
                            </span>
                        </div>
                        <span asp-validation-for="ActivityLevel" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
                    </div>

                    <div class="sm:col-span-2">
                        <label class="mb-2 flex items-center gap-1.5 text-sm font-semibold text-gray-700">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 text-gray-400">
                                <path d="M12 3s6 6.5 6 11a6 6 0 1 1-12 0c0-4.5 6-11 6-11z" />
                            </svg>
                            @SharedLocalizer["MedCase_BloodGroup"]
                        </label>

                        <select asp-for="BloodGroup" id="BloodGroup" class="hidden">
                            <option value="">@SharedLocalizer["Shared_Select"]</option>
                            <optgroup label="@SharedLocalizer["BloodGroup_PositiveGroup"]">
                                <option value="@((byte)EnBloodGroup.APositive)">@SharedLocalizer["BloodGroup_APositive"]</option>
                                <option value="@((byte)EnBloodGroup.BPositive)">@SharedLocalizer["BloodGroup_BPositive"]</option>
                                <option value="@((byte)EnBloodGroup.OPositive)">@SharedLocalizer["BloodGroup_OPositive"]</option>
                                <option value="@((byte)EnBloodGroup.ABPositive)">@SharedLocalizer["BloodGroup_ABPositive"]</option>
                            </optgroup>
                            <optgroup label="@SharedLocalizer["BloodGroup_NegativeGroup"]">
                                <option value="@((byte)EnBloodGroup.ANegative)">@SharedLocalizer["BloodGroup_ANegative"]</option>
                                <option value="@((byte)EnBloodGroup.BNegative)">@SharedLocalizer["BloodGroup_BNegative"]</option>
                                <option value="@((byte)EnBloodGroup.ONegative)">@SharedLocalizer["BloodGroup_ONegative"]</option>
                                <option value="@((byte)EnBloodGroup.ABNegative)">@SharedLocalizer["BloodGroup_ABNegative"]</option>
                            </optgroup>
                        </select>

                        <div class="space-y-3 rounded-lg border border-gray-100 bg-gray-50/60 p-3">
                            <div>
                                <p class="mb-1.5 text-xs font-medium uppercase tracking-wide text-gray-400">@SharedLocalizer["BloodGroup_PositiveGroup"]</p>
                                <div class="flex flex-wrap gap-2">
                                    <button type="button" data-value="@((byte)EnBloodGroup.APositive)" class="blood-pill rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-semibold text-gray-600 transition-all duration-150 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-800">@SharedLocalizer["BloodGroup_APositive"]</button>
                                    <button type="button" data-value="@((byte)EnBloodGroup.BPositive)" class="blood-pill rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-semibold text-gray-600 transition-all duration-150 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-800">@SharedLocalizer["BloodGroup_BPositive"]</button>
                                    <button type="button" data-value="@((byte)EnBloodGroup.OPositive)" class="blood-pill rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-semibold text-gray-600 transition-all duration-150 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-800">@SharedLocalizer["BloodGroup_OPositive"]</button>
                                    <button type="button" data-value="@((byte)EnBloodGroup.ABPositive)" class="blood-pill rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-semibold text-gray-600 transition-all duration-150 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-800">@SharedLocalizer["BloodGroup_ABPositive"]</button>
                                </div>
                            </div>
                            <div>
                                <p class="mb-1.5 text-xs font-medium uppercase tracking-wide text-gray-400">@SharedLocalizer["BloodGroup_NegativeGroup"]</p>
                                <div class="flex flex-wrap gap-2">
                                    <button type="button" data-value="@((byte)EnBloodGroup.ANegative)" class="blood-pill rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-semibold text-gray-600 transition-all duration-150 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-800">@SharedLocalizer["BloodGroup_ANegative"]</button>
                                    <button type="button" data-value="@((byte)EnBloodGroup.BNegative)" class="blood-pill rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-semibold text-gray-600 transition-all duration-150 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-800">@SharedLocalizer["BloodGroup_BNegative"]</button>
                                    <button type="button" data-value="@((byte)EnBloodGroup.ONegative)" class="blood-pill rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-semibold text-gray-600 transition-all duration-150 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-800">@SharedLocalizer["BloodGroup_ONegative"]</button>
                                    <button type="button" data-value="@((byte)EnBloodGroup.ABNegative)" class="blood-pill rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-semibold text-gray-600 transition-all duration-150 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-800">@SharedLocalizer["BloodGroup_ABNegative"]</button>
                                </div>
                            </div>
                        </div>
                        <span asp-validation-for="BloodGroup" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
                    </div>

                    <div class="grid gap-3 sm:col-span-2 sm:grid-cols-2">
                        <label class="flex cursor-pointer items-center justify-between gap-3 rounded-lg border border-gray-200 px-4 py-3 transition-colors duration-150 hover:bg-gray-50">
                            <span class="text-sm font-medium text-gray-700">@SharedLocalizer["MedCase_Smoker"]</span>
                            <span class="relative inline-flex h-6 w-11 shrink-0 items-center">
                                <input asp-for="IsSmoker" type="checkbox" class="peer absolute inset-0 z-10 h-full w-full cursor-pointer opacity-0" />
                                <span class="absolute inset-0 rounded-full bg-gray-200 transition-colors duration-200 peer-checked:bg-indigo-600 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-300 peer-focus-visible:ring-offset-2"></span>
                                <span class="pointer-events-none relative inline-block h-5 w-5 translate-x-0.5 rounded-full bg-white shadow transition-transform duration-200 peer-checked:translate-x-5"></span>
                            </span>
                        </label>
                        <label class="flex cursor-pointer items-center justify-between gap-3 rounded-lg border border-gray-200 px-4 py-3 transition-colors duration-150 hover:bg-gray-50">
                            <span class="text-sm font-medium text-gray-700">@SharedLocalizer["MedCase_ChronicDiseases"]</span>
                            <span class="relative inline-flex h-6 w-11 shrink-0 items-center">
                                <input asp-for="HasChronicDisease" type="checkbox" class="peer absolute inset-0 z-10 h-full w-full cursor-pointer opacity-0" />
                                <span class="absolute inset-0 rounded-full bg-gray-200 transition-colors duration-200 peer-checked:bg-indigo-600 peer-focus-visible:ring-2 peer-focus-visible:ring-indigo-300 peer-focus-visible:ring-offset-2"></span>
                                <span class="pointer-events-none relative inline-block h-5 w-5 translate-x-0.5 rounded-full bg-white shadow transition-transform duration-200 peer-checked:translate-x-5"></span>
                            </span>
                        </label>
                    </div>
                </div>
            </div>

            <div class="animate-fade-slide-up rounded-2xl border border-gray-100 bg-white p-6 shadow-sm sm:p-7" style="animation-delay:120ms">
                <h3 class="mb-5 flex items-center gap-2 border-b border-gray-100 pb-4 text-sm font-bold text-gray-800">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="h-5 w-5 text-indigo-500">
                        <path d="M9 5H7a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2h-2M9 5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2M9 5a2 2 0 0 0 2 2h2a2 2 0 0 0 2-2M9 14l2 2 4-4" />
                    </svg>
                    @SharedLocalizer["MedCase_Create_Title"]
                </h3>

                <div class="grid gap-5">
                    <div>
                        <label asp-for="InjuryHistory" class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["MedCase_InjuryHistory_Label"]</label>
                        <textarea asp-for="InjuryHistory" rows="2" placeholder="@SharedLocalizer["MedCase_InjuryHistory_Placeholder"]" class="w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm text-gray-900 outline-none transition-all duration-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200"></textarea>
                        <span asp-validation-for="InjuryHistory" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
                    </div>

                    <div>
                        <label asp-for="Medications" class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["MedCase_Medications_Label"]</label>
                        <textarea asp-for="Medications" rows="2" placeholder="@SharedLocalizer["MedCase_Medications_Placeholder"]" class="w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm text-gray-900 outline-none transition-all duration-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200"></textarea>
                        <span asp-validation-for="Medications" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
                    </div>

                    <div>
                        <label asp-for="FunctionalAbility" class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["MedCase_FunctionalAbility_Label"]</label>
                        <textarea asp-for="FunctionalAbility" rows="2" placeholder="@SharedLocalizer["MedCase_FunctionalAbility_Placeholder"]" class="w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm text-gray-900 outline-none transition-all duration-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200"></textarea>
                        <span asp-validation-for="FunctionalAbility" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
                    </div>

                    <div>
                        <label asp-for="PersonalGoals" class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["MedCase_PersonalGoals_Label"]</label>
                        <textarea asp-for="PersonalGoals" rows="2" placeholder="@SharedLocalizer["MedCase_PersonalGoals_Placeholder"]" class="w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm text-gray-900 outline-none transition-all duration-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200"></textarea>
                        <span asp-validation-for="PersonalGoals" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
                    </div>
                </div>
            </div>
        </div>

        <div class="animate-fade-slide-up flex flex-col items-stretch justify-between gap-4 rounded-2xl border border-gray-100 bg-white p-6 shadow-sm sm:flex-row sm:items-end sm:p-7" style="animation-delay:180ms">
            <div class="w-full sm:max-w-xs">
                <label asp-for="CreatedAt" class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["MedCase_Create_Date"]</label>
                <input asp-for="CreatedAt" type="date" value="@Model.CreatedAt.ToString("yyyy-MM-dd")" class="w-full rounded-lg border border-gray-200 px-3 py-2.5 text-sm text-gray-900 outline-none transition-all duration-200 focus:border-indigo-400 focus:ring-2 focus:ring-indigo-200" />
                <span asp-validation-for="CreatedAt" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
            </div>
            <button type="submit" class="flex w-full items-center justify-center gap-2 rounded-lg bg-gradient-to-r from-indigo-600 to-violet-500 px-8 py-2.5 text-sm font-semibold text-white shadow-sm transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md active:translate-y-0 sm:w-auto">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
                    <path d="M12 4.5v15m7.5-7.5h-15" />
                </svg>
                @SharedLocalizer["MedCase_Create_Btn"]
            </button>
        </div>
    </form>
</div>

<script>
    const weightInput = document.getElementById("Weight");
    const heightInput = document.getElementById("Height");
    const bmiBadge = document.getElementById("bmiBadge");
    const bmiPill = document.getElementById("bmiPill");
    const bmiValue = document.getElementById("bmiValue");

    function updateBmi() {
        const w = parseFloat(weightInput.value);
        const h = parseFloat(heightInput.value);

        if (!w || !h) {
            bmiBadge.classList.add("hidden");
            return;
        }

        const bmi = w / Math.pow(h / 100, 2);
        let tone = "border-teal-200 bg-teal-50 text-teal-700";

        if (bmi < 18.5) {
            tone = "border-indigo-200 bg-indigo-50 text-indigo-700";
        } else if (bmi >= 25) {
            tone = "border-red-300 bg-red-50 text-red-800";
        }

        bmiValue.textContent = bmi.toFixed(1);
        bmiPill.className = "inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold " + tone;
        bmiBadge.classList.remove("hidden", "animate-pop-in");
        requestAnimationFrame(function () {
            bmiBadge.classList.add("animate-pop-in");
        });
    }

    weightInput.addEventListener("input", updateBmi);
    heightInput.addEventListener("input", updateBmi);
    updateBmi();

    const bloodSelect = document.getElementById("BloodGroup");
    const bloodPills = document.querySelectorAll(".blood-pill");

    function syncBloodGroup() {
        bloodPills.forEach(function (pill) {
            const isActive = pill.dataset.value === bloodSelect.value;
            pill.classList.toggle("border-red-300", isActive);
            pill.classList.toggle("bg-red-50", isActive);
            pill.classList.toggle("text-red-800", isActive);
            pill.classList.toggle("border-gray-200", !isActive);
            pill.classList.toggle("text-gray-600", !isActive);
        });
    }

    bloodPills.forEach(function (pill) {
        pill.addEventListener("click", function () {
            bloodSelect.value = pill.dataset.value;
            syncBloodGroup();
        });
    });

    syncBloodGroup();
</script>
