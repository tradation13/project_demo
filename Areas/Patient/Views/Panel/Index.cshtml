@model IPTS.Areas.Patient.ViewsModels.PatientPanelViewModel
@{
    ViewData["Title"] = "Patient Panel";
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
}

<div class="mx-auto max-w-3xl py-10">
    <div class="mb-8">
        <h2 class="mb-2 flex items-center gap-2 text-3xl font-bold text-gray-800">
            <i class="fas fa-user-circle text-primary"></i>
            @SharedLocalizer["Panel_Title"]
        </h2>
        <p class="text-gray-600">@SharedLocalizer["Panel_Subtitle"]</p>
    </div>

    <div class="mb-10 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="flex items-center gap-4 rounded-lg bg-white p-6 shadow">
            <div class="rounded-full bg-blue-100 p-4 text-blue-600">
                <i class="fas fa-calendar-check fa-2x"></i>
            </div>
            <div>
                <div class="text-2xl font-bold">@Model.AppointmentsCount</div>
                <div class="text-gray-700">@SharedLocalizer["Appointments"]</div>
            </div>
        </div>
        <div class="flex items-center gap-4 rounded-lg bg-white p-6 shadow">
            <div class="rounded-full bg-green-100 p-4 text-green-600">
                <i class="fas fa-notes-medical fa-2x"></i>
            </div>
            <div>
                <div class="text-2xl font-bold">@Model.MedicalCasesCount</div>
                <div class="text-gray-700">@SharedLocalizer["Shared_Medical_Cases"]</div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 gap-6 md:grid-cols-4">
        <a href="@Url.Action("my-appointments", "Appointment", new { area = "patient" })"
           class="group flex flex-col items-center rounded-lg border-2 border-red-600 bg-red-600 p-6 text-white shadow transition hover:bg-red-700 hover:text-white">
            <i class="fas fa-calendar-alt fa-2x mb-2 transition group-hover:scale-110"></i>
            <span class="font-semibold">@SharedLocalizer["Appointments"]</span>
        </a>

        <a href="@Url.Action("Index", "MedicalCases", new { area = "patient" })"
           class="group flex flex-col items-center rounded-lg bg-green-600 p-6 text-white shadow transition hover:bg-green-700">
            <i class="fas fa-notes-medical fa-2x mb-2 transition group-hover:scale-110"></i>
            <span class="font-semibold">@SharedLocalizer["Shared_Medical_Cases"]</span>
        </a>
        <a href="@Url.Action("Index", "Profile", new { area = "" })"
           class="group flex flex-col items-center rounded-lg bg-blue-600 p-6 text-white shadow transition hover:bg-blue-700">
            <i class="fas fa-user-cog fa-2x mb-2 transition group-hover:scale-110"></i>
            <span class="font-semibold">@SharedLocalizer["Panel_Account"]</span>
        </a>
        <a href="@Url.Action("Index", "Home", new { area = "" })"
           class="group flex flex-col items-center rounded-lg bg-gray-600 p-6 text-white shadow transition hover:bg-gray-700">
            <i class="fas fa-home fa-2x mb-2 transition group-hover:scale-110"></i>
            <span class="font-semibold">@SharedLocalizer["Shared_Home"]</span>
        </a>
    </div>
</div>
