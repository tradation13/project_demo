@using IPTS.Areas.Doctor.ViewsModels
@model AcceptAppointmentViewModel
@{
    ViewData["Title"] = SharedLocalizer["Appt_Confirm_Title"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";

    var backUrl = Context.Request.Query["returnUrl"].ToString();
    if (string.IsNullOrWhiteSpace(backUrl))
    {
        backUrl = Context.Request.Headers["Referer"].ToString();
    }

    if (string.IsNullOrWhiteSpace(backUrl) || !Url.IsLocalUrl(backUrl))
    {
        backUrl = Url.Action("Index", "Appointments", new { area = "Doctor" }) ?? "/Doctor/Appointments";
    }
}

<style>

    @@keyframes shakeSlot {
    0%,100% { transform: translateX(0); }
    20%     { transform: translateX(-5px); }
    40%     { transform: translateX(5px); }
    60%     { transform: translateX(-4px); }
    80%     { transform: translateX(4px); }
}

.slot-error-shake {
    animation: shakeSlot 0.4s ease;
    border-color: #ef4444 !important;
    background: #fff1f1 !important;
}

.summary-box.has-error {
    background: #fff1f1;
    border-color: #fca5a5;
}

.summary-icon {
    display: inline-flex;
    align-items: center;
    gap: 4px;
}

    .confirm-wrapper {
        width: 100%;
        padding: 1.5rem;
        animation: fadeSlideIn 0.4s ease both;
    }

    @@keyframes fadeSlideIn {
        from { opacity: 0; transform: translateY(14px); }
        to   { opacity: 1; transform: translateY(0); }
    }

    .confirm-card {
        background: #fff;
        border-radius: 16px;
        border: 1px solid #e5e7eb;
        padding: 2rem;
        box-shadow: 0 4px 24px rgba(0,0,0,0.05);
    }

    .confirm-icon-wrap {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        background: #dcfce7;
        border-radius: 12px;
        margin-bottom: 1rem;
        animation: pulseGreen 2.5s ease-in-out infinite;
    }

    @@keyframes pulseGreen {
        0%,100% { box-shadow: 0 0 0 0 rgba(22,163,74,0.15); }
        50%      { box-shadow: 0 0 0 8px rgba(22,163,74,0); }
    }

    .confirm-title {
        font-size: 1.25rem;
        font-weight: 700;
        color: #111827;
        margin: 0 0 0.2rem;
    }

    .confirm-patient {
        font-size: 0.9rem;
        color: #6b7280;
        margin: 0 0 1.5rem;
    }

    .patient-banner {
        background: #eff6ff;
        border-left: 4px solid #3b82f6;
        border-radius: 10px;
        padding: 1rem 1.25rem;
        margin-bottom: 1.5rem;
        animation: fadeSlideIn 0.5s ease 0.1s both;
    }

    .patient-banner-title {
        font-size: 0.875rem;
        font-weight: 700;
        color: #1e3a8a;
        margin: 0 0 0.4rem;
    }

    .patient-banner-time {
        font-size: 1rem;
        color: #1d4ed8;
        font-weight: 500;
        margin: 0 0 0.5rem;
    }

    .patient-banner-note {
        font-size: 0.8rem;
        color: #3b82f6;
        margin: 0;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .slots-label {
        font-size: 1rem;
        font-weight: 700;
        color: #111827;
        margin-bottom: 1rem;
        display: block;
    }

    .error-box {
        background: #fee2e2;
        border: 1px solid #fca5a5;
        border-radius: 8px;
        padding: 0.75rem 1rem;
        color: #b91c1c;
        font-size: 0.875rem;
        margin-bottom: 1rem;
    }

    .slots-grid {
        display: grid;
        gap: 0.6rem;
        grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    }

    .slot-label {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        padding: 0.65rem 0.85rem;
        cursor: pointer;
        transition: border-color 0.2s, background 0.2s, transform 0.15s, box-shadow 0.2s;
        background: #fff;
        user-select: none;
    }

    .slot-label:hover:not(.slot-disabled) {
        border-color: #6ee7b7;
        background: #f0fdf4;
        transform: translateY(-1px);
        box-shadow: 0 2px 8px rgba(22,163,74,0.1);
    }

    .slot-label.slot-selected {
        border-color: #16a34a;
        background: #f0fdf4;
        box-shadow: 0 0 0 3px rgba(22,163,74,0.1);
    }

    .slot-label.slot-disabled {
        border-color: #f3f4f6;
        background: #f9fafb;
        color: #d1d5db;
        cursor: not-allowed;
    }

    .slot-time {
        font-size: 0.85rem;
        font-weight: 500;
        flex: 1;
    }

    .slot-badge {
        font-size: 0.7rem;
        font-weight: 700;
        padding: 1px 6px;
        border-radius: 20px;
    }

    .slot-badge.available { color: #15803d; background: #dcfce7; }
    .slot-badge.booked    { color: #b91c1c; background: #fee2e2; }

    .slot-check {
        color: #16a34a;
        flex-shrink: 0;
    }

    .summary-box {
        background: #f9fafb;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 0.85rem 1.1rem;
        margin: 1.25rem 0;
        font-size: 0.875rem;
        color: #374151;
        transition: background 0.3s;
    }

    .summary-value {
        font-weight: 600;
        color: #16a34a;
        transition: color 0.3s;
    }

    .summary-value.empty {
        color: #9ca3af;
        font-weight: 400;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.25rem;
        border: 1.5px solid #d1d5db;
        border-radius: 10px;
        background: #fff;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s, border-color 0.2s, transform 0.15s;
    }

    .btn-cancel:hover {
        background: #f9fafb;
        border-color: #9ca3af;
    }

    .btn-cancel:active { transform: scale(0.97); }

    .btn-confirm {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.4rem;
        border: 1px solid #6ee7b7;
        border-radius: 8px;
        background: #ecfdf5;
        color: #065f46;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s, transform 0.15s;
    }

    .btn-confirm:hover:not(:disabled) {
        background: #d1fae5;
        transform: translateY(-1px);
    }

    .btn-confirm:active:not(:disabled) { transform: scale(0.97); }

    .btn-confirm:disabled {
        opacity: 0.45;
        cursor: not-allowed;
    }

    @@media (max-width: 640px) {
        .confirm-card { padding: 1.25rem; }
        .confirm-actions { flex-direction: column; }
        .btn-cancel, .btn-confirm { width: 100%; justify-content: center; }
        .slots-grid { grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); }
    }
</style>

<div class="prac-page confirm-wrapper">
    <div class="confirm-card">

        <div class="confirm-icon-wrap">
            <svg width="22" height="22" fill="none" stroke="#16a34a" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
            </svg>
        </div>

        <h2 class="confirm-title">@SharedLocalizer["Appt_Confirm_Title"]</h2>
        <p class="confirm-patient">@Model.PatientName</p>

        @if (Model.StartSlotIndex >= 0 && Model.EndSlotIndex >= Model.StartSlotIndex)
        {
            var patientSlotStart = Model.AvailableSlots.FirstOrDefault(s => s.SlotIndex == Model.StartSlotIndex);
            var patientSlotEnd   = Model.AvailableSlots.FirstOrDefault(s => s.SlotIndex == Model.EndSlotIndex);

            <div class="patient-banner">
                <p class="patient-banner-title">@SharedLocalizer["Appt_PatientSelected"]</p>
                @if (patientSlotStart != null && patientSlotEnd != null)
                {
                    <p class="patient-banner-time">
                        <strong><span data-utc="@patientSlotStart.TimeUtc">@patientSlotStart.Time</span></strong>
                        &nbsp;@SharedLocalizer["Appt_TimeRangeSeparator"]&nbsp;
                        <strong><span data-utc="@patientSlotEnd.TimeUtc">@patientSlotEnd.Time</span></strong>
                        <span style="font-size:0.8rem; color:#60a5fa; margin-left:0.75rem;">
                            (@Model.TotalDurationMinutes @SharedLocalizer["Shared_Minutes"])
                        </span>
                    </p>
                }
                <p class="patient-banner-note">
                    <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 5v8a2 2 0 01-2 2h-5l-5 4v-4H4a2 2 0 01-2-2V5a2 2 0 012-2h12a2 2 0 012 2zm-11-1a1 1 0 11-2 0 1 1 0 012 0zM8 7a1 1 0 11-2 0 1 1 0 012 0zm5-1a1 1 0 110-2 1 1 0 010 2z" clip-rule="evenodd" />
                    </svg>
                    @SharedLocalizer["Appt_PatientSelectInfo"]
                </p>
            </div>
        }

        <form asp-action="AcceptRequest" method="post">
            <input type="hidden" asp-for="AppointmentId" />
            <input type="hidden" asp-for="DoctorId" />
            <input type="hidden" asp-for="ScheduledDate" />
            <input type="hidden" asp-for="StartSlotIndex" />
            <input type="hidden" asp-for="EndSlotIndex" />
            <input type="hidden" asp-for="TotalDurationMinutes" />
            <input type="hidden" asp-for="PatientName" />
            <input type="hidden" asp-for="PatientEmail" />

            <span class="slots-label">@SharedLocalizer["Appt_Confirm_SelectSlots"]</span>

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="error-box">
                    <strong>@SharedLocalizer["Error"]:</strong> @Html.ValidationMessage("")
                </div>
            }

            <div class="slots-grid">
                @foreach (var slot in Model.AvailableSlots)
                {
                    var isPatientSelected = Model.SelectedSlots.Contains(slot.SlotIndex);
                    var isDisabled = !slot.IsAvailable && !isPatientSelected;
                    var labelClass = isPatientSelected ? "slot-label slot-selected" : isDisabled ? "slot-label slot-disabled" : "slot-label";

                    <label class="@labelClass">
                        <input type="checkbox"
                               name="SelectedSlots"
                               value="@slot.SlotIndex"
                               @(isPatientSelected ? "checked" : "")
                               @(isDisabled ? "disabled" : "")
                               style="width:15px;height:15px;accent-color:#16a34a;flex-shrink:0;" />
                        <span class="slot-time" data-utc="@slot.TimeUtc">@slot.Time</span>
                        <span class="slot-badge @(slot.IsAvailable ? "available" : "booked")">
                            @(slot.IsAvailable ? SharedLocalizer["Shared_Available"] : SharedLocalizer["Shared_Booked"])
                        </span>
                        @if (isPatientSelected)
                        {
                            <svg class="slot-check" width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
                                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                        }
                    </label>
                }
            </div>

            <div class="summary-box">
                <strong>@SharedLocalizer["Appt_SelectedTimeSlots"]</strong>
                <span id="selectedSummary" class="summary-value empty" style="margin-left:0.5rem;">@SharedLocalizer["Appt_NoSlotsSelected"]</span>
            </div>

            <div class="confirm-actions" style="display:flex; gap:0.75rem; margin-top:1.5rem;">
                <a href="@backUrl" class="btn-cancel">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    @SharedLocalizer["Shared_Cancel"]
                </a>
                <button type="submit" id="confirmBtn" disabled class="btn-confirm">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                    </svg>
                    @SharedLocalizer["Appt_Confirm_BtnSubmit"]
                </button>
            </div>
        </form>
    </div>
</div>

<script>
    const slots = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.AvailableSlots.Select(s => new { SlotIndex = s.SlotIndex, TimeUtc = s.TimeUtc }).ToList()));
    const noSlotsText    = "@SharedLocalizer["Appt_NoSlotsSelected"]";
    const minutesText    = "@SharedLocalizer["Shared_Minutes"]";
    const rangeSeparator = "@SharedLocalizer["Appt_TimeRangeSeparator"]";
    const browserTZ      = Intl.DateTimeFormat().resolvedOptions().timeZone;
    const confirmBtn     = document.getElementById('confirmBtn');
    const summaryEl      = document.getElementById('selectedSummary');

    function formatUtcTime(utc) {
        if (!utc) return '';
        const d = new Date(utc);
        if (isNaN(d)) return '';
        return new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', hour12: false, timeZone: browserTZ }).format(d);
    }

    function localizeSlotTimes() {
        document.querySelectorAll('[data-utc]').forEach(el => {
            const t = formatUtcTime(el.getAttribute('data-utc'));
            if (t) el.textContent = t;
        });
    }

    function updateSummary() {
        const checked = Array.from(document.querySelectorAll('input[name="SelectedSlots"]:checked'))
            .map(cb => parseInt(cb.value)).sort((a, b) => a - b);

        confirmBtn.disabled = checked.length === 0;

        if (checked.length === 0) {
    summaryEl.innerHTML = `<span class="summary-icon">
        <svg width="14" height="14" fill="none" stroke="#ef4444" viewBox="0 0 24 24">
            <circle cx="12" cy="12" r="10" stroke-width="2"/>
            <path stroke-linecap="round" stroke-width="2" d="M8 8l8 8M16 8l-8 8"/>
        </svg>
        ${noSlotsText}
    </span>`;
    summaryEl.classList.add('empty');
    document.querySelector('.summary-box').classList.add('has-error');
    return;
}

        summaryEl.classList.remove('empty');
document.querySelector('.summary-box').classList.remove('has-error');
        const first = slots.find(s => s.SlotIndex === checked[0]);
        const last  = slots.find(s => s.SlotIndex === checked[checked.length - 1]);
        if (first && last) {
            const duration = checked.length * 20;
            summaryEl.textContent = `${formatUtcTime(first.TimeUtc)} ${rangeSeparator} ${formatUtcTime(last.TimeUtc)} (${duration} ${minutesText})`;
        }
    }

    function updateSlotStyles() {
        document.querySelectorAll('input[name="SelectedSlots"]').forEach(cb => {
            const label = cb.closest('label');
            if (!label || label.classList.contains('slot-disabled')) return;
            if (cb.checked) {
                label.classList.add('slot-selected');
            } else {
                label.classList.remove('slot-selected');
            }
        });
    }

    function init() {
        localizeSlotTimes();
        updateSummary();
        updateSlotStyles();

        document.querySelectorAll('input[name="SelectedSlots"]').forEach(cb => {
            cb.removeEventListener('change', onSlotChange);
            cb.addEventListener('change', onSlotChange);
        });
    }

   function onSlotChange(e) {
    const cb = e.target;
    if (cb.checked) {
        const checked = Array.from(document.querySelectorAll('input[name="SelectedSlots"]:checked'))
            .map(c => parseInt(c.value)).sort((a, b) => a - b);

        const isConsecutive = checked.every((val, i) => i === 0 || val === checked[i - 1] + 1);

        if (!isConsecutive) {
            cb.checked = false;
            const label = cb.closest('label');
            label.classList.add('slot-error-shake');
            setTimeout(() => label.classList.remove('slot-error-shake'), 500);
            updateSlotStyles();
            updateSummary();
            return;
        }
    }
    updateSlotStyles();
    updateSummary();
}

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
    } else {
        init();
    }

    window.addEventListener('pageshow', init);
    setTimeout(init, 200);
</script>