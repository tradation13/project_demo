@* Why Choose PhysoTech *@
<section class="bg-white py-12">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 text-center">
            <div class="flex items-center justify-center gap-3">
                <i class="fas fa-star text-2xl text-primary-600"></i>
                <h3 class="text-3xl font-bold text-gray-900">@SharedLocalizer["Why_Title"]</h3>
            </div>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <div class="flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-5 text-center shadow-md transition-shadow hover:shadow-lg">
                <div class="mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-primary-100 text-4xl text-primary-600">
                    <i class="fas fa-file-alt"></i>
                </div>
                <p class="text-base font-semibold text-gray-900">@SharedLocalizer["Why_Card1_Title"]</p>
                <p class="mt-1 text-sm text-gray-600">@SharedLocalizer["Why_Card1_Desc"]</p>
            </div>

            <div class="flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-5 text-center shadow-md transition-shadow hover:shadow-lg">
                <div class="mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-primary-100 text-4xl text-primary-600">
                    <i class="fas fa-robot"></i>
                </div>
                <p class="text-base font-semibold text-gray-900">@SharedLocalizer["Why_Card2_Title"]</p>
                <p class="mt-1 text-sm text-gray-600">@SharedLocalizer["Why_Card2_Desc"]</p>
            </div>

            <div class="flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-5 text-center shadow-md transition-shadow hover:shadow-lg">
                <div class="mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-primary-100 text-4xl text-primary-600">
                    <i class="fas fa-sync-alt"></i>
                </div>
                <p class="text-base font-semibold text-gray-900">@SharedLocalizer["Why_Card3_Title"]</p>
                <p class="mt-1 text-sm text-gray-600">@SharedLocalizer["Why_Card3_Desc"]</p>
            </div>

            <div class="flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-5 text-center shadow-md transition-shadow hover:shadow-lg">
                <div class="mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-primary-100 text-4xl text-primary-600">
                    <i class="fas fa-user-md"></i>
                </div>
                <p class="text-base font-semibold text-gray-900">@SharedLocalizer["Why_Card4_Title"]</p>
                <p class="mt-1 text-sm text-gray-600">@SharedLocalizer["Why_Card4_Desc"]</p>
            </div>
        </div>
    </div>
</section>
