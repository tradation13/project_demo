@model IPTS.ViewModels.MedicalCaseViewModel
@using IPTS.Models.Enums
@{
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    ViewData["Title"] = @SharedLocalizer["MedCase_Create_Title"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<h2 class="mb-4 text-2xl font-bold">@SharedLocalizer["MedCase_Create_Header"] @($"{patient?.User?.FirstName} {patient?.User?.LastName}")</h2>

<form asp-action="Create" method="post" class="max-w-lg rounded bg-white p-6 shadow">
    <input type="hidden" asp-for="PatientId" />

    @* --- Basic Info --- *@
    <div class="mb-4">
        <label asp-for="Name" class="mb-1 block font-bold">@SharedLocalizer["MedCase_Create_Name"]</label>
        <input asp-for="Name" class="w-full rounded border px-3 py-2 focus:ring-1 focus:ring-blue-500" />
        <span asp-validation-for="Name" class="text-sm text-red-500"></span>
    </div>

    <div class="mb-4">
        <label asp-for="Description" class="mb-1 block font-bold">@SharedLocalizer["MedCase_Create_Desc"]</label>
        <textarea asp-for="Description" class="w-full rounded border px-3 py-2 focus:ring-1 focus:ring-blue-500" rows="3"></textarea>
        <span asp-validation-for="Description" class="text-sm text-red-500"></span>
    </div>

    @* --- Extra Physical & Medical Data Combined Template --- *@
    <div class="mb-6 rounded-lg border border-blue-100 bg-blue-50 p-4">
        <h3 class="mb-3 flex items-center border-b border-blue-200 pb-2 text-sm font-bold text-blue-800">
            <svg class="mr-2 h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
            </svg>
            @SharedLocalizer["MedCase_PhysicalVitals_Header"]
        </h3>

        <div class="grid grid-cols-2 gap-4">
            @* Weight *@
            <div>
                <label asp-for="Weight" class="block text-xs font-bold uppercase text-gray-600">@SharedLocalizer["MedCase_Weight"]</label>
                <input asp-for="Weight" type="number" step="0.1" class="w-full rounded border border-gray-300 px-2 py-1 text-sm focus:ring-1 focus:ring-blue-500" placeholder="70" />
                <span asp-validation-for="Weight" class="text-xs text-red-500"></span>
            </div>

            @* Height *@
            <div>
                <label asp-for="Height" class="block text-xs font-bold uppercase text-gray-600">@SharedLocalizer["MedCase_Height"]</label>
                <input asp-for="Height" type="number" step="0.1" class="w-full rounded border border-gray-300 px-2 py-1 text-sm focus:ring-1 focus:ring-blue-500" placeholder="175" />
                <span asp-validation-for="Height" class="text-xs text-red-500"></span>
            </div>

            @* Dominant Side *@
            <div>
                <label asp-for="DominantSide" class="block text-xs font-bold uppercase text-gray-600">@SharedLocalizer["MedCase_DominantSide"]</label>
                <select asp-for="DominantSide" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm" 
                        asp-items="Html.GetEnumSelectList<EnDominantSide>()">
                    <option value="">@SharedLocalizer["FileSelected"]</option>
                </select>
            </div>

            @* Blood Group *@
            <div>
                <label asp-for="BloodGroup" class="block text-xs font-bold uppercase text-gray-600">@SharedLocalizer["MedCase_BloodGroup"]</label>
                <select asp-for="BloodGroup" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm">
                    <option value="">@SharedLocalizer["FileSelected"]</option>
                    <optgroup label="@SharedLocalizer["BloodGroup_PositiveGroup"]">
                        <option value="@((byte)EnBloodGroup.APositive)">@SharedLocalizer["BloodGroup_APositive"]</option>
                        <option value="@((byte)EnBloodGroup.BPositive)">@SharedLocalizer["BloodGroup_BPositive"]</option>
                        <option value="@((byte)EnBloodGroup.OPositive)">@SharedLocalizer["BloodGroup_OPositive"]</option>
                        <option value="@((byte)EnBloodGroup.ABPositive)">@SharedLocalizer["BloodGroup_ABPositive"]</option>
                    </optgroup>
                    <optgroup label="@SharedLocalizer["BloodGroup_NegativeGroup"]">
                        <option value="@((byte)EnBloodGroup.ANegative)">@SharedLocalizer["BloodGroup_ANegative"]</option>
                        <option value="@((byte)EnBloodGroup.BNegative)">@SharedLocalizer["BloodGroup_BNegative"]</option>
                        <option value="@((byte)EnBloodGroup.ONegative)">@SharedLocalizer["BloodGroup_ONegative"]</option>
                        <option value="@((byte)EnBloodGroup.ABNegative)">@SharedLocalizer["BloodGroup_ABNegative"]</option>
                    </optgroup>
                </select>
            </div>

            @* Activity Level *@
            <div class="col-span-2">
                <label asp-for="ActivityLevel" class="block text-xs font-bold uppercase text-gray-600">@SharedLocalizer["MedCase_ActivityLevel"]</label>
                <select asp-for="ActivityLevel" class="w-full rounded border border-gray-300 bg-white px-2 py-1 text-sm"
                        asp-items="Html.GetEnumSelectList<EnActivityLevel>()">
                    <option value="">@SharedLocalizer["FileSelected"]</option>
                </select>
            </div>

            @* Checkboxes Row *@
            <div class="flex items-center space-x-4 col-span-2 py-1">
                <div class="flex items-center space-x-2">
                    <input asp-for="IsSmoker" type="checkbox" class="h-4 w-4 rounded text-blue-600" />
                    <label asp-for="IsSmoker" class="text-xs font-bold text-gray-700">@SharedLocalizer["MedCase_Smoker"]</label>
                </div>
                <div class="flex items-center space-x-2">
                    <input asp-for="HasChronicDisease" type="checkbox" class="h-4 w-4 rounded text-blue-600" />
                    <label asp-for="HasChronicDisease" class="text-xs font-bold text-gray-700">@SharedLocalizer["MedCase_ChronicDiseases"]</label>
                </div>
            </div>

            @* --- Additional Text Areas Inside the Blue Box --- *@
            <div class="col-span-2 grid grid-cols-1 gap-4 mt-2 pt-4 border-t border-blue-200">
                @* Injury History *@
                <div>
                    <label asp-for="InjuryHistory" class="block text-xs font-bold text-gray-700">@SharedLocalizer["MedCase_InjuryHistory_Label"]</label>
                    <textarea asp-for="InjuryHistory" class="w-full rounded border border-gray-300 px-2 py-1 text-sm focus:ring-1 focus:ring-blue-500" rows="2" placeholder="@SharedLocalizer["MedCase_InjuryHistory_Placeholder"]"></textarea>
                    <span asp-validation-for="InjuryHistory" class="text-xs text-red-500"></span>
                </div>

                @* Medications *@
                <div>
                    <label asp-for="Medications" class="block text-xs font-bold text-gray-700">@SharedLocalizer["MedCase_Medications_Label"]</label>
                    <textarea asp-for="Medications" class="w-full rounded border border-gray-300 px-2 py-1 text-sm focus:ring-1 focus:ring-blue-500" rows="2" placeholder="@SharedLocalizer["MedCase_Medications_Placeholder"]"></textarea>
                    <span asp-validation-for="Medications" class="text-xs text-red-500"></span>
                </div>

                @* Functional Ability *@
                <div>
                    <label asp-for="FunctionalAbility" class="block text-xs font-bold text-gray-700">@SharedLocalizer["MedCase_FunctionalAbility_Label"]</label>
                    <textarea asp-for="FunctionalAbility" class="w-full rounded border border-gray-300 px-2 py-1 text-sm focus:ring-1 focus:ring-blue-500" rows="2" placeholder="@SharedLocalizer["MedCase_FunctionalAbility_Placeholder"]"></textarea>
                    <span asp-validation-for="FunctionalAbility" class="text-xs text-red-500"></span>
                </div>

                @* Personal Goals *@
                <div>
                    <label asp-for="PersonalGoals" class="block text-xs font-bold text-gray-700">@SharedLocalizer["MedCase_PersonalGoals_Label"]</label>
                    <textarea asp-for="PersonalGoals" class="w-full rounded border border-gray-300 px-2 py-1 text-sm focus:ring-1 focus:ring-blue-500" rows="2" placeholder="@SharedLocalizer["MedCase_PersonalGoals_Placeholder"]"></textarea>
                    <span asp-validation-for="PersonalGoals" class="text-xs text-red-500"></span>
                </div>
            </div>
        </div>
    </div>

    @* --- Date (At the bottom now) --- *@
    <div class="mb-6">
        <label asp-for="CreatedAt" class="mb-1 block font-bold text-gray-700">@SharedLocalizer["MedCase_Create_Date"]</label>
        <input asp-for="CreatedAt" type="date" class="w-full rounded border px-3 py-2 focus:ring-1 focus:ring-blue-500" value="@Model.CreatedAt.ToString("yyyy-MM-dd")" />
    </div>

    <button type="submit" class="w-full rounded bg-green-600 px-6 py-3 font-bold text-white shadow hover:bg-green-700 transition duration-200">
        @SharedLocalizer["MedCase_Create_Btn"]
    </button>
</form>