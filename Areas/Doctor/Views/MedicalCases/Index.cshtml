@model List<IPTS.Models.Entites.MedicalCase>
@{
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    ViewData["Title"] = SharedLocalizer["Shared_Medical_Cases"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";

    var fullName = $"{patient?.User?.FirstName} {patient?.User?.LastName}".Trim();
    var initials = fullName.Length > 0
        ? string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => n[0].ToString().ToUpper()))
        : "P";
}

<div class="prac-page space-y-6">

    <div class="flex items-center gap-3">
        <div class="avatar-lg">@initials</div>
        <div>
            <h2 class="text-xl font-semibold text-gray-900 leading-tight">@SharedLocalizer["MedCase_Header"] @fullName</h2>
            <p class="text-sm text-gray-500 mt-0.5">@SharedLocalizer["Shared_Medical_Cases"]</p>
        </div>
    </div>

    <div class="header-card prac-header-card p-5">
        <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">
            <div class="space-y-1">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">
                    @SharedLocalizer["Shared_Patient"] @SharedLocalizer["Shared_Information"]
                </p>
                <p class="text-base font-semibold text-gray-800">@fullName</p>
                <div class="meta-row">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    @patient?.User?.PhoneNumber
                </div>
                <div class="meta-row">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    <a href="mailto:@patient?.User?.Email">@patient?.User?.Email</a>
                </div>
            </div>
            <div class="flex items-center gap-3 flex-wrap">
                <a href="@Url.Action("Create", "MedicalCases", new { area = "doctor", patientId = patient?.Id })" class="btn-add-test">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    @SharedLocalizer["Shared_Add_MedicalCase"]
                </a>
            </div>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span class="empty-icon">📋</span>
            <p class="empty-text">@SharedLocalizer["MedCase_NoData"]</p>
        </div>
    }
    else
    {
        <div class="prac-section">
            <div class="group-divider">
                <div class="group-divider-line"></div>
                <span class="group-label">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                    </svg>
                    @SharedLocalizer["Shared_Medical_Cases"]
                    <span class="group-count">@Model.Count</span>
                </span>
                <div class="group-divider-line"></div>
            </div>

            <div class="prac-list">
                @foreach (var mc in Model)
                {
                    var hasFinishedTest = mc.MedicalCaseTests?.Any(t => !string.IsNullOrEmpty(t.Result)) == true;
                    var latestReport = mc.MedicalReportHistories?.OrderByDescending(r => r.CreatedAt).FirstOrDefault();
                    var testCount = mc.MedicalCaseTests?.Count ?? 0;

                    <div class="prac-row">
                        <div class="prac-row-main">
                            <div class="prac-row-body">
                                <p class="test-name">@mc.Name</p>
                                @if (!string.IsNullOrWhiteSpace(mc.Description))
                                {
                                    <p class="text-sm text-gray-500 mt-1 line-clamp-2">@mc.Description</p>
                                }
                                <div class="mt-2 flex flex-wrap items-center gap-2">
                                    @if (testCount > 0)
                                    {
                                        <span class="result-chip result-set">
                                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            @testCount
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="result-chip result-empty">
                                            <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                            </svg>
                                            @SharedLocalizer["MedCase_Det_NotSet"]
                                        </span>
                                    }
                                    <span class="test-date !mt-0">
                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                        @SharedLocalizer["Shared_Created"]: @mc.CreatedAt.ToString("yyyy-MM-dd")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="prac-row-actions">
                            <a href="@Url.Action("Details", "MedicalCases", new { area = "doctor", id = mc.Id })"
                               class="btn-toggle">
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                @SharedLocalizer["Shared_Details"]
                            </a>

                            @if (latestReport != null)
                            {
                                <a asp-action="ViewReport"
                                   asp-controller="MedicalCases"
                                   asp-route-fileName="@latestReport.ReportUrl"
                                   target="_blank"
                                   class="btn-prac-indigo">
                                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                                    </svg>
                                    @SharedLocalizer["Shared_View_Latest_Report"]
                                </a>
                            }

                            @if (hasFinishedTest)
                            {
                                <a href="@Url.Action("PrintReport", "MedicalCases", new { area = "doctor", id = mc.Id })"
                                   class="btn-print">
                                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                                    </svg>
                                    @SharedLocalizer["Shared_Print_Report"]
                                </a>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
