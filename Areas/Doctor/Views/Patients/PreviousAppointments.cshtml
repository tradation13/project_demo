@model List<IPTS.Models.Entites.Appointment>
@{
    ViewData["Title"] = "Previous Appointments";
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<h2 class="text-2xl font-bold mb-6">Previous Appointments</h2>
@if (!Model.Any())
{
    <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded mb-4">
        <p class="text-yellow-800">No previous appointments found for this patient.</p>
    </div>
}
else
{
    <table class="min-w-full bg-white rounded shadow">
        <thead>
            <tr>
                <th class="px-4 py-2 text-left">Date</th>
                <th class="px-4 py-2 text-left">Time</th>
                <th class="px-4 py-2 text-left">Status</th>
                <th class="px-4 py-2 text-left">Notes</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr class="border-b">
                    <td class="px-4 py-2">@a.ScheduledTime.ToString("yyyy-MM-dd")</td>
                    <td class="px-4 py-2">@a.ScheduledTime.ToString("HH:mm")</td>
                    <td class="px-4 py-2">@a.Status</td>
                    <td class="px-4 py-2">@a.Notes</td>
                </tr>
            }
        </tbody>
    </table>
}
