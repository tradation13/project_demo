@model List<IPTS.Models.Entites.Patient>
@{
    ViewData["Title"] = SharedLocalizer["Pat_Header"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="prac-page space-y-6">

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
            <div class="avatar-lg">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-gray-900 leading-tight">@SharedLocalizer["Pat_Header"]</h2>
                <p class="text-sm text-gray-500 mt-0.5">
                    @if (Model.Any())
                    {
                        <span>@Model.Count</span>
                    }
                </p>
            </div>
        </div>
        <a asp-action="Create" class="btn-add-test">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            @SharedLocalizer["Pat_AddNew"]
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span class="empty-icon">
                <svg class="h-8 w-8 text-amber-600 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                </svg>
            </span>
            <p class="empty-text">@SharedLocalizer["Pat_NoPatients"]</p>
        </div>
    }
    else
    {
        <div class="group-divider">
            <div class="group-divider-line"></div>
            <span class="group-label">
                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                </svg>
                @SharedLocalizer["Pat_Header"]
                <span class="group-count">@Model.Count</span>
            </span>
            <div class="group-divider-line"></div>
        </div>

        <div class="prac-list">
            @foreach (var p in Model)
            {
                var fullName = $"{p.User?.FirstName} {p.User?.LastName}".Trim();
                var initials = fullName.Length > 0
                    ? string.Join("", fullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => n[0].ToString().ToUpper()))
                    : "P";

                <div class="prac-row">
                    <div class="prac-row-main">
                        <div class="avatar-sm">@initials</div>
                        <div class="prac-row-body">
                            <p class="test-name">@fullName</p>
                            <div class="meta-row">
                                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                                </svg>
                                <a href="mailto:@p.User?.Email" class="truncate">@p.User?.Email</a>
                            </div>
                            <div class="meta-row">
                                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                                </svg>
                                @p.User?.PhoneNumber
                            </div>
                        </div>
                    </div>

                    <div class="prac-row-actions">
                        <a href="@Url.Action("Index", "Profile", new { area = "", id = p.UserId })"
                           class="btn-prac-indigo" title="@SharedLocalizer["Shared_Profile"]">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/>
                            </svg>
                            @SharedLocalizer["Shared_Profile"]
                        </a>
                        <a href="@Url.Action("PreviousAppointments", "Patients", new { area = "doctor", patientId = p.Id })"
                           class="btn-prac-secondary" title="@SharedLocalizer["Appt_Header"]">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                            </svg>
                            @SharedLocalizer["Appt_Header"]
                        </a>
                        <a href="@Url.Action("Index", "MedicalCases", new { area = "doctor", patientId = p.Id })"
                           class="btn-toggle" title="@SharedLocalizer["Shared_Medical_Cases"]">
                            <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
                            </svg>
                            @SharedLocalizer["Shared_Medical_Cases"]
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>
