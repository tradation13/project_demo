@*
  Shared confirmation dialog.
  Usage: add data-confirm on any form that needs Yes/No before submit.
  Edit forms: data-confirm. Create forms: leave without data-confirm.
*@
<style>
    [x-cloak] { display: none !important; }
</style>
<div x-data="{
        open: false,
        resolve: null,
        ask(detail) {
            this.open = true;
            this.resolve = detail.resolve;
        },
        answer(ok) {
            this.open = false;
            this.resolve?.(ok);
            this.resolve = null;
        }
     }"
     @@app-confirm.window="ask($event.detail)"
     x-cloak>
    <div x-show="open"
         x-transition.opacity
         class="fixed inset-0 z-[100] flex items-center justify-center bg-slate-900/40 p-4"
         @@keydown.escape.window="if (open) answer(false)">
        <div x-show="open"
             x-transition:enter="transition ease-out duration-200"
             x-transition:enter-start="opacity-0 scale-95"
             x-transition:enter-end="opacity-100 scale-100"
             x-transition:leave="transition ease-in duration-150"
             x-transition:leave-start="opacity-100 scale-100"
             x-transition:leave-end="opacity-0 scale-95"
             class="w-full max-w-sm rounded-2xl border border-slate-100 bg-white p-6 shadow-xl shadow-slate-200"
             @@click.outside="answer(false)"
             role="dialog"
             aria-modal="true"
             aria-labelledby="confirm-dialog-title">
            <div class="mb-5 flex items-start gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    <i class="fas fa-circle-question"></i>
                </span>
                <div>
                    <h3 id="confirm-dialog-title" class="text-lg font-bold text-slate-800">@SharedLocalizer["Msg_AreYouSure"]</h3>
                </div>
            </div>
            <div class="flex items-center justify-end gap-2">
                <button type="button"
                        @@click="answer(false)"
                        class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-600 transition-all hover:bg-slate-50">
                    @SharedLocalizer["Shared_No"]
                </button>
                <button type="button"
                        @@click="answer(true)"
                        class="inline-flex items-center justify-center rounded-xl bg-gradient-to-r from-primary to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-primary/20 transition-all hover:-translate-y-0.5 hover:shadow-lg">
                    @SharedLocalizer["Shared_Yes"]
                </button>
            </div>
        </div>
    </div>
</div>
