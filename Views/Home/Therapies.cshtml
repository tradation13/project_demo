@model List<DoctorViewModel>
@{
    ViewData["Title"] = "Therapies";
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
    var tomorrowMidnight = DateTime.Today.AddDays(1);
}

<div class="min-h-screen bg-gray-50">
    <cache expires-on="@tomorrowMidnight">
        <section class="bg-gradient-to-br from-blue-50 to-indigo-100 py-16">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="flex items-center space-x-4 mb-8">
                    <button onclick="window.history.back()"
                            class="p-2 text-gray-600 hover:text-green-600 transition-colors bg-white rounded-lg shadow-sm">
                        <!-- SVG Back Arrow -->
                    </button>
                </div>
                <div class="text-center">
                    <h1 class="text-4xl md:text-5xl font-bold text-gray-900 mb-4">
                        Meet Our Expert Physical Therapists
                    </h1>
                    <p class="text-xl text-gray-600 max-w-3xl mx-auto">
                        Connect with our team of licensed physical therapists specializing in various rehabilitation areas.
                        Find the right therapist for your recovery needs.
                    </p>
                </div>
            </div>
        </section>
   </cache>

    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
        <cache expires-on="@tomorrowMidnight">
       @*  <form method="get" class="flex flex-col lg:flex-row gap-6 mb-6">
            <div class="flex-1">
                <input type="text" name="search" value="@(Context.Request.Query["search"])" placeholder="Search therapists by name or specialty..."
                       class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors" />
            </div>
            <div class="lg:w-48">
                <select name="sort" class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
                    <option value="name" selected="@(Context.Request.Query["sort"] == "name")">Name (A-Z)</option>
                    <option value="rating" selected="@(Context.Request.Query["sort"] == "rating")">Highest Rated</option>
                    <option value="experience" selected="@(Context.Request.Query["sort"] == "experience")">Most Experienced</option>
                    <option value="availability" selected="@(Context.Request.Query["sort"] == "availability")">Availability</option>
                </select>
            </div>
            <div class="lg:w-48">
                <select name="specialty" class="w-full px-4 py-3 border border-gray-300 rounded-lg bg-white text-gray-900 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 transition-colors">
                    <option value="">All Specialties</option>
                    @foreach (var spec in Model.Select(d => d.Specialty).Distinct())
                    {
                        <option >1</option>
                    }
                </select>
            </div>
            <button type="submit" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">Filter</button>
        </form> *@

        <div class="mb-8">
            <p id="results-summary" class="text-gray-600">
                Showing @Model.Count doctor@(Model.Count == 1 ? "" : "s")
            </p>
        </div>
        </cache>

        <div id="doctors-grid" class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-12">
            @if (Model.Count == 0)
            {
                <div class="col-span-full text-center py-12">
                    <h3 class="text-lg font-medium text-gray-900 mb-2">No doctors found</h3>
                    <p class="text-gray-600 mb-6">Try adjusting your search criteria or filters to find more doctors.</p>
                    <a href="/Home/Therapies" class="px-6 py-2 bg-green-600 text-white rounded-lg hover:bg-green-700 transition-colors">Clear All Filters</a>
                </div>
            }
            else
            {
                @foreach (var doctor in Model)
                {
                    <div class="bg-white rounded-xl p-6 shadow-lg hover:shadow-xl transition-shadow">
                        <div class="text-center">
                            <div class="w-24 h-24 mx-auto mb-4 relative flex items-center justify-center">
                                @if (string.IsNullOrWhiteSpace(doctor?.PhotoUrl))
                                {
                                    <i class="fa-solid fa-user-doctor text-primary-dark" style="font-size: 80px;"></i>
                                }
                                else
                                {
                                    <img src="@doctor.PhotoUrl"
                                         alt="@doctor.FullName"
                                         class="w-24 h-24 rounded-full object-cover" />
                                }
                            </div>
                            <h3 class="text-xl font-semibold text-gray-900 mb-2">@doctor.FullName</h3>
                            <p class="text-blue-600 font-medium mb-2">@doctor.Specialty</p>
                            @* <div class="flex items-center justify-center space-x-2 mb-4"> *@
                            @*     <div class="flex text-yellow-400"> *@
                            @*         @for (int i = 0; i < Math.Round(doctor.Rating); i++) *@
                            @*         { *@
                            @*             <svg class="h-4 w-4 fill-current" viewBox="0 0 20 20"><path d="..." /></svg> *@
                            @*         } *@
                            @*     </div> *@
                            @*     <span class="text-sm text-gray-600">@doctor.Rating.ToString("0.0")</span> *@
                            @* </div> *@
                            <a href="@Url.Action("Index","Profile", new {id = doctor.Id})"
                               class="inline-flex items-center justify-center w-full px-4 py-2 text-sm font-medium text-primary-600 bg-primary-50 rounded-lg hover:bg-primary-100 transition-colors mb-2">
                                View Profile
                            </a>
                            <a asp-area="patient"
                                asp-controller="Appointment"
                                asp-action="Index"
                                asp-route-Id="@doctor.UserId"
                               class="inline-flex items-center justify-center w-full px-4 py-2 text-sm font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors">
                                Book Appointment
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
