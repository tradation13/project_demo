@model TestGroupDetailsViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewData["Title"] = Model.Name;
}

<div class="space-y-5">
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-slate-100 bg-white px-8 py-6 shadow-sm shadow-slate-100">
        <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <i class="fas fa-layer-group"></i>
            </span>
            <div>
                <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["TestGroups"]</p>
                <h4 class="text-xl font-bold text-slate-800">@Model.Name</h4>
            </div>
        </div>
        <a href="@Url.Action("Index")"
           class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">
            <i class="fas fa-arrow-left text-xs"></i>
            @SharedLocalizer["Shared_Back"]
        </a>
    </div>

    @if (Model.Tests.Count == 0)
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-6 py-10 text-center text-amber-800">
            @SharedLocalizer["TestGroups_NoTests"]
        </div>
    }
    else
    {
        foreach (var test in Model.Tests)
        {
            <details class="overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm shadow-slate-100" open>
                <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-6 py-4">
                    <div class="flex min-w-0 items-center gap-3">
                        <span class="flex h-9 w-9 items-center justify-center rounded-xl bg-yellow-50 text-yellow-500">
                            <i class="fas fa-vial text-sm"></i>
                        </span>
                        <div class="min-w-0">
                            <p class="truncate font-semibold text-slate-800">@test.Name</p>
                            <p class="text-xs text-slate-400">@SharedLocalizer["Tests_StandardValue"]: @(test.StandardValue?.ToString("G29") ?? "—")</p>
                        </div>
                    </div>
                    <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">@test.Cases.Count</span>
                </summary>

                <div class="border-t border-slate-100 px-6 py-4">
                    @if (test.Cases.Count == 0)
                    {
                        <p class="py-4 text-center text-sm text-slate-400">@SharedLocalizer["TestGroups_NoCases"]</p>
                    }
                    else
                    {
                        <table class="w-full text-sm">
                            <thead class="text-slate-500">
                                <tr>
                                    <th class="px-2 py-2 text-start font-semibold">@SharedLocalizer["Shared_Medical_Cases"]</th>
                                    <th class="px-2 py-2 text-start font-semibold">@SharedLocalizer["Shared_Patient"]</th>
                                    <th class="px-2 py-2 text-start font-semibold">@SharedLocalizer["Shared_Created"]</th>
                                    <th class="px-2 py-2"></th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                @foreach (var medicalCase in test.Cases)
                                {
                                    <tr>
                                        <td class="px-2 py-2 font-medium text-slate-700">@medicalCase.Name</td>
                                        <td class="px-2 py-2 text-slate-600">@(string.IsNullOrWhiteSpace(medicalCase.PatientName) ? "—" : medicalCase.PatientName)</td>
                                        <td class="px-2 py-2 text-slate-500">@medicalCase.CreatedAt.ToString("yyyy-MM-dd")</td>
                                        <td class="px-2 py-2 text-end">
                                            <a href="@Url.Action("Details", "MedicalCases", new { area = "admin", id = medicalCase.Id })"
                                               class="text-xs font-semibold text-primary hover:underline">@SharedLocalizer["Shared_Details"]</a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </details>
        }
    }
</div>
