@model RegisterViewModel
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Reg_PageTitle"];
    var fieldClasses = "mt-1 w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition focus:border-[#0D7A62] focus:ring-2 focus:ring-[#0D7A62]/15";
    var labelClasses = "mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500";
    var checkboxClasses = "mt-1 h-4 w-4 rounded border-slate-300 text-[#0D7A62] focus:ring-[#0D7A62]";
}

<div class="mx-auto w-full max-w-4xl overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
    <div class="h-1 bg-[#0D7A62]"></div>

    <div class="px-7 py-8 sm:px-9 sm:py-10">
        <div class="mb-8 border-b border-slate-100 pb-6">
            <h1 class="text-xl font-semibold tracking-tight text-slate-800 sm:text-2xl">
                @SharedLocalizer["Reg_Header"]
            </h1>
            <p class="mt-2 text-sm leading-6 text-slate-500">
                @SharedLocalizer["Reg_Subtitle"]
            </p>
        </div>

        <form id="registerForm" asp-area="" asp-controller="Auth" asp-action="Register" method="post" autocomplete="off" onsubmit="return checkPrivacyConsent()" class="space-y-6 text-sm">
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
            {
                <div asp-validation-summary="All" class="rounded-lg border border-red-200 bg-red-50 p-4 text-sm text-red-700"></div>
            }

            <input hidden asp-for="UserTypeName" value="patient" />
            <input type="hidden" asp-for="Patient.UserId" />
            <input type="hidden" asp-for="BookingDoctorUserId" />

            <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
                <div>
                    <label asp-for="FirstName" class="@labelClasses">@SharedLocalizer["Shared_FirstName"]</label>
                    <input asp-for="FirstName" class="@fieldClasses" />
                    <span asp-validation-for="FirstName" class="mt-1.5 block text-xs text-red-600"></span>
                </div>

                <div>
                    <label asp-for="LastName" class="@labelClasses">@SharedLocalizer["Shared_LastName"]</label>
                    <input asp-for="LastName" class="@fieldClasses" />
                    <span asp-validation-for="LastName" class="mt-1.5 block text-xs text-red-600"></span>
                </div>

                <div class="sm:col-span-2">
                    <label asp-for="Email" class="@labelClasses">@SharedLocalizer["Shared_Email"]</label>
                    <input asp-for="Email" class="@fieldClasses" />
                    <span asp-validation-for="Email" class="mt-1.5 block text-xs text-red-600"></span>
                </div>
            </div>

            <div x-data="{ show: false }">
                <label asp-for="Password" class="@labelClasses">@SharedLocalizer["Shared_Password"]</label>
                <div class="relative">
                    <input :type="show ? 'text' : 'password'" asp-for="Password" class="@fieldClasses pe-11" />
                    <button x-on:click="show = !show" type="button"
                            class="absolute inset-y-0 end-0 flex w-11 items-center justify-center text-slate-400 transition hover:text-slate-600"
                            aria-label="@SharedLocalizer["Shared_Password"]">
                        <i class="fa-solid text-sm" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="mt-1.5 block text-xs text-red-600"></span>
            </div>

            <div x-data="{ show: false }">
                <label asp-for="ConfirmPassword" class="@labelClasses">@SharedLocalizer["Shared_ConfirmPassword"]</label>
                <div class="relative">
                    <input :type="show ? 'text' : 'password'" asp-for="ConfirmPassword" class="@fieldClasses pe-11" />
                    <button x-on:click="show = !show" type="button"
                            class="absolute inset-y-0 end-0 flex w-11 items-center justify-center text-slate-400 transition hover:text-slate-600"
                            aria-label="@SharedLocalizer["Shared_ConfirmPassword"]">
                        <i class="fa-solid text-sm" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="mt-1.5 block text-xs text-red-600"></span>
            </div>

            <div class="space-y-4 border-t border-slate-100 pt-5">
                <div>
                    <div class="flex items-start gap-3">
                        <input asp-for="AcceptPrivacy" type="checkbox" class="@checkboxClasses" />
                        <label asp-for="AcceptPrivacy" class="text-sm text-slate-600">
                            @SharedLocalizer["Reg_PrivacyConsent"]
                            <a href="@Url.Action("Privacy", "Home", new { returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}" })" class="font-semibold text-[#0D7A62] hover:underline">
                                @SharedLocalizer["Shared_Privacy_Title"]
                            </a>
                        </label>
                    </div>
                    <span asp-validation-for="AcceptPrivacy" class="mt-1.5 block text-xs text-red-600"></span>
                </div>

                <div>
                    <div class="flex items-start gap-3">
                        <input asp-for="AcceptTerms" type="checkbox" class="@checkboxClasses" />
                        <label asp-for="AcceptTerms" class="text-sm text-slate-600">
                            @SharedLocalizer["Reg_TermsConsent"]
                            <a href="@Url.Action("Terms", "Home", new { returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}" })" class="font-semibold text-[#0D7A62] hover:underline">
                                @SharedLocalizer["Footer_Terms"]
                            </a>
                        </label>
                    </div>
                    <span asp-validation-for="AcceptTerms" class="mt-1.5 block text-xs text-red-600"></span>
                </div>

                <div class="rounded-lg border border-slate-200 bg-slate-50 p-4">
                    <div class="flex items-start gap-3">
                        <input asp-for="AcceptHealthDataConsent" type="checkbox" class="@checkboxClasses shrink-0" />
                        <label asp-for="AcceptHealthDataConsent" class="text-sm leading-relaxed text-slate-700">
                            @SharedLocalizer["Reg_HealthConsent_Before"]
                            <a href="@Url.Action("Privacy", "Home", new { returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}" })" class="font-semibold text-[#0D7A62] hover:underline">
                                @SharedLocalizer["Reg_HealthConsent_Link"]
                            </a>
                            @SharedLocalizer["Reg_HealthConsent_After"]
                        </label>
                    </div>
                    <span asp-validation-for="AcceptHealthDataConsent" class="mt-2 block text-xs text-red-600"></span>
                </div>
            </div>

            <div class="flex flex-col gap-3 pt-1">
                <button type="submit"
                        class="inline-flex w-full items-center justify-center rounded-lg bg-[#0D7A62] px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0a6350]">
                    @SharedLocalizer["Reg_SubmitBtn"]
                </button>
            </div>

            <p class="pt-1 text-center text-sm text-slate-500">
                @SharedLocalizer["Reg_AlreadyHaveAccount"]
                <a href="@Url.Action("Login", "Auth")"
                   class="font-semibold text-[#0D7A62] hover:text-[#0a6350] hover:underline">
                    @SharedLocalizer["Reg_SignIn_Link"]
                </a>
            </p>
        </form>
    </div>
</div>

<div id="privacyModal"
     class="fixed inset-0 z-50 hidden items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/40"></div>
    <div class="relative w-full max-w-sm overflow-hidden rounded-lg border border-slate-200 bg-white shadow-lg">
        <div class="h-1 bg-[#0D7A62]"></div>
        <div class="px-6 py-7 text-center">
            <h3 class="mb-2 text-lg font-semibold text-slate-800">
                @SharedLocalizer["Reg_PrivacyModal_Title"]
            </h3>
            <p class="mb-6 text-sm leading-relaxed text-slate-500">
                @SharedLocalizer["Reg_PrivacyModal_Message"]
            </p>
            <button type="button" onclick="closePrivacyModal()"
                    class="inline-flex w-full items-center justify-center rounded-lg bg-[#0D7A62] px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0a6350]">
                @SharedLocalizer["Shared_GotIt"]
            </button>
        </div>
    </div>
</div>

<script>
document.addEventListener("DOMContentLoaded", function () {
    const modal = document.getElementById('privacyModal');
    if (modal) {
        document.body.appendChild(modal);
    }

    const STORAGE_KEY = 'registerDraft';
    const form = document.getElementById('registerForm');
    const textFields = ['FirstName', 'LastName', 'Email'];

    const readDraft = () => {
        try {
            return JSON.parse(sessionStorage.getItem(STORAGE_KEY) || 'null');
        } catch (e) {
            return null;
        }
    };

    const saveDraft = () => {
        try {
            const draft = {};
            textFields.forEach((id) => {
                const el = document.getElementById(id);
                if (el) draft[id] = el.value;
            });
            sessionStorage.setItem(STORAGE_KEY, JSON.stringify(draft));
        } catch (e) { /* ignore private mode / quota */ }
    };

    const restoreDraft = () => {
        const firstName = document.getElementById('FirstName');
        if (firstName && firstName.value.trim()) return;

        const draft = readDraft();
        if (!draft) return;

        textFields.forEach((id) => {
            const el = document.getElementById(id);
            if (el && !el.value && draft[id]) el.value = draft[id];
        });
    };

    restoreDraft();

    if (form) {
        form.addEventListener('input', saveDraft);
        form.addEventListener('change', saveDraft);
        form.addEventListener('submit', function () {
            const privacy = document.getElementById('AcceptPrivacy');
            const terms = document.getElementById('AcceptTerms');
            const health = document.getElementById('AcceptHealthDataConsent');
            if (privacy && privacy.checked && terms && terms.checked && health && health.checked) {
                try { sessionStorage.removeItem(STORAGE_KEY); } catch (e) { /* ignore */ }
            }
        });
    }
});

function showPrivacyModal() {
    const modal = document.getElementById('privacyModal');
    modal.classList.remove('hidden');
    modal.classList.add('flex');
}

function closePrivacyModal() {
    const modal = document.getElementById('privacyModal');
    modal.classList.add('hidden');
    modal.classList.remove('flex');
}

function checkPrivacyConsent() {
    const privacy = document.getElementById('AcceptPrivacy');
    const terms = document.getElementById('AcceptTerms');
    const health = document.getElementById('AcceptHealthDataConsent');
    if (!privacy || !privacy.checked || !terms || !terms.checked || !health || !health.checked) {
        showPrivacyModal();
        return false;
    }
    return true;
}
</script>
