@model IPTS.ViewModels.MedicalCaseTestViewModel
@{
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    var tests = ViewBag.Tests as List<IPTS.Models.Entites.Test> ?? new List<IPTS.Models.Entites.Test>();
    var searchPlaceholder = SharedLocalizer["AddTest_SearchPlaceholder"].Value;
    ViewData["Title"] = SharedLocalizer["MedCase_Det_AddTest"].Value;
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";

    var firstName = patient?.User?.FirstName ?? "";
    var lastName = patient?.User?.LastName ?? "";
    var fullName = $"{firstName} {lastName}".Trim();
    var initials = $"{(firstName.Length > 0 ? firstName[0].ToString() : "")}{(lastName.Length > 0 ? lastName[0].ToString() : "")}".ToUpper();
    if (string.IsNullOrWhiteSpace(initials)) { initials = "?"; }
}

<style>
    @@keyframes popIn {
        from { opacity: 0; transform: scale(0.92); }
        to { opacity: 1; transform: scale(1); }
    }
    .animate-pop-in { animation: popIn 0.18s ease-out both; }
</style>

<div class="prac-page max-w-xl">
    <div class="mb-6 flex items-center gap-3">
        <div class="avatar-lg">@initials</div>
        <div>
            <h2 class="text-xl font-semibold leading-tight text-gray-900">@fullName</h2>
            <p class="text-sm text-gray-500 mt-0.5">@SharedLocalizer["AddTest_Header"]</p>
        </div>
    </div>

    <form asp-action="AddTest" method="post" class="header-card prac-header-card p-6 sm:p-7">
        <input type="hidden" asp-for="MedicalCaseId" />

        <div class="relative mb-5">
            <label class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["AddTest_SearchLabel"]</label>

            <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-gray-400">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                    </svg>
                </span>
                <input type="text" id="testSearch" placeholder="@searchPlaceholder"
                       class="prac-input with-icon"
                       autocomplete="off" />
            </div>

            <ul id="suggestions"
                class="absolute z-10 mt-2 hidden max-h-56 w-full origin-top scale-95 list-none overflow-y-auto rounded-lg border border-gray-100 bg-white p-1.5 opacity-0 shadow-lg transition-all duration-150">
                @if (tests != null && tests.Any())
                {
                    @foreach (var t in tests)
                    {
                        <li data-id="@t.Id" data-name="@t.Name" data-group="@t.TestGroup?.Name"
                            class="flex cursor-pointer items-center justify-between gap-3 rounded-md px-3 py-2.5 text-sm text-gray-700 transition-all duration-150 hover:scale-[1.02] hover:bg-indigo-50 hover:text-indigo-700">
                            <span class="truncate">@t.Name</span>
                            @if (t.TestGroup != null)
                            {
                                <span class="shrink-0 rounded-full bg-teal-100 px-2.5 py-0.5 text-xs font-medium text-teal-700">@t.TestGroup.Name</span>
                            }
                        </li>
                    }
                }
            </ul>
        </div>

        <div id="selectedChip" class="mb-5 hidden items-center gap-2 rounded-lg border border-indigo-200 bg-indigo-50 px-3 py-2 text-sm font-medium text-indigo-700">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="h-5 w-5 shrink-0">
                <path stroke-linecap="round" stroke-linejoin="round" d="m9 12.75 1.5 1.5 4.5-4.5m6 1.5a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
            </svg>
            <span id="selectedChipText" class="flex-1 truncate"></span>
            <button type="button" id="clearSelection" aria-label="Clear" class="group rounded-full p-1 text-indigo-400 transition-colors duration-150 hover:bg-indigo-100 hover:text-indigo-600">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 transition-transform duration-200 group-hover:rotate-90">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
                </svg>
            </button>
        </div>

        <input type="hidden" asp-for="TestId" id="selectedTestId" />
        <input type="hidden" asp-for="TestName" id="selectedTestName" />
        <span asp-validation-for="TestId" class="mb-3 block text-xs font-medium text-red-800 empty:hidden"></span>
        <span asp-validation-for="TestName" class="mb-3 block text-xs font-medium text-red-800 empty:hidden"></span>

        <div class="mb-5">
            <label asp-for="Result" class="mb-2 flex items-center gap-2 text-sm font-semibold text-gray-700">
                @SharedLocalizer["Shared_Result"]
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-normal text-gray-500">@SharedLocalizer["Shared_Optional"]</span>
            </label>
            <input asp-for="Result" class="prac-input" />
        </div>

        <div class="mb-5">
            <label asp-for="StandardValue" class="mb-2 flex items-center gap-2 text-sm font-semibold text-gray-700">
                @SharedLocalizer["MedCase_Det_StandardValue"]
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-normal text-gray-500">@SharedLocalizer["Shared_Optional"]</span>
            </label>
            <input asp-for="StandardValue" type="number" step="any" class="prac-input"
                   placeholder="@SharedLocalizer["MedCase_Det_StandardValueHint"]" />
            <p class="mt-1.5 text-xs text-gray-500">@SharedLocalizer["MedCase_Det_StandardValueHint"]</p>
            <span asp-validation-for="StandardValue" class="mt-1 block text-xs font-medium text-red-800 empty:hidden"></span>
        </div>

        <div class="mb-6">
            <label class="mb-2 block text-sm font-semibold text-gray-700">@SharedLocalizer["MedCase_Create_Date"]</label>
            <input asp-for="CreatedAt" type="date"
                   class="prac-input"
                   value="@DateTime.Now.ToString("yyyy-MM-dd")" />
        </div>

        <button type="submit" class="btn-add-test w-full">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
            </svg>
            @SharedLocalizer["MedCase_Det_AddTest"]
        </button>
    </form>
</div>

<script>
    const searchInput = document.getElementById("testSearch");
    const suggestionBox = document.getElementById("suggestions");
    const hiddenInput = document.getElementById("selectedTestId");
    const hiddenNameInput = document.getElementById("selectedTestName");
    const selectedChip = document.getElementById("selectedChip");
    const selectedChipText = document.getElementById("selectedChipText");
    const clearBtn = document.getElementById("clearSelection");

    function showSuggestions() {
        suggestionBox.classList.remove("hidden");
        requestAnimationFrame(function () {
            suggestionBox.classList.remove("opacity-0", "scale-95");
            suggestionBox.classList.add("opacity-100", "scale-100");
        });
    }

    function hideSuggestions() {
        suggestionBox.classList.add("opacity-0", "scale-95");
        suggestionBox.classList.remove("opacity-100", "scale-100");
        setTimeout(function () {
            suggestionBox.classList.add("hidden");
        }, 150);
    }

    function showChip(text) {
        selectedChipText.textContent = text;
        selectedChip.classList.remove("hidden", "animate-pop-in");
        selectedChip.classList.add("flex");
        requestAnimationFrame(function () {
            selectedChip.classList.add("animate-pop-in");
        });
    }

    function clearSelection() {
        hiddenInput.value = "";
        hiddenNameInput.value = "";
        selectedChip.classList.add("hidden");
        selectedChip.classList.remove("flex", "animate-pop-in");
    }

    searchInput.addEventListener("input", function () {
        const filter = this.value.trim().toLowerCase();
        const items = suggestionBox.getElementsByTagName("li");
        let visibleCount = 0;

        for (let item of items) {
            const text = ((item.dataset.group || "") + " " + item.dataset.name).toLowerCase();
            const isMatch = filter.length > 0 && text.includes(filter);
            item.style.display = isMatch ? "" : "none";
            if (isMatch) visibleCount++;
        }

        if (filter.length > 0 && visibleCount > 0) {
            showSuggestions();
        } else {
            hideSuggestions();
        }

        clearSelection();
    });

    suggestionBox.addEventListener("click", function (e) {
        const li = e.target.closest("li");
        if (!li) return;

        const testId = li.dataset.id;
        const testName = li.dataset.name;
        const testGroup = li.dataset.group;
        const displayName = testGroup ? `${testGroup} - ${testName}` : testName;

        searchInput.value = displayName;
        hiddenInput.value = testId;
        hiddenNameInput.value = testName;

        showChip(displayName);
        hideSuggestions();
    });

    clearBtn.addEventListener("click", function () {
        searchInput.value = "";
        clearSelection();
        searchInput.focus();
    });

    document.addEventListener("click", function (e) {
        if (!suggestionBox.contains(e.target) && e.target !== searchInput) {
            hideSuggestions();
        }
    });
</script>
