@model List<IPTS.ViewModels.AppointmentViewModel>
@using IPTS.Models.Entites
@{
    ViewData["Title"] = "My Appointments";
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
    var nowUtc = DateTime.UtcNow;
    string BadgeClass(AppointmentViewModel appt, out string display)
    {
        var isPast = appt.ScheduledTime <= nowUtc;

        display = appt.StatusDisplay;

        if (isPast && appt.Status == AppointmentStatus.Pending)
        {
            display = @SharedLocalizer["Appt_Status_Expired"];
            return "bg-orange-100 text-orange-800";
        }
        if (isPast && appt.Status == AppointmentStatus.Confirmed)
        {
            display =  @SharedLocalizer["Dash_CompletedMonth"];
            return "bg-blue-100 text-blue-800";
        }
        return appt.Status switch
        {
            AppointmentStatus.Confirmed => "bg-green-100 text-green-800",
            AppointmentStatus.Pending => "bg-yellow-100 text-yellow-800",
            AppointmentStatus.Completed => "bg-blue-100 text-blue-800",
            AppointmentStatus.Cancelled => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }
}

<div class="mx-auto max-w-5xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8">
 <div class="mb-6 rounded-3xl border border-slate-200 bg-white p-4 shadow-sm sm:p-6">
    <div class="flex w-full justify-between gap-4">
        
        <h2 class="text-2xl font-bold text-slate-800 sm:text-3xl">
            @SharedLocalizer["MyAppointments"]
        </h2>

        <a href="/home/therapies"
           class="inline-flex items-center justify-center rounded-2xl border border-green-500 bg-green-600 px-4 py-2.5 text-sm font-bold text-white shadow-sm transition hover:bg-green-700">
            <i class="fa-solid fa-plus mr-2"></i> @SharedLocalizer["Appt_New"]
        </a>

    </div>
</div>
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        const apptDebug = window.localStorage.getItem('apptDebug') === '1';

        const debugLog = (...args) => {
            if (apptDebug) {
                console.debug('[AppointmentsList]', ...args);
            }
        };

        document.querySelectorAll('[data-utc]').forEach(el => {
            const utc = el.getAttribute('data-utc');
            if (!utc) return;
            const d = new Date(utc);
            if (el.classList.contains('appt-date')) {
                debugLog('date render', { utc, local: d.toString(), text: el.textContent });
                el.textContent = d.toLocaleDateString(undefined, { month: 'long', day: '2-digit', year: 'numeric' });
            } else if (el.classList.contains('appt-time')) {
                debugLog('time render', { utc, local: d.toString(), text: el.textContent });
                el.textContent = d.toLocaleTimeString(undefined, { hour: '2-digit', minute: '2-digit', hour12: false });
            } else {
                el.textContent = d.toLocaleString();
            }
        });
    });
    </script>

    @if (Model == null || !Model.Any())
    {
        <div class="mb-4 rounded-2xl border border-yellow-200 bg-yellow-50 p-4 sm:p-5">
            <p class="text-yellow-800">@SharedLocalizer["Appt_NoAppointments"]</p>
        </div>
    }
    else
    {
        <div class="grid gap-4 sm:gap-6">
            @foreach (var appt in Model)
            {
                var isPast = appt.ScheduledTime <= nowUtc;
                var scheduledUtcIso = DateTime.SpecifyKind(appt.ScheduledTime, DateTimeKind.Utc).ToString("o");
                var badgeText = "";
                var badgeClass = BadgeClass(appt, out badgeText);

                <article class="rounded-3xl border border-slate-200 bg-white p-4 shadow-sm transition hover:shadow-md sm:p-6">
                    <div class="flex flex-col gap-4">
                        <div class="flex flex-wrap items-center gap-2">
                            <h3 class="text-lg font-bold text-slate-800">@appt.DoctorName</h3>

                            <span class="@badgeClass rounded-full px-3 py-1 text-xs font-bold">
                                @badgeText
                            </span>

                            @if (isPast)
                            {
                                <span class="rounded-full border border-gray-200 bg-gray-100 px-2 py-0.5 text-[10px] text-gray-700">
                                    @SharedLocalizer["Appt_Past"]
                                </span>
                            }
                        </div>

                            <div class="grid grid-cols-1 gap-2 text-sm text-gray-600 sm:grid-cols-2 lg:grid-cols-3">
                            <div>
                                <span class="font-normal text-slate-700">@SharedLocalizer["Shared_Date"]:</span>
                                <span class="appt-date" data-utc="@scheduledUtcIso">@appt.ScheduledTime.ToString("MMMM dd, yyyy")</span>
                            </div>
                            <div>
                                <span class="font-normal text-slate-700">@SharedLocalizer["Shared_Time"]:</span>
                                <span class="appt-time" data-utc="@scheduledUtcIso">@appt.ScheduledTime.ToString("HH:mm")</span>
                            </div>
                            <div>
                                <span class="font-normal text-slate-700">@SharedLocalizer["Req_Duration"]:</span> @appt.TotalDurationMinutes @SharedLocalizer["Shared_Min"]
                            </div>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(appt.Notes))
                        {
                            <div class="rounded-2xl bg-slate-50 px-3 py-2 text-sm text-gray-700">
                                <span class="font-normal text-slate-800">@SharedLocalizer["Shared_Notes"]:</span> @appt.Notes
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(appt.PrescriptionFileName))
                        {
                            <div class="text-sm">
                                <span class="font-normal text-slate-800">@SharedLocalizer["Shared_Prescription"]:</span>
                                <a href="@Url.Action("DownloadPrescription", "Appointment", new { area = "Patient", id = appt.Id })" target="_blank" rel="noopener noreferrer" class="ml-1 inline-flex items-center gap-1 rounded-xl bg-blue-100 px-2.5 py-1 text-blue-700 transition hover:bg-blue-200">
                                    <img src="~/images/logo.png" class="h-4 w-4" alt="logo" /> @appt.PrescriptionDisplayName
                                </a>
                            </div>
                        }

                        <div class="mt-1 grid grid-cols-1 gap-2 sm:flex sm:flex-wrap sm:justify-start lg:justify-end">
                            <a href="@Url.Action("my-appointments", "Appointment", new { area = "Patient", id = appt.Id })"
                               class="inline-flex h-10 w-full items-center justify-center rounded-xl border border-blue-500 bg-blue-600 px-4 text-center text-sm font-bold text-white transition hover:bg-blue-700 sm:w-auto sm:min-w-[140px]">
                                @SharedLocalizer["Shared_Details"]
                            </a>

                            @* نسمح بالتعديل فقط إن كانت الحالة Pending ولم ينته وقت الموعد *@
                            @if (appt.Status == AppointmentStatus.Pending && !isPast)
                            {
                                <a href="@Url.Action("Edit", "Appointment", new { area = "Patient", id = appt.Id })"
                                   class="inline-flex h-10 w-full items-center justify-center rounded-xl border border-yellow-500 bg-yellow-500 px-4 text-center text-sm font-bold text-white transition hover:bg-yellow-600 sm:w-auto sm:min-w-[140px]">
                                    @SharedLocalizer["Shared_Edit"]
                                </a>
                            }
                        </div>
                    </div>
                </article>
            }
        </div>
    }
</div>
