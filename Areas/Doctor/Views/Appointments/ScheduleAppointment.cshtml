@using IPTS.ViewModels
@model AppointmentCreateViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="rounded-lg bg-white px-8 py-6">
    <div class="mb-4 flex items-center justify-between">
        <h4 class="text-xl font-semibold">@SharedLocalizer["Appt_Sched_Title"]</h4>
        <a href="@Url.Action("SearchPatient", "Appointments", new { area = "doctor" })"
           class="rounded bg-gray-500 px-4 py-1 text-sm text-white transition duration-150 hover:bg-gray-600">
            @SharedLocalizer["Appt_Sched_Back"]
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 rounded border border-green-400 bg-green-100 p-4 text-green-700">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="mb-4 rounded border border-yellow-400 bg-yellow-100 p-4 text-yellow-700">
            @TempData["WarningMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-4 rounded border border-red-400 bg-red-100 p-4 text-red-700">
            @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="mb-4 rounded border border-blue-400 bg-blue-100 p-4 text-blue-700">
            @TempData["InfoMessage"]
        </div>
    }



    <form asp-action="ScheduleAppointment" method="post" class="mt-8">
        <input type="hidden" asp-for="PatientId" />
        <input type="hidden" asp-for="DoctorId" />
        
        <div class="mb-8 grid grid-cols-1 gap-6 md:grid-cols-2">
            <div>
                <label asp-for="ScheduledDate" class="mb-2 block text-sm font-medium text-gray-700">@SharedLocalizer["Appt_Sched_DateLabel"]</label>
                <input asp-for="ScheduledDate" type="date" 
                       class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary"
                       onchange="loadTimeSlots(this.value)" />
                <span asp-validation-for="ScheduledDate" class="text-sm text-red-500"></span>
            </div>

            <div>
                <label class="mb-2 block text-sm font-medium text-gray-700">@SharedLocalizer["Appt_Sched_PatientInfo"]</label>
                <p class="text-gray-600">@SharedLocalizer["Shared_Patient"] @SharedLocalizer["Shared_ID"]: @Model.PatientId</p>
                @if (TempData["PatientName"] != null)
                {
                    <p class="text-gray-600">@SharedLocalizer["Contact_Label_Name"]: @TempData["PatientName"]</p>
                }
            </div>
        </div>

        <div class="mb-8">
            <div class="mb-4 flex items-center justify-between">
                <div>
                                         <h5 class="font-semibold text-gray-700">@SharedLocalizer["Appt_Sched_DurationTitle"]</h5>
                                         <p class="mt-1 text-sm text-gray-600">
                         <i class="fas fa-info-circle mr-1"></i>
                         <strong>@SharedLocalizer["Appt_Sched_Important"]:</strong> @SharedLocalizer["Appt_Sched_ConsecutiveNote"]. 
                         @SharedLocalizer["Appt_Sched_OneApptNote"].
                         <br><span class="font-medium text-blue-600">@SharedLocalizer["Appt_Sched_Note"]:</span> @SharedLocalizer["Appt_Sched_NonConsecutiveAlert"].
                     </p>
                </div>
                <button type="button" onclick="loadTimeSlots(document.getElementById('ScheduledDate').value)" 
                        class="rounded-md bg-blue-600 px-4 py-2 text-white transition duration-150 hover:bg-blue-700">
                    <i class="fas fa-sync-alt mr-2"></i>@SharedLocalizer["Appt_Sched_Refresh"]
                </button>
            </div>
            
                         <div id="timeSlotsContainer" class="grid min-h-[100px] grid-cols-6 gap-2">
                 <div class="col-span-6 py-8 text-center text-sm text-gray-500">
                     <i class="fas fa-calendar-alt mb-2 text-2xl text-gray-400"></i>
                     <p>@SharedLocalizer["Appt_Sched_PromptDate"]</p>
                 </div>
             </div>
            
            <div class="mt-4 rounded-lg bg-gray-50 p-4">
                <div class="grid grid-cols-2 gap-4 text-sm text-gray-600 md:grid-cols-4">
                    <div>
                        <span class="font-medium">@SharedLocalizer["Appt_Sched_SelectedSlots"]:</span> 
                        <span id="selectedCount" class="font-bold text-blue-600">0</span>
                    </div>
                    <div>
                        <span class="font-medium">@SharedLocalizer["Appt_Sched_TotalDuration"]:</span> 
                        <span id="totalDuration" class="font-bold text-green-600">0</span> @SharedLocalizer["Shared_Minutes"]
                    </div>
                    <div>
                        <span class="font-medium">@SharedLocalizer["Appt_Sched_TimeRange"]:</span> 
                        <span id="timeRange" class="font-bold text-purple-600">-</span>
                    </div>
                    <div>
                        <span class="font-medium">@SharedLocalizer["Shared_WorkingHours"]:</span> 
                        <span class="text-gray-800">@SharedLocalizer["Appt_Sched_WorkingHoursRange"]</span>
                    </div>
                </div>
            </div>
        </div>

        <div class="mb-8 grid grid-cols-1 gap-6">
            <div>
                <label asp-for="Notes" class="mb-2 block text-sm font-medium text-gray-700">@SharedLocalizer["Appt_Sched_Notes"]</label>
                <textarea asp-for="Notes" rows="3" 
                          class="w-full rounded-md border border-gray-300 px-3 py-2 focus:border-transparent focus:outline-none focus:ring-2 focus:ring-primary"
                          placeholder=@SharedLocalizer["Appt_Sched_NotesPlaceholder"]></textarea>
                <span asp-validation-for="Notes" class="text-sm text-red-500"></span>
            </div>
        </div>

                 <!-- Hidden inputs for time slot data -->
         <input type="hidden" id="startSlotIndex" name="StartSlotIndex" value="" />
         <input type="hidden" id="endSlotIndex" name="EndSlotIndex" value="" />
         <input type="hidden" id="startTime" name="StartTime" value="" />
         <input type="hidden" id="endTime" name="EndTime" value="" />
         
         <div class="flex justify-end space-x-3">
             <a href="@Url.Action("SearchPatient", "Appointments", new { area = "doctor" })" 
                class="rounded-md bg-gray-500 px-6 py-2 text-white transition duration-150 hover:bg-gray-600">
                @SharedLocalizer["Shared_Cancel"]
             </a>
             <button type="submit" id="submitBtn" disabled
                     class="rounded-md bg-primary px-6 py-2 text-white transition duration-150 hover:bg-primary-dark disabled:cursor-not-allowed disabled:opacity-50">
                 @SharedLocalizer["Appt_Sched_CreateBtn"]
             </button>
         </div>
         
         @* <!-- Debug Info (can be removed in production) -->
         <div id="debugInfo" class="mt-4 rounded bg-gray-100 p-3 text-xs text-gray-600" style="display: none;">
             <strong>Debug Info:</strong>
             <div>Start Slot Index: <span id="debugStartIndex">-</span></div>
             <div>End Slot Index: <span id="debugEndIndex">-</span></div>
             <div>Start Time: <span id="debugStartTime">-</span></div>
             <div>End Time: <span id="debugEndTime">-</span></div>
             
             <div class="mt-2 border-t border-gray-300 pt-2">
                 <strong>Hidden Input Values:</strong>
                 <div>startSlotIndex: <span id="debugHiddenStartIndex">-</span></div>
                 <div>endSlotIndex: <span id="debugHiddenEndIndex">-</span></div>
                 <div>startTime: <span id="debugHiddenStartTime">-</span></div>
                 <div>endTime: <span id="debugHiddenEndTime">-</span></div>
             </div>
             
             <button type="button" onclick="testFormData()" class="mt-2 rounded bg-blue-500 px-3 py-1 text-xs text-white hover:bg-blue-600">
                 Test Form Data
             </button>
         </div> *@
    </form>
</div>

<script>
let selectedSlots = [];

function loadTimeSlots(date) {
    if (!date) {
        showNoDateMessage();
        return;
    }
    
    // Show loading state
    const container = document.getElementById('timeSlotsContainer');
    container.innerHTML = `
                         <div class="col-span-6 py-8 text-center text-sm text-gray-500">
                     <i class="fas fa-spinner fa-spin mb-2 text-2xl text-blue-500"></i>
                     <p>@SharedLocalizer["Appt_Sched_LoadingSlots"]</p>
                 </div>
    `;
    
    fetch(`/doctor/appointments/gettimeslots?date=${date}`)
        .then(response => response.json())
        .then(data => {
            if (data.success) {
                allTimeSlots = data.timeSlots;
                displayTimeSlots(data.timeSlots);
            } else {
                showErrorMessage(data.message || '@SharedLocalizer["Error_LoadTimeSlots"]');
            }
        })
        .catch(error => {
            console.error('Error:', error);
            showErrorMessage('@SharedLocalizer["Error_LoadSlotsForDuration"]');
        });
}

function displayTimeSlots(timeSlots) {
    const container = document.getElementById('timeSlotsContainer');
    container.innerHTML = '';
    
    if (!timeSlots || timeSlots.length === 0) {
        showNoSlotsMessage();
        return;
    }
    
    // Validate and process each slot
    timeSlots.forEach((slot, index) => {
        // Ensure slot has required properties
        if (!slot.time || typeof slot.slotIndex === 'undefined' || typeof slot.isAvailable === 'undefined') {
            console.warn('Invalid slot data:', slot);
            return;
        }
        
        const slotElement = document.createElement('div');
        slotElement.className = `slot-element p-4 text-center text-sm rounded cursor-pointer transition-all duration-200 border-2 min-h-[80px] flex flex-col justify-center items-center ${
            slot.isAvailable
                ? 'bg-green-50 hover:bg-green-100 border-green-300 hover:border-green-400 hover:shadow-md text-green-800' 
                : 'bg-red-50 text-red-700 border-red-300 cursor-not-allowed opacity-75'
        }`;
        
        if (slot.isAvailable) {
            slotElement.onclick = () => toggleSlot(slot);
            slotElement.title = `@SharedLocalizer["Appt_Sched_ClickSelect"] ${slot.time}`;
        } else {
            slotElement.title = `${slot.time} - @SharedLocalizer["Shared_NotAvailable"]`;
        }
        
        // Ensure text is clearly visible
        slotElement.innerHTML = `
            <div class="mb-1 text-lg font-bold">${slot.time}</div>
            <div class="text-xs ${slot.isAvailable ? 'text-green-600' : 'text-red-500'}">
                ${slot.isAvailable ? '@SharedLocalizer["Shared_Available"]' : '@SharedLocalizer["Shared_Booked"]'}
            </div>
        `;
        
        container.appendChild(slotElement);
    });
    
    updateSelectionDisplay();
    updateSlotVisuals();
}

function showNoDateMessage() {
    const container = document.getElementById('timeSlotsContainer');
    container.innerHTML = `
        <div class="col-span-6 py-8 text-center text-sm text-gray-500">
            <i class="fas fa-calendar-alt mb-2 text-2xl text-gray-400"></i>
            <p>@SharedLocalizer["Appt_Sched_SelectDateMsg"]</p>
        </div>
    `;
}

function showNoSlotsMessage() {
    const container = document.getElementById('timeSlotsContainer');
    container.innerHTML = `
        <div class="col-span-6 py-8 text-center text-sm text-gray-500">
            <i class="fas fa-calendar-times mb-2 text-2xl text-red-400"></i>
            <p>@SharedLocalizer["Appt_Sched_NoSlotsMsg"]</p>
            <p class="mt-1 text-xs">@SharedLocalizer["Appt_Sched_TryAnotherDate"]</p>
        </div>
    `;
}

function showErrorMessage(message) {
    const container = document.getElementById('timeSlotsContainer');
    container.innerHTML = `
        <div class="col-span-6 py-8 text-center text-sm text-red-500">
            <i class="fas fa-exclamation-triangle mb-2 text-2xl text-red-400"></i>
            <p>${message}</p>
            <p class="mt-1 text-xs">@SharedLocalizer["Shared_TryAgainSupport"]</p>
        </div>
    `;
}

let allTimeSlots = [];

function toggleSlot(slot) {
    const index = selectedSlots.findIndex(s => s.slotIndex === slot.slotIndex);
    
    if (index > -1) {
        // Remove this slot from selection
        selectedSlots.splice(index, 1);
        slot.isSelected = false;
    } else {
        // Check if this slot can be added (must be consecutive)
        if (canAddSlot(slot)) {
            selectedSlots.push(slot);
            slot.isSelected = true;
        } else {
            // Clear previous selection and start new one
            clearAllSelections();
            selectedSlots.push(slot);
            slot.isSelected = true;
        }
    }
    
    // Validate and fix consecutiveness after any change
    validateAndFixConsecutiveness();
    
    updateSelectionDisplay();
    updateSubmitButton();
    updateSlotVisuals();
}

function canAddSlot(slot) {
    if (selectedSlots.length === 0) {
        return true; // First slot can always be added
    }
    
    // Check if the slot is consecutive to existing selection
    const startIndex = Math.min(...selectedSlots.map(s => s.slotIndex));
    const endIndex = Math.max(...selectedSlots.map(s => s.slotIndex));
    
    // Slot must be adjacent to existing selection (before start or after end)
    return slot.slotIndex === startIndex - 1 || slot.slotIndex === endIndex + 1;
}

function clearAllSelections() {
    // Clear all previous selections
    selectedSlots.forEach(slot => {
        slot.isSelected = false;
    });
    selectedSlots = [];
}

function validateAndFixConsecutiveness() {
    if (selectedSlots.length <= 1) return;
    
    // Sort slots by index
    selectedSlots.sort((a, b) => a.slotIndex - b.slotIndex);
    
    // Check if all slots are consecutive using mathematical calculation
    const startIndex = selectedSlots[0].slotIndex;
    const endIndex = selectedSlots[selectedSlots.length - 1].slotIndex;
    const expectedSlots = (endIndex - startIndex) + 1;
    
    // If the actual number of slots doesn't match the expected consecutive range
    if (selectedSlots.length !== expectedSlots) {
        const lastSlot = selectedSlots[selectedSlots.length - 1];
        clearAllSelections();
        selectedSlots.push(lastSlot);
        lastSlot.isSelected = true;
        
        // Show warning
        showConsecutiveWarning();
    }
}

function showConsecutiveWarning() {
    // Show a temporary warning message
    const warningDiv = document.createElement('div');
    warningDiv.className = 'fixed top-4 right-4 bg-yellow-100 border border-yellow-400 text-yellow-700 px-4 py-2 rounded shadow-lg z-50';
    warningDiv.innerHTML = `
        <div class="flex items-center">
            <i class="fas fa-exclamation-triangle mr-2"></i>
            <span>@SharedLocalizer["Appt_Sched_NonConsecutive"]</span>
        </div>
    `;
    
    document.body.appendChild(warningDiv);
    
    // Remove warning after 3 seconds
    setTimeout(() => {
        if (warningDiv.parentNode) {
            warningDiv.parentNode.removeChild(warningDiv);
        }
    }, 3000);
}

function updateSlotVisuals() {
    const container = document.getElementById('timeSlotsContainer');
    const slotElements = container.querySelectorAll('.slot-element');
    
    slotElements.forEach((element, index) => {
        const slot = allTimeSlots[index];
        if (!slot) return;
        
        const isSelected = selectedSlots.find(s => s.slotIndex === slot.slotIndex);
        
        if (isSelected) {
            // Selected slot - use distinct blue color
            element.classList.remove('bg-green-50', 'hover:bg-green-100', 'border-green-300', 'text-green-800', 'hover:border-green-400', 'hover:shadow-md');
            element.classList.add('bg-blue-600', 'hover:bg-blue-700', 'border-blue-700', 'text-white', 'ring-2', 'ring-blue-400', 'shadow-lg', 'font-bold');
            
            // Update the "Available" text color to white for selected slots
            const availableText = element.querySelector('.text-xs');
            if (availableText) {
                availableText.classList.remove('text-green-600');
                availableText.classList.add('text-white');
            }
        } else if (slot.isAvailable) {
            // Available but not selected - reset to green
            element.classList.remove('bg-blue-600', 'hover:bg-blue-700', 'border-blue-700', 'text-white', 'ring-2', 'ring-blue-400', 'shadow-lg', 'font-bold');
            element.classList.add('bg-green-50', 'hover:bg-green-100', 'border-green-300', 'text-green-800', 'hover:border-green-400', 'hover:shadow-md');
            
            // Reset the "Available" text color to green
            const availableText = element.querySelector('.text-xs');
            if (availableText) {
                availableText.classList.remove('text-white');
                availableText.classList.add('text-green-600');
            }
        }
    });
}

function updateSelectionDisplay() {
    if (selectedSlots.length === 0) {
        document.getElementById('selectedCount').textContent = '0';
        document.getElementById('totalDuration').textContent = '0';
        document.getElementById('timeRange').textContent = '-';
        
        // Clear hidden inputs
        document.getElementById('startSlotIndex').value = '';
        document.getElementById('endSlotIndex').value = '';
        document.getElementById('startTime').value = '';
        document.getElementById('endTime').value = '';
        
        // Hide debug info
        document.getElementById('debugInfo').style.display = 'none';
        return;
    }
    
    // Sort slots by index to ensure correct order
    selectedSlots.sort((a, b) => a.slotIndex - b.slotIndex);
    
    // Calculate using start and end indices only
    const startIndex = selectedSlots[0].slotIndex;
    const endIndex = selectedSlots[selectedSlots.length - 1].slotIndex;
    const totalSlots = (endIndex - startIndex) + 1;
    const totalDuration = totalSlots * 20;
    
    // Get start and end times
    const startTime = selectedSlots[0].time;
    const endTime = selectedSlots[selectedSlots.length - 1].time;
    
    // Update display
    document.getElementById('selectedCount').textContent = totalSlots;
    document.getElementById('totalDuration').textContent = totalDuration;
    document.getElementById('timeRange').textContent = `${startTime} - ${endTime}`;
    
    // Update hidden inputs
    document.getElementById('startSlotIndex').value = startIndex;
    document.getElementById('endSlotIndex').value = endIndex;
    document.getElementById('startTime').value = startTime;
    document.getElementById('endTime').value = endTime;
    
    // Update debug info
    document.getElementById('debugStartIndex').textContent = startIndex;
    document.getElementById('debugEndIndex').textContent = endIndex;
    document.getElementById('debugStartTime').textContent = startTime;
    document.getElementById('debugEndTime').textContent = endTime;
    document.getElementById('debugInfo').style.display = 'block';
    
    console.log('Hidden inputs updated:', {
        startSlotIndex: startIndex,
        endSlotIndex: endIndex,
        startTime: startTime,
        endTime: endTime
    });
    
    // Update debug hidden input values
    document.getElementById('debugHiddenStartIndex').textContent = startIndex;
    document.getElementById('debugHiddenEndIndex').textContent = endIndex;
    document.getElementById('debugHiddenStartTime').textContent = startTime;
    document.getElementById('debugHiddenEndTime').textContent = endTime;
}

function testFormData() {
    const startSlotIndex = document.getElementById('startSlotIndex').value;
    const endSlotIndex = document.getElementById('endSlotIndex').value;
    const startTime = document.getElementById('startTime').value;
    const endTime = document.getElementById('endTime').value;
    
    console.log('=== FORM DATA TEST ===');
    console.log('Hidden Input Values:', {
        startSlotIndex: startSlotIndex,
        endSlotIndex: endSlotIndex,
        startTime: startTime,
        endTime: endTime
    });
    
    console.log('Selected Slots:', selectedSlots);
    
    if (selectedSlots.length > 0) {
        const sortedSlots = selectedSlots.sort((a, b) => a.slotIndex - b.slotIndex);
        console.log('Sorted Slots:', sortedSlots);
        console.log('First Slot:', sortedSlots[0]);
        console.log('Last Slot:', sortedSlots[sortedSlots.length - 1]);
    }
    
    // Test form submission simulation
    const form = document.querySelector('form');
    const formData = new FormData(form);
    console.log('FormData entries:');
    for (let [key, value] of formData.entries()) {
        console.log(`${key}: ${value}`);
    }
}

function updateSubmitButton() {
    const submitBtn = document.getElementById('submitBtn');
    submitBtn.disabled = selectedSlots.length === 0;
    
    if (selectedSlots.length > 0) {
        submitBtn.classList.remove('opacity-50', 'cursor-not-allowed');
        submitBtn.classList.add('hover:shadow-lg');
    } else {
        submitBtn.classList.add('opacity-50', 'cursor-not-allowed');
        submitBtn.classList.remove('hover:shadow-lg');
    }
}

// Form submit validation
document.querySelector('form').addEventListener('submit', function(e) {
    console.log('Form submit event triggered');
    console.log('Selected slots:', selectedSlots);
    
    if (selectedSlots.length === 0) {
        e.preventDefault();
        alert('@SharedLocalizer["Validation_SelectAtLeastOneSlot"]');
        return;
    }
    
    // Verify slots are consecutive
    if (!areSlotsConsecutive()) {
        e.preventDefault();
        alert('@SharedLocalizer["Validation_ConsecutiveSlotsOnly"]');
        return;
    }
    
    // Verify hidden inputs have values
    const startSlotIndex = document.getElementById('startSlotIndex').value;
    const endSlotIndex = document.getElementById('endSlotIndex').value;
    const startTime = document.getElementById('startTime').value;
    const endTime = document.getElementById('endTime').value;
    
    console.log('Hidden input values before submit:', {
        startSlotIndex: startSlotIndex,
        endSlotIndex: endSlotIndex,
        startTime: startTime,
        endTime: endTime
    });
    
    if (!startSlotIndex || !endSlotIndex || !startTime || !endTime) {
        e.preventDefault();
        alert('@SharedLocalizer["Error_MissingSlotData"]');
        return;
    }
    
    console.log('Form validation passed, submitting with data:', {
        startSlotIndex: startSlotIndex,
        endSlotIndex: endSlotIndex,
        startTime: startTime,
        endTime: endTime,
        totalSlots: selectedSlots.length,
        totalDuration: selectedSlots.length * 20
    });
});

function areSlotsConsecutive() {
    if (selectedSlots.length <= 1) return true;
    
    const sortedSlots = selectedSlots.sort((a, b) => a.slotIndex - b.slotIndex);
    const startIndex = sortedSlots[0].slotIndex;
    const endIndex = sortedSlots[sortedSlots.length - 1].slotIndex;
    const expectedSlots = (endIndex - startIndex) + 1;
    
    // Check if the actual number of slots matches the expected consecutive range
    return selectedSlots.length === expectedSlots;
}

// Load time slots when date changes
document.getElementById('ScheduledDate').addEventListener('change', function() {
    selectedSlots = []; // Reset selection when date changes
    updateSelectionDisplay();
    updateSubmitButton();
    loadTimeSlots(this.value);
});

// Initialize on page load
document.addEventListener('DOMContentLoaded', function() {
    const today = new Date().toISOString().split('T')[0];
    document.getElementById('ScheduledDate').value = today;
    loadTimeSlots(today);
});
</script>
