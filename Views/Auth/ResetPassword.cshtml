@model IPTS.ViewModels.ResetPasswordViewModel
@{
    Layout = ViewBag.HasDashboard
                ? "~/Views/Shared/Layouts/_DashboardLayout.cshtml"
                : "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Shared_ResetPassword"];
    var isDashboard = Convert.ToBoolean(ViewBag.HasDashboard);
}

<style>
    @@keyframes rpFadeUp {
        from { opacity: 0; transform: translateY(18px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes rpOrb {
        0%, 100% { transform: translate3d(0, 0, 0) scale(1); }
        50%      { transform: translate3d(16px, -14px, 0) scale(1.06); }
    }
    .rp-page { animation: rpFadeUp .5s cubic-bezier(.22, 1, .36, 1) both; }
    .rp-orb-a { animation: rpOrb 8s ease-in-out infinite; }
    .rp-orb-b { animation: rpOrb 10s ease-in-out infinite reverse; }
</style>

<div class="rp-page w-full @(isDashboard ? "" : "max-w-none")">
    <div class="relative w-full overflow-hidden rounded-2xl border border-slate-100 bg-white shadow-sm shadow-slate-100 sm:rounded-[1.75rem]">

        <div class="pointer-events-none absolute inset-0 overflow-hidden">
            <div class="rp-orb-a absolute -left-16 -top-16 h-48 w-48 rounded-full bg-emerald-500/10 blur-3xl"></div>
            <div class="rp-orb-b absolute -bottom-20 -right-12 h-56 w-56 rounded-full bg-sky-500/10 blur-3xl"></div>
            <div class="absolute inset-x-0 top-0 h-1 bg-gradient-to-r from-emerald-500 via-teal-500 to-sky-500"></div>
        </div>

        <div class="relative z-10 grid w-full gap-8 p-5 sm:gap-10 sm:p-8 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:p-10">

            <div class="flex flex-col justify-center border-b border-slate-100 pb-6 lg:border-b-0 lg:border-e lg:pb-0 lg:pe-10">
                <span class="mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white shadow-lg shadow-emerald-500/25 ring-1 ring-white/50">
                    <i class="fas fa-shield-halved text-xl" aria-hidden="true"></i>
                </span>
                <h2 class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
                    @SharedLocalizer["Shared_ResetPassword"]
                </h2>
                <p class="mt-3 max-w-md text-sm leading-relaxed text-slate-500 sm:text-[0.95rem]">
                    @SharedLocalizer["ResetPass_PasswordStrength"]
                </p>
            </div>

            <form class="space-y-5"
                  asp-action="ResetPassword"
                  method="post"
                  autocomplete="off"
                  x-data="{
                      showCurrent: false,
                      showNew: false,
                      showConfirm: false,
                      strength: 0,
                      evaluate(pw) {
                          let s = 0;
                          if (!pw) { this.strength = 0; return; }
                          if (pw.length >= 8) s++;
                          if (/[A-Z]/.test(pw)) s++;
                          if (/[0-9]/.test(pw)) s++;
                          if (/[^A-Za-z0-9]/.test(pw)) s++;
                          this.strength = s;
                      }
                  }">

                <div>
                    <label asp-for="CurrentPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">
                        @SharedLocalizer["ResetPass_Label_Current"]
                    </label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3.5 text-slate-300">
                            <i class="fas fa-key text-xs"></i>
                        </span>
                        <input :type="showCurrent ? 'text' : 'password'"
                               asp-for="CurrentPassword"
                               class="w-full rounded-xl border border-slate-200 bg-white/90 py-3 ps-10 pe-12 text-[15px] text-slate-800 transition-all placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-4 focus:ring-emerald-500/10"
                               placeholder="@SharedLocalizer["ResetPass_Placeholder_Current"]" />
                        <button type="button"
                                @@click="showCurrent = !showCurrent"
                                class="absolute inset-y-0 end-0 flex items-center pe-3.5 text-slate-400 transition-colors hover:text-emerald-600"
                                aria-label="Toggle current password visibility">
                            <i class="fas" :class="showCurrent ? 'fa-eye' : 'fa-eye-slash'"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CurrentPassword" class="mt-1.5 block text-xs text-red-500"></span>
                </div>

                <div>
                    <label asp-for="NewPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">
                        @SharedLocalizer["Shared_NewPassword"]
                    </label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3.5 text-slate-300">
                            <i class="fas fa-lock text-xs"></i>
                        </span>
                        <input :type="showNew ? 'text' : 'password'"
                               asp-for="NewPassword"
                               @@input="evaluate($event.target.value)"
                               class="w-full rounded-xl border border-slate-200 bg-white/90 py-3 ps-10 pe-12 text-[15px] text-slate-800 transition-all placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-4 focus:ring-emerald-500/10"
                               placeholder="@SharedLocalizer["Shared_EnterNewPassword"]" />
                        <button type="button"
                                @@click="showNew = !showNew"
                                class="absolute inset-y-0 end-0 flex items-center pe-3.5 text-slate-400 transition-colors hover:text-emerald-600"
                                aria-label="Toggle new password visibility">
                            <i class="fas" :class="showNew ? 'fa-eye' : 'fa-eye-slash'"></i>
                        </button>
                    </div>
                    <div class="mt-2.5 space-y-1.5">
                        <div class="flex items-center gap-2">
                            <div class="flex w-full gap-1.5">
                                <template x-for="i in 4" :key="i">
                                    <div class="h-1.5 flex-1 rounded-full transition-colors duration-200"
                                         :class="strength >= i ? (strength <= 1 ? 'bg-red-500' : strength === 2 ? 'bg-amber-400' : 'bg-emerald-500') : 'bg-slate-200'"></div>
                                </template>
                            </div>
                            <span class="shrink-0 text-xs font-semibold text-slate-500"
                                  x-text="strength === 0 ? '' : (strength <= 1 ? 'Weak' : (strength === 2 ? 'Fair' : (strength === 3 ? 'Good' : 'Strong')))"></span>
                        </div>
                    </div>
                    <span asp-validation-for="NewPassword" class="mt-1.5 block text-xs text-red-500"></span>
                </div>

                <div>
                    <label asp-for="ConfirmPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">
                        @SharedLocalizer["Shared_ConfirmPassword"]
                    </label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3.5 text-slate-300">
                            <i class="fas fa-lock text-xs"></i>
                        </span>
                        <input :type="showConfirm ? 'text' : 'password'"
                               asp-for="ConfirmPassword"
                               class="w-full rounded-xl border border-slate-200 bg-white/90 py-3 ps-10 pe-12 text-[15px] text-slate-800 transition-all placeholder:text-slate-400 focus:border-emerald-500 focus:outline-none focus:ring-4 focus:ring-emerald-500/10"
                               placeholder="@SharedLocalizer["Shared_ConfirmNewPassword"]" />
                        <button type="button"
                                @@click="showConfirm = !showConfirm"
                                class="absolute inset-y-0 end-0 flex items-center pe-3.5 text-slate-400 transition-colors hover:text-emerald-600"
                                aria-label="Toggle confirm password visibility">
                            <i class="fas" :class="showConfirm ? 'fa-eye' : 'fa-eye-slash'"></i>
                        </button>
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="mt-1.5 block text-xs text-red-500"></span>
                </div>

                <button type="submit"
                        class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-emerald-600 to-teal-500 px-5 py-3.5 text-sm font-semibold text-white shadow-lg shadow-emerald-600/20 transition-all duration-200 hover:-translate-y-0.5 hover:from-emerald-700 hover:to-teal-600 hover:shadow-xl">
                    <i class="fas fa-check text-xs"></i>
                    @SharedLocalizer["ResetPass_UpdateBtn"]
                </button>

                @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
            </form>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")
