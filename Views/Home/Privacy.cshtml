<style>
    /* ══ Keyframes ══ */
    @@keyframes ppFadeUp {
        from { opacity:0; transform:translateY(28px); }
        to   { opacity:1; transform:translateY(0); }
    }
    @@keyframes ppFadeIn {
        from { opacity:0; }
        to   { opacity:1; }
    }
    @@keyframes ppSlideIn {
        from { opacity:0; transform:translateX(-20px); }
        to   { opacity:1; transform:translateX(0); }
    }
    @@keyframes ppAccent {
        0%,100% { width:32px; opacity:.5; }
        50%      { width:56px; opacity:1; }
    }

    /* ══ Title ══ */
    .pp-title {
        opacity: 0;
        animation: ppFadeIn 0.6s cubic-bezier(.22,1,.36,1) .05s forwards;
        position: relative;
    }
    .pp-title::after {
        content:'';
        display:block;
        height:3px;
        width:40px;
        background: #10b981;
        border-radius:2px;
        margin-top:10px;
        animation: ppAccent 2.4s ease-in-out infinite;
    }

    /* ══ Sections — مخفية ══ */
    .pp-section {
        opacity: 0;
        transition: box-shadow .25s ease, border-color .25s ease, transform .25s ease;
        position: relative;
        overflow: hidden;
    }

    /* خط جانبي يظهر عند hover */
    .pp-section::before {
        content:'';
        position:absolute;
        top:0; left:0;
        width:3px; height:0;
        background: linear-gradient(to bottom, #10b981, #6ee7b7);
        border-radius:2px;
        transition: height .35s ease;
    }
    .pp-section:hover::before { height:100%; }

    .pp-section:hover {
        box-shadow: 0 8px 28px rgba(16,185,129,.10);
        border-color: #d1fae5;
        transform: translateX(3px);
    }

    /* ══ visible state ══ */
    .pp-section.av {
        animation: ppFadeUp 0.65s cubic-bezier(.22,1,.36,1) forwards;
    }

    /* h3/h4 داخل السكشن — خط أخضر خفيف */
    .pp-section h3,
    .pp-section h4 {
        position: relative;
        padding-right: 10px;
    }
    .pp-section h3::before,
    .pp-section h4::before {
        content:'';
        display:inline-block;
        width:6px; height:6px;
        background:#10b981;
        border-radius:50%;
        margin-left:8px;
        vertical-align:middle;
        opacity:.7;
    }
</style>

<script>
(function(){
    var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
            if(e.isIntersecting){
                e.target.classList.add('av');
            } else {
                e.target.classList.remove('av');
            }
        });
    },{ threshold:0.08 });

    document.querySelectorAll('.pp-section')
            .forEach(function(el){ obs.observe(el); });
})();
</script>