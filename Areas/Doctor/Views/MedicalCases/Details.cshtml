@model IPTS.Models.Entites.MedicalCase
@{
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    ViewData["Title"] = "Medical Case Details";
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<h2 class="mb-4 text-2xl font-bold">@SharedLocalizer["MedCase_Det_Title"]: @Model.Name</h2>

<div class="mb-6 rounded bg-white p-4 shadow">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            <div class="font-semibold">@SharedLocalizer["Shared_Patient"]:</div>
            <div class="text-gray-700">@($"{patient?.User?.FirstName} {patient?.User?.LastName}")</div>

            @* <div class="mt-2 font-semibold">@SharedLocalizer["Shared_Identity_Number"]:</div>
            <div class="text-gray-700">@patient?.IdentityNumber</div> *@

            <div class="mt-2 font-semibold">@SharedLocalizer["Shared_Phone"]:</div>
            <div class="text-gray-700">@patient?.User?.PhoneNumber</div>

            <div class="mt-2 font-semibold">@SharedLocalizer["Shared_Email"]:</div>
            <div class="text-gray-700">@patient?.User?.Email</div>
        </div>

        <div class="mt-4 md:mt-0">
            <a href="@Url.Action("AddTest", "MedicalCases", new { area = "doctor", medicalCaseId = Model.Id })"
               class="rounded bg-green-600 px-6 py-2 font-bold text-white shadow hover:bg-green-700">
                + @SharedLocalizer["MedCase_Det_AddTest"]
            </a>
            @if (Model.MedicalCaseTests.Count > 0)
            {
                <a href="@Url.Action("PrintReport", "MedicalCases", new { area = "doctor", id = Model.Id })"
                   class="rounded bg-gray-700 px-4 py-2 text-sm text-white hover:bg-gray-900">@SharedLocalizer["Shared_Print_Report"]</a>
            }
        </div>
    </div>
</div>

@if (Model.MedicalCaseTests == null || !Model.MedicalCaseTests.Any())
{
    <div class="mb-4 rounded border-l-4 border-yellow-400 bg-yellow-50 p-4">
        <p class="text-yellow-800">@SharedLocalizer["MedCase_Det_NoTests"]</p>
    </div>
}
else
{
    var grouped = Model.MedicalCaseTests
        .Where(t => t.Test != null && t.Test.TestGroup != null)
        .GroupBy(t => t.Test.TestGroup.Name)
        .OrderBy(g => g.Key);

    foreach (var group in grouped)
    {
        <div class="mb-8">
            <h3 class="mb-4 border-b border-teal-300 pb-1 text-lg font-bold text-teal-700">@group.Key</h3>

            <!-- شبكة عرض أنيقة -->
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                @foreach (var test in group.OrderBy(t => t.Test.Name))
                {
                    var hasResult = !string.IsNullOrWhiteSpace(test.Result);

                    <div class="flex flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4 shadow-sm transition-all duration-200 hover:shadow-md">
                        <div>
                            <div class="font-semibold text-gray-800">@test.Test.Name</div>
                            <div class="text-sm text-gray-600">
                                @SharedLocalizer["Shared_Result"]: @(hasResult ? test.Result : @SharedLocalizer["MedCase_Det_NotSet"])
                            </div>
                            <div class="text-xs text-gray-400">
                                @SharedLocalizer["Shared_Added"]: @test.CreatedAt.ToString("yyyy-MM-dd")
                            </div>
                        </div>

                        <!-- الزر -->
                       @{
    // تعريف النص مسبقاً يمنع تداخل علامات التنصيص في الـ HTML
    var buttonText = hasResult 
        ? $"✏️ {SharedLocalizer["Shared_Update"]} {SharedLocalizer["Shared_Result"]}" 
        : $"➕ {SharedLocalizer["Shared_Add"]} {SharedLocalizer["Shared_Result"]}";
}

<button type="button"
        class="toggle-form w-fit rounded bg-blue-600 px-3 py-1 text-xs text-white"
        data-target="form-@test.Id"
        data-defaulttext="@buttonText">
    @buttonText
</button>

                        <!-- الفورم -->
                        <form id="form-@test.Id"
                              asp-action="UpdateTestResult"
                              asp-controller="MedicalCases"
                              asp-area="doctor"
                              method="post"
                              class="mt-2 flex hidden flex-col items-start gap-2 sm:flex-row sm:items-center">
                            <input type="hidden" name="id" value="@test.Id" />
                            <input type="text"
                                   name="result"
                                   value="@test.Result"
                                   placeholder=@SharedLocalizer["MedCase_Det_EnterResult"]
                                   class="w-full flex-1 rounded border px-2 py-1 text-sm sm:w-auto" />
                            <button type="submit"
                                    class="rounded bg-green-600 px-3 py-1 text-xs text-white hover:bg-green-700">
                                @SharedLocalizer["Shared_Save"]
                            </button>
                        </form>

                        <form asp-action="DeleteTest"
                              asp-controller="MedicalCases"
                              asp-area="doctor"
                              method="post"
                              class="mt-1">
                            <input type="hidden" name="id" value="@test.Id" />
                            <button type="submit"
                                    class="rounded bg-red-600 px-3 py-1 text-xs text-white"
                                    onclick="return confirm('Delete this test?')">
                                @SharedLocalizer["Shared_Delete"]
                            </button>
                        </form>
                    </div>
                }
            </div>
        </div>
    }
}

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            document.querySelectorAll(".toggle-form").forEach(btn => {
                btn.addEventListener("click", function () {
                    const targetId = this.getAttribute("data-target");
                    const form = document.getElementById(targetId);
                    const defaultText = this.getAttribute("data-defaulttext");

                    const isHidden = form.classList.contains("hidden");
                    form.classList.toggle("hidden");

                    // غيّر النص عند الفتح أو الإغلاق
                    this.textContent = isHidden ? "❌ @SharedLocalizer["Shared_Cancel"] @SharedLocalizer["Shared_Edit"]" : defaultText;
                });
            });
        });
    </script>