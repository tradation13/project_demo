@model EditAdminViewModel

@{
    ViewData["Title"] = "Edit Admin";
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div>
    <h4 class="text-xl capitalize mb-4">Edit Admin</h4>

    <form asp-action="EditAdmin" asp-route-id="@Model.Id" method="post" class="space-y-4">
        <div class="flex flex-col">
            <label asp-for="UserName" class="mb-1 font-medium">Username</label>
            <input asp-for="UserName" class="py-1 border-gray-300 rounded focus:outline-none focus:ring-0" placeholder="Enter username" />
            <span asp-validation-for="UserName" class="text-red-500 text-sm"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Email" class="mb-1 font-medium">Email</label>
            <input asp-for="Email" class="py-1 border-gray-300 rounded focus:outline-none focus:ring-0" placeholder="Enter email" />
            <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="PhoneNumber" class="mb-1 font-medium">Phone Number</label>
            <input asp-for="PhoneNumber" class="py-1 border-gray-300 rounded focus:outline-none focus:ring-0" placeholder="Enter phone number" />
            <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Status" class="mb-1 font-medium">Status</label>
            <select asp-for="Status" class="py-1 border-gray-300 rounded focus:outline-none focus:ring-0">
                <option value="0">Active</option>
                <option value="1">Inactive</option>
            </select>
            <span asp-validation-for="Status" class="text-red-500 text-sm"></span>
        </div>

        <div class="flex gap-2 mt-6">
            <a asp-action="Index"
               class="bg-secondary bg-opacity-20 hover:bg-opacity-40 rounded-lg px-6 py-1.5 text-secondary hover:shadow-xl transition duration-150">
                Cancel
            </a>
            <button type="submit"
                    class="bg-primary hover:bg-primary-dark rounded-lg px-6 py-1.5 text-white hover:shadow-xl transition duration-150">
                Save Changes
            </button>
        </div>
    </form>
</div>