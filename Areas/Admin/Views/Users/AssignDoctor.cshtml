@using IPTS.Models.Entites
@model IPTS.Areas.Admin.ViewsModels.AssignDoctorViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    var doctors = ViewBag.Doctors as List<Doctor> ?? new List<Doctor>();
}

<div class="custom-scrollbar overflow-x-auto rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">
    <div class="mb-6 flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <i class="fas fa-user-md"></i>
        </span>
        <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["AssignDoctor_Title"]</h4>
    </div>

    <div class="mb-6 rounded-2xl border border-slate-100 bg-slate-50/70 p-5">
        <p class="text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["AssignDoctor_Patient"]</p>
        <p class="mt-1 text-sm font-semibold text-slate-800">@Model.PatientName</p>
        <p class="text-sm text-slate-500">@Model.PatientEmail</p>
    </div>

    <form asp-action="AssignDoctor" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="PatientId" />
        <input type="hidden" asp-for="UserId" />
        <input type="hidden" asp-for="PatientName" />
        <input type="hidden" asp-for="PatientEmail" />

        <div class="mb-6 max-w-xl">
            <label asp-for="AssignedDoctorId" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">
                @SharedLocalizer["AssignDoctor_Select"]
            </label>
            <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                    <i class="fas fa-stethoscope text-xs"></i>
                </span>
                <select asp-for="AssignedDoctorId"
                        class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10">
                    <option value="0">@SharedLocalizer["AssignDoctor_Placeholder"]</option>
                    @foreach (var doctor in doctors)
                    {
                        var name = $"{doctor.User?.FirstName} {doctor.User?.LastName}".Trim();
                        <option value="@doctor.Id">@name</option>
                    }
                </select>
            </div>
            <span asp-validation-for="AssignedDoctorId" class="mt-1.5 text-xs text-red-500"></span>
        </div>

        <div class="flex flex-wrap items-center gap-3">
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-primary/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
                <i class="fas fa-check text-xs"></i>
                @SharedLocalizer["AssignDoctor_Save"]
            </button>
            <a asp-action="Index"
               class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-600 transition-colors hover:bg-slate-50">
                @SharedLocalizer["Shared_Cancel"]
            </a>
        </div>
    </form>
</div>
