@model IPTS.Areas.Admin.ViewsModels.ChatConversationListViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["ChatConversations"];
}

<div class="custom-scrollbar overflow-x-auto rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">

    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <i class="fas fa-comments"></i>
            </span>
            <div>
                <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["ChatConversations"]</h4>
                <p class="mt-0.5 text-xs text-slate-500">@SharedLocalizer["ChatConversations_Subtitle"]</p>
            </div>
        </div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">
            <i class="fas fa-lock text-[10px]"></i>
            @SharedLocalizer["ChatConversations_ReadOnly"]
        </span>
    </div>

    @if (Model.Items.Count == 0)
    {
        <div class="rounded-2xl border border-dashed border-slate-200 bg-slate-50/70 px-6 py-16 text-center">
            <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-white text-slate-400 shadow-sm">
                <i class="fas fa-comment-slash"></i>
            </div>
            <p class="text-sm font-medium text-slate-600">@SharedLocalizer["ChatConversations_Empty"]</p>
        </div>
    }
    else
    {
        <div class="w-full overflow-auto rounded-2xl border border-slate-100">
            <table class="mb-0 w-full whitespace-nowrap text-sm">
                <thead class="sticky top-0 z-10 bg-gradient-to-r from-primary to-indigo-600 text-white">
                    <tr>
                        <th class="px-4 py-3 font-semibold">#</th>
                        <th class="px-4 py-3 font-semibold">@SharedLocalizer["ChatConversations_Session"]</th>
                        <th class="px-4 py-3 font-semibold">@SharedLocalizer["ChatConversations_UserType"]</th>
                        <th class="px-4 py-3 font-semibold">@SharedLocalizer["ChatConversations_UserId"]</th>
                        <th class="px-4 py-3 font-semibold">@SharedLocalizer["ChatConversations_Ip"]</th>
                        <th class="px-4 py-3 font-semibold">@SharedLocalizer["ChatConversations_Consent"]</th>
                        <th class="px-4 py-3 font-semibold">@SharedLocalizer["ChatConversations_LastMessage"]</th>
                        <th class="px-4 py-3 font-semibold">@SharedLocalizer["ChatConversations_Created"]</th>
                        <th class="px-4 py-3"></th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @{ int row = 0; }
                    @foreach (var item in Model.Items)
                    {
                        row++;
                        var typeClass = item.UserType switch
                        {
                            IPTS.Models.Enums.ChatbotUserType.Patient => "bg-sky-50 text-sky-700",
                            IPTS.Models.Enums.ChatbotUserType.Therapist => "bg-violet-50 text-violet-700",
                            IPTS.Models.Enums.ChatbotUserType.Admin => "bg-amber-50 text-amber-700",
                            _ => "bg-slate-100 text-slate-600"
                        };
                        <tr class="animate-fade-slide-up transition-colors hover:bg-slate-50" style="animation-delay:@(row * 30)ms">
                            <td class="px-4 py-3 text-center text-slate-400">@item.Id</td>
                            <td class="px-4 py-3 text-center">
                                <code class="rounded bg-slate-50 px-2 py-1 text-xs text-slate-600" title="@item.SessionId">
                                    @(item.SessionId.Length > 12 ? item.SessionId[..8] + "…" : item.SessionId)
                                </code>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex rounded-full @typeClass px-3 py-1 text-xs font-semibold">
                                    @SharedLocalizer["ChatbotUserType_" + item.UserType.ToString()]
                                </span>
                            </td>
                            <td class="px-4 py-3 text-center text-slate-600">
                                @(string.IsNullOrWhiteSpace(item.UserId) ? "—" : item.UserId)
                            </td>
                            <td class="px-4 py-3 text-center text-slate-500">
                                @(string.IsNullOrWhiteSpace(item.IpAddress) ? "—" : item.IpAddress)
                            </td>
                            <td class="px-4 py-3 text-center">
                                @if (item.ConsentGiven)
                                {
                                    <span class="inline-flex rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-700">✓</span>
                                }
                                else
                                {
                                    <span class="inline-flex rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-600">✗</span>
                                }
                            </td>
                            <td class="px-4 py-3 text-center text-slate-500">@item.LastMessageAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td class="px-4 py-3 text-center text-slate-500">@item.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-center">
                                    <a asp-action="Details" asp-route-id="@item.Id"
                                       title="@SharedLocalizer["Shared_Details"]"
                                       class="inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-primary/10">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPages > 1)
        {
            <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
                <p class="text-xs text-slate-500">
                    @string.Format(SharedLocalizer["ChatConversations_PageOf"].Value ?? "Page {0} of {1}", Model.Page, Model.TotalPages)
                </p>
                <div class="flex items-center gap-2">
                    @if (Model.Page > 1)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize"
                           class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">
                            @SharedLocalizer["ChatConversations_Prev"]
                        </a>
                    }
                    @if (Model.Page < Model.TotalPages)
                    {
                        <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize"
                           class="rounded-xl border border-slate-200 bg-white px-3 py-1.5 text-xs font-semibold text-slate-700 hover:bg-slate-50">
                            @SharedLocalizer["ChatConversations_Next"]
                        </a>
                    }
                </div>
            </div>
        }
    }
</div>
