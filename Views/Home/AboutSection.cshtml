@* About PhysoTech Section *@
<section id="about" class="bg-white py-3">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-12 lg:grid-cols-2">
            <div class="flex items-center justify-center">
               <div class="relative flex w-full items-center justify-center lg:justify-end">
    <img src="/images/home/about.png" 
         alt="PhysoTech Logo" 
         class="h-auto w-full min-w-[300px] max-w-[550px] transform drop-shadow-2xl transition-all duration-500 hover:scale-105" 
         loading="lazy" />
    
    <div class="absolute -z-10 h-72 w-72 rounded-full bg-primary/10 opacity-50 blur-3xl"></div>
</div>
            </div>

            <div class="space-y-6">
                <div class="mb-4 flex items-center gap-3">
                    <i class="fas fa-dna text-3xl text-primary-600"></i>
                    <h2 class="text-4xl font-bold text-gray-900">@SharedLocalizer["Shared_AboutPhysoTech"]</h2>
                </div>

                <p class="text-lg leading-relaxed text-gray-700">
                    @SharedLocalizer["About_Brief"]
                </p>

                <p class="text-lg leading-relaxed text-gray-700">
                          @SharedLocalizer["About_PoweredBy"] <span class="font-semibold text-primary-600">@SharedLocalizer["System_FullTitle"]</span>
                          <a href="@Url.Action("About", "Home")"
                       class="ml-1 inline-flex items-center font-medium text-primary-600 transition-colors hover:text-primary-700">
                        <span class="border-b border-primary-600 hover:border-primary-700">@SharedLocalizer["About_LinkReadMore"]</span>
                        <i class="fas fa-arrow-right ml-1 text-sm"></i>
                    </a>,
                    @SharedLocalizer["About_Details"]
                </p>

                <div class="pt-6">
                    <a href="@Url.Action("About", "Home")"
                       class="inline-flex transform items-center gap-2 rounded-lg bg-primary-600 px-6 py-3 font-semibold text-white shadow-lg transition-all duration-200 hover:scale-105 hover:bg-primary-700 hover:shadow-xl">
                        <i class="fas fa-book-open"></i>
                        @SharedLocalizer["About_BtnMoreUs"]
                        <i class="fas fa-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
