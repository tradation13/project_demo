@using IPTS.Models.Entites
@model UserFormViewModel

@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    var isEditMode = !string.IsNullOrEmpty(Model.Id);
    ViewBag.Title = (isEditMode ? @SharedLocalizer["Shared_Edit"] : @SharedLocalizer["Users_CreateTitle"]) + ViewBag.UserType;
}

<form asp-action="UserForm" asp-route-id="" method="post" asp-route-UserType="@ViewBag.UserType" enctype="multipart/form-data" data-confirm="@(isEditMode ? "true" : null)">
    <input type="hidden" asp-for="Id" />

    <div class="flex flex-col gap-6">

        <div class="rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">
            <div class="mb-6 flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    <i class="fas fa-id-card"></i>
                </span>
                <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["Users_UserInformation"]</h4>
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                @if (!isEditMode)
                {
                    <div class="flex flex-col">
                        <label asp-for="UserName" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                                <i class="fas fa-at text-xs"></i>
                            </span>
                            <input asp-for="UserName" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                        </div>
                        <span asp-validation-for="UserName" class="mt-1.5 text-xs text-red-500"></span>
                    </div>
                }
                <div class="flex flex-col">
                    <label asp-for="Email" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                            <i class="fas fa-envelope text-xs"></i>
                        </span>
                        <input asp-for="Email" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                    </div>
                    <span asp-validation-for="Email" class="mt-1.5 text-xs text-red-500"></span>
                </div>
                <div class="flex flex-col">
                    <label asp-for="PhoneNumber" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                            <i class="fas fa-phone text-xs"></i>
                        </span>
                        <input asp-for="PhoneNumber" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="mt-1.5 text-xs text-red-500"></span>
                </div>
            </div>

            <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="flex flex-col">
                    <label asp-for="FirstName" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                            <i class="fas fa-user text-xs"></i>
                        </span>
                        <input asp-for="FirstName" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                    </div>
                    <span asp-validation-for="FirstName" class="mt-1.5 text-xs text-red-500"></span>
                </div>
                <div class="flex flex-col">
                    <label asp-for="LastName" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                            <i class="fas fa-id-badge text-xs"></i>
                        </span>
                        <input asp-for="LastName" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                    </div>
                    <span asp-validation-for="LastName" class="mt-1.5 text-xs text-red-500"></span>
                </div>
            </div>

            @if (!isEditMode)
            {
                <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="flex flex-col">
                        <label asp-for="Password" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                                <i class="fas fa-lock text-xs"></i>
                            </span>
                            <input asp-for="Password" type="password" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                        </div>
                        <span asp-validation-for="Password" class="mt-1.5 text-xs text-red-500"></span>
                    </div>
                    <div class="flex flex-col">
                        <label asp-for="ConfirmPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                                <i class="fas fa-lock text-xs"></i>
                            </span>
                            <input asp-for="ConfirmPassword" type="password" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                        </div>
                        <span asp-validation-for="ConfirmPassword" class="mt-1.5 text-xs text-red-500"></span>
                    </div>
                </div>
            }
            @if (isEditMode)
            {
                <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div class="flex flex-col">
                        <label asp-for="Status" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                        <div class="relative">
                            <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                                <i class="fas fa-toggle-on text-xs"></i>
                            </span>
                            <select asp-for="Status" class="block w-full appearance-none rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-8 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10">
                                <option value="0">@SharedLocalizer["Status_Active"]</option>
                                <option value="1">@SharedLocalizer["Status_Inactive"]</option>
                            </select>
                            <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-slate-300">
                                <i class="fas fa-chevron-down text-xs"></i>
                            </span>
                        </div>
                        <span asp-validation-for="Status" class="mt-1.5 text-xs text-red-500"></span>
                    </div>
                </div>
            }
        </div>

        @switch (ViewBag.UserType?.ToLower())
        {
            case "admin":
                break;

            case "customer":
                <div class="rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">
                    <div class="mb-6 flex items-center gap-3">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                            <i class="fas fa-address-card"></i>
                        </span>
                        <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["Users_CustomerInformation"]</h4>
                    </div>

                    <input type="hidden" asp-for="Customer.Id" />

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div class="flex flex-col">
                            <label asp-for="Customer.FirstName" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                                    <i class="fas fa-user text-xs"></i>
                                </span>
                                <input asp-for="Customer.FirstName" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                            </div>
                            <span asp-validation-for="Customer.FirstName" class="mt-1.5 text-xs text-red-500"></span>
                        </div>
                        <div class="flex flex-col">
                            <label asp-for="Customer.LastName" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                                    <i class="fas fa-id-badge text-xs"></i>
                                </span>
                                <input asp-for="Customer.LastName" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                            </div>
                            <span asp-validation-for="Customer.LastName" class="mt-1.5 text-xs text-red-500"></span>
                        </div>
                    </div>
                </div>
                break;

            case "patient":
                <div class="rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">
                    <div class="mb-6 flex items-center gap-3">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                            <i class="fas fa-user-injured"></i>
                        </span>
                        <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["Appt_Sched_PatientInfo"]</h4>
                    </div>

                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div class="flex flex-col">
                            <label asp-for="Patient.BirthDate" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Shared_Date_Of_Birth"]</label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                                    <i class="fas fa-calendar-days text-xs"></i>
                                </span>
                                <input asp-for="Patient.BirthDate" type="date" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                            </div>
                            <span asp-validation-for="Patient.BirthDate" class="mt-1.5 text-xs text-red-500"></span>
                        </div>
                    </div>
                </div>
                break;

            case "doctor":
                <div class="rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">
                    <div class="mb-6 flex items-center gap-3">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                            <i class="fas fa-user-doctor"></i>
                        </span>
                        <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["Users_DoctorInformation"]</h4>
                    </div>

                    <input type="hidden" asp-for="Doctor.Id" />
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div class="flex flex-col">
                            <label asp-for="Doctor.SpecialtyId" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                                    <i class="fas fa-stethoscope text-xs"></i>
                                </span>
                                <select asp-for="Doctor.SpecialtyId" class="block w-full appearance-none rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-8 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10">
                                    <option value="">@SharedLocalizer["Users_SelectSpecialty"]</option>
                                    @{
                                        var specialtiesList = ViewBag.Specialties as IEnumerable<Specialty>;
                                    }
                                    @if (specialtiesList != null && specialtiesList.Any())
                                    {
                                        foreach (var specialty in specialtiesList)
                                        {
                                            <option value="@specialty.Id">@specialty.Name</option>
                                        }
                                    }
                                    else
                                    {
                                        <option value="" disabled>@SharedLocalizer["Users_NoSpecialties"]</option>
                                    }
                                </select>
                                <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-slate-300">
                                    <i class="fas fa-chevron-down text-xs"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Doctor.SpecialtyId" class="mt-1.5 text-xs text-red-500"></span>
                        </div>
                        <div class="flex flex-col">
                            <label asp-for="Doctor.PhotoFile" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Users_DoctorPhoto"]</label>
                            <div class="relative">
                                <label for="doctorPhotoUpload"
                                       class="flex cursor-pointer items-center justify-between rounded-lg border border-slate-200 bg-white px-3 py-2 transition-all duration-200 hover:border-primary hover:bg-slate-50">
                                    <div class="flex items-center gap-2 overflow-hidden">
                                        <i class="fas fa-image text-primary text-xs"></i>
                                        <span id="fileNameDisplay" class="truncate text-sm text-slate-500">
                                            @SharedLocalizer["Profile_SelectPhoto"]...
                                        </span>
                                    </div>
                                    <span class="rounded-lg bg-gradient-to-r from-primary to-indigo-600 px-3 py-1 text-xs font-semibold text-white">
                                        @SharedLocalizer["Shared_Browse"]
                                    </span>
                                    <input asp-for="Doctor.PhotoFile"
                                           id="doctorPhotoUpload"
                                           type="file"
                                           accept="image/*"
                                           class="hidden"
                                           onchange="updatePhotoLabel(this)" />
                                </label>
                            </div>
                            <span asp-validation-for="Doctor.PhotoFile" class="mt-1 block text-xs text-red-500"></span>
                        </div>
                    </div>
                </div>
                break;
        }
    </div>

    <div class="mt-8 flex gap-3">
        <button type="submit"
                class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-primary/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
            <i class="fas fa-check text-xs"></i> @(isEditMode ? @SharedLocalizer["Profile_SaveBtn"] : @SharedLocalizer["Users_CreateTitle"])
        </button>
        <a href="@Url.Action("Index")"
           class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition-all duration-200 hover:bg-slate-50">
            <i class="fas fa-xmark text-xs"></i> @SharedLocalizer["Shared_Cancel"]
        </a>
    </div>

    <div asp-validation-summary="All" class="mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-500"></div>
</form>

<script>
    function updatePhotoLabel(input) {
        const display = document.getElementById('fileNameDisplay');
        if (input.files && input.files[0]) {
            display.textContent = input.files[0].name;
            display.classList.remove('text-slate-500');
            display.classList.add('text-primary', 'font-normal');
        } else {
            display.textContent = "@SharedLocalizer["Profile_SelectPhoto"]...";
            display.classList.add('text-slate-500');
        }
    }
</script>
