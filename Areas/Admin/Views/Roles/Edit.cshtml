@model IdentityRole
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}
<form asp-action="Edit" method="post" class="space-y-4">
    <input type="hidden" asp-for="Id" />
    <div>
        <label asp-for="Name" class="block text-sm font-medium text-gray-700"></label>
        <input asp-for="Name" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
        <span asp-validation-for="Name" class="text-red-500 text-sm"></span>
    </div>
    <div class="flex gap-2 mt-6">
        <a href="@Url.Action("Index")"
           class="bg-secondary bg-opacity-20 hover:bg-opacity-40 rounded-lg px-6 py-1.5 text-primary hover:shadow-xl transition duration-150">
            Cancel
        </a>

        <button type="submit"
                class="bg-primary hover:bg-primary-dark rounded-lg px-6 py-1.5 text-white hover:shadow-xl transition duration-150">
            Update
        </button>
    </div>

</form>
