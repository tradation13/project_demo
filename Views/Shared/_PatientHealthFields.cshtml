@model IPTS.ViewModels.IPatientHealthFields
@using IPTS.Models.Enums
@{
    var variant = (ViewData["HealthFieldsVariant"] as string) ?? "auth";
    string labelCls;
    string inputCls;
    string selectCls;
    string hintCls;
    string pillBase;
    string pillWrap;
    string sectionTitleCls;

    switch (variant)
    {
        case "prac":
            labelCls = "prac-label";
            inputCls = "prac-input";
            selectCls = "prac-input";
            hintCls = "mt-1 block text-xs text-red-700 empty:hidden";
            pillBase = "blood-pill rounded-lg border border-gray-200 bg-white px-3 py-1.5 text-sm font-semibold text-gray-600 transition-all duration-150 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-800";
            pillWrap = "space-y-3 rounded-lg border border-gray-100 bg-gray-50/60 p-3";
            sectionTitleCls = "mb-4 text-sm font-semibold text-gray-800";
            break;
        case "admin":
            labelCls = "mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400";
            inputCls = "w-full rounded-lg border border-slate-200 bg-white py-2 px-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10";
            selectCls = inputCls;
            hintCls = "mt-1.5 text-xs text-red-500 empty:hidden";
            pillBase = "blood-pill rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm font-semibold text-slate-600 transition-all duration-150 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-800";
            pillWrap = "space-y-3 rounded-lg border border-slate-100 bg-slate-50/70 p-3";
            sectionTitleCls = "mb-4 text-sm font-bold text-slate-800";
            break;
        default:
            labelCls = ViewData["HealthLabelClass"] as string ?? "mb-1.5 block text-sm font-medium text-slate-700";
            inputCls = ViewData["HealthInputClass"] as string ?? "mt-1 w-full rounded-2xl border border-slate-200 bg-white/90 px-4 py-3.5 text-[15px] text-slate-900 outline-none transition-all placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10";
            selectCls = inputCls;
            hintCls = "mt-1 block text-xs text-red-500 empty:hidden";
            pillBase = "blood-pill rounded-lg border border-slate-200 bg-white px-3 py-1.5 text-sm font-semibold text-slate-600 transition-all duration-150 hover:-translate-y-0.5 hover:border-red-200 hover:bg-red-50 hover:text-red-800";
            pillWrap = "space-y-3 rounded-2xl border border-slate-100 bg-slate-50/70 p-3";
            sectionTitleCls = "mb-4 text-sm font-semibold text-slate-800";
            break;
    }
}

<div class="js-patient-health-fields space-y-5">
    <p class="@sectionTitleCls">@SharedLocalizer["Patient_HealthData"]</p>
    <p class="mb-4 -mt-3 text-xs text-slate-500">@SharedLocalizer["Patient_HealthData_Optional"]</p>

    <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
        <div>
            <label asp-for="Weight" class="@labelCls">@SharedLocalizer["MedCase_Weight"]</label>
            <div class="relative">
                <input asp-for="Weight" type="number" step="0.1" min="1" max="500" placeholder="70" class="js-health-weight @inputCls pe-12" />
                <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-xs font-medium text-slate-400">kg</span>
            </div>
            <span asp-validation-for="Weight" class="@hintCls"></span>
        </div>
        <div>
            <label asp-for="Height" class="@labelCls">@SharedLocalizer["MedCase_Height"]</label>
            <div class="relative">
                <input asp-for="Height" type="number" step="0.1" min="30" max="300" placeholder="175" class="js-health-height @inputCls pe-12" />
                <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-xs font-medium text-slate-400">cm</span>
            </div>
            <span asp-validation-for="Height" class="@hintCls"></span>
        </div>
        <div class="js-bmi-badge hidden sm:col-span-2">
            <span class="js-bmi-pill inline-flex items-center gap-1.5 rounded-full border border-teal-200 bg-teal-50 px-3 py-1 text-xs font-semibold text-teal-700">
                BMI <span class="js-bmi-value">0</span>
            </span>
        </div>
    </div>

    <div>
        <label class="@labelCls">@SharedLocalizer["MedCase_BloodGroup"]</label>
        <select asp-for="BloodGroup" class="js-blood-group-select hidden">
            <option value="">@SharedLocalizer["Shared_Select"]</option>
            <optgroup label="@SharedLocalizer["BloodGroup_PositiveGroup"]">
                <option value="@((byte)EnBloodGroup.APositive)">@SharedLocalizer["BloodGroup_APositive"]</option>
                <option value="@((byte)EnBloodGroup.BPositive)">@SharedLocalizer["BloodGroup_BPositive"]</option>
                <option value="@((byte)EnBloodGroup.OPositive)">@SharedLocalizer["BloodGroup_OPositive"]</option>
                <option value="@((byte)EnBloodGroup.ABPositive)">@SharedLocalizer["BloodGroup_ABPositive"]</option>
            </optgroup>
            <optgroup label="@SharedLocalizer["BloodGroup_NegativeGroup"]">
                <option value="@((byte)EnBloodGroup.ANegative)">@SharedLocalizer["BloodGroup_ANegative"]</option>
                <option value="@((byte)EnBloodGroup.BNegative)">@SharedLocalizer["BloodGroup_BNegative"]</option>
                <option value="@((byte)EnBloodGroup.ONegative)">@SharedLocalizer["BloodGroup_ONegative"]</option>
                <option value="@((byte)EnBloodGroup.ABNegative)">@SharedLocalizer["BloodGroup_ABNegative"]</option>
            </optgroup>
        </select>
        <div class="@pillWrap">
            <div>
                <p class="mb-1.5 text-xs font-medium uppercase tracking-wide text-slate-400">@SharedLocalizer["BloodGroup_PositiveGroup"]</p>
                <div class="flex flex-wrap gap-2">
                    <button type="button" data-value="@((byte)EnBloodGroup.APositive)" class="@pillBase">@SharedLocalizer["BloodGroup_APositive"]</button>
                    <button type="button" data-value="@((byte)EnBloodGroup.BPositive)" class="@pillBase">@SharedLocalizer["BloodGroup_BPositive"]</button>
                    <button type="button" data-value="@((byte)EnBloodGroup.OPositive)" class="@pillBase">@SharedLocalizer["BloodGroup_OPositive"]</button>
                    <button type="button" data-value="@((byte)EnBloodGroup.ABPositive)" class="@pillBase">@SharedLocalizer["BloodGroup_ABPositive"]</button>
                </div>
            </div>
            <div>
                <p class="mb-1.5 text-xs font-medium uppercase tracking-wide text-slate-400">@SharedLocalizer["BloodGroup_NegativeGroup"]</p>
                <div class="flex flex-wrap gap-2">
                    <button type="button" data-value="@((byte)EnBloodGroup.ANegative)" class="@pillBase">@SharedLocalizer["BloodGroup_ANegative"]</button>
                    <button type="button" data-value="@((byte)EnBloodGroup.BNegative)" class="@pillBase">@SharedLocalizer["BloodGroup_BNegative"]</button>
                    <button type="button" data-value="@((byte)EnBloodGroup.ONegative)" class="@pillBase">@SharedLocalizer["BloodGroup_ONegative"]</button>
                    <button type="button" data-value="@((byte)EnBloodGroup.ABNegative)" class="@pillBase">@SharedLocalizer["BloodGroup_ABNegative"]</button>
                </div>
            </div>
        </div>
        <span asp-validation-for="BloodGroup" class="@hintCls"></span>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        <div>
            <label asp-for="IsSmoker" class="@labelCls">@SharedLocalizer["MedCase_Smoker"]</label>
            <select asp-for="IsSmoker" class="@selectCls">
                <option value="">@SharedLocalizer["Patient_NotSpecified"]</option>
                <option value="true">@SharedLocalizer["Shared_Yes"]</option>
                <option value="false">@SharedLocalizer["Shared_No"]</option>
            </select>
            <span asp-validation-for="IsSmoker" class="@hintCls"></span>
        </div>
        <div>
            <label asp-for="HasChronicDisease" class="@labelCls">@SharedLocalizer["MedCase_ChronicDiseases"]</label>
            <select asp-for="HasChronicDisease" class="@selectCls">
                <option value="">@SharedLocalizer["Patient_NotSpecified"]</option>
                <option value="true">@SharedLocalizer["Shared_Yes"]</option>
                <option value="false">@SharedLocalizer["Shared_No"]</option>
            </select>
            <span asp-validation-for="HasChronicDisease" class="@hintCls"></span>
        </div>
    </div>
</div>

<script>
(function () {
    var roots = document.querySelectorAll(".js-patient-health-fields");
    var root = roots[roots.length - 1];
    if (!root || root.dataset.bound === "1") return;
    root.dataset.bound = "1";

    var weightInput = root.querySelector(".js-health-weight");
    var heightInput = root.querySelector(".js-health-height");
    var bmiBadge = root.querySelector(".js-bmi-badge");
    var bmiPill = root.querySelector(".js-bmi-pill");
    var bmiValue = root.querySelector(".js-bmi-value");

    function updateBmi() {
        if (!weightInput || !heightInput || !bmiBadge) return;
        var w = parseFloat(weightInput.value);
        var h = parseFloat(heightInput.value);
        if (!w || !h) {
            bmiBadge.classList.add("hidden");
            return;
        }
        var bmi = w / Math.pow(h / 100, 2);
        var tone = "border-teal-200 bg-teal-50 text-teal-700";
        if (bmi < 18.5) tone = "border-indigo-200 bg-indigo-50 text-indigo-700";
        else if (bmi >= 25) tone = "border-red-300 bg-red-50 text-red-800";
        bmiValue.textContent = bmi.toFixed(1);
        bmiPill.className = "js-bmi-pill inline-flex items-center gap-1.5 rounded-full border px-3 py-1 text-xs font-semibold " + tone;
        bmiBadge.classList.remove("hidden");
    }

    if (weightInput) weightInput.addEventListener("input", updateBmi);
    if (heightInput) heightInput.addEventListener("input", updateBmi);
    updateBmi();

    var bloodSelect = root.querySelector(".js-blood-group-select");
    var bloodPills = root.querySelectorAll(".blood-pill");

    function syncBloodGroup() {
        if (!bloodSelect) return;
        bloodPills.forEach(function (pill) {
            var isActive = pill.dataset.value === bloodSelect.value;
            pill.classList.toggle("border-red-300", isActive);
            pill.classList.toggle("bg-red-50", isActive);
            pill.classList.toggle("text-red-800", isActive);
            pill.classList.toggle("border-gray-200", !isActive);
            pill.classList.toggle("border-slate-200", !isActive);
            pill.classList.toggle("text-gray-600", !isActive);
            pill.classList.toggle("text-slate-600", !isActive);
        });
    }

    bloodPills.forEach(function (pill) {
        pill.addEventListener("click", function () {
            if (!bloodSelect) return;
            bloodSelect.value = bloodSelect.value === pill.dataset.value ? "" : pill.dataset.value;
            syncBloodGroup();
        });
    });
    syncBloodGroup();
})();
</script>
