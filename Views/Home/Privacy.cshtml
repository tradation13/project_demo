@using Microsoft.AspNetCore.Mvc.Localization
@{
    ViewData["Title"] = SharedLocalizer["Privacy_Title"];
    Layout = "~/Views/Shared/Layouts/_MainLayout.cshtml";

    var returnUrl = Context.Request.Query["returnUrl"].ToString();
    if (string.IsNullOrWhiteSpace(returnUrl))
    {
        returnUrl = Context.Request.Headers["Referer"].ToString();
    }

    if (string.IsNullOrWhiteSpace(returnUrl) || !Url.IsLocalUrl(returnUrl))
    {
        returnUrl = Url.Action("Register", "Auth") ?? "/Auth/Register";
    }
}

<div class="mx-auto mt-6 max-w-5xl rounded-[2rem] border border-gray-100 bg-gradient-to-b from-white to-gray-50/50 p-5 shadow-[0_24px_65px_-25px_rgba(15,23,42,0.35)] sm:mt-10 sm:p-8 lg:p-10">
    <div class="mb-8 sm:mb-10">
        <a href="@returnUrl" class="inline-flex items-center gap-2 rounded-xl border border-gray-200 bg-white px-4 py-2 text-sm font-semibold text-gray-700 shadow-sm transition hover:-translate-y-0.5 hover:border-primary/30 hover:text-primary">
            <i class="fa-solid fa-arrow-left"></i>
            <span>@SharedLocalizer["Shared_Back"]</span>
        </a>
    </div>

    <h1 class="mb-10 border-b border-gray-100 pb-4 text-2xl font-black tracking-tight text-gray-900 sm:mb-12 sm:text-3xl">@SharedLocalizer["Privacy_Title"]</h1>

    <div class="space-y-8 text-justify leading-relaxed text-gray-700 sm:space-y-9">

        <section class="rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-3">@SharedLocalizer["Privacy_Section1_Title"]</h2>
            <p class="text-gray-600">@SharedLocalizer["Privacy_Section1_Subtitle"]</p>
            <p>@SharedLocalizer["Privacy_Section1_Overview"]</p>
        </section>

        <section class="rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
            <h3 class="text-xl font-bold text-gray-800 mb-2">@SharedLocalizer["Privacy_Section1_DataCollectionTitle"]</h3>
            <h4 class="font-semibold">@SharedLocalizer["Privacy_Section1_DataCollectionResponsibilityTitle"]</h4>
            <p>@SharedLocalizer["Privacy_Section1_DataCollectionResponsibilityText"]</p>

            <h4 class="font-semibold mt-4">@SharedLocalizer["Privacy_Section1_HowCollectTitle"]</h4>
            <p>@SharedLocalizer["Privacy_Section1_HowCollectText"]</p>

            <h4 class="font-semibold mt-4">@SharedLocalizer["Privacy_Section1_WhyUseTitle"]</h4>
            <p>@SharedLocalizer["Privacy_Section1_WhyUseText"]</p>

            <h4 class="font-semibold mt-4">@SharedLocalizer["Privacy_Section1_RightsTitle"]</h4>
            <p>@SharedLocalizer["Privacy_Section1_RightsText"]</p>
        </section>

        <section class="rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-3">@SharedLocalizer["Privacy_Section2_Title"]</h2>
            <h3 class="text-xl font-semibold">@SharedLocalizer["Privacy_Section2_Subtitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section2_Content1"]</p>
            <p>@SharedLocalizer["Privacy_Section2_Content2"]</p>
            <p>@SharedLocalizer["Privacy_Section2_Content3"]</p>
        </section>

        <section class="rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-3">@SharedLocalizer["Privacy_Section3_Title"]</h2>
            <p>@SharedLocalizer["Privacy_Section3_Text1"]</p>
            <p>@SharedLocalizer["Privacy_Section3_Text2"]</p>
            <p>@SharedLocalizer["Privacy_Section3_Text3"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section3_ResponsibleTitle"]</h3>
            <address class="not-italic text-gray-700">
                @SharedLocalizer["Privacy_Section3_ResponsibleName"]<br />
                @SharedLocalizer["Privacy_Section3_ResponsibleAddress"]<br />
                @SharedLocalizer["Privacy_Section3_ResponsiblePhone"]<br />
                @SharedLocalizer["Privacy_Section3_ResponsibleEmail"]
            </address>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section3_WithdrawalTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section3_WithdrawalText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section3_ObjectionTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section3_ObjectionText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section3_ComplaintTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section3_ComplaintText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section3_PortabilityTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section3_PortabilityText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section3_EncryptionTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section3_EncryptionText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section3_AccessTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section3_AccessText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section3_RestrictionTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section3_RestrictionText"]</p>
        </section>

        <section class="rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-3">@SharedLocalizer["Privacy_Section4_Title"]</h2>
            <h3 class="text-lg font-semibold">@SharedLocalizer["Privacy_Section4_CookiesTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section4_CookiesText1"]</p>
            <p>@SharedLocalizer["Privacy_Section4_CookiesText2"]</p>
            <p>@SharedLocalizer["Privacy_Section4_CookiesText3"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section4_LogsTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section4_LogsText1"]</p>
            <p>@SharedLocalizer["Privacy_Section4_LogsText2"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section4_ContactTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section4_ContactText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section4_NewsletterTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section4_NewsletterText"]</p>
        </section>

        <section class="rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
            <h2 class="text-2xl font-bold text-gray-900 mb-3">@SharedLocalizer["Privacy_Section5_Title"]</h2>
            <h3 class="text-lg font-semibold">@SharedLocalizer["Privacy_Section5_GoogleFontsTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section5_GoogleFontsText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section5_GoogleMapsTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section5_GoogleMapsText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section5_GoogleAnalyticsTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section5_GoogleAnalyticsText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section5_FacebookPixelTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section5_FacebookPixelText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section5_ReCaptchaTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section5_ReCaptchaText"]</p>

            <h3 class="text-lg font-semibold mt-4">@SharedLocalizer["Privacy_Section5_AnalyticsTitle"]</h3>
            <p>@SharedLocalizer["Privacy_Section5_AnalyticsText"]</p>
        </section>

    </div>
</div>