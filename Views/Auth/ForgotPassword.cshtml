@model ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["ForgotPass_PageTitle"];
}

<div class="mx-auto w-full max-w-md overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
    <div class="h-1 bg-[#0D7A62]"></div>

    <div class="px-7 py-8 sm:px-9 sm:py-10">
        <div class="mb-8 border-b border-slate-100 pb-6">
            <h1 class="text-xl font-semibold tracking-tight text-slate-800 sm:text-2xl">
                @SharedLocalizer["Shared__ForgotPassword"]
            </h1>
            <p class="mt-2 text-sm leading-6 text-slate-500">
                @SharedLocalizer["ForgotPass_Desc"]
            </p>
        </div>

        <form class="space-y-5 text-sm" asp-action="ForgotPassword" method="post" novalidate autocomplete="off">
            <div>
                <label asp-for="Email" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                    @SharedLocalizer["Shared_EmailAddress"]
                </label>
                <input asp-for="Email"
                       type="email"
                       aria-describedby="Email-error"
                       class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition focus:border-[#0D7A62] focus:ring-2 focus:ring-[#0D7A62]/15" />
                <span asp-validation-for="Email" id="Email-error" class="mt-1.5 block text-xs text-red-600"></span>
            </div>

            <div class="flex flex-col gap-3 pt-2">
                <button type="submit"
                        class="inline-flex w-full items-center justify-center rounded-lg bg-[#0D7A62] px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0a6350]">
                    @SharedLocalizer["ForgotPass_SubmitBtn"]
                </button>

                <a href="@(Url.Action("Login", "Auth"))"
                   class="inline-flex w-full items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-800">
                    @SharedLocalizer["Shared_BackToLogin"]
                </a>
            </div>

            @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
        </form>
    </div>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")
