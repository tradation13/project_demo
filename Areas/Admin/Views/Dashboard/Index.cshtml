@model DashboardStatisticsViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="min-h-screen bg-slate-50 p-5 sm:p-7">
  <div class="w-full">

    <style>
      @@keyframes fadeInUp { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: translateY(0); } }
      .animate-fade-up { animation: fadeInUp 540ms cubic-bezier(.2,.85,.25,1) both; }
    </style>

    <div class="w-full overflow-hidden rounded-3xl border border-slate-100 bg-white shadow-lg shadow-slate-100 animate-fade-up">
      <div class="bg-gradient-to-r from-primary to-indigo-600 px-6 py-5 text-white rounded-t-3xl">
        <div class="flex items-center gap-2 mb-0">
          <span class="w-1.5 h-1.5 rounded-full bg-white/40 inline-block"></span>
          <span class="text-[11px] font-bold uppercase tracking-widest text-white/90">PhysioTech — System Overview</span>
        </div>
        <h1 class="text-[26px] font-extrabold tracking-tight text-white leading-tight">
          @SharedLocalizer["Dashboard_Title"]
        </h1>
        <p class="text-sm text-white/90">@SharedLocalizer["Dashboard_Subtitle"]</p>
      </div>

      <div class="px-6 py-6">

        <div class="mb-7">
        </div>

        <hr class="border-slate-200 mb-7" />

        <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-2.5 mb-2.5">

      @* Patients — Teal *@
      <div class="bg-white border border-slate-200/80 rounded-[14px] overflow-hidden hover:-translate-y-0.5 hover:border-slate-300 transition-all duration-150">
        <div class="h-[3px] bg-gradient-to-r from-emerald-500 to-emerald-400"></div>
        <div class="p-4 pb-3">
          <div class="w-[34px] h-[34px] rounded-[9px] bg-emerald-50 flex items-center justify-center text-emerald-600 mb-3">
            <i class="fas fa-users text-sm"></i>
          </div>
          <p class="text-[11px] font-semibold uppercase tracking-wide text-emerald-600 mb-1.5">@SharedLocalizer["Dashboard_TotalPatients"]</p>
          <p class="text-[28px] font-extrabold tracking-tight text-emerald-900 leading-none">@Model.TotalPatients</p>
        </div>
        <div class="px-4 py-2 border-t border-slate-100 text-[11px] text-slate-400 leading-snug">
          @SharedLocalizer["Dashboard_Patients_Description"]
        </div>
      </div>

      @* Doctors — Blue *@
      <div class="bg-white border border-slate-200/80 rounded-[14px] overflow-hidden hover:-translate-y-0.5 hover:border-slate-300 transition-all duration-150">
        <div class="h-[3px] bg-gradient-to-r from-blue-500 to-blue-400"></div>
        <div class="p-4 pb-3">
          <div class="w-[34px] h-[34px] rounded-[9px] bg-blue-50 flex items-center justify-center text-blue-600 mb-3">
            <i class="fas fa-user-md text-sm"></i>
          </div>
          <p class="text-[11px] font-semibold uppercase tracking-wide text-blue-600 mb-1.5">@SharedLocalizer["Dashboard_TotalDoctors"]</p>
          <p class="text-[28px] font-extrabold tracking-tight text-blue-900 leading-none">@Model.TotalDoctors</p>
        </div>
        <div class="px-4 py-2 border-t border-slate-100 text-[11px] text-slate-400 leading-snug">
          @SharedLocalizer["Dashboard_Doctors_Description"]
        </div>
      </div>

      @* Admins — Purple *@
      <div class="bg-white border border-slate-200/80 rounded-[14px] overflow-hidden hover:-translate-y-0.5 hover:border-slate-300 transition-all duration-150">
        <div class="h-[3px] bg-gradient-to-r from-violet-500 to-violet-400"></div>
        <div class="p-4 pb-3">
          <div class="w-[34px] h-[34px] rounded-[9px] bg-violet-50 flex items-center justify-center text-violet-600 mb-3">
            <i class="fas fa-shield-alt text-sm"></i>
          </div>
          <p class="text-[11px] font-semibold uppercase tracking-wide text-violet-600 mb-1.5">@SharedLocalizer["Dashboard_TotalAdmins"]</p>
          <p class="text-[28px] font-extrabold tracking-tight text-violet-900 leading-none">@Model.TotalAdmins</p>
        </div>
        <div class="px-4 py-2 border-t border-slate-100 text-[11px] text-slate-400 leading-snug">
          @SharedLocalizer["Dashboard_Admins_Description"]
        </div>
      </div>

      @* Medical Cases — Rose *@
      <div class="bg-white border border-slate-200/80 rounded-[14px] overflow-hidden hover:-translate-y-0.5 hover:border-slate-300 transition-all duration-150">
        <div class="h-[3px] bg-gradient-to-r from-rose-500 to-rose-400"></div>
        <div class="p-4 pb-3">
          <div class="w-[34px] h-[34px] rounded-[9px] bg-rose-50 flex items-center justify-center text-rose-600 mb-3">
            <i class="fas fa-file-medical text-sm"></i>
          </div>
          <p class="text-[11px] font-semibold uppercase tracking-wide text-rose-600 mb-1.5">@SharedLocalizer["Dashboard_TotalCases"]</p>
          <p class="text-[28px] font-extrabold tracking-tight text-rose-900 leading-none">@Model.TotalMedicalCases</p>
        </div>
        <div class="px-4 py-2 border-t border-slate-100 text-[11px] text-slate-400 leading-snug">
          @SharedLocalizer["Dashboard_Cases_Description"]
        </div>
      </div>

      @* Tests — Amber *@
      <div class="bg-white border border-slate-200/80 rounded-[14px] overflow-hidden hover:-translate-y-0.5 hover:border-slate-300 transition-all duration-150">
        <div class="h-[3px] bg-gradient-to-r from-amber-500 to-amber-400"></div>
        <div class="p-4 pb-3">
          <div class="w-[34px] h-[34px] rounded-[9px] bg-amber-50 flex items-center justify-center text-amber-600 mb-3">
            <i class="fas fa-vial text-sm"></i>
          </div>
          <p class="text-[11px] font-semibold uppercase tracking-wide text-amber-600 mb-1.5">@SharedLocalizer["Dashboard_TotalTests"]</p>
          <p class="text-[28px] font-extrabold tracking-tight text-amber-900 leading-none">@Model.TotalTests</p>
        </div>
        <div class="px-4 py-2 border-t border-slate-100 text-[11px] text-slate-400 leading-snug">
          @SharedLocalizer["Dashboard_Tests_Description"]
        </div>
      </div>

      @* Test Groups — Sky *@
      <div class="bg-white border border-slate-200/80 rounded-[14px] overflow-hidden hover:-translate-y-0.5 hover:border-slate-300 transition-all duration-150">
        <div class="h-[3px] bg-gradient-to-r from-sky-500 to-sky-400"></div>
        <div class="p-4 pb-3">
          <div class="w-[34px] h-[34px] rounded-[9px] bg-sky-50 flex items-center justify-center text-sky-600 mb-3">
            <i class="fas fa-layer-group text-sm"></i>
          </div>
          <p class="text-[11px] font-semibold uppercase tracking-wide text-sky-600 mb-1.5">@SharedLocalizer["Dashboard_TestGroups"]</p>
          <p class="text-[28px] font-extrabold tracking-tight text-sky-900 leading-none">@Model.TotalTestGroups</p>
        </div>
        <div class="px-4 py-2 border-t border-slate-100 text-[11px] text-slate-400 leading-snug">
          @SharedLocalizer["Dashboard_TestGroups_Description"]
        </div>
      </div>

      @* User Types — Indigo *@
      <div class="bg-white border border-slate-200/80 rounded-[14px] overflow-hidden hover:-translate-y-0.5 hover:border-slate-300 transition-all duration-150">
        <div class="h-[3px] bg-gradient-to-r from-indigo-500 to-indigo-400"></div>
        <div class="p-4 pb-3">
          <div class="w-[34px] h-[34px] rounded-[9px] bg-indigo-50 flex items-center justify-center text-indigo-600 mb-3">
            <i class="fas fa-id-badge text-sm"></i>
          </div>
          <p class="text-[11px] font-semibold uppercase tracking-wide text-indigo-600 mb-1.5">@SharedLocalizer["Dashboard_UserTypes"]</p>
          <p class="text-[28px] font-extrabold tracking-tight text-indigo-900 leading-none">@Model.TotalUserTypes</p>
          <p class="text-[11px] text-slate-400 mt-1">@SharedLocalizer["Dashboard_UserTypes_Types"]</p>
        </div>
        <div class="px-4 py-2 border-t border-slate-100 text-[11px] text-slate-400 leading-snug">
          @SharedLocalizer["Dashboard_UserTypes_Description"]
        </div>
      </div>

    </div>

   
    <div class="bg-white border border-slate-200/80 rounded-[14px] p-4 flex items-start gap-3 mt-2.5">
      <div class="w-[36px] h-[36px] rounded-[9px] bg-emerald-50 flex items-center justify-center text-emerald-600 flex-shrink-0">
        <i class="fas fa-info-circle text-sm"></i>
      </div>
      <div>
        <h3 class="text-[13px] font-bold text-slate-800 mb-0.5">@SharedLocalizer["Dashboard_Info_Title"]</h3>
        <p class="text-[12px] text-slate-500 leading-relaxed">@SharedLocalizer["Dashboard_Info_Description"]</p>
      </div>
    </div>

   
  </div>
</div>