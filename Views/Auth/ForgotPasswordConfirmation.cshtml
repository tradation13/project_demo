@{
    Layout = "~/Views/Shared/Layouts/_MainLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["ForgotConf_PageTitle"];
}

<section class="mb-10 rounded bg-white p-6 text-center shadow">
    <h2 class="mb-4 text-2xl font-semibold">
        @SharedLocalizer["ForgotConf_Header"]
    </h2>
    <p class="text-base text-gray-700">
        @SharedLocalizer["ForgotConf_Message"]
    </p>

    <div class="mt-6">
        <a href="@Url.Action("Login", "Auth")"
           class="rounded-lg bg-primary px-6 py-2 text-white transition duration-150 hover:bg-primary-dark hover:shadow-xl">
            @SharedLocalizer["Shared_BackToLogin"]
        </a>
    </div>
</section>