@* ─── Serialize articles to JSON for the modal ─── *@
<script>
    const ARTICLES_DATA = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(articles.Select(a => new {
        id         = a.Id,
        titleDe    = a.TitleDe,
        titleEn    = a.TitleEn,
        bodyDe     = a.BodyDe,
        bodyEn     = a.BodyEn,
        category   = a.Category,
        publishedAt= a.PublishedAt.ToString("dd.MM.yyyy"),
        images     = a.Images
    })));
</script>

<script>
    const i18n = {
        de: {
            hero_eyebrow : "Unser Wissen für dich",
            hero_title   : "Blog",
            hero_sub     : "Tipps, Team-Einblicke & aktuelle News rund um Physiotherapie und Bewegung.",
            filter_all   : "Alle",
            read_more    : "Weiterlesen",
            no_results   : "Keine Artikel in dieser Kategorie.",
            close        : "Schließen",
            prev         : "Zurück",
            next         : "Weiter",
        },
        en: {
            hero_eyebrow : "Our knowledge for you",
            hero_title   : "Blog",
            hero_sub     : "Tips, team insights & the latest news on physiotherapy and movement.",
            filter_all   : "All",
            read_more    : "Read more",
            no_results   : "No articles in this category.",
            close        : "Close",
            prev         : "Previous",
            next         : "Next",
        }
    };

    const urlParams = new URLSearchParams(window.location.search);
    const initialArticleId = parseInt(urlParams.get("articleId"), 10);
    const lang = (navigator.language || "de").startsWith("en") ? "en" : "de";
    const t    = i18n[lang];

    document.addEventListener("DOMContentLoaded", () => {

        /* ── i18n ── */
        document.querySelectorAll("[data-i18n]").forEach(el => {
            const key = el.dataset.i18n;
            if (t[key] !== undefined) el.textContent = t[key];
        });
        document.querySelectorAll(".card-title-de, .card-excerpt-de").forEach(el => el.style.display = lang === "de" ? "" : "none");
        document.querySelectorAll(".card-title-en, .card-excerpt-en").forEach(el => el.style.display = lang === "en" ? "" : "none");

        /* ── Filter ── */
        const filterBtns = document.querySelectorAll(".filter-btn");
        const cards      = document.querySelectorAll(".article-card");

        const applyFilter = (cat) => {
            filterBtns.forEach(b => {
                const isActive = b.dataset.cat === cat;
                b.classList.toggle("filter-btn--active", isActive);
                b.setAttribute("aria-selected", isActive);
            });
            let visible = 0;
            cards.forEach(c => {
                const match = cat === "all" || c.dataset.cat === cat;
                c.style.display = match ? "" : "none";
                if (match) visible++;
            });
            document.getElementById("no-results").style.display = visible === 0 ? "flex" : "none";
        };

        filterBtns.forEach(btn => btn.addEventListener("click", () => applyFilter(btn.dataset.cat)));
        document.querySelector('.filter-btn[data-cat="all"] span').textContent = t.filter_all;
        document.querySelectorAll(".read-more-label").forEach(el => el.textContent = t.read_more);
        document.getElementById("no-results-text").textContent = t.no_results;

        /* ── Modal ── */
        const overlay      = document.getElementById("article-modal-overlay");
        const modalImg     = document.getElementById("modal-main-img");
        const modalBadge   = document.getElementById("modal-badge");
        const modalDate    = document.getElementById("modal-date");
        const modalTitle   = document.getElementById("modal-title");
        const modalBody    = document.getElementById("modal-body");
        const modalThumbsC = document.getElementById("modal-thumbs");
        const modalClose   = document.getElementById("modal-close");
        const modalPrev    = document.getElementById("modal-img-prev");
        const modalNext    = document.getElementById("modal-img-next");
        const modalCounter = document.getElementById("modal-img-counter");

        let currentImages = [];
        let currentIndex  = 0;

        const setImage = (idx) => {
            currentIndex = (idx + currentImages.length) % currentImages.length;
            modalImg.style.opacity = "0";
            setTimeout(() => {
                modalImg.src = currentImages[currentIndex];
                modalImg.style.opacity = "1";
            }, 180);
            document.querySelectorAll(".modal-thumb").forEach((th, i) => {
                th.classList.toggle("modal-thumb--active", i === currentIndex);
            });
            modalCounter.textContent = `${currentIndex + 1} / ${currentImages.length}`;
        };

        const openModal = (id) => {
            const article = ARTICLES_DATA.find(a => a.id === id);
            if (!article) return;

            currentImages = article.images && article.images.length ? article.images : ["https://picsum.photos/1200/800"];

            modalBadge.textContent  = article.category;
            modalDate.textContent   = article.publishedAt;
            modalTitle.textContent  = lang === "de" ? article.titleDe : article.titleEn;

            const bodyText = lang === "de" ? article.bodyDe : article.bodyEn;
            modalBody.innerHTML = bodyText
                .split("\n\n")
                .map(p => `<p>${p}</p>`)
                .join("");

            /* thumbnails */
            modalThumbsC.innerHTML = "";
            currentImages.forEach((src, i) => {
                const btn = document.createElement("button");
                btn.type      = "button";
                btn.className = "modal-thumb" + (i === 0 ? " modal-thumb--active" : "");
                btn.innerHTML = `<img src="${src}" alt="" onerror="this.src='https://picsum.photos/1200/800'" />`;
                btn.addEventListener("click", () => setImage(i));
                modalThumbsC.appendChild(btn);
            });

            currentIndex = 0;
            modalImg.src     = currentImages[0];
            modalImg.style.opacity = "1";
            modalCounter.textContent = `1 / ${currentImages.length}`;

            overlay.classList.add("is-open");
            document.body.style.overflow = "hidden";
            modalClose.focus();
        };

        const closeModal = () => {
            overlay.classList.remove("is-open");
            document.body.style.overflow = "";
        };

        /* open triggers — card click OR button click */
        document.querySelectorAll(".article-card__inner").forEach(card => {
            card.addEventListener("click", (e) => {
                if (e.target.closest(".article-card__readmore")) return; // handled below
                openModal(parseInt(card.dataset.id));
            });
        });

        document.querySelectorAll(".article-card__readmore").forEach(btn => {
            btn.addEventListener("click", (e) => {
                e.stopPropagation();
                openModal(parseInt(btn.dataset.id));
            });
        });

        modalClose.addEventListener("click", closeModal);
        overlay.addEventListener("click", (e) => { if (e.target === overlay) closeModal(); });
        document.addEventListener("keydown", (e) => {
            if (!overlay.classList.contains("is-open")) return;
            if (e.key === "Escape") closeModal();
            if (e.key === "ArrowLeft")  setImage(currentIndex - 1);
            if (e.key === "ArrowRight") setImage(currentIndex + 1);
        });

        modalPrev.addEventListener("click", () => setImage(currentIndex - 1));
        modalNext.addEventListener("click", () => setImage(currentIndex + 1));

        if (!Number.isNaN(initialArticleId)) {
            openModal(initialArticleId);
        }
    });
</script>

<section class="blog-hero relative overflow-hidden">
    <div class="blog-hero__bg absolute inset-0">
        <img src="https://picsum.photos/id/1040/1600/900"
             alt="Blog hero"
             class="w-full h-full object-cover object-center"
             onerror="this.style.display='none'" />
        <div class="absolute inset-0 blog-hero__overlay"></div>
    </div>
    <div class="blog-hero__accent" aria-hidden="true"></div>
    <div class="relative z-10 container mx-auto px-6 flex flex-col justify-end h-full pb-16 pt-32">
        <p class="blog-hero__eyebrow" data-i18n="hero_eyebrow">Unser Wissen für dich</p>
        <h1 class="blog-hero__title" data-i18n="hero_title">Blog</h1>
        <p class="blog-hero__sub" data-i18n="hero_sub">
            Tipps, Team-Einblicke & aktuelle News rund um Physiotherapie und Bewegung.
        </p>
    </div>
</section>

<div class="blog-filter-wrap sticky top-0 z-30">
    <div class="container mx-auto px-6">
        <div class="blog-filter-inner">
            <div class="blog-filter-scroll" role="tablist" aria-label="Filter articles by category">
                <button class="filter-btn filter-btn--active" data-cat="all" role="tab" aria-selected="true">
                    <span>Alle</span>
                </button>
                @foreach (var cat in categories)
                {
                    <button class="filter-btn" data-cat="@cat" role="tab" aria-selected="false">
                        <span>@cat</span>
                    </button>
                }
            </div>
        </div>
    </div>
</div>

<section class="blog-grid-section">
    <div class="container mx-auto px-6">
        <div class="blog-grid" id="articles-grid">
            @foreach (var a in articles)
            {
                <article class="article-card" data-cat="@a.Category">
                    <div class="article-card__inner group" data-id="@a.Id" role="button" tabindex="0" aria-label="@a.TitleDe">

                        <div class="article-card__img-wrap">
                            <img src="@a.ImageUrl"
                                 alt="@a.TitleDe"
                                 class="article-card__img"
                                 loading="lazy"
                                 onerror="this.src='https://picsum.photos/1200/800'" />
                            <div class="article-card__img-overlay"></div>
                            <span class="article-card__badge">@a.Category</span>
                        </div>

                        <div class="article-card__body">
                            <time class="article-card__date" datetime="@a.PublishedAt.ToString("yyyy-MM-dd")">
                                @a.PublishedAt.ToString("dd.MM.yyyy")
                            </time>

                            <h2 class="article-card__title card-title-de">@a.TitleDe</h2>
                            <h2 class="article-card__title card-title-en" style="display:none">@a.TitleEn</h2>

                            <p class="article-card__excerpt card-excerpt-de">@a.ExcerptDe</p>
                            <p class="article-card__excerpt card-excerpt-en" style="display:none">@a.ExcerptEn</p>

                            <div class="article-card__footer">
                                <button type="button" class="article-card__readmore" data-id="@a.Id">
                                    <span class="read-more-label">Weiterlesen</span>
                                    <svg class="article-card__arrow" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
                                        <path d="M4 10H16M16 10L11 5M16 10L11 15" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"/>
                                    </svg>
                                </button>
                            </div>
                        </div>
                    </div>
                </article>
            }
        </div>

        <div id="no-results" class="no-results" style="display:none">
            <svg viewBox="0 0 48 48" fill="none" xmlns="http://www.w3.org/2000/svg">
                <circle cx="24" cy="24" r="20" stroke="currentColor" stroke-width="2"/>
                <path d="M16 28s2-4 8-4 8 4 8 4" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
                <circle cx="18" cy="20" r="2" fill="currentColor"/>
                <circle cx="30" cy="20" r="2" fill="currentColor"/>
            </svg>
            <p id="no-results-text">Keine Artikel in dieser Kategorie.</p>
        </div>
    </div>
</section>

@* ─── Article Modal ─── *@
<div id="article-modal-overlay" role="dialog" aria-modal="true" aria-labelledby="modal-title">
    <div class="modal-container">

        <button type="button" id="modal-close" class="modal-close" aria-label="Close">
            <svg viewBox="0 0 24 24" fill="none"><path d="M18 6L6 18M6 6l12 12" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        </button>

        <div class="modal-layout">

            @* Left – image gallery *@
            <div class="modal-gallery-col">
                <div class="modal-img-wrap">
                    <img id="modal-main-img" src="" alt="" />
                    <div class="modal-img-nav">
                        <button type="button" id="modal-img-prev" class="modal-nav-btn" aria-label="Previous">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                        <span id="modal-img-counter" class="modal-img-counter">1 / 1</span>
                        <button type="button" id="modal-img-next" class="modal-nav-btn" aria-label="Next">
                            <svg viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        </button>
                    </div>
                </div>
                <div id="modal-thumbs" class="modal-thumbs"></div>
            </div>

            @* Right – article content *@
            <div class="modal-content-col">
                <div class="modal-meta">
                    <span id="modal-badge" class="modal-badge"></span>
                    <time id="modal-date" class="modal-date"></time>
                </div>
                <h2 id="modal-title" class="modal-title"></h2>
                <div id="modal-body" class="modal-body"></div>
            </div>

        </div>
    </div>
</div>

<style>
    :root {
        --brand-green   : #4ADE80;
        --brand-green-dk: #16A34A;
        --hero-h        : 460px;
        --card-radius   : 16px;
        --transition    : 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    /* ── Hero ── */
    .blog-hero { height: var(--hero-h); background: #0f0f0f; }
    .blog-hero__bg img { filter: saturate(0.6) brightness(0.45); }
    .blog-hero__overlay { background: linear-gradient(to top, rgba(0,0,0,.85) 0%, rgba(0,0,0,.30) 55%, rgba(0,0,0,.10) 100%); }
    .blog-hero__accent { position: absolute; bottom: 0; left: 0; right: 0; height: 3px; background: linear-gradient(90deg, var(--brand-green) 0%, transparent 60%); z-index: 10; }
    .blog-hero__eyebrow { font-size: .72rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase; color: var(--brand-green); margin-bottom: .5rem; }
    .blog-hero__title   { font-size: clamp(3rem, 8vw, 6rem); font-weight: 800; color: #fff; line-height: 1; letter-spacing: -.02em; margin: 0 0 .75rem; }
    .blog-hero__sub     { font-size: 1rem; color: rgba(255,255,255,.65); max-width: 480px; line-height: 1.6; }

    /* ── Filter ── */
    .blog-filter-wrap { background: rgba(255,255,255,.92); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border-bottom: 1px solid rgba(0,0,0,.07); box-shadow: 0 2px 16px rgba(0,0,0,.06); }
    .blog-filter-inner { display: flex; align-items: center; padding: .75rem 0; }
    .blog-filter-scroll { display: flex; gap: .5rem; overflow-x: auto; padding: .25rem 0; scrollbar-width: none; }
    .blog-filter-scroll::-webkit-scrollbar { display: none; }
    .filter-btn { padding: .45rem 1.15rem; border-radius: 9999px; font-size: .85rem; font-weight: 500; white-space: nowrap; cursor: pointer; transition: var(--transition); border: 1.5px solid rgba(0,0,0,.12); background: transparent; color: #3f3f46; }
    .filter-btn:hover { border-color: var(--brand-green-dk); color: var(--brand-green-dk); background: rgba(74,222,128,.08); }
    .filter-btn--active { background: var(--brand-green); border-color: var(--brand-green); color: #fff !important; font-weight: 600; box-shadow: 0 4px 14px rgba(74,222,128,.35); }

    /* ── Grid ── */
    .blog-grid-section { padding: 3.5rem 0 5rem; background: #f4f4f5; min-height: 60vh; }
    .blog-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.75rem; }
    @@media (max-width: 1024px) { .blog-grid { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 640px)  { .blog-grid { grid-template-columns: 1fr; } .blog-hero__title { font-size: 3rem; } }

    /* ── Card ── */
    .article-card { display: flex; }
    .article-card__inner { display: flex; flex-direction: column; background: #fff; border-radius: var(--card-radius); overflow: hidden; width: 100%; cursor: pointer; transition: transform var(--transition), box-shadow var(--transition); box-shadow: 0 2px 8px rgba(0,0,0,.06); }
    .article-card__inner:hover { transform: translateY(-5px); box-shadow: 0 12px 32px rgba(0,0,0,.12); }
    .article-card__img-wrap { position: relative; aspect-ratio: 16/10; overflow: hidden; background: #e4e4e7; }
    .article-card__img { width: 100%; height: 100%; object-fit: cover; transition: transform .55s cubic-bezier(.4,0,.2,1); }
