@model List<UserType>
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";

}
<div class="bg-white rounded-lg px-8 py-6 overflow-x-scroll custom-scrollbar mb-12">
    <div class="flex items-center justify-between mb-4">
        <h4 class="text-xl font-semibold">User Types</h4>
        <a href="@Url.Action("Create")"
           class="bg-primary text-white text-sm px-4 py-1 rounded hover:bg-primary-dark transition duration-150">
            Add New
        </a>
    </div>
    <table class="w-full my-8 whitespace-nowrap">
        <thead class="bg-primary text-gray-100 font-bold">
            <tr>
                <th class="py-2 pl-2">#</th>
                <th class="py-2 pl-2">Id</th>
                <th class="py-2 pl-2">Name</th>
                <th class="py-2 pl-2">Has Dashboard</th>
                <th class="py-2 pl-2">Registerable</th>
                <th class="py-2 pl-2">Area</th>
                <th class="py-2 pl-2">Controller</th>
                <th class="py-2 pl-2">Action</th>
                <th class="py-2 pl-2"></th>
                <th class="py-2 pl-2"></th>
            </tr>
        </thead>
        <tbody class="text-sm">
            @{
                int i = 0;
            }
            @foreach (var item in Model)
            {
                <tr class="bg-gray-100 hover:bg-primary hover:bg-opacity-20 transition duration-200">
                    <td class="py-3 text-center pl-2">@(++i)</td>
                    <td class="py-3 text-center pl-2">@item.Id</td>
                    <td class="py-3 text-center pl-2">@item.Name</td>
                    <td class="py-3 text-center pl-2">
                        <span class="px-2 py-0.5 rounded text-white @(item.HasDashboard ? "bg-green-500" : "bg-red-500")">
                            @(item.HasDashboard ? "Yes" : "No")
                        </span>
                    </td>
                    <td class="py-3 text-center pl-2">
                        <span class="px-2 py-0.5 rounded text-white @(item.Registerable ? "bg-green-500" : "bg-gray-500")">
                            @(item.Registerable ? "Yes" : "No")
                        </span>
                    </td>
                    <td class="py-3 text-center pl-2">@(item.DefaultArea ?? "-")</td>
                    <td class="py-3 text-center pl-2">@(item.DefaultController ?? "-")</td>
                    <td class="py-3 text-center pl-2">@(item.DefaultAction ?? "-")</td>
                    <td class="py-3 text-center pl-2 ">
                        <a href="@Url.Action(action:"UserForm", controller:"Users", values:new{  UserType = item.Name  })"
                           class="bg-secondary text-white text-sm px-4 py-1 rounded hover:bg-primary-dark transition duration-150">
                            Add User
                        </a>
                    </td>
                    <td class="py-3 text-center pl-2 flex items-center space-x-2">
                        <a href="@Url.Action("Edit", new { id = item.Id })" title="Edit">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-500 hover:text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                            </svg>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline">
                            <button type="submit" title="Delete" onclick="return confirm('Are you sure you want to delete this item?');">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 hover:text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </form>


                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
