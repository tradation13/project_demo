@model IPTS.Models.Entites.UserType

@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">
    <div class="mb-6 flex items-center gap-3">
        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <i class="fas fa-user-tag"></i>
        </span>
        <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["UserTypes_EditTitle"]</h4>
    </div>

    <form asp-action="Edit" method="post" data-confirm>
        <input type="hidden" asp-for="Id" />

        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <div class="flex flex-col">
                <label asp-for="Name" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                        <i class="fas fa-tag text-xs"></i>
                    </span>
                    <input asp-for="Name" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" placeholder=@SharedLocalizer["Shared_EnterName"] />
                </div>
                <span asp-validation-for="Name" class="mt-1.5 text-xs text-red-500"></span>
            </div>
            <div class="flex flex-col">
                <label asp-for="HasDashboard" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["UserTypes_HasDashboard"]</label>
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                        <i class="fas fa-table-columns text-xs"></i>
                    </span>
                    <select asp-for="HasDashboard" class="block w-full appearance-none rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-8 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10">
                        <option value="true">@SharedLocalizer["Shared_Yes"]</option>
                        <option value="false">@SharedLocalizer["Shared_No"]</option>
                    </select>
                    <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-slate-300">
                        <i class="fas fa-chevron-down text-xs"></i>
                    </span>
                </div>
            </div>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-3">
            <div class="flex flex-col">
                <label asp-for="Registerable" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["UserTypes_Registerable"]</label>
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                        <i class="fas fa-user-plus text-xs"></i>
                    </span>
                    <select asp-for="Registerable" class="block w-full appearance-none rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-8 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10">
                        <option value="true">@SharedLocalizer["Shared_Yes"]</option>
                        <option value="false">@SharedLocalizer["Shared_No"]</option>
                    </select>
                    <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-slate-300">
                        <i class="fas fa-chevron-down text-xs"></i>
                    </span>
                </div>
            </div>
            <div class="flex flex-col">
                <label asp-for="DefaultController" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["UserTypes_DefaultController"]</label>
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                        <i class="fas fa-sitemap text-xs"></i>
                    </span>
                    <input asp-for="DefaultController" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                </div>
            </div>
            <div class="flex flex-col">
                <label asp-for="DefaultAction" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["UserTypes_DefaultAction"]</label>
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                        <i class="fas fa-bolt text-xs"></i>
                    </span>
                    <input asp-for="DefaultAction" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                </div>
            </div>
        </div>

        <div class="mt-4 grid grid-cols-1 gap-4 sm:grid-cols-2">
            <div class="flex flex-col">
                <label asp-for="DefaultArea" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["UserTypes_DefaultArea"]</label>
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                        <i class="fas fa-layer-group text-xs"></i>
                    </span>
                    <input asp-for="DefaultArea" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                </div>
            </div>
        </div>

        <div class="mt-4 flex flex-col">
            <label asp-for="DefaultRoleId" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["UserTypes_DefaultRole"]</label>
            <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                    <i class="fas fa-user-shield text-xs"></i>
                </span>
                <select asp-for="DefaultRoleId" asp-items="@((IEnumerable<SelectListItem>)ViewData["Roles"])"
                        class="block w-full appearance-none rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-8 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10">
                    <option value="">@SharedLocalizer["Shared_SelectRole"]</option>
                </select>
                <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 text-slate-300">
                    <i class="fas fa-chevron-down text-xs"></i>
                </span>
            </div>
            <span asp-validation-for="DefaultRoleId" class="mt-1.5 text-xs text-red-500"></span>
        </div>

        <div class="mt-4 flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3.5">
            <label asp-for="RequireAdminApproval" class="flex items-center gap-2 text-sm font-semibold text-slate-700">
                <i class="fas fa-shield-halved text-slate-400"></i>
                @SharedLocalizer["UserTypes_AdminApproval"]
            </label>
            <label class="relative inline-flex cursor-pointer items-center">
                <input asp-for="RequireAdminApproval" type="checkbox" class="peer sr-only" />
                <div class="h-6 w-11 rounded-full bg-slate-300 transition-colors duration-300 peer-checked:bg-primary peer-focus:ring-4 peer-focus:ring-primary/20"></div>
                <div class="absolute start-1 h-4 w-4 rounded-full bg-white shadow-sm transition-transform duration-300 peer-checked:translate-x-5"></div>
            </label>
        </div>
        <span asp-validation-for="RequireAdminApproval" class="mt-1 block text-xs text-red-500"></span>

        <div class="mt-8 flex gap-3">
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-primary/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
                <i class="fas fa-check text-xs"></i> @SharedLocalizer["Shared_Update"]
            </button>
            <a href="@Url.Action("Index")"
               class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition-all duration-200 hover:bg-slate-50">
                <i class="fas fa-xmark text-xs"></i> @SharedLocalizer["Shared_Cancel"]
            </a>
        </div>
    </form>

    @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
</div>
