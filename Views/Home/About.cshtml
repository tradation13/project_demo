@{
    ViewData["Title"] = "About";
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
}

<section class="py-16 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center mb-16">
            <div class="space-y-6">
                <div class="flex items-center gap-3">
                    <div>
                        <p class="text-sm uppercase tracking-wide text-primary-600 font-semibold">About PhysoTech</p>
                        <h1 class="text-4xl font-bold text-gray-900">Precision physiotherapy, powered by tech</h1>
                    </div>
                </div>
                <p class="text-lg text-gray-700 leading-relaxed">
                    PhysoTech is a physiotherapy clinic dedicated to faster recovery and smarter care. We blend expert practitioners with digital workflows so every assessment, session, and follow-up is coordinated and measurable.
                </p>
                <p class="text-lg text-gray-700 leading-relaxed">
                    The clinic runs on IPTS (Intelligent Patient Tracking System)  as our digital engine—handling booking, cases, and progress tracking—so our team stays focused on delivering hands-on treatment and personalized plans.
                </p>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div class="p-4 rounded-xl bg-primary-50 border border-primary-100">
                        <p class="font-semibold text-gray-900">Clinical excellence</p>
                        <p class="text-sm text-gray-700 mt-1">Manual therapy , exercise therapy, and spine care backed by protocols.</p>
                    </div>
                    <div class="p-4 rounded-xl bg-primary-50 border border-primary-100">
                        <p class="font-semibold text-gray-900">Patient experience</p>
                        <p class="text-sm text-gray-700 mt-1">Online booking, progress updates, and guided home programs keep patients engaged.</p>
                    </div>
                </div>
                <div class="grid sm:grid-cols-2 gap-4">
                    <div class="p-4 rounded-xl bg-white border border-gray-200">
                        <p class="font-semibold text-gray-900">Data-driven care</p>
                        <p class="text-sm text-gray-700 mt-1">IPTS dashboards surface adherence, ROM gains, and recovery velocity.</p>
                    </div>
                    <div class="p-4 rounded-xl bg-white border border-gray-200">
                        <p class="font-semibold text-gray-900">Team-ready</p>
                        <p class="text-sm text-gray-700 mt-1">Therapists, admins, and patients stay aligned with role-based access.</p>
                    </div>
                </div>
            </div>
            <div class="relative"> 
                <div class="rounded-2xl overflow-hidden shadow-xl border border-gray-100 bg-white">
                    <img src="/images/home/hero.svg" alt="Clinic technology" class="w-full h-auto object-contain">
                </div>
                <div class="hidden lg:block absolute -bottom-4 -left-4 w-28 h-28 rounded-2xl bg-primary-100 blur-3xl opacity-60"></div>
                <div class="hidden lg:block absolute -top-4 -right-4 w-24 h-24 rounded-2xl bg-primary-200 blur-3xl opacity-60"></div>
            </div>
        </div>
    </div>
</section>