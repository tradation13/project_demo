@* Why Choose PhysoTech *@
<section class="bg-white py-12">
    <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8 text-center">
            <div class="flex items-center justify-center gap-3">
                <i class="fas fa-star text-2xl text-primary-600"></i>
                <h3 class="text-3xl font-bold text-gray-900">@SharedLocalizer["Why_Title"]</h3>
            </div>
        </div>
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            <div class="why-reveal flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-5 text-center shadow-md transition-shadow hover:shadow-lg" data-delay="0" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                <div class="mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-primary-100 text-4xl text-primary-600">
                    <i class="fas fa-file-alt"></i>
                </div>
                <p class="text-base font-semibold text-gray-900">@SharedLocalizer["Why_Card1_Title"]</p>
                <p class="mt-1 text-sm text-gray-600">@SharedLocalizer["Why_Card1_Desc"]</p>
            </div>

            <div class="why-reveal flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-5 text-center shadow-md transition-shadow hover:shadow-lg" data-delay="120" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                <div class="mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-primary-100 text-4xl text-primary-600">
                    <i class="fas fa-robot"></i>
                </div>
                <p class="text-base font-semibold text-gray-900">@SharedLocalizer["Why_Card2_Title"]</p>
                <p class="mt-1 text-sm text-gray-600">@SharedLocalizer["Why_Card2_Desc"]</p>
            </div>

            <div class="why-reveal flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-5 text-center shadow-md transition-shadow hover:shadow-lg" data-delay="240" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                <div class="mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-primary-100 text-4xl text-primary-600">
                    <i class="fas fa-sync-alt"></i>
                </div>
                <p class="text-base font-semibold text-gray-900">@SharedLocalizer["Why_Card3_Title"]</p>
                <p class="mt-1 text-sm text-gray-600">@SharedLocalizer["Why_Card3_Desc"]</p>
            </div>

            <div class="why-reveal flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-5 text-center shadow-md transition-shadow hover:shadow-lg" data-delay="360" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                <div class="mb-4 flex h-24 w-24 items-center justify-center rounded-full bg-primary-100 text-4xl text-primary-600">
                    <i class="fas fa-user-md"></i>
                </div>
                <p class="text-base font-semibold text-gray-900">@SharedLocalizer["Why_Card4_Title"]</p>
                <p class="mt-1 text-sm text-gray-600">@SharedLocalizer["Why_Card4_Desc"]</p>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        const cards = document.querySelectorAll('.why-reveal');
        if (!cards.length) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) {
            cards.forEach((card) => {
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            });
            return;
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                const card = entry.target;
                if (entry.isIntersecting) {
                    const delay = card.getAttribute('data-delay') || '0';
                    card.style.transitionDelay = `${delay}ms`;
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                } else {
                    card.style.transitionDelay = '0ms';
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(28px)';
                }
            });
        }, { threshold: 0.25, rootMargin: '0px 0px -30px 0px' });

        cards.forEach((card) => observer.observe(card));
    })();
</script>
