@model UserProfileViewModel
@{
    Layout = Convert.ToBoolean(ViewBag.HasDashboard)
        ? "~/Views/Shared/Layouts/_DashboardLayout.cshtml"
        : "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
    bool isEditMode = ViewBag.IsEditMode ?? false;
    bool canEdit = ViewBag.CanEdit ?? false;
}

<div class="mb-6 px-4 sm:px-6 lg:px-8">
    <a href="javascript:history.back()" class="text-green-600 hover:text-green-700 hover:underline">
        ← Back
    </a>
</div>

<div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <section class="bg-white shadow p-6 rounded mb-10">
        <h2 class="text-2xl font-semibold mb-6">User Profile</h2>

    @if (canEdit && !isEditMode)
    {
        <div class="mb-6 text-right">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="inline-block bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded shadow transition duration-150">
                <i class="fa-solid fa-pen mr-1"></i> Edit Profile
            </a>
        </div>
    }

    <form asp-action="Edit" asp-controller="Profile" method="post">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
             @if (!isEditMode)
                {
            <div>
                <label class="block text-sm font-medium mb-1">Username</label>
                <input value="@ViewBag.UserName" disabled class="w-full border border-gray-300 rounded px-3 py-2 bg-gray-100 text-gray-700" />
            </div>
                }
            <div>
                <label asp-for="Email" class="block text-sm font-medium mb-1">Email</label>
                @if (isEditMode)
                {
                    <input asp-for="Email" type="email" class="w-full border border-gray-300 rounded px-3 py-2" />
                }
                else
                {
                    <input asp-for="Email" type="email" disabled class="w-full border border-gray-300 rounded px-3 py-2 bg-gray-100 text-gray-700" />
                }
            
            </div>
            <div>
                <label asp-for="FirstName" class="block text-sm font-medium mb-1">First Name</label>
                @if (isEditMode)
                {
                    <input asp-for="FirstName" type="text" class="w-full border border-gray-300 rounded px-3 py-2" />
                }
                else
                {
                    <input asp-for="FirstName" type="text" disabled class="w-full border border-gray-300 rounded px-3 py-2 bg-gray-100 text-gray-700" />
                } 
            
            </div>
            <div>
                <label asp-for="LastName" class="block text-sm font-medium mb-1">Last Name</label>
                @if (isEditMode)
                {
                    <input asp-for="LastName" type="text" class="w-full border border-gray-300 rounded px-3 py-2" />
                }
                else
                {
                    <input asp-for="LastName" type="text" disabled class="w-full border border-gray-300 rounded px-3 py-2 bg-gray-100 text-gray-700" />
                }
            
            </div>

            <div>
                <label asp-for="PhoneNumber" class="block text-sm font-medium mb-1">Phone Number</label>
                @if (isEditMode)
                {
                    <input asp-for="PhoneNumber" class="w-full border border-gray-300 rounded px-3 py-2" />
                }
                else
                {
                    <input type="text" value="@(Model.PhoneNumber ?? "Not Available")" disabled class="w-full border border-gray-300 rounded px-3 py-2 bg-gray-100 text-gray-700" />
                }
            </div>

        </div>

        @if (Model.Admin != null)
        {
            <div class="mt-8">
                <h3 class="text-xl font-semibold mb-4">Admin Details</h3>
                <div class="mb-4">
                    <label asp-for="Admin.Id" class="block text-sm font-medium mb-1">Admin ID</label>
                    <input type="text" asp-for="Admin.Id" readonly class="w-full border border-gray-300 rounded px-3 py-2 bg-gray-100 text-gray-700" />
                </div>
            </div>
        }

        @if (Model.Patient != null)
        {
            <div class="mt-8">
                <h3 class="text-xl font-semibold mb-4">Patient Details</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium mb-1">Identity Number</label>
                        <input type="text" value="@(Model.Patient.IdentityNumber ?? "Not Available")" readonly 
                               class="w-full border border-gray-300 rounded px-3 py-2 bg-gray-100 text-gray-700" />
                    </div>
                    <div>
                        <label class="block text-sm font-medium mb-1">Birth Date</label>
                        <input type="text" value="@Model.Patient.BirthDate.ToShortDateString()" readonly 
                               class="w-full border border-gray-300 rounded px-3 py-2 bg-gray-100 text-gray-700" />
                    </div>
                </div>
            </div>
        }
        @if (Model.Doctor != null)
        {
            @if(isEditMode){
                <div class="flex-1 min-w-[200px]">
                    <label asp-for="Doctor.SpecialtyId" class="block text-sm font-medium text-gray-700"></label>
                    <select asp-for="Doctor.SpecialtyId" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        <option value="">Select Specialt</option>
                        @if (ViewBag.Specialties is List<Specialty> specialties)
                        {
                            foreach (var specialty in specialties)
                            {
                                <option value="@specialty.Id">@specialty.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="Doctor.SpecialtyId" class="text-red-500 text-sm"></span>
                </div>
            }else{
                @if (ViewBag.Specialties is List<Specialty> specialties){
                 <div class="mb-4">
                    <label class="block text-sm font-medium mb-1">Specialty</label>
                        <input type="text" value=@specialties.Find(i=>i.Id == Model.Doctor.SpecialtyId).Name readonly class="w-full border border-gray-300 rounded px-3 py-2 bg-gray-100 text-gray-700" />
                 </div>
                 }

               
            }
        }

        @if (isEditMode)
        {
            <div class="mt-6 flex gap-4">
                <button type="submit" class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded">
                    Save Changes
                </button>
                <a asp-action="Index" asp-route-id="@Model.Id"
                   class="bg-gray-300 hover:bg-gray-400 text-gray-800 px-6 py-2 rounded">
                    Cancel
                </a>
            </div>
        }
    </form>
    </section>
</div>
