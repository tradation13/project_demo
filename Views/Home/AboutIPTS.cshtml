@{
    ViewData["Title"] = "About IPTS";
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
}

<section class="py-16 bg-white">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
        <div class="flex items-center gap-4 mb-2">
            <div>
                <p class="text-sm uppercase tracking-wide text-primary-600 font-semibold">About IPTS</p>
                <h1 class="text-4xl font-bold text-gray-900">The digital core for modern clinics</h1>
            </div>
        </div>

        <div class="grid lg:grid-cols-2 gap-8 items-start">
            <div class="space-y-4">
                <p class="text-lg text-gray-700 leading-relaxed">
                    IPTS is a clinic-grade, integrated platform that streamlines appointments, smart patient tracking,
                    and therapy documentation. It plugs into clinic workflows so teams can focus on care while the system
                    keeps data organized and actionable.
                </p>
                <p class="text-lg text-gray-700 leading-relaxed">
                    From booking to discharge, IPTS centralizes schedules, cases, and follow-ups. Real-time reports and
                    dashboards surface adherence, recovery velocity, and trends, giving clinicians and managers a clear view
                    of outcomes.
                </p>
                <div class="grid sm:grid-cols-2 gap-4 pt-2">
                    <div class="p-4 rounded-xl bg-primary-50 border border-primary-100">
                        <p class="font-semibold text-gray-900">Integrated scheduling</p>
                        <p class="text-sm text-gray-700 mt-1">Online booking, reminders, and capacity planning for every therapist.</p>
                    </div>
                    <div class="p-4 rounded-xl bg-primary-50 border border-primary-100">
                        <p class="font-semibold text-gray-900">Patient tracking</p>
                        <p class="text-sm text-gray-700 mt-1">Unified case files, session notes, and progress logs in one place.</p>
                    </div>
                    <div class="p-4 rounded-xl bg-white border border-gray-200">
                        <p class="font-semibold text-gray-900">Reporting & insights</p>
                        <p class="text-sm text-gray-700 mt-1">Outcome dashboards, ROM charts, pain trends, and adherence scores.</p>
                    </div>
                    <div class="p-4 rounded-xl bg-white border border-gray-200">
                        <p class="font-semibold text-gray-900">Clinic operations</p>
                        <p class="text-sm text-gray-700 mt-1">Billing support, staff coordination, and role-based access for teams.</p>
                    </div>
                </div>
            </div>

            <div class="rounded-2xl overflow-hidden shadow-xl border border-gray-100 bg-white">
                <img src="/images/logo.png" alt="IPTS platform" class="w-full h-auto object-contain">
            </div>
        </div>

        <div class="grid md:grid-cols-3 gap-6 pt-6">
            <div class="p-5 rounded-2xl bg-gray-50 border border-gray-100 shadow-sm">
                <div class="flex items-center gap-3 mb-2">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 text-primary-700"><i class="fas fa-calendar-check"></i></span>
                    <p class="font-semibold text-gray-900">Appointments & reminders</p>
                </div>
                <p class="text-sm text-gray-700 leading-relaxed">Book, reschedule, and notify patients automatically—keeping calendars balanced.</p>
            </div>
            <div class="p-5 rounded-2xl bg-gray-50 border border-gray-100 shadow-sm">
                <div class="flex items-center gap-3 mb-2">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 text-primary-700"><i class="fas fa-notes-medical"></i></span>
                    <p class="font-semibold text-gray-900">Clinical documentation</p>
                </div>
                <p class="text-sm text-gray-700 leading-relaxed">Session notes, protocols, and exercise plans stored centrally with secure access.</p>
            </div>
            <div class="p-5 rounded-2xl bg-gray-50 border border-gray-100 shadow-sm">
                <div class="flex items-center gap-3 mb-2">
                    <span class="inline-flex h-10 w-10 items-center justify-center rounded-full bg-primary-100 text-primary-700"><i class="fas fa-chart-pie"></i></span>
                    <p class="font-semibold text-gray-900">Reports & analytics</p>
                </div>
                <p class="text-sm text-gray-700 leading-relaxed">Exportable reports for outcomes, visits, and utilization to guide decisions.</p>
            </div>
        </div>
    </div>
</section>
