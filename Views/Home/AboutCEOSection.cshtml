@* About the Clinic Owner / CEO *@
<style>
    .ceo-section {
        --ceo-green: #059669;
        --ceo-green-dark: #047857;
        --ceo-teal: #0d9488;
        --ceo-tint: #ecfdf5;
    }

    .ceo-photo-wrap {
        opacity: 0;
        transform: translateX(-28px);
        transition: opacity 0.7s cubic-bezier(.22,1,.36,1), transform 0.7s cubic-bezier(.22,1,.36,1);
    }

    .ceo-content-wrap {
        opacity: 0;
        transform: translateX(28px);
        transition: opacity 0.7s cubic-bezier(.22,1,.36,1) 0.12s, transform 0.7s cubic-bezier(.22,1,.36,1) 0.12s;
    }

    .ceo-para {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.55s ease, transform 0.55s ease;
    }

    .ceo-info-bar {
        opacity: 0;
        transform: translateY(18px);
        transition: opacity 0.55s ease 0.15s, transform 0.55s ease 0.15s;
    }

    .ceo-photo-wrap.visible,
    .ceo-content-wrap.visible,
    .ceo-para.visible,
    .ceo-info-bar.visible {
        opacity: 1;
        transform: none;
    }

    .ceo-para-2 { transition-delay: 0.08s; }
    .ceo-para-3 { transition-delay: 0.16s; }
    .ceo-para-4 { transition-delay: 0.24s; }

    .ceo-main {
        display: block;
    }

    .ceo-main::after {
        content: "";
        display: table;
        clear: both;
    }

    .ceo-photo-wrap {
        display: block;
        width: 100%;
        max-width: 22rem;
        margin: 0 auto 1.75rem;
    }

    @@media (min-width: 1024px) {
        .ceo-photo-wrap {
            float: left;
            width: 38%;
            max-width: 24rem;
            margin: 0 2.5rem 1.25rem 0;
        }

        .ceo-content-wrap {
            overflow: visible;
        }
    }

    .ceo-photo-frame {
        position: relative;
        width: 100%;
        border-radius: 1.5rem;
        border: 1px solid rgba(255, 255, 255, 0.7);
        background: rgba(255, 255, 255, 0.65);
        padding: 0.75rem;
        box-shadow: 0 20px 60px rgba(16, 185, 129, 0.1);
        backdrop-filter: blur(4px);
        overflow: hidden;
    }

    .ceo-photo-frame::before {
        content: "";
        position: absolute;
        inset: -20% auto auto -20%;
        width: 14rem;
        height: 14rem;
        border-radius: 9999px;
        background: rgba(16, 185, 129, 0.12);
        filter: blur(40px);
        z-index: 0;
        pointer-events: none;
    }

    .ceo-photo {
        position: relative;
        z-index: 1;
        display: block;
        width: 100%;
        aspect-ratio: 4 / 5;
        object-fit: cover;
        object-position: center top;
        border-radius: 1rem;
        border: 1px solid #f3f4f6;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        transition: transform 0.45s ease, box-shadow 0.45s ease;
    }

    .ceo-photo-frame:hover .ceo-photo {
        transform: scale(1.02);
        box-shadow: 0 16px 40px rgba(5, 150, 105, 0.18);
    }

    .ceo-role {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.4rem;
        color: var(--ceo-green);
        font-size: 0.95rem;
        font-weight: 600;
        letter-spacing: 0.01em;
    }

    .ceo-role::before {
        content: "";
        display: inline-block;
        width: 1.35rem;
        height: 2px;
        border-radius: 999px;
        background: linear-gradient(90deg, var(--ceo-green), var(--ceo-teal));
    }

    .ceo-info-bar {
        margin-top: 1.35rem;
        padding-top: 1.15rem;
        border-top: 1px solid rgba(16, 185, 129, 0.18);
    }

    .ceo-info-grid {
        display: grid;
        gap: 1.5rem;
    }

    @@media (min-width: 768px) {
        .ceo-info-grid {
            grid-template-columns: repeat(3, 1fr);
            gap: 2rem;
        }
    }

    .ceo-info-row {
        display: flex;
        align-items: flex-start;
        gap: 0.85rem;
        min-width: 0;
    }

    .ceo-info-icon {
        flex-shrink: 0;
        width: 2.25rem;
        height: 2.25rem;
        color: var(--ceo-green);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.05rem;
        margin-top: 0.1rem;
    }

    .ceo-info-label {
        margin: 0;
        font-size: 0.75rem;
        font-weight: 600;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        color: #9ca3af;
    }

    .ceo-info-value {
        margin: 0.2rem 0 0;
        font-size: 0.98rem;
        font-weight: 700;
        color: #111827;
        line-height: 1.35;
    }

    .ceo-info-sub {
        margin: 0.2rem 0 0;
        font-size: 0.875rem;
        color: #6b7280;
        line-height: 1.4;
    }

    .ceo-scholar-link {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        margin-top: 0.35rem;
        color: var(--ceo-green-dark);
        font-size: 0.95rem;
        font-weight: 700;
        text-decoration: none;
        border-bottom: 1.5px solid transparent;
        transition: color 0.15s, border-color 0.15s;
    }

    .ceo-scholar-link:hover {
        color: #065f46;
        border-bottom-color: #065f46;
        text-decoration: none;
    }

    @@media (max-width: 1023.98px) {
        .ceo-photo-wrap,
        .ceo-content-wrap {
            transform: translateY(24px);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ceo-photo-wrap,
        .ceo-content-wrap,
        .ceo-para,
        .ceo-info-bar {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>

<section id="about-ceo" class="ceo-section bg-gray-50/60 py-12 lg:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="mb-12 text-center">
            <div class="mb-3 flex items-center justify-center gap-3">
                <i class="fas fa-user-md text-3xl text-primary-600"></i>
                <h2 class="text-4xl font-bold tracking-tight text-gray-900">@SharedLocalizer["AboutCEO_Title"]</h2>
            </div>
            <p class="mx-auto max-w-2xl text-lg leading-relaxed text-gray-600">
                @SharedLocalizer["AboutCEO_Subtitle"]
            </p>
        </div>

        <div class="ceo-main">
            <div class="ceo-photo-wrap">
                <div class="ceo-photo-frame">
                    <img src="/images/Dr_Ahmet.jpg"
                         alt="@SharedLocalizer["AboutCEO_Name"]"
                         class="ceo-photo"
                         loading="lazy" />
                </div>
            </div>

            <div class="ceo-content-wrap space-y-5">
                <div>
                    <div class="flex items-start gap-3">
                        <div class="mt-1 flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-600 ring-1 ring-emerald-100">
                            <i class="fas fa-quote-left"></i>
                        </div>
                        <div>
                            <h3 class="text-2xl font-extrabold tracking-tight text-gray-900 sm:text-3xl">
                                @SharedLocalizer["AboutCEO_Name"]
                            </h3>
                            <p class="ceo-role">@SharedLocalizer["AboutCEO_Role"]</p>
                        </div>
                    </div>
                </div>

                <div class="space-y-4 text-base leading-relaxed text-gray-600 sm:text-lg">
                    <p class="ceo-para">@SharedLocalizer["AboutCEO_Bio_P1"]</p>
                    <p class="ceo-para ceo-para-2">@SharedLocalizer["AboutCEO_Bio_P2"]</p>
                    <p class="ceo-para ceo-para-3">@SharedLocalizer["AboutCEO_Bio_P3"]</p>
                    <p class="ceo-para ceo-para-4">@SharedLocalizer["AboutCEO_Bio_P4"]</p>
                </div>
            </div>
        </div>

        <aside class="ceo-info-bar">
            <div class="ceo-info-grid">
                <div class="ceo-info-row">
                    <div class="ceo-info-icon"><i class="fas fa-id-card"></i></div>
                    <div class="min-w-0">
                        <p class="ceo-info-label">@SharedLocalizer["AboutCEO_Info_NameLabel"]</p>
                        <p class="ceo-info-value">@SharedLocalizer["AboutCEO_Name"]</p>
                        <p class="ceo-info-sub">@SharedLocalizer["AboutCEO_Clinic"]</p>
                    </div>
                </div>

                <div class="ceo-info-row">
                    <div class="ceo-info-icon"><i class="fas fa-map-marker-alt"></i></div>
                    <div class="min-w-0">
                        <p class="ceo-info-label">@SharedLocalizer["Shared_Address"]</p>
                        <p class="ceo-info-value">@SharedLocalizer["AboutCEO_Address_Line1"]</p>
                        <p class="ceo-info-sub">@SharedLocalizer["AboutCEO_Address_Line2"]</p>
                    </div>
                </div>

                <div class="ceo-info-row">
                    <div class="ceo-info-icon"><i class="fas fa-graduation-cap"></i></div>
                    <div class="min-w-0">
                        <p class="ceo-info-label">@SharedLocalizer["AboutCEO_Scholar_Label"]</p>
                        <a href="https://scholar.google.com/citations?user=V3Jdh2gAAAAJ&amp;hl=tr"
                           target="_blank"
                           rel="noopener noreferrer"
                           class="ceo-scholar-link">
                            @SharedLocalizer["AboutCEO_Scholar_Btn"]
                            <i class="fas fa-arrow-right text-xs"></i>
                        </a>
                    </div>
                </div>
            </div>
        </aside>

    </div>
</section>

<script>
    (function () {
        var root = document.getElementById('about-ceo');
        if (!root) return;

        var targets = root.querySelectorAll('.ceo-photo-wrap, .ceo-content-wrap, .ceo-para, .ceo-info-bar');
        var reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        if (reduceMotion || !('IntersectionObserver' in window)) {
            targets.forEach(function (el) { el.classList.add('visible'); });
            return;
        }

        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.12 });

        targets.forEach(function (el) { observer.observe(el); });
    })();
</script>
