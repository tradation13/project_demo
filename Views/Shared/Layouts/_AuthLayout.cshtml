@{
    Layout = "~/Views/Shared/Layouts/_MainLayout.cshtml";
}

<style>
    .auth-page {
        min-height: 100vh;
        background: #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2.5rem 1rem;
    }

    .auth-page-inner {
        width: 100%;
        max-width: 56rem;
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .auth-logo-wrap img {
        width: 13rem;
        height: auto;
    }

    @@media (min-width: 640px) {
        .auth-logo-wrap img { width: 15rem; }
    }

    .auth-card-wrap {
        width: 100%;
        display: flex;
        justify-content: center;
    }

    .auth-card-wrap > * {
        width: 100%;
    }
</style>

<div class="auth-page">
    <div class="auth-page-inner">
        <div class="auth-logo-wrap mb-8">
            <img src="/images/logo.svg" alt="Logo">
        </div>

        <div class="auth-card-wrap">
            @RenderBody()
        </div>
    </div>
</div>
