@model TestViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewBag.Title = @SharedLocalizer["Tests_Edit"];
    var availableGroups = ViewBag.AvailableGroups as List<TestGroupViewModel>;
}

<form asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />

    <div class="card mb-4">
        <div class="card-header">
            <h5>@SharedLocalizer["Tests_Edit"]</h5>
        </div>
        <div class="card-body">
            <div class="flex flex-wrap gap-4">
                <div class="min-w-[200px] flex-1">
                    <label asp-for="Name" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Name" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="Name" class="text-sm text-red-500"></span>
                </div>
                <div class="min-w-[200px] flex-1">
                    <label asp-for="TestGroupId" class="block text-sm font-medium text-gray-700">@SharedLocalizer["Tests_GroupLabel"]</label>
                    <select asp-for="TestGroupId" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                        <option value="">@SharedLocalizer["Tests_SelectGroup"]</option>
                        @if (availableGroups != null)
                        {
                            foreach (var group in availableGroups)
                            {
                                if (group.Id == Model.TestGroupId)
                                {
                                 <option value="@group.Id" selected>@group.Name</option>

                                }else{
                                    <option value="@group.Id" >@group.Name</option>

                                }
                            }
                        }
                    </select>
                    <span asp-validation-for="TestGroupId" class="text-sm text-red-500"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-6 flex gap-2">
        <a href="@Url.Action("Index")"
           class="rounded-lg bg-secondary bg-opacity-20 px-6 py-1.5 text-secondary transition duration-150 hover:bg-opacity-40 hover:shadow-xl">
            @SharedLocalizer["Shared_Cancel"]
        </a>
        <button type="submit"
                class="rounded-lg bg-primary px-6 py-1.5 text-white transition duration-150 hover:bg-primary-dark hover:shadow-xl">
            @SharedLocalizer["Profile_SaveBtn"]
        </button>
    </div>

    <div asp-validation-summary="All" class="mb-4 text-sm text-red-500"></div>
</form>
