@model List<LogViewModel>
@using IPTS.ViewModels

@{
    Layout = ViewBag.HasDashboard == true
        ? "~/Views/Shared/Layouts/_DashboardLayout.cshtml"
        : "~/Views/Shared/Layouts/_AuthLayout.cshtml";
}

<div x-data="{ filter: false }" class="rounded-2xl border border-slate-100 bg-white px-4 py-5 shadow-sm shadow-slate-100 sm:px-6 sm:py-6 lg:px-8 lg:py-7">

    <div class="mb-5 flex flex-col gap-4 sm:mb-6 sm:flex-row sm:flex-wrap sm:items-center sm:justify-between">
        <div class="flex min-w-0 items-center gap-3">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <i class="fas fa-clipboard-list"></i>
            </span>
            <h2 class="truncate text-lg font-bold text-slate-800 sm:text-xl">@SharedLocalizer["Logs_Title"]</h2>
        </div>
        <button type="button"
                x-on:click="filter = !filter"
                class="inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-primary/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg sm:w-auto">
            <i class="fas fa-filter text-xs"></i>
            @SharedLocalizer["Logs_Btn_ToggleFilter"]
            <i class="fas fa-chevron-down text-xs transition-transform duration-200" x-bind:class="filter ? 'rotate-180' : ''"></i>
        </button>
    </div>

    <div x-show="filter" x-collapse.duration.300ms class="overflow-hidden">
        <div class="mb-5 rounded-2xl border border-slate-100 bg-slate-50/70 p-4 sm:mb-6 sm:p-6">
            <h5 class="mb-4 flex items-center gap-2 text-sm font-bold text-slate-600">
                <i class="fas fa-filter text-primary"></i>
                @SharedLocalizer["Appt_FilterResults"]
            </h5>
            <form method="get" class="grid grid-cols-1 gap-3 sm:grid-cols-[1fr_auto] sm:items-end">
                <div>
                    <label class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400">@SharedLocalizer["Logs_Placeholder_Section"]</label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                            <i class="fas fa-magnifying-glass text-xs"></i>
                        </span>
                        <input type="text"
                               name="systemSection"
                               value="@(Context.Request.Query["systemSection"])"
                               class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10"
                               placeholder="@SharedLocalizer["Logs_Placeholder_Section"]">
                    </div>
                </div>
                <button type="submit"
                        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-primary px-8 py-2 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:bg-primary-dark hover:shadow-lg sm:w-auto">
                    <i class="fas fa-magnifying-glass text-xs"></i>
                    @SharedLocalizer["Logs_Btn_Filter"]
                </button>
            </form>
        </div>
    </div>

    @* Mobile cards *@
    <div class="space-y-3 md:hidden">
        @{
            int mobileIndex = 0;
            foreach (var log in Model)
            {
                var levelColor = log.Level switch
                {
                    "5" => "bg-red-50 text-red-500",
                    "4" => "bg-red-50 text-red-500",
                    "3" => "bg-yellow-50 text-yellow-500",
                    "2" => "bg-blue-50 text-blue-500",
                    "1" => "bg-slate-100 text-slate-600",
                    _ => "bg-slate-50 text-slate-400"
                };
                mobileIndex++;

                <div class="animate-fade-slide-up rounded-2xl border border-slate-100 bg-white p-4 shadow-sm shadow-slate-100" style="animation-delay:@(mobileIndex * 25)ms">
                    <div class="mb-3 flex flex-wrap items-center justify-between gap-2">
                        <span class="text-xs font-medium text-slate-400">#@mobileIndex</span>
                        <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold @levelColor">@log.Level</span>
                    </div>
                    <p class="mb-3 break-words text-sm leading-relaxed text-slate-700">@log.Description</p>
                    <div class="flex flex-wrap items-center gap-2 border-t border-slate-100 pt-3 text-xs text-slate-500">
                        <span class="inline-flex items-center gap-1.5 font-medium text-slate-600">
                            <i class="fas fa-user text-[10px] text-slate-300"></i>
                            @(!string.IsNullOrEmpty(log.UserName) ? log.UserName : log.UserId)
                        </span>
                        <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-0.5 font-semibold text-slate-600">@log.SystemSection</span>
                        <span class="ms-auto inline-flex items-center gap-1.5">
                            <i class="fas fa-clock text-[10px] text-slate-300"></i>
                            @log.Timestamp.ToString("g")
                        </span>
                    </div>
                </div>
            }
        }
    </div>

    @* Desktop table *@
    <div class="custom-scrollbar hidden w-full overflow-x-auto rounded-2xl border border-slate-100 md:block">
        <table class="mb-0 w-full min-w-[640px] whitespace-nowrap text-sm">
            <thead class="sticky top-0 z-10 bg-gradient-to-r from-primary to-indigo-600 text-white">
                <tr>
                    <th class="px-4 py-3 text-center font-semibold">#</th>
                    <th class="px-4 py-3 text-center font-semibold">@SharedLocalizer["Logs_Table_Level"]</th>
                    <th class="px-4 py-3 text-start font-semibold">@SharedLocalizer["Logs_Table_Description"]</th>
                    <th class="px-4 py-3 text-start font-semibold">@SharedLocalizer["Logs_Table_User"]</th>
                    <th class="px-4 py-3 text-start font-semibold">@SharedLocalizer["Logs_Table_Section"]</th>
                    <th class="px-4 py-3 text-center font-semibold">@SharedLocalizer["Logs_Table_Time"]</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @{
                    int x = 0;
                    foreach (var log in Model)
                    {
                        var levelColor = log.Level switch
                        {
                            "5" => "bg-red-50 text-red-500",
                            "4" => "bg-red-50 text-red-500",
                            "3" => "bg-yellow-50 text-yellow-500",
                            "2" => "bg-blue-50 text-blue-500",
                            "1" => "bg-slate-100 text-slate-600",
                            _ => "bg-slate-50 text-slate-400"
                        };
                        x++;

                        <tr class="animate-fade-slide-up transition-colors hover:bg-slate-50" style="animation-delay:@(x * 25)ms">
                            <td class="px-4 py-3 text-center text-slate-400">@x</td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold @levelColor">@log.Level</span>
                            </td>
                            <td class="max-w-md whitespace-normal break-words px-4 py-3 text-slate-700">@log.Description</td>
                            <td class="px-4 py-3 font-medium text-slate-600">@(!string.IsNullOrEmpty(log.UserName) ? log.UserName : log.UserId)</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">@log.SystemSection</span>
                            </td>
                            <td class="px-4 py-3 text-center text-slate-500">@log.Timestamp.ToString("g")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
