@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="rounded-lg bg-white px-8 py-6">
    <div class="mb-4 flex items-center justify-between">
        <h4 class="text-xl font-bold">@SharedLocalizer["Search_SearchPatient"] </h4>
        <div class="flex space-x-2">
            @* <a href="@Url.Action("CreatePatient", "Appointments", new { area = "doctor" })" *@
            @*    class="rounded bg-green-600 px-4 py-2 text-sm text-white transition duration-150 hover:bg-green-700"> *@
            @*     <i class="fas fa-user-plus mr-2"></i>Create New Patient *@
            @* </a> *@
            <a href="@Url.Action("Index", "Appointments", new { area = "doctor" })"
               class="rounded bg-gray-500 px-4 py-2 text-sm text-white transition duration-150 hover:bg-gray-600">
                <i class="fas fa-arrow-left mr-2"></i>@SharedLocalizer["Search_BackToAppointments"]
            </a>
        </div>
    </div>

    <div class="mb-6 rounded-lg border border-blue-200 bg-blue-50 p-4">
        <h5 class="mb-2 font-bold text-blue-800">@SharedLocalizer["Search_QuickStart"] :</h5>
        <p class="mb-3 text-sm text-blue-700">
           @SharedLocalizer["Search_InstructionMain"] 
        </p>
        @* <div class="text-xs text-blue-600">
           @SharedLocalizer["Search_Tip"] 
        </div> *@
        <div class="mt-3 rounded border border-green-200 bg-green-50 p-3 text-xs text-green-700">
           @SharedLocalizer["Search_Workflow"] 
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 rounded border border-green-400 bg-green-100 p-4 text-green-700">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="mb-4 rounded border border-yellow-400 bg-yellow-100 p-4 text-yellow-700">
            @TempData["WarningMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-4 rounded border border-red-400 bg-red-100 p-4 text-red-700">
            @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="mb-4 rounded border border-blue-400 bg-blue-100 p-4 text-blue-700">
            @TempData["InfoMessage"]
        </div>
    }



    <form asp-action="SearchPatient" method="post" class="mt-8">
        <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    <div class="relative">
        <label class="mb-2 block text-sm font-normal text-gray-700">@SharedLocalizer["Appt_PatientName"]</label>
        <div class="relative">
            <input id="patientSearchInput" name="SearchName" type="text" autocomplete="off"
                   class="w-full rounded-md border border-gray-300 px-3 py-2 focus:ring-2 focus:ring-primary"
                   placeholder="@SharedLocalizer["Contact_Label_Name"]" />
            <div id="searchSpinner" class="absolute right-3 top-3 hidden">
                <i class="fas fa-spinner fa-spin text-primary"></i>
            </div>
        </div>
        
        <div id="suggestionsList" class="absolute z-50 mt-1 hidden max-h-64 w-full overflow-y-auto rounded-md border border-gray-200 bg-white shadow-xl">
            <div id="resultsContainer"></div>
        </div>
    </div>

    <div>
        <label class="mb-2 block text-sm font-normal text-gray-700">@SharedLocalizer["Shared_PhoneNumber"]</label>
        <input id="patientPhone" name="PhoneNumber" type="text" 
               class="w-full rounded-md border border-gray-300 bg-gray-50 px-3 py-2" placeholder="05xxxxxxxx" />
    </div>

    <div>
        <label class="mb-2 block text-sm font-normal text-gray-700">@SharedLocalizer["Shared_EmailAddress"]</label>
        <input id="patientEmail" name="Email" type="email" 
               class="w-full rounded-md border border-gray-300 bg-gray-50 px-3 py-2" placeholder="example@mail.com" />
    </div>
</div>

        <div class="mt-8 flex justify-center">
            <button type="submit" class="rounded-md bg-primary px-8 py-3 text-lg text-white transition duration-150 hover:bg-primary-dark">
                <i class="fas fa-search mr-2"></i>@SharedLocalizer["Search_SearchPatient"] 
            </button>
        </div>
    </form>

    <div class="mt-8 rounded-lg bg-gray-50 p-4">
        <h5 class="mb-3 font-bold text-gray-700">@SharedLocalizer["Search_InstructionsTitle"] </h5>
        <ul class="space-y-2 text-sm text-gray-600">
            <li>• <strong>@SharedLocalizer["Appt_PatientName"]</strong> @SharedLocalizer["Search_Step1"]</li>
            <li>• <strong>@SharedLocalizer["Shared_PhoneNumber"]:</strong> @SharedLocalizer["Search_Step2"]</li>
            <li>• <strong>@SharedLocalizer["Shared_Email"]:</strong> @SharedLocalizer["Search_Step3"]</li>
            <li>• @SharedLocalizer["Search_Step4"]</li>
            <li>• @SharedLocalizer["Search_Step5"]</li>
            <li>• @SharedLocalizer["Search_Step6"]</li>
        </ul>
    </div>


</div>


<script>
    const searchInput = document.getElementById('patientSearchInput');
    const suggestionsList = document.getElementById('suggestionsList');
    const resultsContainer = document.getElementById('resultsContainer');
    const spinner = document.getElementById('searchSpinner');
    let searchTimeout = null;

    searchInput.addEventListener('input', function() {
        const term = this.value.trim();
        clearTimeout(searchTimeout);

        if (term.length < 1) {
            suggestionsList.classList.add('hidden');
            return;
        }

        spinner.classList.remove('hidden');

        // Debounce: انتظر حتى يتوقف المستخدم عن الكتابة لـ 400 ملي ثانية
        searchTimeout = setTimeout(() => {
            fetch(`/doctor/Appointments/GetPatientSuggestions?term=${encodeURIComponent(term)}`)
                .then(res => res.json())
                .then(data => {
                    spinner.classList.add('hidden');
                    resultsContainer.innerHTML = '';
                    
                    if (data.length > 0) {
                        suggestionsList.classList.remove('hidden');
                        data.forEach(p => {
                            const row = document.createElement('div');
                            row.className = "p-3 hover:bg-blue-50 cursor-pointer border-b border-gray-50 last:border-0 transition duration-150";
                            row.innerHTML = `
                                <div class="font-bold text-gray-800">${p.name}</div>
                                <div class="text-xs text-gray-500">${p.phone} • ${p.email}</div>
                            `;
                            // عند الضغط على المريض
                            row.onclick = () => {
                                searchInput.value = p.name;
                                document.getElementById('patientPhone').value = p.phone;
                                document.getElementById('patientEmail').value = p.email;
                                suggestionsList.classList.add('hidden');
                            };
                            resultsContainer.appendChild(row);
                        });
                    } else {
                        resultsContainer.innerHTML = '<div class="p-3 text-center text-sm text-gray-500"><i class="fas fa-exclamation-circle text-2xl"></i></div>';
                        suggestionsList.classList.remove('hidden');
                    }
                })
                .catch(err => {
                    console.error('Search error:', err);
                    spinner.classList.add('hidden');
                });
        }, 400);
    });

    // إغلاق القائمة عند الضغط في أي مكان خارجها
    document.addEventListener('click', function(e) {
        if (!searchInput.contains(e.target) && !suggestionsList.contains(e.target)) {
            suggestionsList.classList.add('hidden');
        }
    });
</script>