@using IPTS.ViewModels
@model List<UserListViewModel>
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    string[] avatarPalette = { "bg-indigo-50 text-indigo-600", "bg-teal-50 text-teal-600", "bg-amber-50 text-amber-600", "bg-rose-50 text-rose-600", "bg-sky-50 text-sky-600" };
    var statusFilter = (ViewBag.StatusFilter as string) ?? "active";
    var isInactive = statusFilter == "inactive";
}

<div class="custom-scrollbar overflow-x-auto rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">

    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <i class="fas fa-users"></i>
            </span>
            <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["Users"]</h4>
        </div>
        <a href=@Url.Action(action:"Index", controller: "UsersTypes")
           class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-primary/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
            <i class="fas fa-plus text-xs"></i>
            @SharedLocalizer["Shared_Add_New"]
        </a>
    </div>

    <div class="mb-5 flex flex-wrap gap-2">
        <a asp-action="Index" asp-route-status="active"
           class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold transition-all @(isInactive ? "bg-slate-100 text-slate-600 hover:bg-slate-200" : "bg-gradient-to-r from-primary to-indigo-600 text-white shadow-md shadow-primary/20")">
            <i class="fas fa-user-check text-xs"></i>
            @SharedLocalizer["Users_Tab_Active"]
        </a>
        <a asp-action="Index" asp-route-status="inactive"
           class="inline-flex items-center gap-2 rounded-xl px-4 py-2 text-sm font-semibold transition-all @(!isInactive ? "bg-slate-100 text-slate-600 hover:bg-slate-200" : "bg-gradient-to-r from-primary to-indigo-600 text-white shadow-md shadow-primary/20")">
            <i class="fas fa-user-slash text-xs"></i>
            @SharedLocalizer["Users_Tab_Inactive"]
        </a>
    </div>

    <div class="w-full overflow-auto rounded-2xl border border-slate-100">
    <table class="mb-0 w-full whitespace-nowrap text-sm">
        <thead class="bg-gradient-to-r from-primary to-indigo-600 text-white sticky top-0 z-10">
                <tr>
                    <th class="px-4 py-3 font-semibold">#</th>
                    <th class="px-4 py-3 font-semibold">@SharedLocalizer["Shared_ID"]</th>
                    <th class="px-4 py-3 font-semibold">@SharedLocalizer["Users_AccountType"]</th>
                    <th class="px-4 py-3 font-semibold">@SharedLocalizer["Shared_UserName"]</th>
                    <th class="px-4 py-3 font-semibold">@SharedLocalizer["Shared_Email"]</th>
                    <th class="px-4 py-3 font-semibold">@SharedLocalizer["Appt_Status"]</th>
                    <th class="px-4 py-3"></th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @{int x = 0;}
                @if (Model == null || !Model.Any())
                {
                    <tr>
                        <td colspan="7" class="px-4 py-10 text-center text-slate-400">
                            @(isInactive ? SharedLocalizer["Users_Empty_Inactive"] : SharedLocalizer["Users_Empty_Active"])
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var user in Model)
                    {
                        x++;
                        var avatarLetter = (user.UserName != null && user.UserName.Length > 0) ? user.UserName.Substring(0, 1).ToUpper() : "?";
                        var avatarTone = avatarPalette[x % avatarPalette.Length];

                        <tr class="animate-fade-slide-up transition-colors hover:bg-slate-50" style="animation-delay:@(x * 35)ms">
                            <td class="px-4 py-3 text-center text-slate-400">@x</td>
                            <td class="px-4 py-3 text-center font-medium text-slate-500">@user.Id</td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">@user.UserTypeName</span>
                            </td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex items-center justify-center gap-2">
                                    <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-xs font-bold @avatarTone">@avatarLetter</span>
                                    <span class="font-medium text-slate-700">@user.UserName</span>
                                </span>
                            </td>
                            <td class="px-4 py-3 text-center text-slate-500">@user.Email</td>
                            <td class="px-4 py-3 text-center">
                                <partial name="_UserStatus.cshtml" model=@((int)user.Status) />
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex items-center justify-center gap-1.5">
                                    <a asp-controller="Profile" asp-action="Index" asp-route-id="@user.Id" asp-area=""
                                       title="View"
                                       class="inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-primary/10">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </a>
                                    <a href="@Url.Action("UserForm", "Users", new { id = user.Id, UserType = user.UserTypeName })"
                                       title="Edit"
                                       class="inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-yellow-50">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                                        </svg>
                                    </a>

                                    @if (user.PatientId.HasValue && string.Equals(user.UserTypeName, "patient", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a href="@Url.Action("Index", "MedicalCases", new { area = "admin", patientId = user.PatientId.Value })"
                                           title="@SharedLocalizer["Shared_Medical_Cases"]"
                                           class="inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-teal-50">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                            </svg>
                                        </a>
                                    }

                                    @if (isInactive)
                                    {
                                        <form asp-action="Reactivate" asp-controller="Users" asp-route-id="@user.Id" method="post" data-confirm class="inline">
                                            <button type="submit" title="@SharedLocalizer["Users_Btn_Reactivate"]" class="inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-green-50">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form asp-action="Delete" asp-controller="Users" asp-route-id="@user.Id" method="post" data-confirm class="inline">
                                            <button type="submit" title="Delete" class="inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-red-50">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4
                         a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                                </svg>
                                            </button>
                                        </form>
                                        <form asp-controller="Users" asp-action="SendRestPasswordLink" method="post" data-confirm class="inline">
                                            <input type="hidden" name="Email" value="@user.Email" />
                                            <button type="submit" title="Send Reset Password Link" class="inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-blue-50">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v6h6M20 20v-6h-6M16 8l4-4-4-4M8 16L4 20l4 4" />
                                                </svg>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
