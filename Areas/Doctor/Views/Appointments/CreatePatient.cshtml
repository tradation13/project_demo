@using IPTS.ViewModels
@model PatientCreateViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewBag.Title = "Create New Patient";
}

<div class="bg-white rounded-lg px-8 py-6">
    <div class="flex items-center justify-between mb-4">
        <h4 class="text-xl font-semibold">Create New Patient</h4>
        <a href="@Url.Action("SearchPatient", "Appointments", new { area = "doctor" })"
           class="bg-gray-500 text-white text-sm px-4 py-1 rounded hover:bg-gray-600 transition duration-150">
            Back to Patient Search
        </a>
    </div>

    <div class="mb-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <h5 class="font-semibold text-blue-800 mb-2">Patient Creation Guidelines:</h5>
        <ul class="text-sm text-blue-700 space-y-1">
            <li>• <strong>Identity Number:</strong> Required - National ID or passport number (most important)</li>
            <li>• <strong>Basic Info:</strong> First Name, Last Name, Phone, Email are required</li>
            <li>• <strong>Account Access:</strong> Username and Password for patient login</li>
            <li>• <strong>Birth Date:</strong> Required for medical records</li>
            <li>• <strong>After creation:</strong> The patient can be searched and appointments scheduled</li>
        </ul>
        <div class="mt-3 p-3 bg-yellow-50 border border-yellow-200 rounded text-xs text-yellow-700">
            <strong>Note:</strong> This creates a full patient account with login access. The patient will receive an email confirmation.
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="mb-4 p-4 bg-yellow-100 border border-yellow-400 text-yellow-700 rounded">
            @TempData["WarningMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
            @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="mb-4 p-4 bg-blue-100 border border-blue-400 text-blue-700 rounded">
            @TempData["InfoMessage"]
        </div>
    }

    <form asp-action="CreatePatient" method="post" class="mt-8">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
            <div>
                <label asp-for="IdentityNumber" class="block text-sm font-medium text-gray-700 mb-2">Identity Number *</label>
                <input asp-for="IdentityNumber" type="text" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="Enter identity number" />
                <span asp-validation-for="IdentityNumber" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-2">First Name *</label>
                <input asp-for="FirstName" type="text" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="Enter first name" />
                <span asp-validation-for="FirstName" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-2">Last Name *</label>
                <input asp-for="LastName" type="text" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-transparent"
                       placeholder="Enter last name" />
                <span asp-validation-for="LastName" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 mb-2">Phone Number *</label>
                <input asp-for="PhoneNumber" type="tel" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="Enter phone number" />
                <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-2">Email *</label>
                <input asp-for="Email" type="email" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="Enter email address" />
                <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="BirthDate" class="block text-sm font-medium text-gray-700 mb-2">Birth Date *</label>
                <input asp-for="BirthDate" type="date" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                <span asp-validation-for="BirthDate" class="text-red-500 text-sm"></span>
            </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div>
                <label asp-for="UserName" class="block text-sm font-medium text-gray-700 mb-2">Username *</label>
                <input asp-for="UserName" type="text" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="Enter username" />
                <span asp-validation-for="UserName" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="Password" class="block text-sm font-medium text-gray-700 mb-2">Password *</label>
                <input asp-for="Password" type="password" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="Enter password" />
                <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700 mb-2">Confirm Password *</label>
                <input asp-for="ConfirmPassword" type="password" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="Confirm password" />
                <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
            </div>
        </div>



        <div class="flex justify-end space-x-3">
            <a href="@Url.Action("SearchPatient", "Appointments", new { area = "doctor" })" 
               class="bg-gray-500 text-white px-6 py-2 rounded-md hover:bg-gray-600 transition duration-150">
                Cancel
            </a>
            <button type="submit" class="bg-primary text-white px-6 py-2 rounded-md hover:bg-primary-dark transition duration-150">
                <i class="fas fa-user-plus mr-2"></i>Create Patient
            </button>
        </div>
    </form>

    <!-- Validation Summary -->
    <div asp-validation-summary="All" class="text-red-500 text-sm mt-4"></div>

    <!-- Success Message -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mt-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
            <i class="fas fa-check-circle mr-2"></i>@TempData["SuccessMessage"]
        </div>
    }
</div>

