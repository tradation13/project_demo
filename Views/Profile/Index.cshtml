@model UserProfileViewModel

@{
    Layout = Convert.ToBoolean(ViewBag.HasDashboard)
        ? "~/Views/Shared/Layouts/_DashboardLayout.cshtml"
        : "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
    bool isEditMode = ViewBag.IsEditMode ?? false;
    bool canEdit = ViewBag.CanEdit ?? false;
}

<div class="mb-6 px-4 sm:px-6 lg:px-8">
    <a href="javascript:history.back()" class="text-green-600 hover:text-green-700 hover:underline">
        ← @SharedLocalizer["Shared_Back"]
    </a>
</div>

<div class="mx-auto max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <section class="mb-10 rounded bg-white p-6 shadow">
        <h2 class="mb-6 text-2xl font-semibold">@SharedLocalizer["Profile_Title"]</h2>

    @if (canEdit && !isEditMode)
    {
        <div class="mb-6 text-right">
            <a asp-action="Edit" asp-route-id="@Model.Id"
               class="inline-block rounded-xl bg-primary px-6 py-2.5 text-sm font-bold text-white shadow-lg shadow-primary/20 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-dark active:scale-95">
                <i class="fa-solid fa-pen mr-1"></i> @SharedLocalizer["Profile_EditBtn"]
            </a>
        </div>
    }

    <form asp-action="Edit" asp-controller="Profile" method="post">
        <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-500"></div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
             @if (!isEditMode)
                {
            <div>
                <label class="mb-1 block text-sm font-medium">@SharedLocalizer["Shared_UserName"]</label>
                <input value="@ViewBag.UserName" disabled class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 text-gray-700" />
            </div>
                }
            <div>
                <label asp-for="Email" class="mb-1 block text-sm font-medium">@SharedLocalizer["Shared_Email"]</label>
                @if (isEditMode)
                {
                    <input asp-for="Email" type="email" class="w-full rounded border border-gray-300 px-3 py-2" />
                    <span asp-validation-for="Email" class="text-sm text-red-500"></span>
                }
                else
                {
                    <input asp-for="Email" type="email" disabled class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 text-gray-700" />
                }
            
            </div>
            <div>
                <label asp-for="FirstName" class="mb-1 block text-sm font-medium">@SharedLocalizer["Shared_FirstName"]</label>
                @if (isEditMode)
                {
                    <input asp-for="FirstName" type="text" class="w-full rounded border border-gray-300 px-3 py-2" />
                    <span asp-validation-for="FirstName" class="text-sm text-red-500"></span>
                }
                else
                {
                    <input asp-for="FirstName" type="text" disabled class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 text-gray-700" />
                } 
            
            </div>
            <div>
                <label asp-for="LastName" class="mb-1 block text-sm font-medium">@SharedLocalizer["Shared_LastName"]</label>
                @if (isEditMode)
                {
                    <input asp-for="LastName" type="text" class="w-full rounded border border-gray-300 px-3 py-2" />
                    <span asp-validation-for="LastName" class="text-sm text-red-500"></span>
                }
                else
                {
                    <input asp-for="LastName" type="text" disabled class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 text-gray-700" />
                }
            
            </div>

            <div>
                <label asp-for="PhoneNumber" class="mb-1 block text-sm font-medium">@SharedLocalizer["Shared_Phone"]</label>
                @if (isEditMode)
                {
                    <input asp-for="PhoneNumber" class="w-full rounded border border-gray-300 px-3 py-2" />
                    <span asp-validation-for="PhoneNumber" class="text-sm text-red-500"></span>
                }
                else
                {
                    <input type="text" value="@(Model.PhoneNumber ?? SharedLocalizer["Profile_NotAvailable"].Value)" disabled class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 text-gray-700" />
                }
            </div>

        </div>

        @if (Model.Admin != null)
        {
            <div class="mt-8">
                <h3 class="mb-4 text-xl font-semibold">@SharedLocalizer["Profile_AdminDetails"]</h3>
                <div class="mb-4">
                    <label asp-for="Admin.Id" class="mb-1 block text-sm font-medium">@SharedLocalizer["Shared_Admin"] @SharedLocalizer["Shared_ID"]</label>
                    <input type="text" asp-for="Admin.Id" readonly class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 text-gray-700" />
                </div>
            </div>
        }

        @if (Model.Patient != null)
        {
            <div class="mt-8">
                <h3 class="mb-4 text-xl font-semibold">@SharedLocalizer["Profile_PatientDetails"]</h3>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    <div>
                        <label class="mb-1 block text-sm font-medium">@SharedLocalizer["Shared_Identity_Number"]</label>
                        <input type="text" value="@(Model.Patient.IdentityNumber ?? SharedLocalizer["Profile_NotAvailable"].Value)" readonly 
                               class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 text-gray-700" />
                    </div>
                    <div>
                        <label class="mb-1 block text-sm font-medium">@SharedLocalizer["Shared_Date_Of_Birth"]</label>
                        <input type="text" value="@Model.Patient.BirthDate.ToShortDateString()" readonly 
                               class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 text-gray-700" />
                    </div>
                </div>
            </div>
        }
        @if (Model.Doctor != null)
        {
            @if(isEditMode){
                <div class="min-w-[200px] flex-1">
                    <label asp-for="Doctor.SpecialtyId" class="block text-sm font-medium text-gray-700">@SharedLocalizer["Profile_Specialty"]</label>
                    <select asp-for="Doctor.SpecialtyId" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        <option value="">@SharedLocalizer["Profile_SelectSpecialty"]</option>
                        @if (ViewBag.Specialties is List<Specialty> specialties)
                        {
                            foreach (var specialty in specialties)
                            {
                                <option value="@specialty.Id" selected="@(specialty.Id == Model.Doctor.SpecialtyId ? "selected" : String.Empty)">@specialty.Name</option>
                            }
                        }
                    </select>
                    <span asp-validation-for="Doctor.SpecialtyId" class="text-sm text-red-500"></span>
                </div>
            }else{
                @if (ViewBag.Specialties is List<Specialty> specialties){
                 <div class="mb-4">
                    <label class="mb-1 block text-sm font-medium">@SharedLocalizer["Profile_Specialty"]</label>
                        <input type="text" value=@specialties.Find(i=>i.Id == Model.Doctor.SpecialtyId).Name readonly class="w-full rounded border border-gray-300 bg-gray-100 px-3 py-2 text-gray-700" />
                 </div>
                 }

               
            }
        }

        @if (isEditMode)
        {
            <div class="mt-6 flex gap-4">
                <button type="submit" class="rounded bg-green-600 px-6 py-2 text-white hover:bg-green-700">
                    @SharedLocalizer["Profile_SaveBtn"]
                </button>
                <a asp-action="Index" asp-route-id="@Model.Id"
                   class="rounded bg-gray-300 px-6 py-2 text-gray-800 hover:bg-gray-400">
                    @SharedLocalizer["Shared_Cancel"]
                </a>
            </div>
        }
    </form>
    </section>
</div>