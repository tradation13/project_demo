@{
    ViewData["Title"] = SharedLocalizer["Impressum_Title"];
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
}

<section class="legal-page relative overflow-hidden bg-gradient-to-b from-white via-emerald-50/30 to-white py-12 sm:py-16">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -left-20 top-24 h-72 w-72 rounded-full bg-emerald-100/50 blur-3xl"></div>
        <div class="absolute -right-16 bottom-20 h-80 w-80 rounded-full bg-sky-100/40 blur-3xl"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

        <div class="legal-draft mb-6 flex items-start gap-3 rounded-2xl border border-amber-200/80 bg-amber-50/90 px-4 py-3.5 text-sm text-amber-900 shadow-sm sm:px-5">
            <span class="mt-0.5 flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-amber-100 text-amber-700">
                <i class="fa-solid fa-pen-ruler" aria-hidden="true"></i>
            </span>
            <div>
                <p class="font-bold">@SharedLocalizer["Legal_Draft_Title"]</p>
                <p class="mt-0.5 leading-relaxed text-amber-800/90">@SharedLocalizer["Legal_Draft_Text"]</p>
            </div>
        </div>

        <div class="rounded-[2rem] border border-gray-100 bg-gradient-to-b from-white to-gray-50/50 p-5 shadow-[0_24px_65px_-25px_rgba(15,23,42,0.35)] sm:p-8 lg:p-10">

            <h1 class="pp-title mb-8 border-b border-gray-100 pb-4 text-2xl font-bold tracking-tight text-gray-900 sm:mb-10 sm:text-3xl">
                @SharedLocalizer["Impressum_Title"]
            </h1>

            <div class="space-y-8 text-justify leading-relaxed text-gray-700 sm:space-y-9">

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Impressum_Section1_Title"]</h2>
                    <address class="not-italic space-y-1 text-gray-700">
                        <p class="text-lg font-semibold text-gray-900">@SharedLocalizer["Impressum_Company"]</p>
                        <p>@SharedLocalizer["Impressum_Address_Line1"]</p>
                        <p>@SharedLocalizer["Impressum_Address_Line2"]</p>
                        <p class="pt-2">
                            <a href="tel:01728758302" class="text-emerald-700 hover:underline">0172 8758302</a>
                        </p>
                        <p>
                            <a href="mailto:dr.kurtoglu@physiotech-ehrenfeld.de" class="text-emerald-700 hover:underline break-all">
                                dr.kurtoglu@physiotech-ehrenfeld.de
                            </a>
                        </p>
                    </address>
                </section>

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Impressum_Section2_Title"]</h2>
                    <p>@SharedLocalizer["Impressum_Section2_Text"]</p>
                </section>

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Impressum_Section3_Title"]</h2>
                    <p>@SharedLocalizer["Impressum_Section3_Text"]</p>
                </section>

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Impressum_Section4_Title"]</h2>
                    <p>@SharedLocalizer["Impressum_Section4_Text"]</p>
                </section>

                <section class="pp-section rounded-2xl border border-emerald-100 bg-gradient-to-br from-emerald-50/80 to-white p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Impressum_Hosting_Title"]</h2>
                    <p>@SharedLocalizer["Impressum_Hosting_Text"]</p>
                    <ul class="mt-4 space-y-2 text-left text-sm text-gray-700">
                        <li class="flex items-start gap-2">
                            <i class="fa-solid fa-check mt-1 text-emerald-600" aria-hidden="true"></i>
                            <span>@SharedLocalizer["Legal_Host_Db_Text"]</span>
                        </li>
                        <li class="flex items-start gap-2">
                            <i class="fa-solid fa-check mt-1 text-emerald-600" aria-hidden="true"></i>
                            <span>@SharedLocalizer["Legal_Host_Server_Text"]</span>
                        </li>
                    </ul>
                </section>

            </div>
        </div>
    </div>
</section>

<style>
    @@keyframes ppFadeUp {
        from { opacity:0; transform:translateY(28px); }
        to   { opacity:1; transform:translateY(0); }
    }
    @@keyframes ppFadeIn {
        from { opacity:0; }
        to   { opacity:1; }
    }
    @@keyframes ppAccent {
        0%,100% { width:32px; opacity:.5; }
        50%      { width:56px; opacity:1; }
    }
    .pp-title {
        opacity: 0;
        animation: ppFadeIn 0.6s cubic-bezier(.22,1,.36,1) .05s forwards;
        position: relative;
    }
    .pp-title::after {
        content:'';
        display:block;
        height:3px;
        width:40px;
        background: #10b981;
        border-radius:2px;
        margin-top:10px;
        animation: ppAccent 2.4s ease-in-out infinite;
    }
    .pp-section {
        opacity: 0;
        transition: box-shadow .25s ease, border-color .25s ease, transform .25s ease;
        position: relative;
        overflow: hidden;
    }
    .pp-section::before {
        content:'';
        position:absolute;
        top:0; left:0;
        width:3px; height:0;
        background: linear-gradient(to bottom, #10b981, #6ee7b7);
        border-radius:2px;
        transition: height .35s ease;
    }
    .pp-section:hover::before { height:100%; }
    .pp-section:hover {
        box-shadow: 0 8px 28px rgba(16,185,129,.10);
        border-color: #d1fae5;
        transform: translateX(3px);
    }
    .pp-section.av {
        animation: ppFadeUp 0.65s cubic-bezier(.22,1,.36,1) forwards;
    }
    .legal-draft { animation: ppFadeIn .5s ease both; }
</style>

<script>
(function(){
    var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
            if(e.isIntersecting){ e.target.classList.add('av'); }
            else { e.target.classList.remove('av'); }
        });
    },{ threshold:0.08 });
    document.querySelectorAll('.pp-section').forEach(function(el){ obs.observe(el); });
})();
</script>
