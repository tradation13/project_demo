@model IPTS.ViewModels.ResetPasswordConfirmViewModel
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Shared_ResetPassword"];
}

<div class="auth-ui-card auth-ui-pad relative mx-auto w-full max-w-md overflow-hidden rounded-[2rem] border border-white/70 bg-white/85 p-8 shadow-[0_24px_80px_rgba(15,23,42,0.12)] backdrop-blur-xl sm:p-10">
    <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[2rem]">
        <div class="auth-ui-orb auth-ui-orb-a absolute -left-10 -top-10 h-32 w-32 rounded-full bg-emerald-500/10 blur-3xl"></div>
        <div class="auth-ui-orb auth-ui-orb-b absolute -bottom-12 -right-8 h-36 w-36 rounded-full bg-blue-500/10 blur-3xl"></div>
    </div>

    <div class="relative z-10">
        <div class="mb-8 text-center">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white shadow-lg shadow-emerald-500/20 ring-1 ring-white/60">
                <i class="fas fa-key text-lg" aria-hidden="true"></i>
            </div>
            <h2 class="auth-ui-title text-3xl font-extrabold tracking-tight sm:text-[2rem]">
                @SharedLocalizer["Shared_ResetPassword"]
            </h2>
        </div>

        <form class="space-y-5" asp-action="ResetPasswordConfirm" method="post" autocomplete="off">
            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />

            <div class="space-y-2">
                <label asp-for="NewPassword" class="ml-1 block text-sm font-medium text-slate-700">
                    @SharedLocalizer["Shared_NewPassword"]
                </label>
                <div x-data="{ show: false }" class="relative">
                    <input :type="show ? 'text' : 'password'"
                           asp-for="NewPassword"
                           class="auth-ui-input w-full rounded-2xl border border-slate-200 bg-white/90 px-4 py-3.5 pr-12 text-[15px] text-slate-900 outline-none transition-all placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10"
                           placeholder="@SharedLocalizer["Shared_EnterNewPassword"]" />
                    <button x-on:click="show = !show" type="button"
                            class="absolute right-4 top-1/2 flex -translate-y-1/2 items-center justify-center text-slate-400 transition-colors hover:text-emerald-600">
                        <i class="fa-solid" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="mt-1 block text-xs text-red-500"></span>
            </div>

            <div class="space-y-2">
                <label asp-for="ConfirmPassword" class="ml-1 block text-sm font-medium text-slate-700">
                    @SharedLocalizer["Shared_ConfirmPassword"]
                </label>
                <div x-data="{ show: false }" class="relative">
                    <input :type="show ? 'text' : 'password'"
                           asp-for="ConfirmPassword"
                           class="auth-ui-input w-full rounded-2xl border border-slate-200 bg-white/90 px-4 py-3.5 pr-12 text-[15px] text-slate-900 outline-none transition-all placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10"
                           placeholder="@SharedLocalizer["Shared_ConfirmNewPassword"]" />
                    <button x-on:click="show = !show" type="button"
                            class="absolute right-4 top-1/2 flex -translate-y-1/2 items-center justify-center text-slate-400 transition-colors hover:text-emerald-600">
                        <i class="fa-solid" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="mt-1 block text-xs text-red-500"></span>
            </div>

            <button type="submit"
                    class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-emerald-600 to-emerald-500 px-8 py-3.5 font-semibold text-white shadow-lg shadow-emerald-600/20 transition-all duration-200 hover:-translate-y-0.5 hover:from-emerald-700 hover:to-emerald-600 hover:shadow-xl hover:shadow-emerald-700/25">
                <i class="fas fa-check text-xs" aria-hidden="true"></i>
                @SharedLocalizer["Shared_ResetPassword"]
            </button>

            @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
        </form>
    </div>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")
