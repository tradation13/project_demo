@model List<IPTS.Models.Entites.Patient>
@{
    ViewData["Title"] = "My Patients";
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="p-6">
    <div class="mb-6 flex items-center justify-between">
        <h2 class="text-2xl font-bold text-slate-800">@SharedLocalizer["Pat_Header"]</h2>
        <a asp-action="Create" class="rounded-xl bg-primary px-4 py-2 text-white shadow-lg transition hover:brightness-110">
            <i class="fas fa-plus mr-2"></i> @SharedLocalizer["Pat_AddNew"]
        </a>
    </div>



    @if (!Model.Any())
    {
        <div class="rounded-xl border-l-4 border-yellow-400 bg-yellow-50 p-8 text-center shadow-sm">
            <div class="mb-2 text-yellow-400">
                <i class="fas fa-user-slash fa-3x"></i>
            </div>
            <p class="font-medium text-yellow-800">@SharedLocalizer["Pat_NoPatients"]</p>
        </div>
    }
    else
    {
        <div class="overflow-hidden overflow-x-auto rounded-3xl border border-slate-200 bg-white shadow-xl">
            <table class="min-w-full divide-y divide-slate-200">
                <thead class="bg-slate-50">
                    <tr>
                        <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">@SharedLocalizer["Contact_Label_Name"]</th>
                        <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">@SharedLocalizer["Shared_Identity_Number"]</th>
                        <th class="px-6 py-4 text-left text-xs font-bold uppercase tracking-wider text-slate-500">@SharedLocalizer["Shared_Contact_Info"]</th>
                        <th class="px-6 py-4 text-center text-xs font-bold uppercase tracking-wider text-slate-500">@SharedLocalizer["Shared_Options"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @foreach (var p in Model)
                    {
                        <tr class="transition-colors hover:bg-slate-50/50">
                            <td class="whitespace-nowrap px-6 py-4">
                                <div class="font-semibold text-slate-700">@($"{p.User?.FirstName} {p.User?.LastName}")</div>
                            </td>
                            <td class="whitespace-nowrap px-6 py-4">
                                <span class="rounded-full bg-slate-100 px-3 py-1 font-mono text-xs text-slate-600">@p.IdentityNumber</span>
                            </td>
                            <td class="px-6 py-4">
                                <div class="text-sm italic text-slate-600">@p.User?.Email</div>
                                <div class="text-xs text-slate-400">@p.User?.PhoneNumber</div>
                            </td>
                            <td class="px-6 py-4">
                                <div class="flex justify-center gap-3">
                                    <a href="@Url.Action("Index", "Profile", new { area = "", id = p.UserId })"
                                       title=@SharedLocalizer["Shared_Profile"] class="flex h-8 w-8 items-center justify-center rounded-lg bg-blue-50 text-blue-600 transition-all hover:bg-blue-600 hover:text-white">
                                        <i class="fa fa-user text-sm"></i>
                                    </a>
                                    <a href="@Url.Action("PreviousAppointments", "Patients", new { area = "doctor", patientId = p.Id })"
                                       title=@SharedLocalizer["Appt_Header"] class="flex h-8 w-8 items-center justify-center rounded-lg bg-green-50 text-green-600 transition-all hover:bg-green-600 hover:text-white">
                                        <i class="fa fa-calendar-alt text-sm"></i>
                                    </a>
                                    <a href="@Url.Action("Index", "MedicalCases", new { area = "doctor", patientId = p.Id })"
                                       title=@SharedLocalizer["Shared_Medical_Cases"] class="flex h-8 w-8 items-center justify-center rounded-lg bg-purple-50 text-purple-600 transition-all hover:bg-purple-600 hover:text-white">
                                        <i class="fa fa-notes-medical text-sm"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>