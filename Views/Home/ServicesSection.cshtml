@* Core Services Section *@
<section id="services" class="bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
            <div class="mb-4 flex items-center justify-center gap-3">
                <i class="fas fa-hospital text-3xl text-primary-600"></i>
                <h2 class="text-4xl font-bold text-gray-900">@SharedLocalizer["Services_Title"]</h2>
            </div>
            <p class="mx-auto max-w-2xl text-lg text-gray-600">
                @SharedLocalizer["Services_Subtitle"]
            </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
            <div class="service-reveal rounded-xl border border-gray-100 bg-white p-6 shadow-md transition-shadow duration-300 hover:shadow-xl" data-delay="0" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 rounded-lg bg-primary-100 p-3">
                        <i class="fas fa-hands-helping text-2xl text-primary-600"></i>
                    </div>
                    <div>
                        <h3 class="text-l mb-2 font-bold text-gray-900">@SharedLocalizer["Services_S1_Title"]</h3>
                        <p class="text-sm leading-relaxed text-gray-600">
                            @SharedLocalizer["Services_S1_Desc"]
                        </p>
                    </div>
                </div>
            </div>

            <div class="service-reveal rounded-xl border border-gray-100 bg-white p-6 shadow-md transition-shadow duration-300 hover:shadow-xl" data-delay="120" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 rounded-lg bg-primary-100 p-3">
                        <i class="fas fa-running text-2xl text-primary-600"></i>
                    </div>
                    <div>
                        <h3 class="text-l mb-2 font-bold text-gray-900">@SharedLocalizer["Services_S2_Title"]</h3>
                        <p class="text-sm leading-relaxed text-gray-600">
                            @SharedLocalizer["Services_S2_Desc"]
                        </p>
                    </div>
                </div>
            </div>

            <div class="service-reveal rounded-xl border border-gray-100 bg-white p-6 shadow-md transition-shadow duration-300 hover:shadow-xl" data-delay="240" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 rounded-lg bg-primary-100 p-3">
                        <i class="fas fa-running text-2xl text-primary-600"></i>
                    </div>
                    <div>
                        <h3 class="text-l mb-2 font-bold text-gray-900">@SharedLocalizer["Services_S3_Title"]</h3>
                        <p class="text-sm leading-relaxed text-gray-600">
                            @SharedLocalizer["Services_S3_Desc"]
                        </p>
                    </div>
                </div>
            </div>

            <div class="service-reveal rounded-xl border border-gray-100 bg-white p-6 shadow-md transition-shadow duration-300 hover:shadow-xl" data-delay="360" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 rounded-lg bg-primary-100 p-3">
                        <i class="fas fa-brain text-2xl text-primary-600"></i>
                    </div>
                    <div>
                        <h3 class="text-l mb-2 font-bold text-gray-900">@SharedLocalizer["Services_S4_Title"]</h3>
                        <p class="text-sm leading-relaxed text-gray-600">
                            @SharedLocalizer["Services_S4_Desc"]
                        </p>
                    </div>
                </div>
            </div>

            <div class="service-reveal rounded-xl border border-gray-100 bg-white p-6 shadow-md transition-shadow duration-300 hover:shadow-xl" data-delay="480" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                <div class="flex items-start gap-4">
                    <div class="flex-shrink-0 rounded-lg bg-primary-100 p-3">
                        <i class="fas fa-chart-line text-2xl text-primary-600"></i>
                    </div>
                    <div>
                        <h3 class="text-l mb-2 font-bold text-gray-900">@SharedLocalizer["Services_S5_Title"]</h3>
                        <p class="text-sm leading-relaxed text-gray-600">
                            @SharedLocalizer["Services_S5_Desc"]
                        </p>
                    </div>
                </div>
            </div>

            <div class="service-reveal flex items-center justify-center rounded-xl border border-primary-200 bg-white p-6 shadow-md transition-shadow duration-300 hover:shadow-xl" data-delay="600" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                <div class="text-center">
                    <h3 class="text-l mb-2 font-bold text-gray-900">@SharedLocalizer["Services_CTA_Title"]</h3>
                    <p class="mb-4 text-sm text-gray-600">@SharedLocalizer["Services_CTA_Desc"]</p>
                  <a asp-controller="Home" 
   asp-action="Therapies" 
    class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-4 py-2 font-bold text-white transition-colors hover:bg-primary-700">
    @SharedLocalizer["Shared_Book_Now"]
    <i class="fas fa-arrow-right"></i>
</a>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        const cards = document.querySelectorAll('.service-reveal');
        if (!cards.length) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) {
            cards.forEach((card) => {
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            });
            return;
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                const card = entry.target;
                if (entry.isIntersecting) {
                    const delay = card.getAttribute('data-delay') || '0';
                    card.style.transitionDelay = `${delay}ms`;
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                } else {
                    card.style.transitionDelay = '0ms';
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(28px)';
                }
            });
        }, { threshold: 0.25, rootMargin: '0px 0px -30px 0px' });

        cards.forEach((card) => observer.observe(card));
    })();
</script>
