@model IPTS.ViewModels.ResetPasswordViewModel
@{
    Layout = ViewBag.HasDashboard
                ? "~/Views/Shared/Layouts/_DashboardLayout.cshtml"
                : "~/Views/Shared/Layouts/_AuthLayout.cshtml";
}
<section class="bg-white shadow p-6 rounded mb-10">
    <h2 class="text-center text-2xl font-bold tracking-wide text-gray-800">Reset Password</h2>

    <form asp-action="ResetPassword" method="post" class="my-8 text-sm">
        <!-- Current Password -->
        <div class="flex flex-col my-4">
            <label asp-for="CurrentPassword" class="text-gray-700"></label>
            <div x-data="{ show: false }" class="relative flex items-center mt-2">
                <input :type=" show ? 'text' : 'password' "
                       asp-for="CurrentPassword"
                       class="flex-1 py-2 pr-10 border-gray-300 focus:outline-none focus:ring-0
                              focus:border-gray-300 rounded text-sm text-gray-900"
                       placeholder="Enter current password" />
                <button x-on:click ="show = !show" type="button"
                        class="absolute right-2 bg-transparent flex items-center justify-center text-gray-700">
                    <svg x-show="!show" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59"></path>
                    </svg>
                    <svg x-show="show" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display: none;">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                    </svg>
                </button>
            </div>
            <span asp-validation-for="CurrentPassword" class="text-red-500 text-sm"></span>
        </div>

        <!-- New Password -->
        <div class="flex flex-col my-4">
            <label asp-for="NewPassword" class="text-gray-700"></label>
            <div x-data="{ show: false }" class="relative flex items-center mt-2">
                <input :type=" show ? 'text' : 'password' "
                       asp-for="NewPassword"
                       class="flex-1 py-2 pr-10 border-gray-300 focus:outline-none focus:ring-0
                              focus:border-gray-300 rounded text-sm text-gray-900"
                       placeholder="Enter new password" />
                <button x-on:click ="show = !show" type="button"
                        class="absolute right-2 bg-transparent flex items-center justify-center text-gray-700">
                    <!-- نفس أيقونات الـ SVG أعلاه -->
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="text-red-500 text-sm"></span>
        </div>

        <!-- Confirm Password -->
        <div class="flex flex-col my-4">
            <label asp-for="ConfirmPassword" class="text-gray-700"></label>
            <div x-data="{ show: false }" class="relative flex items-center mt-2">
                <input :type=" show ? 'text' : 'password' "
                       asp-for="ConfirmPassword"
                       class="flex-1 py-2 pr-10 border-gray-300 focus:outline-none focus:ring-0
                              focus:border-gray-300 rounded text-sm text-gray-900"
                       placeholder="Confirm new password" />
                <button x-on:click ="show = !show" type="button"
                        class="absolute right-2 bg-transparent flex items-center justify-center text-gray-700">
                    <!-- نفس أيقونات الـ SVG أعلاه -->
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
        </div>

        <!-- Buttons -->
        <div class="flex gap-2 mt-6">
            @* <a href="@Url.Action("Index")" *@
            @*    class="bg-secondary bg-opacity-20 hover:bg-opacity-40 rounded-lg px-6 py-1.5 text-secondary *@
            @*           hover:shadow-xl transition duration-150"> *@
            @*     Cancel *@
            @* </a> *@

            <button type="submit"
                    class="bg-primary hover:bg-primary-dark rounded-lg px-6 py-1.5 text-white
                           hover:shadow-xl transition duration-150">
                Update Password
            </button>
        </div>

        <div asp-validation-summary="All" class="text-red-500 text-sm mt-4"></div>
    </form>
</section>