@* Location & Contact Section *@
<section id="contact" class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
            <div class="mb-3 flex items-center justify-center gap-3">
                <i class="fas fa-map-marker-alt text-3xl text-primary-600 contact-bounce-icon"></i>
                <h2 class="text-4xl font-bold text-gray-900 contact-animate">@SharedLocalizer["Contact_Title"]</h2>
            </div>
            <p class="text-lg text-gray-600 contact-animate" style="animation-delay:0.1s">@SharedLocalizer["Contact_Subtitle"]</p>
        </div>

        <div class="grid items-start gap-8 lg:grid-cols-2">
            <!-- Contact Details -->
            <div class="space-y-4">
                <div class="contact-card flex items-start gap-3 rounded-xl border border-gray-100 bg-gray-50 p-4 shadow-sm" data-delay="0">
                    <div class="flex h-11 w-11 items-center justify-center rounded-lg  text-xl text-primary-600">
                        <i class="fas fa-map-pin contact-icon-float"></i>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-gray-500">@SharedLocalizer["Shared_Address"]</p>
                        <p class="font-bold text-primary-600 hover:text-primary-700">Venloer Straße 305, 50823 Köln-Ehrenfeld</p>
                    </div>
                </div>

                <div class="contact-card flex items-start gap-3 rounded-xl border border-gray-100 bg-gray-50 p-4 shadow-sm" data-delay="150">
                    <div class="flex h-11 w-11 items-center justify-center rounded-lg  text-xl text-primary-600">
                        <i class="fas fa-phone contact-icon-ring"></i>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-gray-500">@SharedLocalizer["Shared_Phone"]</p>
                        <a href="tel:022170244490" class="font-bold text-primary-600 hover:text-primary-700">0221 702 444 90</a>
                    </div>
                </div>

                <div class="contact-card flex items-start gap-3 rounded-xl border border-gray-100 bg-gray-50 p-4 shadow-sm" data-delay="300">
                    <div class="flex h-11 w-11 items-center justify-center rounded-lg  text-xl text-primary-600">
                        <i class="fas fa-envelope contact-icon-shake"></i>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-gray-500">@SharedLocalizer["Shared_Email"]</p>
                        <a href="mailto:dr.kurtoglu@physiotech-ehrenfeld.de" class="font-bold text-primary-600 hover:text-primary-700">dr.kurtoglu@physiotech-ehrenfeld.de</a>
                    </div>
                </div>

                 <div class="contact-card flex items-start gap-3 rounded-xl border border-gray-100 bg-gray-50 p-4 shadow-sm" data-delay="450">
                    <div class="flex h-11 w-11 items-center justify-center rounded-lg  text-xl text-primary-600">
                        <i class="fa-solid fa-business-time contact-icon-shake"></i>
                    </div>
                    <div>
                        <p class="text-sm font-bold text-gray-500">@SharedLocalizer["Shared_Working_Hours"]</p>
                        <p class="font-bold text-primary-600 hover:text-primary-700">@SharedLocalizer["Shared_Opening_Hours_Details"]</p>
                    </div>
                </div>
            </div>

            <!-- Map: embed loads only after an explicit click -->
            <div class="map-wrapper w-full contact-card" data-delay="200">
                <div class="relative overflow-hidden rounded-2xl border border-gray-200 shadow-md">
                    @await Html.PartialAsync("~/Views/Shared/PublicSide/GoogleMapGate.cshtml", 360)
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    /* ── Keyframes ── */
    @@keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(32px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    @@keyframes fadeSlideRight {
        from { opacity: 0; transform: translateX(-32px); }
        to   { opacity: 1; transform: translateX(0); }
    }

    /* دائم - طفو */
    @@keyframes floatY {
        0%, 100% { transform: translateY(0); }
        50%       { transform: translateY(-5px); }
    }
    /* دائم - اهتزاز الهاتف */
    @@keyframes ringShake {
        0%, 100% { transform: rotate(0deg); }
        15%       { transform: rotate(-18deg); }
        30%       { transform: rotate(18deg); }
        45%       { transform: rotate(-12deg); }
        60%       { transform: rotate(12deg); }
        75%       { transform: rotate(-6deg); }
        90%       { transform: rotate(6deg); }
    }
    /* دائم - نبضة المغلف */
    @@keyframes shakeLetter {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        25%       { transform: translateY(-3px) rotate(-4deg); }
        75%       { transform: translateY(-3px) rotate(4deg); }
    }
    /* دائم - ارتداد الـ marker */
    @@keyframes markerBounce {
        0%, 100% { transform: translateY(0) scale(1); }
        40%       { transform: translateY(-8px) scale(1.1); }
        60%       { transform: translateY(-4px) scale(1.05); }
    }

    /* ── حالة البداية — مخفية حتى يشوفها الـ observer ── */
    .contact-animate,
    .contact-card {
        opacity: 0;
    }

    /* ── لما يدخل الـ observer يحط هذه الكلاس ── */
    .contact-animate.is-visible {
        animation: fadeSlideUp 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }
    .contact-card.is-visible {
        animation: fadeSlideRight 0.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
    }

    /* ── Hover على البطاقة ── */
    .contact-card {
        transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
        will-change: transform;
    }
    .contact-card:hover {
        transform: translateY(-4px) translateX(4px);
        box-shadow: 0 10px 28px rgba(0,0,0,0.10);
        border-color: #bbf7d0;
    }

    /* ── أنيميشن دائمة على الأيقونات ── */
    .contact-icon-float {
        display: inline-block;
        animation: floatY 2.8s ease-in-out infinite;
    }
    .contact-icon-ring {
        display: inline-block;
        animation: ringShake 2.5s ease-in-out infinite;
        animation-delay: 0.8s;
    }
    .contact-icon-shake {
        display: inline-block;
        animation: shakeLetter 2.2s ease-in-out infinite;
        animation-delay: 1.4s;
    }
    .contact-bounce-icon {
        display: inline-block;
        animation: markerBounce 2s ease-in-out infinite;
    }

    /* ── Map hover ── */
    .map-wrapper iframe {
        transition: filter 0.35s ease;
        filter: saturate(0.85);
    }
    .map-wrapper:hover iframe {
        filter: saturate(1.15);
    }
</style>

<script>
    (function () {
        var observer = new IntersectionObserver(function (entries) {
            entries.forEach(function (entry) {
                if (entry.isIntersecting) {
                    var el = entry.target;
                    var delay = el.dataset.delay || 0;
                    setTimeout(function () {
                        el.classList.add('is-visible');
                    }, parseInt(delay));
                } else {
                    // يشيل الكلاس عشان تتكرر الأنيميشن كل ما يرجع
                    entry.target.classList.remove('is-visible');
                }
            });
        }, { threshold: 0.15 });

        document.querySelectorAll('.contact-animate, .contact-card').forEach(function (el) {
            observer.observe(el);
        });
    })();
</script>