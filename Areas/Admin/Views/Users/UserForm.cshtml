@using IPTS.Models.Entites
@model UserFormViewModel

@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    var isEditMode = !string.IsNullOrEmpty(Model.Id);
    ViewBag.Title = (isEditMode ? @SharedLocalizer["Shared_Edit"] : @SharedLocalizer["Users_CreateTitle"]) + ViewBag.UserType;
}

<form asp-action="UserForm" asp-route-id="" method="post" asp-route-UserType="@ViewBag.UserType">
    @* Hidden Id Field للتعديل لكل المستخدمين *@
    <input type="hidden" asp-for="Id" />

    <div class="card mb-4">
        <div class="card-header">
            <h5>@SharedLocalizer["Users_UserInformation"]</h5>
        </div>
        <div class="card-body">
            <div class="flex flex-wrap gap-4">
                 @if(!isEditMode){
                <div class="min-w-[200px] flex-1">
                    <label asp-for="UserName" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="UserName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="UserName" class="text-sm text-red-500"></span>
                </div>
                 }
                <div class="min-w-[200px] flex-1">
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="Email" class="text-sm text-red-500"></span>
                </div>
                <div class="min-w-[200px] flex-1">
                    <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="PhoneNumber" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="PhoneNumber" class="text-sm text-red-500"></span>
                </div>
            </div> 
            <div class="card-body">
            <div class="flex flex-wrap gap-4">

                <div class="min-w-[200px] flex-1">
                    <label asp-for="FirstName" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="FirstName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="FirstName" class="text-sm text-red-500"></span>
                </div>
                <div class="min-w-[200px] flex-1">
                    <label asp-for="LastName" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="LastName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="LastName" class="text-sm text-red-500"></span>
                </div>
            </div>

        @if(!isEditMode){
                <div class="mt-4 flex gap-4">
                    <div class="min-w-[200px] flex-1">
                        <label asp-for="Password" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="Password" type="password" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"  />
                        <span asp-validation-for="Password" class="text-sm text-red-500"></span>
                    </div>
                    <div class="min-w-[200px] flex-1">
                        <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="ConfirmPassword" type="password" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                        <span asp-validation-for="ConfirmPassword" class="text-sm text-red-500"></span>
                    </div>
                </div>
        }
            @if (isEditMode)
            {
                <div class="mt-4 flex gap-4">
                    <div class="min-w-[200px] flex-1">
                        <label asp-for="Status" class="block text-sm font-medium text-gray-700"></label>
                        <select asp-for="Status" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm">
                            <option value="0">@SharedLocalizer["Status_Active"]</option>
                            <option value="1">@SharedLocalizer["Status_Inactive"]</option>
                        </select>
                        <span asp-validation-for="Status" class="text-sm text-red-500"></span>
                    </div>
                </div>
            }
        </div>
    </div>

    @* أقسام خاصة بالأنواع *@
    @switch (ViewBag.UserType?.ToLower())
    {
        case "admin":
            @* Id موجود مسبقًا في Hidden Field *@
            break;

        case "customer":
            <div class="card mb-4">
                <div class="card-header">
                    <h5>@SharedLocalizer["Users_CustomerInformation"]</h5>
                </div>
                <div class="card-body flex gap-4">
                    @* Hidden Id للـ Customer إذا موجود *@
                    <input type="hidden" asp-for="Customer.Id" />

                    <div class="min-w-[200px] flex-1">
                        <label asp-for="Customer.FirstName" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="Customer.FirstName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                        <span asp-validation-for="Customer.FirstName" class="text-sm text-red-500"></span>
                    </div>
                    <div class="min-w-[200px] flex-1">
                        <label asp-for="Customer.LastName" class="block text-sm font-medium text-gray-700"></label>
                        <input asp-for="Customer.LastName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                        <span asp-validation-for="Customer.LastName" class="text-sm text-red-500"></span>
                    </div>
                </div>
            </div>
            break;
               case "patient":
        <div class="card mb-4">
            <div class="card-header">
                <h5>@SharedLocalizer["Appt_Sched_PatientInfo"]</h5>
            </div>
            <div class="card-body flex gap-4">
                @* <input type="hidden" asp-for="Patient.Id" />
                <div class="min-w-[200px] flex-1">
                    <label asp-for="Patient.IdentityNumber" class="block text-sm font-medium text-gray-700">@SharedLocalizer["Shared_Identity_Number"] *</label>
                    @if (!isEditMode)
                    {
                        <input asp-for="Patient.IdentityNumber" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" placeholder=@SharedLocalizer["Search_PlaceholderID"] required />
                        <span asp-validation-for="Patient.IdentityNumber" class="text-sm text-red-500"></span>
                    }
                    else
                    {
                        <input asp-for="Patient.IdentityNumber" class="mt-1 block w-full cursor-not-allowed rounded-md border-gray-300 bg-gray-100 shadow-sm" readonly />
                        <small class="text-gray-500">@SharedLocalizer["Users_IdentityReadOnly"]</small>
                    }
                </div> *@
                <div class="min-w-[200px] flex-1">
                    <label asp-for="Patient.BirthDate" class="block text-sm font-medium text-gray-700">@SharedLocalizer["Shared_Date_Of_Birth"]</label>
                    <input asp-for="Patient.BirthDate" type="date" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="Patient.BirthDate" class="text-sm text-red-500"></span>
                </div>
            </div>
        </div>
        break;

    case "doctor":
        <div class="card mb-4">
            <div class="card-header">
                <h5>@SharedLocalizer["Users_DoctorInformation"]</h5>
            </div>
            <div class="card-body flex gap-4">
                <input type="hidden" asp-for="Doctor.Id" />
                <div class="min-w-[200px] flex-1">
                    <label asp-for="Doctor.SpecialtyId" class="block text-sm font-medium text-gray-700"></label>
                    <select asp-for="Doctor.SpecialtyId" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                        <option value="">@SharedLocalizer["Users_SelectSpecialty"]</option>
                                @if (ViewBag.Specialties != null)
                                {
                                    @foreach (var specialty in ViewBag.Specialties as List<Specialty>)
                                    {
                                        <option value="@specialty.Id">@specialty.Name</option>
                                    }
                                }
                                else
                                {
                                    <option value="">@SharedLocalizer["Users_NoSpecialties"]</option>
                                }
                    </select>
                    <span asp-validation-for="Doctor.SpecialtyId" class="text-sm text-red-500"></span>
                </div>
            </div>
        </div>
        break;
    }

    <div class="mt-6 flex gap-2">
        <a href="@Url.Action("Index")"
           class="rounded-lg bg-secondary bg-opacity-20 px-6 py-1.5 text-secondary transition duration-150 hover:bg-opacity-40 hover:shadow-xl">
            @SharedLocalizer["Shared_Cancel"]
        </a>

        <button type="submit"
                class="rounded-lg bg-primary px-6 py-1.5 text-white transition duration-150 hover:bg-primary-dark hover:shadow-xl">
            @(isEditMode ? @SharedLocalizer["Profile_SaveBtn"] : @SharedLocalizer["Users_CreateTitle"])
        </button>
    </div>

    <div asp-validation-summary="All" class="mb-4 text-sm text-red-500"></div>
</form>
