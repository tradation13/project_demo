@model UserProfileViewModel
@inject IWebHostEnvironment WebHostEnvironment

@{
    Layout = Convert.ToBoolean(ViewBag.HasDashboard)
        ? "~/Views/Shared/Layouts/_DashboardLayout.cshtml"
        : "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
    bool isEditMode = ViewBag.IsEditMode ?? false;
    bool canEdit = ViewBag.CanEdit ?? false;

    // Profile subject identity — set by ProfileController (not only Model.Admin)
    var profileKind = (ViewBag.ProfileKind as string)?.ToLowerInvariant()
        ?? (Model.Doctor != null ? "doctor"
            : Model.Admin != null ? "admin"
            : "patient");
    var isDoctorProfile = profileKind == "doctor";
    var isAdminProfile = profileKind == "admin";
    var isPatientProfile = !isDoctorProfile && !isAdminProfile;

    if (isDoctorProfile)
    {
        ViewBag.LoadPractitionerCss = true;
    }

    var displayName = $"{Model.FirstName} {Model.LastName}".Trim();
    if (string.IsNullOrWhiteSpace(displayName))
    {
        displayName = ViewBag.UserName as string ?? SharedLocalizer["Profile_Title"].Value;
    }
    var avatarLetter = !string.IsNullOrEmpty(displayName) ? displayName.Substring(0, 1).ToUpper() : "?";
    var avatarInitials = displayName.Length > 0
        ? string.Join("", displayName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(n => n[0].ToString().ToUpper()))
        : "?";

    string? doctorPhotoUrl = null;
    var doctorPhotoExists = false;
    if (Model.Doctor != null && !string.IsNullOrWhiteSpace(Model.Doctor.PhotoUrl))
    {
        doctorPhotoUrl = System.IO.Path.GetFileName(Model.Doctor.PhotoUrl.Trim());
        var doctorPhotoPath = System.IO.Path.Combine(WebHostEnvironment.ContentRootPath, "InternalStorage", "DoctorPhotos", doctorPhotoUrl);
        doctorPhotoExists = System.IO.File.Exists(doctorPhotoPath);
    }

    // —— Design tokens by role ——
    string pageWrap;
    string card;
    string btnPrimary;
    string btnSecondary;
    string labelCls;
    string inputEdit;
    string inputReadonly;
    string sectionCard;
    string sectionIcon;
    string sectionTitle;
    string fieldIcon;
    string titleCls;
    string subtitleCls;
    string eyebrowCls;
    string borderCls;

    if (isDoctorProfile)
    {
        pageWrap = "prac-page space-y-6 w-full";
        card = "header-card prac-header-card p-5 sm:p-7";
        btnPrimary = "btn-add-test";
        btnSecondary = "btn-prac-secondary";
        labelCls = "prac-label";
        inputEdit = "prac-input";
        inputReadonly = "prac-input bg-gray-50";
        sectionCard = "rounded-xl border border-gray-200 bg-gray-50 p-4 sm:p-5";
        sectionIcon = "flex h-9 w-9 items-center justify-center rounded-full bg-violet-100 text-violet-800";
        sectionTitle = "text-base font-semibold text-gray-800";
        fieldIcon = "pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-gray-400";
        titleCls = "truncate text-xl font-semibold text-gray-900";
        subtitleCls = "truncate text-sm text-gray-500";
        eyebrowCls = "text-xs font-semibold uppercase tracking-wide text-gray-400";
        borderCls = "border-gray-100";
    }
    else if (isAdminProfile)
    {
        // AdminDesign — distinct from patient (indigo gradient, page header, slate shell)
        pageWrap = "w-full animate-fade-slide-up";
        card = "rounded-2xl border border-slate-100 bg-white px-5 py-6 shadow-sm shadow-slate-100 sm:px-8 sm:py-7";
        btnPrimary = "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-primary/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg sm:w-auto";
        btnSecondary = "inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition-all duration-200 hover:bg-slate-50 sm:w-auto";
        labelCls = "mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400";
        inputEdit = "w-full rounded-lg border border-slate-200 bg-white px-3 py-2.5 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10";
        inputReadonly = "w-full rounded-lg border border-slate-200 bg-slate-50 px-3 py-2.5 text-sm text-slate-600";
        sectionCard = "rounded-2xl border border-slate-100 bg-slate-50/70 p-4 sm:p-5";
        sectionIcon = "flex h-9 w-9 items-center justify-center rounded-xl bg-indigo-50 text-indigo-600";
        sectionTitle = "text-sm font-bold text-slate-800 sm:text-base";
        fieldIcon = "pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300";
        titleCls = "text-xl font-bold text-slate-800";
        subtitleCls = "truncate text-sm text-slate-500";
        eyebrowCls = "text-xs font-semibold uppercase tracking-wide text-slate-400";
        borderCls = "border-slate-100";
    }
    else
    {
        // Patient — keep current design
        pageWrap = "mx-auto w-full max-w-4xl px-4 py-6 sm:px-6 sm:py-8 lg:px-8";
        card = "rounded-2xl border border-slate-100 bg-white px-4 py-5 shadow-sm shadow-slate-100 sm:px-6 sm:py-7 lg:px-8";
        btnPrimary = "inline-flex w-full items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-primary to-primary-dark px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-primary/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg sm:w-auto";
        btnSecondary = "inline-flex w-full items-center justify-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition-all duration-200 hover:bg-slate-50 sm:w-auto";
        labelCls = "mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400";
        inputEdit = "w-full rounded-lg border border-slate-200 bg-white py-2.5 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10";
        inputReadonly = "w-full rounded-lg border border-slate-200 bg-slate-50 py-2.5 ps-9 pe-3 text-sm text-slate-600";
        sectionCard = "rounded-2xl border border-slate-100 bg-slate-50/70 p-4 sm:p-5";
        sectionIcon = "flex h-9 w-9 items-center justify-center rounded-xl bg-primary/10 text-primary";
        sectionTitle = "text-sm font-bold text-slate-800 sm:text-base";
        fieldIcon = "pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300";
        titleCls = "truncate text-xl font-bold text-slate-800 sm:text-2xl";
        subtitleCls = "truncate text-sm text-slate-500";
        eyebrowCls = "text-xs font-semibold uppercase tracking-wide text-slate-400";
        borderCls = "border-slate-100";
    }

    var useIconInputs = isDoctorProfile || isPatientProfile;
    var inputWithIconEdit = isDoctorProfile
        ? "prac-input with-icon"
        : isAdminProfile
            ? inputEdit + " ps-9"
            : inputEdit;
    var inputWithIconReadonly = isDoctorProfile
        ? "prac-input with-icon bg-gray-50"
        : isAdminProfile
            ? inputReadonly + " ps-9"
            : inputReadonly;
}

<div class="@pageWrap">
    @if (isAdminProfile)
    {
        @* AdminDesign page header — same pattern as EditAdmin *@
        <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <div class="flex min-w-0 items-center gap-3">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    <i class="fas fa-user-shield"></i>
                </span>
                <div class="min-w-0">
                    <h4 class="@titleCls">@SharedLocalizer["Profile_Title"]</h4>
                    <p class="@subtitleCls">@displayName@(ViewBag.UserName != null ? $" · {ViewBag.UserName}" : "")</p>
                </div>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <span class="inline-flex items-center gap-1.5 rounded-lg bg-indigo-50 px-3 py-1.5 text-xs font-semibold text-indigo-600">
                    <i class="fas fa-shield-halved text-[10px]"></i>
                    @SharedLocalizer["Shared_Admin"]
                </span>
                @if (canEdit && !isEditMode)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="@btnPrimary">
                        <i class="fas fa-pen text-xs"></i>
                        @SharedLocalizer["Profile_EditBtn"]
                    </a>
                }
            </div>
        </div>
    }

    <div class="@card">

        @if (!isAdminProfile)
        {
            <div class="mb-6 flex flex-col gap-4 border-b @borderCls pb-6 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex min-w-0 items-center gap-3 sm:gap-4">
                    @if (doctorPhotoExists)
                    {
                        <img src="/InternalStorage/DoctorPhotos/@doctorPhotoUrl"
                             alt="@displayName"
                             class="@(isDoctorProfile
                                 ? "h-12 w-12 shrink-0 rounded-full object-cover ring-2 ring-violet-100 sm:h-[52px] sm:w-[52px]"
                                 : "h-14 w-14 shrink-0 rounded-full border-2 border-white object-cover shadow-sm sm:h-16 sm:w-16")" />
                    }
                    else if (isDoctorProfile)
                    {
                        <div class="avatar-lg">@avatarInitials</div>
                    }
                    else
                    {
                        <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-full bg-primary/10 text-lg font-bold text-primary sm:h-16 sm:w-16 sm:text-xl">
                            @avatarLetter
                        </span>
                    }
                    <div class="min-w-0">
                        <p class="@eyebrowCls">@SharedLocalizer["Profile_Title"]</p>
                        <h2 class="@titleCls">@displayName</h2>
                        @if (ViewBag.UserName != null)
                        {
                            <p class="@subtitleCls">@ViewBag.UserName</p>
                        }
                    </div>
                </div>

                @if (canEdit && !isEditMode)
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="@btnPrimary">
                        @if (isDoctorProfile)
                        {
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                            </svg>
                        }
                        else
                        {
                            <i class="fas fa-pen text-xs"></i>
                        }
                        @SharedLocalizer["Profile_EditBtn"]
                    </a>
                }
            </div>
        }

        <form asp-action="Edit" asp-controller="Profile" method="post" enctype="multipart/form-data" class="space-y-6">
            <div asp-validation-summary="ModelOnly"
                 class="@(isDoctorProfile
                     ? "rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800"
                     : "rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-600")"></div>

            <div class="grid grid-cols-1 gap-4 @(isAdminProfile ? "md:grid-cols-2" : "sm:grid-cols-2")">
                @if (!isEditMode && Model.Doctor == null)
                {
                    <div>
                        <label class="@labelCls">@SharedLocalizer["Shared_UserName"]</label>
                        @if (useIconInputs || isAdminProfile)
                        {
                            <div class="relative">
                                <span class="@fieldIcon"><i class="fas fa-at text-xs"></i></span>
                                <input value="@ViewBag.UserName" disabled class="@inputWithIconReadonly" />
                            </div>
                        }
                        else
                        {
                            <input value="@ViewBag.UserName" disabled class="@inputReadonly" />
                        }
                    </div>
                }

                <div>
                    <label asp-for="Email" class="@labelCls">@SharedLocalizer["Shared_Email"]</label>
                    <div class="relative">
                        @if (useIconInputs || isAdminProfile)
                        {
                            <span class="@fieldIcon"><i class="fas fa-envelope text-xs"></i></span>
                        }
                        @if (isEditMode)
                        {
                            <input asp-for="Email" type="email" class="@(useIconInputs || isAdminProfile ? inputWithIconEdit : inputEdit)" />
                        }
                        else
                        {
                            <input asp-for="Email" type="email" disabled class="@(useIconInputs || isAdminProfile ? inputWithIconReadonly : inputReadonly)" />
                        }
                    </div>
                    @if (isEditMode)
                    {
                        <span asp-validation-for="Email" class="mt-1.5 block text-xs text-red-500"></span>
                    }
                </div>

                <div>
                    <label asp-for="FirstName" class="@labelCls">@SharedLocalizer["Shared_FirstName"]</label>
                    <div class="relative">
                        @if (useIconInputs || isAdminProfile)
                        {
                            <span class="@fieldIcon"><i class="fas fa-user text-xs"></i></span>
                        }
                        @if (isEditMode)
                        {
                            <input asp-for="FirstName" type="text" class="@(useIconInputs || isAdminProfile ? inputWithIconEdit : inputEdit)" />
                        }
                        else
                        {
                            <input asp-for="FirstName" type="text" disabled class="@(useIconInputs || isAdminProfile ? inputWithIconReadonly : inputReadonly)" />
                        }
                    </div>
                    @if (isEditMode)
                    {
                        <span asp-validation-for="FirstName" class="mt-1.5 block text-xs text-red-500"></span>
                    }
                </div>

                <div>
                    <label asp-for="LastName" class="@labelCls">@SharedLocalizer["Shared_LastName"]</label>
                    <div class="relative">
                        @if (useIconInputs || isAdminProfile)
                        {
                            <span class="@fieldIcon"><i class="fas fa-id-badge text-xs"></i></span>
                        }
                        @if (isEditMode)
                        {
                            <input asp-for="LastName" type="text" class="@(useIconInputs || isAdminProfile ? inputWithIconEdit : inputEdit)" />
                        }
                        else
                        {
                            <input asp-for="LastName" type="text" disabled class="@(useIconInputs || isAdminProfile ? inputWithIconReadonly : inputReadonly)" />
                        }
                    </div>
                    @if (isEditMode)
                    {
                        <span asp-validation-for="LastName" class="mt-1.5 block text-xs text-red-500"></span>
                    }
                </div>

                <div>
                    <label asp-for="PhoneNumber" class="@labelCls">@SharedLocalizer["Shared_Phone"]</label>
                    <div class="relative">
                        @if (useIconInputs || isAdminProfile)
                        {
                            <span class="@fieldIcon"><i class="fas fa-phone text-xs"></i></span>
                        }
                        @if (isEditMode)
                        {
                            <input asp-for="PhoneNumber" class="@(useIconInputs || isAdminProfile ? inputWithIconEdit : inputEdit)" />
                        }
                        else
                        {
                            <input type="text" value="@(Model.PhoneNumber ?? SharedLocalizer["Profile_NotAvailable"].Value)" disabled
                                   class="@(useIconInputs || isAdminProfile ? inputWithIconReadonly : inputReadonly)" />
                        }
                    </div>
                    @if (isEditMode)
                    {
                        <span asp-validation-for="PhoneNumber" class="mt-1.5 block text-xs text-red-500"></span>
                    }
                </div>
            </div>

            @if (isAdminProfile)
            {
                <div class="@sectionCard">
                    <div class="mb-4 flex items-center gap-2">
                        <span class="@sectionIcon"><i class="fas fa-user-shield"></i></span>
                        <h3 class="@sectionTitle">@SharedLocalizer["Profile_AdminDetails"]</h3>
                    </div>
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        @if (Model.Admin != null)
                        {
                            <div>
                                <label asp-for="Admin.Id" class="@labelCls">@SharedLocalizer["Shared_Admin"] @SharedLocalizer["Shared_ID"]</label>
                                <div class="relative">
                                    <span class="@fieldIcon"><i class="fas fa-shield-halved text-xs"></i></span>
                                    <input type="text" asp-for="Admin.Id" readonly class="@inputWithIconReadonly" />
                                </div>
                            </div>
                        }
                        <div>
                            <label class="@labelCls">@SharedLocalizer["Shared_UserName"]</label>
                            <div class="relative">
                                <span class="@fieldIcon"><i class="fas fa-at text-xs"></i></span>
                                <input type="text" value="@ViewBag.UserName" readonly class="@inputWithIconReadonly" />
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (Model.Admin != null)
            {
                <div class="@sectionCard">
                    <div class="mb-4 flex items-center gap-2">
                        <span class="@sectionIcon"><i class="fas fa-user-shield"></i></span>
                        <h3 class="@sectionTitle">@SharedLocalizer["Profile_AdminDetails"]</h3>
                    </div>
                    <div>
                        <label asp-for="Admin.Id" class="@labelCls">@SharedLocalizer["Shared_Admin"] @SharedLocalizer["Shared_ID"]</label>
                        <div class="relative">
                            <span class="@fieldIcon"><i class="fas fa-shield-halved text-xs"></i></span>
                            <input type="text" asp-for="Admin.Id" readonly class="@inputWithIconReadonly" />
                        </div>
                    </div>
                </div>
            }

            @if (Model.Patient != null && !isAdminProfile)
            {
                <div class="@sectionCard">
                    <div class="mb-4 flex items-center gap-2">
                        <span class="@sectionIcon"><i class="fas fa-notes-medical"></i></span>
                        <h3 class="@sectionTitle">@SharedLocalizer["Profile_PatientDetails"]</h3>
                    </div>
                    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
                        <div>
                            <label class="@labelCls">@SharedLocalizer["Shared_Date_Of_Birth"]</label>
                            <div class="relative">
                                <span class="@fieldIcon"><i class="fas fa-cake-candles text-xs"></i></span>
                                <input type="text" value="@Model.Patient.BirthDate.ToShortDateString()" readonly
                                       class="@inputWithIconReadonly" />
                            </div>
                        </div>
                    </div>
                </div>
            }

            @if (Model.Doctor != null)
            {
                @if (isEditMode)
                {
                    <div class="@sectionCard">
                        <div class="mb-4 flex items-center gap-2">
                            <span class="@sectionIcon"><i class="fas fa-user-doctor"></i></span>
                            <h3 class="@sectionTitle">@SharedLocalizer["Users_DoctorInformation"]</h3>
                        </div>

                        <div class="mb-4">
                            <label class="@labelCls">@SharedLocalizer["Profile_Photo"]</label>
                            @if (isDoctorProfile)
                            {
                                <label for="doctorPhoto" class="btn-prac-indigo cursor-pointer">
                                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"/>
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    </svg>
                                    <span>@SharedLocalizer["Profile_ChangePhoto"]</span>
                                </label>
                            }
                            else
                            {
                                <label for="doctorPhoto"
                                       class="inline-flex cursor-pointer items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 transition-all duration-200 hover:border-primary hover:text-primary">
                                    <i class="fas fa-camera text-primary"></i>
                                    <span>@SharedLocalizer["Profile_ChangePhoto"]</span>
                                </label>
                            }
                            <input asp-for="Doctor.PhotoFile" id="doctorPhoto" type="file" accept="image/*" class="hidden" onchange="showFileName(this)" />
                            <span id="fileNameDisplay" class="mt-2 block text-xs @(isDoctorProfile ? "text-gray-400" : "text-slate-400")"></span>
                            <span asp-validation-for="Doctor.PhotoFile" class="mt-1 block text-xs text-red-500"></span>
                        </div>

                        <div>
                            <label asp-for="Doctor.SpecialtyId" class="@labelCls">@SharedLocalizer["Profile_Specialty"]</label>
                            <div class="relative">
                                <span class="@fieldIcon"><i class="fas fa-stethoscope text-xs"></i></span>
                                <select asp-for="Doctor.SpecialtyId"
                                        class="@(isDoctorProfile
                                            ? "prac-input with-icon with-icon-end appearance-none"
                                            : "block w-full appearance-none rounded-lg border border-slate-200 bg-white py-2.5 ps-9 pe-8 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10")">
                                    <option value="">@SharedLocalizer["Profile_SelectSpecialty"]</option>
                                    @if (ViewBag.Specialties is List<Specialty> specialties)
                                    {
                                        foreach (var specialty in specialties)
                                        {
                                            <option value="@specialty.Id" selected="@(specialty.Id == Model.Doctor.SpecialtyId ? "selected" : String.Empty)">@specialty.Name</option>
                                        }
                                    }
                                </select>
                                <span class="pointer-events-none absolute inset-y-0 end-0 flex items-center pe-3 @(isDoctorProfile ? "text-gray-400" : "text-slate-300")">
                                    <i class="fas fa-chevron-down text-xs"></i>
                                </span>
                            </div>
                            <span asp-validation-for="Doctor.SpecialtyId" class="mt-1.5 block text-xs text-red-500"></span>
                        </div>

                        <script>
                            function showFileName(input) {
                                const label = document.getElementById('fileNameDisplay');
                                if (input.files && input.files[0]) {
                                    label.textContent = input.files[0].name;
                                }
                            }
                        </script>
                    </div>
                }
                else if (ViewBag.Specialties is List<Specialty> specialties)
                {
                    <div class="@sectionCard">
                        <div class="mb-4 flex items-center gap-2">
                            <span class="@sectionIcon"><i class="fas fa-stethoscope"></i></span>
                            <h3 class="@sectionTitle">@SharedLocalizer["Profile_Specialty"]</h3>
                        </div>
                        <div class="relative">
                            <span class="@fieldIcon"><i class="fas fa-stethoscope text-xs"></i></span>
                            <input type="text"
                                   value="@(specialties.FirstOrDefault(i => i.Id == Model.Doctor.SpecialtyId)?.Name ?? SharedLocalizer["Profile_NotAvailable"].Value)"
                                   readonly
                                   class="@inputWithIconReadonly" />
                        </div>
                    </div>
                }
            }

            @if (isEditMode)
            {
                <div class="flex flex-col-reverse gap-3 border-t @borderCls pt-5 sm:flex-row sm:items-center">
                    <button type="submit" class="@btnPrimary">
                        @if (isDoctorProfile)
                        {
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                            </svg>
                        }
                        else
                        {
                            <i class="fas fa-check text-xs"></i>
                        }
                        @SharedLocalizer["Profile_SaveBtn"]
                    </button>
                    <a asp-action="Index" asp-route-id="@Model.Id" class="@btnSecondary">
                        @if (isDoctorProfile)
                        {
                            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
                            </svg>
                        }
                        else
                        {
                            <i class="fas fa-xmark text-xs"></i>
                        }
                        @SharedLocalizer["Shared_Cancel"]
                    </a>
                </div>
            }
        </form>
    </div>
</div>
