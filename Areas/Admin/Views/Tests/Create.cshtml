@model TestViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    var availableGroups = ViewBag.AvailableGroups as List<TestGroupViewModel>;
    ViewData["Title"] = SharedLocalizer["Tests_AddNew"];
}

<div>
    <h4 class="text-xl capitalize">@SharedLocalizer["TestGroups_AddNew"]</h4>
    <form asp-action="Create" method="post">
        <input hidden asp-for="Id" />

        <!-- Name -->
        <div class="my-4 flex flex-col">
            <label asp-for="Name" class="mb-1"></label>
            <input asp-for="Name" class="mt-1 rounded border-gray-300 py-1 focus:outline-none focus:ring-0" placeholder='@SharedLocalizer["Tests_Name"]' />
            <span asp-validation-for="Name" class="text-sm text-red-500"></span>
        </div>

        <!-- Test Group Dropdown -->
        <div class="my-4 flex flex-col">
            <label asp-for="TestGroupId" class="mb-1">@SharedLocalizer["Tests_GroupLabel"]</label>
            <select asp-for="TestGroupId" class="mt-1 rounded border-gray-300 py-1 focus:outline-none focus:ring-0">
                <option value="">@SharedLocalizer["Tests_SelectGroup"]</option>
                @if (availableGroups != null)
                {
                    foreach (var group in availableGroups)
                    {
                        <option value="@group.Id">@group.Name</option>
                    }
                }
            </select>
            <span asp-validation-for="TestGroupId" class="text-sm text-red-500"></span>
        </div>

        <!-- Buttons -->
        <div class="mt-6 flex gap-2">
            <a href="@Url.Action("Index")"
               class="rounded-lg bg-secondary bg-opacity-20 px-6 py-1.5 text-secondary transition duration-150 hover:bg-opacity-40 hover:shadow-xl">
                @SharedLocalizer["Shared_Cancel"]
            </a>
            <button type="submit" class="rounded-lg bg-primary px-6 py-1.5 text-white transition duration-150 hover:bg-primary-dark hover:shadow-xl">
                @SharedLocalizer["Shared_Submit"]
            </button>
        </div>
    </form>
</div>
