@using IPTS.ViewModels
@model AppointmentEditViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="bg-white rounded-lg px-8 py-6">
    <div class="flex items-center justify-between mb-4">
        <h4 class="text-xl font-semibold">Edit Appointment</h4>
        <a href="@Url.Action("Index", "Appointments", new { area = "doctor" })"
           class="bg-gray-500 text-white text-sm px-4 py-1 rounded hover:bg-gray-600 transition duration-150">
            Back to List
        </a>
    </div>

    <form asp-action="Edit" method="post" class="mt-8">
        <input type="hidden" asp-for="Id" />
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
                <label asp-for="PatientId" class="block text-sm font-medium text-gray-700 mb-2">Patient ID</label>
                <input asp-for="PatientId" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                <span asp-validation-for="PatientId" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="DoctorId" class="block text-sm font-medium text-gray-700 mb-2">Doctor ID</label>
                <input asp-for="DoctorId" type="number" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                <span asp-validation-for="DoctorId" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="ScheduledTime" class="block text-sm font-medium text-gray-700 mb-2">Scheduled Time</label>
                <input asp-for="ScheduledTime" type="datetime-local" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent" />
                <span asp-validation-for="ScheduledTime" class="text-red-500 text-sm"></span>
            </div>

            <div>
                <label asp-for="Status" class="block text-sm font-medium text-gray-700 mb-2">Status</label>
                <select asp-for="Status" asp-items="Html.GetEnumSelectList<AppointmentStatus>()" class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent">
                </select>
                <span asp-validation-for="Status" class="text-red-500 text-sm"></span>
            </div>
        </div>

        <div class="mt-8 flex justify-end space-x-3">
            <a href="@Url.Action("Index", "Appointments", new { area = "doctor" })" 
               class="bg-gray-500 text-white px-6 py-2 rounded-md hover:bg-gray-600 transition duration-150">
                Cancel
            </a>
            <button type="submit" class="bg-primary text-white px-6 py-2 rounded-md hover:bg-primary-dark transition duration-150">
                Update Appointment
            </button>
        </div>
    </form>
</div>
