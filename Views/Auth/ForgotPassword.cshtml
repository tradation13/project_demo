@model ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["ForgotPass_PageTitle"];
}

<div class="auth-ui-card auth-ui-pad relative mx-auto w-full max-w-md overflow-hidden rounded-[2rem] border border-white/70 bg-white/85 p-8 shadow-[0_24px_80px_rgba(15,23,42,0.12)] backdrop-blur-xl sm:p-10">
    <div class="pointer-events-none absolute inset-0 overflow-hidden rounded-[2rem]">
        <div class="auth-ui-orb auth-ui-orb-a absolute -left-10 -top-10 h-32 w-32 rounded-full bg-emerald-500/10 blur-3xl"></div>
        <div class="auth-ui-orb auth-ui-orb-b absolute -bottom-12 -right-8 h-36 w-36 rounded-full bg-blue-500/10 blur-3xl"></div>
    </div>

    <div class="relative z-10">
        <div class="mb-8 text-center">
            <div class="mx-auto mb-5 flex h-14 w-14 items-center justify-center rounded-2xl bg-gradient-to-br from-emerald-500 to-teal-600 text-white shadow-lg shadow-emerald-500/20 ring-1 ring-white/60">
                <i class="fas fa-lock text-lg" aria-hidden="true"></i>
            </div>
            <h2 class="auth-ui-title text-3xl font-extrabold tracking-tight sm:text-[2rem]">
                @SharedLocalizer["Shared__ForgotPassword"]
            </h2>
            <p class="mt-3 text-sm leading-6 text-slate-500 sm:text-[0.95rem]">
                @SharedLocalizer["ForgotPass_Desc"]
            </p>
        </div>

        <form class="space-y-5" asp-action="ForgotPassword" method="post" novalidate autocomplete="off">
            <div class="space-y-2">
                <label asp-for="Email" class="ml-1 block text-sm font-medium text-slate-700">
                    @SharedLocalizer["Shared_EmailAddress"]
                </label>
                <div class="relative">
                    <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3.5 text-slate-300">
                        <i class="fas fa-envelope text-sm" aria-hidden="true"></i>
                    </span>
                    <input asp-for="Email"
                           type="email"
                           aria-describedby="Email-error"
                           class="auth-ui-input w-full rounded-2xl border border-slate-200 bg-white/90 py-3.5 ps-10 pe-4 text-[15px] text-slate-900 outline-none transition-all placeholder:text-slate-400 focus:border-emerald-500 focus:ring-4 focus:ring-emerald-500/10"
                           placeholder="@SharedLocalizer["Shared_EnterYourEmail"]" />
                </div>
                <span asp-validation-for="Email" id="Email-error" class="mt-1 block text-xs text-red-500"></span>
            </div>

            <button type="submit"
                    class="inline-flex w-full items-center justify-center gap-2 rounded-2xl bg-gradient-to-r from-emerald-600 to-emerald-500 px-8 py-3.5 font-semibold text-white shadow-lg shadow-emerald-600/20 transition-all duration-200 hover:-translate-y-0.5 hover:from-emerald-700 hover:to-emerald-600 hover:shadow-xl hover:shadow-emerald-700/25">
                <i class="fas fa-paper-plane text-xs" aria-hidden="true"></i>
                @SharedLocalizer["ForgotPass_SubmitBtn"]
            </button>

            @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
        </form>

        <div class="mt-6">
            <a href="@(Url.Action("Login", "Auth"))"
               class="inline-flex w-full items-center justify-center gap-2 rounded-2xl border border-slate-200 bg-white px-6 py-3.5 font-semibold text-slate-600 transition-all duration-200 hover:border-emerald-300 hover:bg-emerald-50 hover:text-emerald-700">
                <i class="fas fa-arrow-left text-xs" aria-hidden="true"></i>
                @SharedLocalizer["Shared_BackToLogin"]
            </a>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")
