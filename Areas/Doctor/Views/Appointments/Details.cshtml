@using IPTS.ViewModels
@model AppointmentViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="rounded-lg bg-white px-8 py-6">
    <div class="mb-4 flex items-center justify-between">
        <h4 class="text-xl font-semibold">@SharedLocalizer["Shared_Appointment"] @SharedLocalizer["Shared_Details"]</h4>
        <div class="flex space-x-2">
            @* <a href="@Url.Action("Edit", "Appointments", new { id = Model.Id, area = "doctor" })" *@
            @*    class="rounded bg-yellow-500 px-4 py-1 text-sm text-white transition duration-150 hover:bg-yellow-600"> *@
            @*     Edit *@
            @* </a> *@
            <a href="@Url.Action("Index", "Appointments", new { area = "doctor" })"
               class="rounded bg-gray-500 px-4 py-1 text-sm text-white transition duration-150 hover:bg-gray-600">
                @SharedLocalizer["Shared_Back"]
            </a>
        </div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="rounded-lg bg-gray-50 p-4">
            <h5 class="mb-3 font-semibold text-gray-700">@SharedLocalizer["Shared_Appointment"] @SharedLocalizer["Shared_Information"]</h5>
            <div class="space-y-3">
                <div>
                    <label class="text-sm font-medium text-gray-600">@SharedLocalizer["Shared_ID"]:</label>
                    <p class="text-gray-900">@Model.Id</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-600">@SharedLocalizer["Appt_Status"]:</label>
                  <span class="@(Model.Status == AppointmentStatus.Confirmed ?"rounded-full px-2 py-1 text-xs bg-green-100 text-green-800" :
                         Model.Status == AppointmentStatus.Pending ? "bg-yellow-100 text-yellow-800" :
                         Model.Status == AppointmentStatus.Completed ? "bg-blue-100 text-blue-800" :
                         "bg-red-100 text-red-800")">
    @SharedLocalizer[$"Status_{Model.Status}"]
</span>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-600">@SharedLocalizer["Appt_ScheduledTime"]:</label>
                    <p class="text-gray-900">@Model.ScheduledTime.ToString("MMMM dd, yyyy 'at' HH:mm")</p>
                </div>
            </div>
        </div>

        <div class="rounded-lg bg-gray-50 p-4">
            <h5 class="mb-3 font-semibold text-gray-700">@SharedLocalizer["Shared_People"] @SharedLocalizer["Shared_Information"]</h5>
            <div class="space-y-3">
                <div>
                    <label class="text-sm font-medium text-gray-600">@SharedLocalizer["Shared_Patient"] @SharedLocalizer["Contact_Label_Name"]:</label>
                    <p class="text-gray-900">@Model.PatientName</p>
                </div>
                <div>
                    <label class="text-sm font-medium text-gray-600">@SharedLocalizer["Therapies_Doctor"] @SharedLocalizer["Contact_Label_Name"]:</label>
                    <p class="text-gray-900">@Model.DoctorName</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional section for notes and prescription -->
    <div class="mt-6 rounded-lg bg-gray-50 p-4">
        <h5 class="mb-3 font-semibold text-gray-700">@SharedLocalizer["Shared_Notes"]</h5>
        <p class="text-gray-900">@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</p>

        @if (!string.IsNullOrWhiteSpace(Model.PrescriptionFileName))
        {
            <div class="mt-4">
                <span class="font-medium">@SharedLocalizer["Shared_Prescription"]:</span>
                <a href="@Url.Action("DownloadPrescription", "Appointments", new { id = Model.Id, area = "Doctor" })" target="_blank" rel="noopener noreferrer" class="ml-1 inline-block rounded bg-blue-100 px-2 py-1 text-blue-700 hover:bg-blue-200">
                    <img src="~/images/logo.png" class="inline-block h-4 w-4" alt="logo" /> @Model.PrescriptionDisplayName
                </a>
            </div>
        }
    </div>
</div>
