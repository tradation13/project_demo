@using IPTS.ViewModels
@model PatientCreateViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewBag.Title = SharedLocalizer["Patient_Create_Title"];
}

<div class="prac-page space-y-6 max-w-4xl">

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
            <div class="avatar-lg">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
                </svg>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-gray-900 leading-tight">@SharedLocalizer["Patient_Create_Title"]</h2>
                <p class="text-sm text-gray-500 mt-0.5">@SharedLocalizer["Patient_Guidelines_Title"]</p>
            </div>
        </div>
        <a href="@Url.Action("SearchPatient", "Appointments", new { area = "doctor" })" class="btn-prac-secondary">
            @SharedLocalizer["Patient_BackToSearch"]
        </a>
    </div>

    <div class="header-card p-4 border-blue-100 bg-blue-50">
        <ul class="space-y-1 text-sm text-blue-800">
            <li>• <strong>@SharedLocalizer["Patient_Label_BasicInfo"]:</strong> @SharedLocalizer["Patient_Desc_BasicInfo"]</li>
            <li>• <strong>@SharedLocalizer["Patient_Label_AccountAccess"]:</strong> @SharedLocalizer["Patient_Desc_AccountAccess"]</li>
            <li>• <strong>@SharedLocalizer["Shared_Date_Of_Birth"]:</strong> @SharedLocalizer["Patient_Guideline_Medical"]</li>
            <li>• <strong>@SharedLocalizer["Patient_Label_AfterCreation"]:</strong> @SharedLocalizer["Patient_Desc_AfterCreation"]</li>
        </ul>
        <p class="mt-3 rounded-lg border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
            <strong>@SharedLocalizer["Appt_Sched_Note"]:</strong> @SharedLocalizer["Patient_CreationNote"]
        </p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">@TempData["WarningMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">@TempData["InfoMessage"]</div>
    }

    <div class="header-card prac-header-card p-5 sm:p-7">
        <form asp-action="CreatePatient" method="post">
            <div class="mb-6 grid grid-cols-1 gap-5 md:grid-cols-2">
                <div>
                    <label asp-for="FirstName" class="prac-label">@SharedLocalizer["Shared_FirstName"] *</label>
                    <input asp-for="FirstName" type="text" class="prac-input" placeholder=@SharedLocalizer["Reg_Placeholder_FirstName"] />
                    <span asp-validation-for="FirstName" class="mt-1 block text-xs text-red-700"></span>
                </div>
                <div>
                    <label asp-for="LastName" class="prac-label">@SharedLocalizer["Shared_LastName"] *</label>
                    <input asp-for="LastName" type="text" class="prac-input" placeholder=@SharedLocalizer["Reg_Placeholder_LastName"] />
                    <span asp-validation-for="LastName" class="mt-1 block text-xs text-red-700"></span>
                </div>
                <div>
                    <label asp-for="PhoneNumber" class="prac-label">@SharedLocalizer["Shared_Phone"] *</label>
                    <input asp-for="PhoneNumber" type="tel" class="prac-input" placeholder=@SharedLocalizer["Search_PlaceholderPhone"] />
                    <span asp-validation-for="PhoneNumber" class="mt-1 block text-xs text-red-700"></span>
                </div>
                <div>
                    <label asp-for="Email" class="prac-label">@SharedLocalizer["Shared_Email"] *</label>
                    <input asp-for="Email" type="email" class="prac-input" placeholder=@SharedLocalizer["Shared_EnterYourEmail"] />
                    <span asp-validation-for="Email" class="mt-1 block text-xs text-red-700"></span>
                </div>
                <div>
                    <label asp-for="BirthDate" class="prac-label">@SharedLocalizer["Shared_Date_Of_Birth"] *</label>
                    <input asp-for="BirthDate" type="date" class="prac-input" />
                    <span asp-validation-for="BirthDate" class="mt-1 block text-xs text-red-700"></span>
                </div>
            </div>

            @{ ViewData["HealthFieldsVariant"] = "prac"; }
            <div class="mb-6">
                <partial name="_PatientHealthFields" />
            </div>

            <div class="group-divider mb-5">
                <div class="group-divider-line"></div>
                <span class="group-label">@SharedLocalizer["Patient_Label_AccountAccess"]</span>
                <div class="group-divider-line"></div>
            </div>

            <div class="mb-6 grid grid-cols-1 gap-5 md:grid-cols-2">
                <div>
                    <label asp-for="UserName" class="prac-label">@SharedLocalizer["Shared_UserName"] *</label>
                    <input asp-for="UserName" type="text" class="prac-input" placeholder=@SharedLocalizer["Patient_Placeholder_User"] />
                    <span asp-validation-for="UserName" class="mt-1 block text-xs text-red-700"></span>
                </div>
                <div>
                    <label asp-for="Password" class="prac-label">@SharedLocalizer["Shared_Password"] *</label>
                    <input asp-for="Password" type="password" class="prac-input" placeholder=@SharedLocalizer["Patient_Placeholder_Pass"] />
                    <span asp-validation-for="Password" class="mt-1 block text-xs text-red-700"></span>
                </div>
                <div>
                    <label asp-for="ConfirmPassword" class="prac-label">@SharedLocalizer["Shared_ConfirmPassword"] *</label>
                    <input asp-for="ConfirmPassword" type="password" class="prac-input" placeholder=@SharedLocalizer["Shared_ConfirmPassword"] />
                    <span asp-validation-for="ConfirmPassword" class="mt-1 block text-xs text-red-700"></span>
                </div>
            </div>

            <div class="flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                <a href="@Url.Action("SearchPatient", "Appointments", new { area = "doctor" })" class="btn-prac-secondary">
                    @SharedLocalizer["Shared_Cancel"]
                </a>
                <button type="submit" class="btn-add-test">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    @SharedLocalizer["Patient_BtnCreate"]
                </button>
            </div>
        </form>
        <div asp-validation-summary="All" class="mt-4 text-sm text-red-700"></div>
    </div>
</div>
