@model ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
}


<div class="mx-auto w-full max-w-md bg-white shadow rounded-lg p-8">
    <h2 class="text-center text-2xl font-bold tracking-wide text-gray-800">Forgot Your Password?</h2>
    <p class="text-center text-sm text-gray-600 mt-2">
        No problem. Just let us know your email address and we will email you a password reset link that will allow you to choose a new one.
    </p>

    <form class="my-8 text-sm" asp-action="ForgotPassword" method="post" autocomplete="off">
        <div class="flex flex-col my-4">
            <label asp-for="Email" class="text-gray-700">Email Address</label>
            <input asp-for="Email" type="email"
                   class="mt-2 py-2 border-gray-300 focus:outline-none focus:ring-0
                          focus:border-gray-300 rounded text-sm text-gray-900"
                   placeholder="Enter your email" />
            <span asp-validation-for="Email" class="text-sm text-red-500"></span>
        </div>

        <div class="my-4 flex items-center justify-end space-x-4">
            <button type="submit"
                    class="bg-primary hover:bg-primary-dark rounded-lg px-8 py-2
                           text-gray-100 hover:shadow-xl transition duration-150 uppercase">
                Email Password Reset Link
            </button>
        </div>

        @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
    </form>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")
