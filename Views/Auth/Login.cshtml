@model LoginViewModel
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Login_PageTitle"];
}
@* Clear chatbot SessionId on the login page so a new identity never reuses the previous chat session. *@
<script>
    (function () {
        try {
            sessionStorage.removeItem("physiotech_n8n_chat_session");
        } catch (e) { /* ignore */ }
    })();
</script>

<div class="mx-auto w-full max-w-md overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
    <div class="h-1 bg-[#0D7A62]"></div>

    <div class="px-7 py-8 sm:px-9 sm:py-10">
        <div class="mb-8 border-b border-slate-100 pb-6">
            <h1 class="text-xl font-semibold tracking-tight text-slate-800 sm:text-2xl">
                @SharedLocalizer["Shared_SignIn"]
            </h1>
            <p class="mt-2 text-sm leading-6 text-slate-500">
                @SharedLocalizer["Login_Subtitle"]
            </p>
        </div>

        <form asp-controller="auth" asp-action="login" method="post" autocomplete="off" class="space-y-5 text-sm">
            @Html.AntiForgeryToken()
            <input asp-for="ReturnUrl" type="hidden" />

            <div>
                <label asp-for="UsernameOrEmail" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                    @SharedLocalizer["Login_Label_UserEmail"]
                </label>
                <input asp-for="UsernameOrEmail"
                       class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition focus:border-[#0D7A62] focus:ring-2 focus:ring-[#0D7A62]/15" />
                <span asp-validation-for="UsernameOrEmail" class="mt-1.5 block text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="Password" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                    @SharedLocalizer["Shared_Password"]
                </label>
                <div x-data="{ show: false }" class="relative">
                    <input :type="show ? 'text' : 'password'"
                           asp-for="Password"
                           class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 pe-11 text-sm text-slate-800 outline-none transition focus:border-[#0D7A62] focus:ring-2 focus:ring-[#0D7A62]/15" />
                    <button x-on:click="show = !show" type="button"
                            class="absolute inset-y-0 end-0 flex w-11 items-center justify-center text-slate-400 transition hover:text-slate-600"
                            aria-label="@SharedLocalizer["Shared_Password"]">
                        <i :class="show ? 'fas fa-eye' : 'fas fa-eye-slash'" class="text-sm"></i>
                    </button>
                </div>
                <span asp-validation-for="Password" class="mt-1.5 block text-xs text-red-600"></span>
            </div>

            <div class="flex flex-wrap items-center justify-between gap-3 pt-0.5">
                <label for="remember_me" class="flex items-center gap-2 text-slate-600">
                    <input asp-for="RememberMe" type="checkbox" id="remember_me"
                           class="rounded border-slate-300 text-[#0D7A62] focus:ring-[#0D7A62]" />
                    <span>@SharedLocalizer["Login_RememberMe"]</span>
                </label>

                <a href="@Url.Action("ForgotPassword","auth")"
                   class="font-medium text-[#0D7A62] transition hover:text-[#0a6350] hover:underline">
                    @SharedLocalizer["Shared__ForgotPassword"]
                </a>
            </div>

            <div class="flex flex-col gap-3 pt-2">
                <button type="submit"
                        class="inline-flex w-full items-center justify-center rounded-lg bg-[#0D7A62] px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0a6350]"
                        aria-label="@SharedLocalizer["Shared_SignIn"]">
                    @SharedLocalizer["Shared_SignIn"]
                </button>

                <a asp-controller="Home" asp-action="Index"
                   class="inline-flex w-full items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-800">
                    @SharedLocalizer["Login_BackHome"]
                </a>
            </div>

            <p class="pt-1 text-center text-sm text-slate-500">
                @SharedLocalizer["Login_NoAccount"]
                <a href="@Url.Action("Register", "Auth")"
                   class="font-semibold text-[#0D7A62] hover:text-[#0a6350] hover:underline"
                   title="@SharedLocalizer["Login_SignUp_Title"]">
                    @SharedLocalizer["Login_SignUp_Link"]
                </a>
            </p>

            @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
        </form>

        @await Html.PartialAsync("_ValidationScriptsPartial")
    </div>
</div>
