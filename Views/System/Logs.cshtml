@model List<LogViewModel>
@using IPTS.ViewModels

@{
    Layout = ViewBag.HasDashboard == true
        ? "~/Views/Shared/Layouts/_DashboardLayout.cshtml"
        : "~/Views/Shared/Layouts/_AuthLayout.cshtml";
}

<div x-data="{ filter: false, systemSection: '' }" class="custom-scrollbar overflow-x-auto rounded-lg bg-white px-8 py-6">

    <!-- Header -->
    <div class="mb-4 flex items-center justify-between">
        <h2 class="text-xl font-bold">@SharedLocalizer["Logs_Title"]</h2>
        <button x-on:click="filter = !filter"
                class="rounded bg-primary px-4 py-1 text-sm text-white transition duration-150 hover:bg-primary-dark">
            @SharedLocalizer["Logs_Btn_ToggleFilter"]
        </button>
    </div>

    <div class="mb-4">
        <form method="get" class="flex items-center space-x-4">
            <input type="text"
                   name="systemSection"
                   value="@(Context.Request.Query["systemSection"])"
                   class="rounded border border-gray-300 px-2 py-1 focus:outline-none focus:ring-0"
                   placeholder=@SharedLocalizer["Logs_Placeholder_Section"]>
            <button type="submit"
                    class="rounded bg-secondary px-4 py-1 text-sm text-white transition duration-150 hover:bg-primary-dark">
                @SharedLocalizer["Logs_Btn_Filter"]
            </button>
        </form>
    </div>

    <!-- Logs Table -->
    <div class="overflow-x-auto">
        <table class="mb-8 w-full table-auto whitespace-nowrap border border-gray-200">
            <thead class="bg-secondary font-bold text-white">
                <tr>
                    <th class="px-3 py-2 text-center">#</th>
                    <th class="px-3 py-2 text-center">@SharedLocalizer["Logs_Table_Level"]</th>
                    <th class="px-3 py-2 text-left">@SharedLocalizer["Logs_Table_Description"]</th>
                    <th class="px-3 py-2 text-left">@SharedLocalizer["Logs_Table_User"]</th>
                    <th class="px-3 py-2 text-left">@SharedLocalizer["Logs_Table_Section"]</th>
                    <th class="px-3 py-2 text-center">@SharedLocalizer["Logs_Table_Time"]</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int x = 0;
                    foreach (var log in Model)
                    {
                        var levelColor = log.Level switch
                        {
                            "5" => "bg-red-600 text-white",
                            "4" => "bg-red-400 text-white",
                            "3" => "bg-yellow-300",
                            "2" => "bg-blue-200",
                            "1" => "bg-gray-200",
                            _ => ""
                        };
                        <tr class="hover:bg-gray-100">
                            <td class="px-2 py-1 text-center">@(++x)</td>
                            <td class="@levelColor px-2 py-1 text-center">@log.Level</td>
                            <td class="px-2 py-1">@log.Description</td>
                            <td class="px-2 py-1">@(!string.IsNullOrEmpty(log.UserName) ? log.UserName : log.UserId)</td>
                            <td class="px-2 py-1">@log.SystemSection</td>
                            <td class="px-2 py-1 text-center">@log.Timestamp.ToString("g")</td>
                        </tr>
                }
           
            }
            </tbody>
        </table>
    </div>
</div>
