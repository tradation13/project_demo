@model IPTS.ViewModels.ResetPasswordConfirmViewModel

@{
    Layout = "~/Views/Shared/Layouts/_MainLayout.cshtml";
}

<h2 class="mb-6 text-center text-3xl font-bold text-gray-800">
    @SharedLocalizer["ResetPass_Header"]
</h2>

<form class="space-y-6 text-left" asp-action="ResetPasswordConfirm" method="post" autocomplete="off">
    <input asp-for="Token" type="hidden" />
    <input asp-for="Email" type="hidden" />

    <div class="my-4 flex flex-col">
        <label asp-for="NewPassword" class="mb-1 block text-sm font-medium text-gray-700">
            @SharedLocalizer["Shared_NewPassword"]
        </label>
        <div x-data="{ show: false }" class="relative mt-2 flex items-center">
            <input :type="show ? 'text' : 'password'"
                   asp-for="NewPassword"
                   class="flex-1 rounded border-gray-300 py-2 pr-10 text-sm text-gray-900 focus:border-gray-300 focus:outline-none focus:ring-0"
                   placeholder="@SharedLocalizer["Shared_EnterNewPassword"]" />
            <button x-on:click ="show = !show" type="button"
                    class="absolute right-2 flex items-center justify-center bg-transparent text-gray-700">
                <svg x-show="!show" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59"></path>
                </svg>
                <svg x-show="show" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display: none;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
            </button>
        </div>
        <span asp-validation-for="NewPassword" class="text-sm text-red-500"></span>
    </div>

    <div class="my-4 flex flex-col">
        <label asp-for="ConfirmPassword" class="mb-1 block text-sm font-medium text-gray-700">
            @SharedLocalizer["Shared_ConfirmPassword"]
        </label>
        <div x-data="{ show: false }" class="relative mt-2 flex items-center">
            <input :type="show ? 'text' : 'password'"
                   asp-for="ConfirmPassword"
                   class="flex-1 rounded border-gray-300 py-2 pr-10 text-sm text-gray-900 focus:border-gray-300 focus:outline-none focus:ring-0"
                   placeholder="@SharedLocalizer["Shared_ConfirmNewPassword"]" />
            <button x-on:click ="show = !show" type="button"
                    class="absolute right-2 flex items-center justify-center bg-transparent text-gray-700">
                <svg x-show="!show" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l3.59 3.59"></path>
                </svg>
                <svg x-show="show" class="h-5 w-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display: none;">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-sm text-red-500"></span>
    </div>

    <button type="submit"
            class="w-full rounded-lg bg-blue-500 py-2.5 font-semibold text-white hover:bg-blue-600 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
        @SharedLocalizer["Shared_ResetPassword"]
    </button>

    @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
</form>

@await Html.PartialAsync("_ValidationScriptsPartial")