@model ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["ForgotPass_PageTitle"];
}

<div class="flex items-center justify-center bg-gradient-to-b from-gray-50 to-white ">
    <style>
        @@keyframes fadeInUp { from { opacity: 0; transform: translateY(18px) scale(.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
        .animate-fade-in-up { animation: fadeInUp 640ms cubic-bezier(.16,.8,.24,1) both; }
    </style>
    <div class="w-full max-w-md bg-white/90 rounded-xl p-6 shadow-md ring-1 ring-gray-100 animate-fade-in-up">
        <div class="flex flex-col items-center text-center">
            <div class="flex h-16 w-16 items-center justify-center rounded-full bg-primary/10 text-primary mb-4">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 10-8 0v4M5 12h14v7a2 2 0 01-2 2H7a2 2 0 01-2-2v-7z" />
                </svg>
            </div>
            <h2 class="text-2xl font-semibold text-gray-800">@SharedLocalizer["Shared__ForgotPassword"]</h2>
            <p class="mt-2 text-sm text-gray-600">@SharedLocalizer["ForgotPass_Desc"]</p>
        </div>

        <form class="mt-6" asp-action="ForgotPassword" method="post" novalidate autocomplete="off">
            <div class="space-y-4">
                <div>
                    <label asp-for="Email" class="sr-only">@SharedLocalizer["Shared_EmailAddress"]</label>
                    <div class="relative">
                        <span class="absolute inset-y-0 left-0 flex items-center pl-3 text-gray-400">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor">
                                <path d="M2.94 6.94A8 8 0 1117.06 17.06 8 8 0 012.94 6.94zM7 8a3 3 0 106 0 3 3 0 00-6 0z" />
                            </svg>
                        </span>
                        <input asp-for="Email" type="email" aria-describedby="Email-error"
                               class="w-full border border-gray-200 bg-white/60 py-3 pl-11 pr-4 text-sm text-gray-900 rounded-lg shadow-sm focus:outline-none focus:ring-2 focus:ring-primary/40"
                               placeholder="@SharedLocalizer["Shared_EnterYourEmail"]" />
                    </div>
                    <span asp-validation-for="Email" id="Email-error" class="mt-2 block text-sm text-red-600"></span>
                </div>

                <div class="flex items-center justify-between">
                    <button type="submit" class="flex-1 inline-flex items-center justify-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-medium text-white shadow hover:bg-primary-dark transition">
                       
                        @SharedLocalizer["ForgotPass_SubmitBtn"]
                    </button>
                </div>

                @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
            </div>
        </form>

        <div class="mt-6 flex justify-center">
            <a href="@(Url.Action("Login", "Auth"))" class="inline-flex items-center gap-2 rounded-lg border border-primary bg-white px-5 py-2 text-sm text-primary hover:bg-primary hover:text-white transition">
               
                @SharedLocalizer["Shared_BackToLogin"]
            </a>
        </div>
    </div>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")