<header class="sticky top-0 z-50 bg-gray-50 shadow-sm transition-colors">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex h-16 items-center justify-between lg:h-20">
            <!-- Logo -->
            <a asp-controller="Home" asp-area="" asp-action="Index" class="flex shrink-0 items-center space-x-2">
                <img src="/images/logo.svg" alt="ipts Logo"
                    class="h-12 w-auto transition-transform hover:scale-105 sm:h-14 md:h-24 lg:h-28">
            </a>

           <nav class="hidden items-center gap-2 min-[1000px]:flex">
    
    <div class="flex items-center gap-1">
        <a asp-controller="Home" asp-area="" asp-action="Index" 
           class="group relative whitespace-nowrap px-4 py-2 text-sm font-bold text-gray-700 transition-colors hover:text-green-600">
            @SharedLocalizer["Shared_Home"]
            <span class="absolute inset-x-4 bottom-1 h-0.5 scale-x-0 bg-green-600 transition-transform duration-300 group-hover:scale-x-100"></span>
        </a>

        <a asp-controller="Home" asp-area="" asp-action="About" 
           class="group relative whitespace-nowrap px-4 py-2 text-sm font-bold text-gray-700 transition-colors hover:text-green-600">
            @SharedLocalizer["About"]
            <span class="absolute inset-x-4 bottom-1 h-0.5 scale-x-0 bg-green-600 transition-transform duration-300 group-hover:scale-x-100"></span>
        </a>

        <a asp-controller="Home" asp-area="" asp-action="Contact" 
           class="group relative whitespace-nowrap px-4 py-2 text-sm font-bold text-gray-700 transition-colors hover:text-green-600">
            @SharedLocalizer["Contact"]
            <span class="absolute inset-x-4 bottom-1 h-0.5 scale-x-0 bg-green-600 transition-transform duration-300 group-hover:scale-x-100"></span>
        </a>

          <a asp-controller="Home" asp-area="" asp-action="Treatments" 
           class="group relative whitespace-nowrap px-4 py-2 text-sm font-bold text-gray-700 transition-colors hover:text-green-600">
           @SharedLocalizer["Shared_Treatments"]
            <span class="absolute inset-x-4 bottom-1 h-0.5 scale-x-0 bg-green-600 transition-transform duration-300 group-hover:scale-x-100"></span>
        </a>

        <a asp-controller="Home" asp-area="" asp-action="Therapies" 
           class="group relative whitespace-nowrap px-4 py-2 text-sm font-bold text-gray-700 transition-colors hover:text-green-600">
            @SharedLocalizer["Therapies"]
            <span class="absolute inset-x-4 bottom-1 h-0.5 scale-x-0 bg-green-600 transition-transform duration-300 group-hover:scale-x-100"></span>
        </a>

        @if (User.IsInRole("doctor") || User.IsInRole("admin"))
        {
            var area = User.IsInRole("admin") ? "Admin" : "Doctor";
            <a asp-area="@area" asp-controller="Dashboard" asp-action="Index" 
               class="ml-2 rounded-full bg-green-50 px-4 py-2 text-sm font-bold text-green-700 ring-1 ring-inset ring-green-600/20 transition-all hover:bg-green-600 hover:text-white">
                @SharedLocalizer["Dashboard"]
            </a>
        }
    </div>

    <div class="mx-2 h-6 w-px bg-gray-200"></div>

    @{
        var currentCulture = Context.Features.Get<IRequestCultureFeature>()?.RequestCulture.Culture.Name;
        var targetCulture = currentCulture == "de-DE" ? "en-US" : "de-DE";
        var toggleLabel = currentCulture == "de-DE" ? "EN" : "DE";
        var languageLabel = SharedLocalizer["Language"].Value;

        // Fallback: if de culture falls back to key text, force German label.
        if (currentCulture?.StartsWith("de") == true && string.Equals(languageLabel, "Language", StringComparison.OrdinalIgnoreCase))
        {
            languageLabel = "Sprache";
        }
    }

    <a asp-area="" 
   asp-controller="Home" 
   asp-action="SetLanguage" 
   asp-route-culture="@targetCulture" 
   asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
   class="group flex items-center gap-2 rounded-xl border border-gray-100 bg-white p-1.5 pr-3 shadow-sm transition-all hover:border-green-600 hover:shadow-md">
        
        <div class="flex h-7 w-7 items-center justify-center rounded-lg bg-gray-50 text-gray-500 transition-colors group-hover:bg-green-50 group-hover:text-green-600">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 0 1 6.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5c.13 3.74-.93 7.607-3.751 10.5M4.5 9c1.94 1.44 4.5 2.5 7.5 3" />
            </svg>
        </div>
        
        <span class="text-[11px] font-bold uppercase tracking-tighter text-gray-400 group-hover:text-green-700">@toggleLabel</span>
    </a>
</nav>

            <!-- Right Side Controls -->
            <div class="ml-2 flex shrink-0 items-center gap-1 sm:gap-3">
                <!-- Theme Toggle -->
                <button id="theme-toggle"
                        class="p-2 text-gray-600 transition-colors hover:text-green-600">
                    <i data-lucide="moon" id="theme-icon" class="h-5 w-5"></i>
                </button>

                

                @if (User?.Identity?.IsAuthenticated != true)
                {
                    <!-- Auth Button (Join) -->
                    <a asp-controller="Auth" asp-action="Login"
                       class="guest-desktop-join rounded-lg px-4 py-2 text-base font-bold text-green-600 transition-colors hover:text-green-700">
                        @SharedLocalizer["Join"]
                    </a>
                }
                else
                {
                    <!-- Desktop User Menu -->
                    <div class="desktop-user-menu relative ml-2">
                        <input id="desktop-user-menu-toggle" type="checkbox" class="desktop-user-menu-toggle sr-only" />
                        <label for="desktop-user-menu-toggle"
                               class="desktop-user-menu-button inline-flex max-w-[200px] cursor-pointer items-center gap-2 rounded-lg border border-gray-200 bg-white px-3 py-2 text-sm font-bold text-gray-700 shadow-sm transition-colors hover:border-green-600 hover:text-green-700">
                            <i class="fas fa-user-circle text-lg"></i>
                            <span class="truncate">@User.Identity?.Name</span>
                            <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </label>

                        <div id="desktop-user-menu-panel" class="hidden absolute right-0 z-50 mt-2 w-56 rounded-lg border border-gray-100 bg-white py-2 shadow-lg">
                            <a asp-area="" asp-controller="Profile" asp-action="Index" class="block px-4 py-2 text-sm font-bold text-gray-700 transition-colors hover:bg-gray-100 hover:text-green-700">@SharedLocalizer["Shared_Profile"]</a>
                            @if (User.IsInRole("doctor"))
                            {
                                <a asp-area="Doctor" asp-controller="Dashboard" asp-action="Index" class="block px-4 py-2 text-sm font-bold text-gray-700 transition-colors hover:bg-gray-100 hover:text-green-700">@SharedLocalizer["Dashboard"]</a>
                            }
                            @if (User.IsInRole("admin"))
                            {
                                <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="block px-4 py-2 text-sm font-bold text-gray-700 transition-colors hover:bg-gray-100 hover:text-green-700">@SharedLocalizer["Dashboard"]</a>
                            }
                            @if (User.IsInRole("patient"))
                            {
                                <a asp-area="Patient" asp-controller="Panel" asp-action="Index" class="block px-4 py-2 text-sm font-bold text-gray-700 transition-colors hover:bg-gray-100 hover:text-green-700">@SharedLocalizer["Panel"]</a>
                                <a asp-area="Patient" asp-controller="Appointment" asp-action="Appointments" class="block px-4 py-2 text-sm font-bold text-gray-700 transition-colors hover:bg-gray-100 hover:text-green-700">@SharedLocalizer["MyAppointments"]</a>
                                <a asp-area="Patient" asp-controller="MedicalCases" asp-action="Index" class="block px-4 py-2 text-sm font-bold text-gray-700 transition-colors hover:bg-gray-100 hover:text-green-700">@SharedLocalizer["Shared_Medical_Cases"]</a>
                            }
                            <div class="my-1 border-t border-gray-100"></div>
                            <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                                <button type="submit" class="block w-full px-4 py-2 text-left text-sm font-bold text-red-600 transition-colors hover:bg-red-50 hover:text-red-700">@SharedLocalizer["Shared_Logout"]</button>
                            </form>
                        </div>
                    </div>
                }

                <!-- Mobile Menu Button -->
                <button id="mobile-menu-button"
                    class="mobile-only-trigger inline-flex items-center justify-center text-gray-700 transition-colors hover:text-green-600 @(User?.Identity?.IsAuthenticated == true ? "rounded-md border border-gray-200 p-2 hover:border-green-600" : "guest-mobile-menu-trigger gap-1 px-2 py-1.5 font-bold")">
                    @if (User?.Identity?.IsAuthenticated == true)
                    {
                        var userDisplayName = string.IsNullOrWhiteSpace(User.Identity?.Name)
                            ? SharedLocalizer["Shared_Profile"].Value
                            : User.Identity.Name;
                        <span class="flex items-center gap-1.5 leading-tight">
                            <i class="fas fa-user-circle text-base text-gray-600"></i>
                            <span class="max-w-[120px] truncate text-sm font-bold text-gray-700">@userDisplayName</span>
                            <svg class="h-3.5 w-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                        </span>
                    }
                    else
                    {
                        <span class="text-sm font-bold text-green-700">@SharedLocalizer["Join"]</span>
                        <svg class="h-3.5 w-3.5 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                        </svg>
                    }
                </button>
            </div>
        </div>

        <!-- Mobile Navigation -->
        <div id="mobile-menu" class="hidden border-t border-gray-200 py-4 min-[1000px]:hidden">
            <div class="flex flex-col space-y-2">
                <a asp-area="" asp-controller="Home" asp-action="Index" class="px-3 py-2 text-base font-bold text-gray-600 transition-colors hover:text-green-600">
                    @SharedLocalizer["Shared_Home"]
                </a>
                <a asp-area="" asp-controller="Home" asp-action="About" class="px-3 py-2 text-base font-bold text-gray-600 transition-colors hover:text-green-600">
                    @SharedLocalizer["About"]
                </a>
                <a asp-area="" asp-controller="Home" asp-action="Contact" class="px-3 py-2 text-base font-bold text-gray-600 transition-colors hover:text-green-600">
                    @SharedLocalizer["Contact"]
                </a>
                <a asp-area="" asp-controller="Home" asp-action="Treatments" class="px-3 py-2 text-base font-bold text-gray-600 transition-colors hover:text-green-600">
                    @SharedLocalizer["Shared_Treatments"]
                </a>
                <a asp-area="" asp-controller="Home" asp-action="Therapies" class="px-3 py-2 text-base font-bold text-gray-600 transition-colors hover:text-green-600">
                    @SharedLocalizer["Therapies"]
                </a>
                <a asp-area="" 
                   asp-controller="Home" 
                   asp-action="SetLanguage" 
                   asp-route-culture="@targetCulture" 
                   asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                   class="px-3 py-2 text-base font-bold text-gray-600 transition-colors hover:text-green-600">
                    @languageLabel (@toggleLabel)
                </a>
                @if (User?.Identity?.IsAuthenticated != true)
                {
                    <div class="border-t border-gray-200 pt-3">
                        <a asp-area="" asp-controller="Auth" asp-action="Login"
                           class="block px-3 py-2 text-center text-base font-bold text-green-600 transition-colors hover:text-green-700">
                            @SharedLocalizer["Join"]
                        </a>
                    </div>
                }
                @if (User?.Identity?.IsAuthenticated == true)
                {
                    <div class="space-y-3 border-t border-gray-200 pt-4">
                        <a asp-area="" asp-controller="Profile" asp-action="Index" class="block px-3 py-2 text-center text-base font-bold text-gray-600 hover:bg-gray-100">@SharedLocalizer["Shared_Profile"]</a>
                        @if (User.IsInRole("doctor"))
                        {
                            <a asp-area="Doctor" asp-controller="Dashboard" asp-action="Index" class="block px-3 py-2 text-center text-base font-bold text-gray-600 hover:bg-gray-100">@SharedLocalizer["Dashboard"]</a>
                        }
                        @if (User.IsInRole("admin"))
                        {
                            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="block px-3 py-2 text-center text-base font-bold text-gray-600 hover:bg-gray-100">@SharedLocalizer["Dashboard"]</a>
                        }
                        @if (User.IsInRole("patient"))
                        {
                            <a asp-area="Patient" asp-controller="Panel" asp-action="Index" class="block px-3 py-2 text-center text-base font-bold text-gray-600 hover:bg-gray-100">@SharedLocalizer["Panel"]</a>
                            <a asp-area="Patient" asp-controller="Appointment" asp-action="Appointments" class="block px-3 py-2 text-center text-base font-bold text-gray-600 hover:bg-gray-100">@SharedLocalizer["MyAppointments"]</a>
                            <a asp-area="Patient" asp-controller="MedicalCases" asp-action="Index" class="block px-3 py-2 text-center text-base font-bold text-gray-600 hover:bg-gray-100">@SharedLocalizer["Shared_Medical_Cases"]</a>
                        }
                        <form asp-area="" asp-controller="Auth" asp-action="Logout"  method="post">
                            <button type="submit" class="w-full px-3 py-2 text-center text-red-600 hover:bg-gray-100">@SharedLocalizer["Shared_Logout"]</button>
                        </form>
                    </div>
                }
            </div>
        </div>
    </div>
</header>

<style>
    .guest-desktop-join {
        display: none;
    }

    .desktop-user-menu {
        display: none;
    }

    @@media (min-width: 1000px) {
        .guest-desktop-join {
            display: inline-flex;
        }

        .desktop-user-menu {
            display: block;
        }

        .desktop-user-menu-toggle:checked ~ #desktop-user-menu-panel {
            display: block;
        }

        .desktop-user-menu-toggle:checked + .desktop-user-menu-button {
            border-color: rgb(22 163 74);
            color: rgb(21 128 61);
        }

        .mobile-only-trigger {
            display: none;
        }
    }

    @@media (max-width: 999.98px) {
        .mobile-only-trigger {
            display: inline-flex;
        }

        .guest-mobile-menu-trigger {
            display: inline-flex;
        }
    }
</style>

<script src="/js/header.js"></script>
<script> 
    function highlightActiveLink() { 
        const currentPath = window.location.pathname; 
        document.querySelectorAll('nav a').forEach(link => { 
            if (link.getAttribute('href') === currentPath) { 
                link.classList.add('text-green-600', 'border-b-2', 'border-green-600');
                link.classList.remove('text-gray-600', 'dark:text-gray-300');
            } else { 
                link.classList.remove('text-green-600', 'border-b-2', 'border-green-600');
                link.classList.add('text-gray-600', 'dark:text-gray-300');
            } 
        }); 
    } 
    document.addEventListener('DOMContentLoaded', function () { 
        highlightActiveLink(); 
        lucide.createIcons(); 
    }); 
    window.addEventListener('popstate', highlightActiveLink); 

    
</script>
