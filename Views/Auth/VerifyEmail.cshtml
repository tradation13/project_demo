@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
}
<h2 class="text-center text-2xl font-bold tracking-wide text-gray-800">Email Verification</h2>
<p class="text-center text-sm text-gray-600 mt-2">
    Thanks for signing up! Before getting started, please verify your email.
</p>
<div class="sm:flex items-center justify-between">
    <form asp-action="ResendVerificationEmail" method="post" class="my-8 text-sm">
        <button class="w-full sm:w-auto bg-primary hover:bg-primary-dark rounded-lg px-8 py-2 text-gray-100 hover:shadow-xl transition duration-150 uppercase">
            Resend Verification Email
        </button>
    </form>
    <form asp-action="Logout" method="post" class="flex items-center justify-center">
        <button class="text-gray-600 hover:text-gray-800 text-sm underline" title="Log Out">Log Out</button>
    </form>
</div>
