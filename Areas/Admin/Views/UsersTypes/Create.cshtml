@model UserType
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}
<div>
    <h4 class="text-xl capitalize">@SharedLocalizer["UserTypes_AddNew"]</h4>
    <form asp-action="Create" method="post">
        <div class="grid grid-cols-2 gap-8">
            <div class="my-4 flex flex-col">
                <label asp-for="Name" class="mb-1"></label>
                <input asp-for="Name" class="mt-1 flex-1 rounded border-gray-300 py-1 focus:outline-none focus:ring-0" placeholder=@SharedLocalizer["Shared_EnterName"] />
                <span asp-validation-for="Name" class="text-sm text-red-500"></span>
            </div>
            <div class="my-4 flex flex-col">
                <label asp-for="HasDashboard" class="mb-1">@SharedLocalizer["UserTypes_HasDashboard"]</label>
                <select asp-for="HasDashboard" class="mt-1 flex-1 rounded border-gray-300 py-1 focus:outline-none focus:ring-0">
                    <option value="true">@SharedLocalizer["Shared_Yes"]</option>
                    <option value="false">@SharedLocalizer["Shared_No"]</option>
                </select>
            </div>
        </div>

        <div class="grid grid-cols-3 gap-8">
            <div class="my-4 flex flex-col">
                <label asp-for="Registerable" class="mb-1"></label>
                <select asp-for="Registerable" class="mt-1 flex-1 rounded border-gray-300 py-1 focus:outline-none focus:ring-0">
                    <option value="true">@SharedLocalizer["Shared_Yes"]</option>
                    <option value="false">@SharedLocalizer["Shared_No"]</option>
                </select>
            </div>
            <div class="my-4 flex flex-col">
                <label asp-for="DefaultController" class="mb-1">@SharedLocalizer["UserTypes_DefaultController"]</label>
                <input asp-for="DefaultController" class="mt-1 flex-1 rounded border-gray-300 py-1 focus:outline-none focus:ring-0" placeholder=@SharedLocalizer["UserTypes_DefaultController"] />
            </div>
            <div class="my-4 flex flex-col">
                <label asp-for="DefaultAction" class="mb-1">@SharedLocalizer["UserTypes_DefaultAction"]</label>
                <input asp-for="DefaultAction" class="mt-1 flex-1 rounded border-gray-300 py-1 focus:outline-none focus:ring-0" placeholder=@SharedLocalizer["UserTypes_DefaultAction"] />
            </div>
        </div>
  
        <div class="grid grid-cols-2 gap-8">
            <div class="my-4 flex flex-col">
                <label asp-for="DefaultArea" class="mb-1">@SharedLocalizer["UserTypes_DefaultArea"]</label>
                <input asp-for="DefaultArea" class="mt-1 flex-1 rounded border-gray-300 py-1 focus:outline-none focus:ring-0" placeholder=@SharedLocalizer["UserTypes_DefaultArea"] />
            </div>
        </div>
        <div class="my-4 flex flex-col">
            <label asp-for="DefaultRoleId" class="mb-1">@SharedLocalizer["UserTypes_DefaultRole"]</label>
            <select asp-for="DefaultRoleId" asp-items="@((IEnumerable<SelectListItem>)ViewData["Roles"])"
                    class="mt-1 flex-1 rounded border-gray-300 py-1 focus:outline-none focus:ring-0">
                <option value="">@SharedLocalizer["Shared_SelectRole"]</option>
            </select>
            <span asp-validation-for="DefaultRoleId" class="text-sm text-red-500"></span>
        </div>
        <div class="form-group">
            <label asp-for="RequireAdminApproval" class="control-label">@SharedLocalizer["UserTypes_AdminApproval"]</label>
            <input asp-for="RequireAdminApproval" type="checkbox" class="form-check-input" />
            <span asp-validation-for="RequireAdminApproval" class="text-danger"></span>
        </div>

        <div class="mt-6 flex gap-2">
            <a href="@Url.Action("Index")"
               class="rounded-lg bg-secondary bg-opacity-20 px-6 py-1.5 text-secondary transition duration-150 hover:bg-opacity-40 hover:shadow-xl">
                @SharedLocalizer["Shared_Cancel"]
            </a>

            <button type="submit"
                    class="rounded-lg bg-primary px-6 py-1.5 text-white transition duration-150 hover:bg-primary-dark hover:shadow-xl">
                @SharedLocalizer["Shared_Submit"]
            </button>
        </div>

    </form>
    @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)

</div>