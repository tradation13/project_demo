@{
    ViewData["Title"] = SharedLocalizer["Shared_AccessDenied"];
    Layout = "~/Views/Shared/Layouts/_MainLayout.cshtml";
}

<style>
    .access-denied-page {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 2rem 1rem;
        background: linear-gradient(135deg, #fef2f2 0%, #fff7f7 50%, #fafafa 100%);
    }

    .access-denied-card {
        width: 100%;
        max-width: 480px;
        background: #ffffff;
        border-radius: 24px;
        padding: 3rem 2.5rem;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.07), 0 20px 60px -10px rgba(220,38,38,0.08);
        border: 1px solid rgba(220,38,38,0.08);
        text-align: center;
    }

    .access-icon-wrapper {
        width: 96px;
        height: 96px;
        border-radius: 50%;
        background: linear-gradient(135deg, #fee2e2, #fecaca);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1.75rem;
        border: 3px solid rgba(220,38,38,0.12);
    }

    .access-icon-wrapper i {
        font-size: 2.5rem;
        color: #dc2626;
    }

    .access-denied-card h1 {
        font-size: 1.75rem;
        font-weight: 700;
        color: #1f2937;
        margin-bottom: 0.75rem;
        line-height: 1.3;
    }

    .access-denied-card p {
        font-size: 1rem;
        color: #6b7280;
        line-height: 1.7;
        margin-bottom: 2rem;
    }

    .access-actions {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        align-items: center;
    }

    @@media (min-width: 480px) {
        .access-actions {
            flex-direction: row;
            justify-content: center;
        }
    }

    .btn-primary-action {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.75rem;
        background: #dc2626;
        color: #ffffff !important;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.15s ease;
        border: none;
        cursor: pointer;
    }

    .btn-primary-action:hover {
        background: #b91c1c;
        transform: translateY(-1px);
    }

    .btn-secondary-action {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.75rem 1.75rem;
        background: #f3f4f6;
        color: #374151 !important;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: none;
        transition: background 0.2s ease, transform 0.15s ease;
        border: none;
        cursor: pointer;
    }

    .btn-secondary-action:hover {
        background: #e5e7eb;
        transform: translateY(-1px);
    }

    .access-divider {
        width: 48px;
        height: 3px;
        background: linear-gradient(90deg, #fca5a5, #dc2626);
        border-radius: 99px;
        margin: 0 auto 1.5rem;
    }
</style>

<div class="access-denied-page">
    <div class="access-denied-card">
        <div class="access-icon-wrapper">
            <i class="fa-solid fa-user-lock"></i>
        </div>

        <h1>@SharedLocalizer["Shared_AccessDenied"]</h1>

        <div class="access-divider"></div>

        <p>
            🚫 @SharedLocalizer["Access_Message"]<br />
            @SharedLocalizer["Access_ContactAdmin"]
        </p>

        <div class="access-actions">
            <a href="@Url.Action("Index", "Home")" class="btn-primary-action">
                <i class="fa-solid fa-house"></i> @SharedLocalizer["Access_GoHome"]
            </a>
            <button type="button" onclick="history.go(-1)" class="btn-secondary-action">
                <i class="fa-solid fa-arrow-left"></i> @SharedLocalizer["Shared_Back"]
            </button>
        </div>
    </div>
</div>