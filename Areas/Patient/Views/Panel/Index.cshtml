@model IPTS.Areas.Patient.ViewsModels.PatientPanelViewModel
@{
    ViewData["Title"] = "Patient Panel";
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
}

<div class="max-w-3xl mx-auto py-10">
    <div class="mb-8">
        <h2 class="text-3xl font-bold text-gray-800 mb-2 flex items-center gap-2">
            <i class="fas fa-user-circle text-primary"></i>
            IPTS Patient Panel
        </h2>
        <p class="text-gray-600">Manage your appointments, medical cases, and account easily.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10">
        <div class="bg-white rounded-lg shadow p-6 flex items-center gap-4">
            <div class="bg-blue-100 text-blue-600 rounded-full p-4">
                <i class="fas fa-calendar-check fa-2x"></i>
            </div>
            <div>
                <div class="text-2xl font-bold">@Model.AppointmentsCount</div>
                <div class="text-gray-700">Appointments</div>
            </div>
        </div>
        <div class="bg-white rounded-lg shadow p-6 flex items-center gap-4">
            <div class="bg-green-100 text-green-600 rounded-full p-4">
                <i class="fas fa-notes-medical fa-2x"></i>
            </div>
            <div>
                <div class="text-2xl font-bold">@Model.MedicalCasesCount</div>
                <div class="text-gray-700">Medical Cases</div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        <a href="@Url.Action("my-appointments", "Appointment", new { area = "patient" })"
           class="flex flex-col items-center bg-red-600 text-white border-2 border-red-600 rounded-lg p-6 hover:bg-red-700 hover:text-white transition shadow group">
            <i class="fas fa-calendar-alt fa-2x mb-2 group-hover:scale-110 transition"></i>
            <span class="font-semibold">Appointments</span>
        </a>

        <a href="@Url.Action("Index", "MedicalCases", new { area = "patient" })"
           class="flex flex-col items-center bg-green-600 text-white rounded-lg p-6 hover:bg-green-700 transition shadow group">
            <i class="fas fa-notes-medical fa-2x mb-2 group-hover:scale-110 transition"></i>
            <span class="font-semibold">Medical Cases</span>
        </a>
        <a href="@Url.Action("Index", "Profile", new { area = "" })"
           class="flex flex-col items-center bg-blue-600 text-white rounded-lg p-6 hover:bg-blue-700 transition shadow group">
            <i class="fas fa-user-cog fa-2x mb-2 group-hover:scale-110 transition"></i>
            <span class="font-semibold">Account</span>
        </a>
        <a href="@Url.Action("Index", "Home", new { area = "" })"
           class="flex flex-col items-center bg-gray-600 text-white rounded-lg p-6 hover:bg-gray-700 transition shadow group">
            <i class="fas fa-home fa-2x mb-2 group-hover:scale-110 transition"></i>
            <span class="font-semibold">Home</span>
        </a>
    </div>
</div>
