@{
    ViewData["Title"] = "About";
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
}
// About Section

<section class="bg-white py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 grid items-center gap-12 lg:grid-cols-2">
            <div class="space-y-6">
                <div class="flex items-center gap-3">
                    <div>
                        <p class="text-sm font-semibold uppercase tracking-wide text-primary-600">About PhysoTech</p>
                        <h1 class="text-4xl font-bold text-gray-900">Precision physiotherapy, powered by tech</h1>
                    </div>
                </div>
                <p class="text-lg leading-relaxed text-gray-700">
                    PhysoTech is a physiotherapy clinic dedicated to faster recovery and smarter care. We blend expert practitioners with digital workflows so every assessment, session, and follow-up is coordinated and measurable.
                </p>
                <p class="text-lg leading-relaxed text-gray-700">
                    The clinic runs on IPTS (Intelligent Patient Tracking System)  as our digital engine—handling booking, cases, and progress tracking—so our team stays focused on delivering hands-on treatment and personalized plans.
                </p>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="bg-primary-50 rounded-xl border border-primary-100 p-4">
                        <p class="font-semibold text-gray-900">Clinical excellence</p>
                        <p class="mt-1 text-sm text-gray-700">Manual therapy , exercise therapy, and spine care backed by protocols.</p>
                    </div>
                    <div class="bg-primary-50 rounded-xl border border-primary-100 p-4">
                        <p class="font-semibold text-gray-900">Patient experience</p>
                        <p class="mt-1 text-sm text-gray-700">Online booking, progress updates, and guided home programs keep patients engaged.</p>
                    </div>
                </div>
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="rounded-xl border border-gray-200 bg-white p-4">
                        <p class="font-semibold text-gray-900">Data-driven care</p>
                        <p class="mt-1 text-sm text-gray-700">IPTS dashboards surface adherence, ROM gains, and recovery velocity.</p>
                    </div>
                    <div class="rounded-xl border border-gray-200 bg-white p-4">
                        <p class="font-semibold text-gray-900">Team-ready</p>
                        <p class="mt-1 text-sm text-gray-700">Therapists, admins, and patients stay aligned with role-based access.</p>
                    </div>
                </div>
            </div>
            <div class="relative"> 
                <div class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-xl">
                    <img src="/images/home/hero.svg" alt="Clinic technology" class="h-auto w-full object-contain">
                </div>
                <div class="absolute -bottom-4 -left-4 hidden h-28 w-28 rounded-2xl bg-primary-100 opacity-60 blur-3xl lg:block"></div>
                <div class="absolute -right-4 -top-4 hidden h-24 w-24 rounded-2xl bg-primary-200 opacity-60 blur-3xl lg:block"></div>
            </div>
        </div>
    </div>
</section>