@model IPTS.Models.Entites.MedicalCaseTest
@{
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    var tests = ViewBag.Tests as List<IPTS.Models.Entites.Test>;
    ViewData["Title"] = "Add Test";
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<h2 class="text-2xl font-bold mb-4">
    Add Test for @($"{patient?.User?.FirstName} {patient?.User?.LastName}")
</h2>

<form asp-action="AddTest" method="post" class="bg-white rounded shadow p-6 max-w-lg">
    <input type="hidden" asp-for="MedicalCaseId" />

    <!-- حقل البحث -->
    <div class="mb-4 relative">
        <label class="block font-semibold mb-1">Search Test</label>
        <input type="text" id="testSearch" placeholder="Type to search test..."
               class="w-full border rounded px-3 py-2" autocomplete="off" />

        <!-- قائمة الاقتراحات -->
        <ul id="suggestions"
            class="absolute z-10 bg-white border rounded mt-1 w-full shadow max-h-48 overflow-y-auto hidden">
            @foreach (var t in tests)
            {
                <li data-id="@t.Id"
                    class="px-3 py-2 cursor-pointer hover:bg-green-100">
                    @($"{t.TestGroup?.Name} - {t.Name}")
                </li>
            }
        </ul>
    </div>

    <!-- الحقل الفعلي الذي يخزن TestId -->
    <input type="hidden" asp-for="TestId" id="selectedTestId" />
    <span asp-validation-for="TestId" class="text-red-500 text-sm"></span>

    <div class="mb-4">
        <label asp-for="Result" class="block font-semibold mb-1">Result (optional)</label>
        <input asp-for="Result" class="w-full border rounded px-3 py-2" />
    </div>

    <div class="mb-4">
        <label class="block font-semibold mb-1">Created At</label>
        <input asp-for="CreatedAt" type="date" class="w-full border rounded px-3 py-2"
               value="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>

    <button type="submit"
            class="bg-green-600 hover:bg-green-700 text-white px-6 py-2 rounded shadow font-bold">
        Add Test
    </button>
</form>

<script>
    const searchInput = document.getElementById("testSearch");
    const suggestionBox = document.getElementById("suggestions");
    const hiddenInput = document.getElementById("selectedTestId");

    // عند الكتابة يتم فلترة النتائج
    searchInput.addEventListener("input", function () {
        const filter = this.value.toLowerCase();
        const items = suggestionBox.getElementsByTagName("li");
        let visibleCount = 0;

        for (let item of items) {
            const text = item.textContent.toLowerCase();
            if (text.includes(filter) && filter.length > 0) {
                item.style.display = "";
                visibleCount++;
            } else {
                item.style.display = "none";
            }
        }

        suggestionBox.style.display = visibleCount > 0 ? "block" : "none";
        hiddenInput.value = ""; // مسح الاختيار عند تعديل البحث
    });

    // عند اختيار عنصر
    suggestionBox.addEventListener("click", function (e) {
        const li = e.target.closest("li");
        if (!li) return;
        const testName = li.textContent.trim();
        const testId = li.getAttribute("data-id");

        searchInput.value = testName;
        hiddenInput.value = testId;

        suggestionBox.style.display = "none";
    });

    // إغلاق القائمة عند فقدان التركيز
    document.addEventListener("click", function (e) {
        if (!suggestionBox.contains(e.target) && e.target !== searchInput) {
            suggestionBox.style.display = "none";
        }
    });
</script>
