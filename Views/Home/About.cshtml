@{
    ViewData["Title"] = SharedLocalizer["Shared_AboutPhysoTech"];
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
}

<section class="bg-white py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
        <div class="mb-16 grid items-center gap-12 lg:grid-cols-2">
            <div class="space-y-6">
                <div class="flex items-center gap-3">
                    <div>
                        <p class="text-sm font-semibold uppercase tracking-wide text-primary-600">@SharedLocalizer["Shared_AboutPhysoTech"]</p>
                        <h1 class="text-4xl font-bold text-gray-900">@SharedLocalizer["PageAbout_MainHeading"]</h1>
                    </div>
                </div>
                <p class="text-lg leading-relaxed text-gray-700">
                    @SharedLocalizer["PageAbout_IntroPara"]
                </p>
                <p class="text-lg leading-relaxed text-gray-700">
                    @SharedLocalizer["PageAbout_IPTSPara"]
                </p>
                
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="about-reveal bg-primary-50 rounded-xl border border-primary-100 p-4" data-delay="0" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                        <p class="font-semibold text-gray-900">@SharedLocalizer["PageAbout_Card1_Title"]</p>
                        <p class="mt-1 text-sm text-gray-700">@SharedLocalizer["PageAbout_Card1_Desc"]</p>
                    </div>
                    <div class="about-reveal bg-primary-50 rounded-xl border border-primary-100 p-4" data-delay="120" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                        <p class="font-semibold text-gray-900">@SharedLocalizer["PageAbout_Card2_Title"]</p>
                        <p class="mt-1 text-sm text-gray-700">@SharedLocalizer["PageAbout_Card2_Desc"]</p>
                    </div>
                </div>
                
                <div class="grid gap-4 sm:grid-cols-2">
                    <div class="about-reveal rounded-xl border border-gray-200 bg-white p-4" data-delay="240" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                        <p class="font-semibold text-gray-900">@SharedLocalizer["PageAbout_Card3_Title"]</p>
                        <p class="mt-1 text-sm text-gray-700">@SharedLocalizer["PageAbout_Card3_Desc"]</p>
                    </div>
                    <div class="about-reveal rounded-xl border border-gray-200 bg-white p-4" data-delay="360" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                        <p class="font-semibold text-gray-900">@SharedLocalizer["PageAbout_Card4_Title"]</p>
                        <p class="mt-1 text-sm text-gray-700">@SharedLocalizer["PageAbout_Card4_Desc"]</p>
                    </div>
                </div>
            </div>
            
            <div class="relative"> 
                <div class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-xl">
                    <img src="/images/home/hero.svg" alt="@SharedLocalizer["Hero_ImgAlt"]" class="h-auto w-full object-contain">
                </div>
                <div class="absolute -bottom-4 -left-4 hidden h-28 w-28 rounded-2xl bg-primary-100 opacity-60 blur-3xl lg:block"></div>
                <div class="absolute -right-4 -top-4 hidden h-24 w-24 rounded-2xl bg-primary-200 opacity-60 blur-3xl lg:block"></div>
            </div>
        </div>
    </div>
</section>

<script>
    (function () {
        const cards = document.querySelectorAll('.about-reveal');
        if (!cards.length) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) {
            cards.forEach((card) => {
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            });
            return;
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                const card = entry.target;
                if (entry.isIntersecting) {
                    const delay = card.getAttribute('data-delay') || '0';
                    card.style.transitionDelay = `${delay}ms`;
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                } else {
                    card.style.transitionDelay = '0ms';
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(28px)';
                }
            });
        }, { threshold: 0.25, rootMargin: '0px 0px -30px 0px' });

        cards.forEach((card) => observer.observe(card));
    })();
</script>