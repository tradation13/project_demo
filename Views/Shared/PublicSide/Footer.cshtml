<footer class="bg-gray-900 py-8 text-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <!-- Main Content -->
        <div class="mb-6 grid gap-8 md:grid-cols-3">
            <!-- Logo Section -->
            <div>
                <img src="/images/logo.svg" alt="IPTS Logo" class="mb-3 h-16 w-auto brightness-110 filter">
                <p class="text-sm leading-relaxed text-secondary-light">
                    @SharedLocalizer["SystemDescription"]
                </p>
            </div>

            <!-- Quick Links -->
            <div>
                <h3 class="mb-4 flex items-center gap-2 text-lg font-semibold text-white">
                    <i class="fas fa-link text-primary-500"></i>
                    @SharedLocalizer["QuickLinks"]
                </h3>
                <ul class="space-y-2">
                    <li>
                        <a href="@Url.Action("Index", "Home", new { area = "" })" 
                           class="flex items-center gap-2 text-secondary-light transition-colors duration-200 hover:text-primary-500">
                            <i class="fas fa-chevron-right text-xs"></i>
                             @SharedLocalizer["Shared_Home"]
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("About", "Home", new { area = "" })" 
                           class="flex items-center gap-2 text-secondary-light transition-colors duration-200 hover:text-primary-500">
                            <i class="fas fa-chevron-right text-xs"></i>
                            @SharedLocalizer["About"]
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Therapies", "Home", new { area = "" })" 
                           class="flex items-center gap-2 text-secondary-light transition-colors duration-200 hover:text-primary-500">
                            <i class="fas fa-chevron-right text-xs"></i>
                            @SharedLocalizer["Therapies"] 
                        </a>
                    </li>
                    <li>
                        <a href="@Url.Action("Contact", "Home", new { area = "" })" 
                           class="flex items-center gap-2 text-secondary-light transition-colors duration-200 hover:text-primary-500">
                            <i class="fas fa-chevron-right text-xs"></i>
                            @SharedLocalizer["Contact"] 
                        </a>
                    </li>
                </ul>
            </div>

            <!-- Contact Info -->
            <div>
                <h3 class="mb-4 flex items-center gap-2 text-lg font-semibold text-white">
                    <i class="fas fa-info-circle text-primary-500"></i>
                    @SharedLocalizer["Contact"] 
                </h3>
                <div class="space-y-3">
                    <div class="flex items-center gap-2">
                        <i class="fas fa-phone w-5 text-primary-500"></i>
                        <a href="tel:+905062646625" class="text-secondary-light transition-colors hover:text-primary-500">
                            +905062646625
                        </a>
                    </div>
                    <div class="flex items-center gap-2">
                        <i class="fas fa-envelope w-5 text-primary-500"></i>
                        <a href="mailto:muhammadkalumian@gmail.com" class="text-secondary-light transition-colors hover:text-primary-500">
                            muhammadkalumian@gmail.com
                        </a>
                    </div>
                    <div class="flex items-start gap-2">
                        <i class="fas fa-map-marker-alt mt-1 w-5 text-primary-500"></i>
                        <p class="text-sm text-secondary-light">
                            --
                            --

                        </p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Divider -->
        <div class="border-t border-gray-800 pt-4">
            <div class="text-center text-sm text-secondary-light">
                <p>&copy; @(DateTime.Now.Year) @SharedLocalizer["CopyRight"]</p>
            </div>
        </div>
    </div>
</footer>