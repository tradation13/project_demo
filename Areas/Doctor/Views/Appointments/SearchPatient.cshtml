@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Search_SearchPatient"];
}

<div class="prac-page space-y-6 w-full">

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
            <div class="avatar-lg">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
                </svg>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-gray-900 leading-tight">@SharedLocalizer["Search_SearchPatient"]</h2>
                <p class="text-sm text-gray-500 mt-0.5">@SharedLocalizer["Search_QuickStart"]</p>
            </div>
        </div>
        <a href="@Url.Action("Index", "Appointments", new { area = "doctor" })" class="btn-prac-secondary">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
            </svg>
            @SharedLocalizer["Search_BackToAppointments"]
        </a>
    </div>

    <div class="header-card p-4 border-blue-100 bg-blue-50">
        <p class="text-sm text-blue-800">@SharedLocalizer["Search_InstructionMain"]</p>
        <p class="mt-2 text-xs text-emerald-700 rounded-lg border border-emerald-200 bg-emerald-50 px-3 py-2">@SharedLocalizer["Search_Workflow"]</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">@TempData["WarningMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">@TempData["InfoMessage"]</div>
    }

    <div class="header-card prac-header-card p-5 sm:p-7">
        <form asp-action="SearchPatient" method="post">
            <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
                <div class="relative">
                    <label class="prac-label">@SharedLocalizer["Appt_PatientName"]</label>
                    <input id="patientSearchInput" name="SearchName" type="text" autocomplete="off"
                           class="prac-input" placeholder="@SharedLocalizer["Contact_Label_Name"]" />
                    <div id="searchSpinner" class="absolute right-3 top-9 hidden">
                        <i class="fas fa-spinner fa-spin text-indigo-500"></i>
                    </div>
                    <div id="suggestionsList" class="absolute z-50 mt-1 hidden max-h-64 w-full overflow-y-auto rounded-lg border border-gray-200 bg-white shadow-lg">
                        <div id="resultsContainer"></div>
                    </div>
                </div>
                <div>
                    <label class="prac-label">@SharedLocalizer["Shared_PhoneNumber"]</label>
                    <input id="patientPhone" name="PhoneNumber" type="text" class="prac-input" placeholder="05xxxxxxxx" />
                </div>
                <div>
                    <label class="prac-label">@SharedLocalizer["Shared_EmailAddress"]</label>
                    <input id="patientEmail" name="Email" type="email" class="prac-input" placeholder="example@mail.com" />
                </div>
            </div>

            <div class="mt-6 flex justify-center">
                <button type="submit" class="btn-add-test">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/>
                    </svg>
                    @SharedLocalizer["Search_SearchPatient"]
                </button>
            </div>
        </form>
    </div>

    <div class="prac-filter">
        <p class="prac-label mb-3">@SharedLocalizer["Search_InstructionsTitle"]</p>
        <ul class="space-y-2 text-sm text-gray-600">
            <li>• <strong>@SharedLocalizer["Appt_PatientName"]</strong> @SharedLocalizer["Search_Step1"]</li>
            <li>• <strong>@SharedLocalizer["Shared_PhoneNumber"]:</strong> @SharedLocalizer["Search_Step2"]</li>
            <li>• <strong>@SharedLocalizer["Shared_Email"]:</strong> @SharedLocalizer["Search_Step3"]</li>
            <li>• @SharedLocalizer["Search_Step4"]</li>
            <li>• @SharedLocalizer["Search_Step5"]</li>
            <li>• @SharedLocalizer["Search_Step6"]</li>
        </ul>
    </div>
</div>

<script>
    const searchInput = document.getElementById('patientSearchInput');
    const suggestionsList = document.getElementById('suggestionsList');
    const resultsContainer = document.getElementById('resultsContainer');
    const spinner = document.getElementById('searchSpinner');
    let searchTimeout = null;

    searchInput.addEventListener('input', function() {
        const term = this.value.trim();
        clearTimeout(searchTimeout);

        if (term.length < 1) {
            suggestionsList.classList.add('hidden');
            return;
        }

        spinner.classList.remove('hidden');

        searchTimeout = setTimeout(() => {
            fetch(`/doctor/Appointments/GetPatientSuggestions?term=${encodeURIComponent(term)}`)
                .then(res => res.json())
                .then(data => {
                    spinner.classList.add('hidden');
                    resultsContainer.innerHTML = '';

                    if (data.length > 0) {
                        suggestionsList.classList.remove('hidden');
                        data.forEach(p => {
                            const row = document.createElement('div');
                            row.className = "p-3 hover:bg-indigo-50 cursor-pointer border-b border-gray-50 last:border-0 transition duration-150";
                            row.innerHTML = `
                                <div class="font-semibold text-gray-800">${p.name}</div>
                                <div class="text-xs text-gray-500">${p.phone} • ${p.email}</div>
                            `;
                            row.onclick = () => {
                                searchInput.value = p.name;
                                document.getElementById('patientPhone').value = p.phone;
                                document.getElementById('patientEmail').value = p.email;
                                suggestionsList.classList.add('hidden');
                            };
                            resultsContainer.appendChild(row);
                        });
                    } else {
                        resultsContainer.innerHTML = '<div class="p-3 text-center text-sm text-gray-500">—</div>';
                        suggestionsList.classList.remove('hidden');
                    }
                })
                .catch(err => {
                    console.error('Search error:', err);
                    spinner.classList.add('hidden');
                });
        }, 400);
    });

    document.addEventListener('click', function(e) {
        if (!searchInput.contains(e.target) && !suggestionsList.contains(e.target)) {
            suggestionsList.classList.add('hidden');
        }
    });
</script>
