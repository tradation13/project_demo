@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="bg-white rounded-lg px-8 py-6">
    <div class="flex items-center justify-between mb-4">
        <h4 class="text-xl font-semibold">Search Patient</h4>
        <div class="flex space-x-2">
            @* <a href="@Url.Action("CreatePatient", "Appointments", new { area = "doctor" })" *@
            @*    class="bg-green-600 text-white text-sm px-4 py-2 rounded hover:bg-green-700 transition duration-150"> *@
            @*     <i class="fas fa-user-plus mr-2"></i>Create New Patient *@
            @* </a> *@
            <a href="@Url.Action("Index", "Appointments", new { area = "doctor" })"
               class="bg-gray-500 text-white text-sm px-4 py-2 rounded hover:bg-gray-600 transition duration-150">
                <i class="fas fa-arrow-left mr-2"></i>Back to Appointments
            </a>
        </div>
    </div>

    <div class="mb-6 bg-blue-50 border border-blue-200 rounded-lg p-4">
        <h5 class="font-semibold text-blue-800 mb-2">Quick Start:</h5>
        <p class="text-sm text-blue-700 mb-3">
            Search for an existing patient using their identity number, phone, or email. 
            If the patient doesn't exist, use the "Create New Patient" button above to add them.
        </p>
        <div class="text-xs text-blue-600">
            <strong>Tip:</strong> Identity Number is the most reliable search method.
        </div>
        <div class="mt-3 p-3 bg-green-50 border border-green-200 rounded text-xs text-green-700">
            <strong>Workflow:</strong> Search → Create (if needed) → Schedule Appointment
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 p-4 bg-green-100 border border-green-400 text-green-700 rounded">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="mb-4 p-4 bg-yellow-100 border border-yellow-400 text-yellow-700 rounded">
            @TempData["WarningMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-4 p-4 bg-red-100 border border-red-400 text-red-700 rounded">
            @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="mb-4 p-4 bg-blue-100 border border-blue-400 text-blue-700 rounded">
            @TempData["InfoMessage"]
        </div>
    }



    <form asp-action="SearchPatient" method="post" class="mt-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Identity Number</label>
                <input name="IdentityNumber" type="text" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="Enter identity number..." />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Phone Number</label>
                <input name="PhoneNumber" type="text" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="Enter phone number..." />
            </div>

            <div>
                <label class="block text-sm font-medium text-gray-700 mb-2">Email Address</label>
                <input name="Email" type="email" 
                       class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                       placeholder="Enter email address..." />
            </div>
        </div>

        <div class="mt-8 flex justify-center">
            <button type="submit" class="bg-primary text-white px-8 py-3 rounded-md hover:bg-primary-dark transition duration-150 text-lg">
                <i class="fas fa-search mr-2"></i>Search Patient
            </button>
        </div>
    </form>

    <div class="mt-8 bg-gray-50 p-4 rounded-lg">
        <h5 class="font-semibold text-gray-700 mb-3">Search Instructions:</h5>
        <ul class="text-sm text-gray-600 space-y-2">
            <li>• <strong>Identity Number:</strong> Enter the patient's national ID or passport number (most reliable)</li>
            <li>• <strong>Phone Number:</strong> Enter the patient's phone number</li>
            <li>• <strong>Email:</strong> Enter the patient's email address</li>
            <li>• You can fill one, two, or all three fields for more accurate search results</li>
            <li>• <strong>If patient is not found:</strong> Use the "Create Patient" button to add them</li>
            <li>• <strong>After finding the patient:</strong> You can proceed to schedule an appointment</li>
        </ul>
    </div>


</div>
