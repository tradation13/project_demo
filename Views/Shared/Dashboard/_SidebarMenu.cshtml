@using IPTS.Models.Sidebar;
@inject LocService Loc

<style>
    .dashboard-sidebar {
        box-shadow: 16px 0 30px -18px rgba(156, 163, 175, 0.45);
    }
</style>

<div x-data="{ menuOpen : false }">

    <button x-on:click="menuOpen = true" 
            x-show="!menuOpen"
            x-transition:enter="transition ease-out duration-300"
            x-transition:enter-start="-translate-x-full"
            x-transition:enter-end="translate-x-0"
            class="fixed left-0 top-1/2 z-40 flex h-16 w-6 -translate-y-1/2 items-center justify-center rounded-r-2xl bg-primary text-white shadow-lg shadow-primary/30 transition-all hover:w-8 lg:hidden"
            title="@SharedLocalizer["Shared_OpenMenu"]">
        <i class="fa-solid fa-chevron-right text-xs"></i>
    </button>

    <div x-show="menuOpen" 
         x-cloak
         x-on:click="menuOpen = false" 
         x-transition:enter="transition opacity-0 duration-300"
         x-transition:enter-end="opacity-100"
         class="fixed inset-0 z-40 bg-black/40 backdrop-blur-[2px] lg:hidden"></div>

        <aside :class="menuOpen ? 'translate-x-0' : '-translate-x-full'"
            class="dashboard-sidebar custom-scrollbar fixed inset-y-0 left-0 z-50 w-64 overflow-y-auto bg-white transition-transform duration-300 ease-in-out lg:fixed lg:top-0 lg:h-screen lg:translate-x-0">
        
        <div class="flex items-center justify-end p-4 lg:hidden">
            <button x-on:click="menuOpen = false" class="text-gray-400 transition-colors hover:text-primary">
                <i class="fa-solid fa-xmark fa-lg"></i>
            </button>
        </div>

        <div class="flex flex-col items-center justify-center border-b border-gray-50">
            <a href="/" class="group flex flex-col items-center">
                <img src="/images/logo.png"
                     alt="IPTS Logo"
                     class="h-auto w-[180px] drop-shadow-sm transition-transform duration-300 group-hover:scale-105">
            </a>
        </div>

        <nav class="p-4 pb-10">
            @foreach (var group in SidebarProvider.GetSidebarItems(User, Loc))
            {
                <h3 class="mb-2 mt-6 px-4 text-[10px] font-bold uppercase tracking-widest text-gray-400">@group.Title</h3>

                @foreach (var item in group.Items)
                {
                    <a x-data="{ linkHover: false }"
                       x-on:mouseover="linkHover = true"
                       x-on:mouseleave="linkHover = false"
                       href="@Url.Action(item.Action, item.Controller, new { area = item.Area })"
                       class="flex items-center rounded-xl px-4 py-3 text-gray-600 transition-all duration-200 hover:bg-primary/5 hover:text-primary">
                        
                        <span class="flex h-8 w-8 items-center justify-center">
                            @if (item.Icon.StartsWith("<svg")) { @Html.Raw(item.Icon) }
                            else { <i class="fa-solid fa-@item.Icon text-lg"></i> }
                        </span>

                        <span class="ml-3 text-sm font-bold">
                            @item.Title 
                        </span>
                    </a>
                }
            }

            <div class="mt-10 border-t border-gray-50 pt-6">
                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit"
                            class="flex w-full items-center justify-center gap-2 rounded-xl bg-red-600 py-3 text-sm font-bold text-white transition-all duration-300 hover:bg-red-700 hover:shadow-[0_8px_20px_-6px_rgba(220,38,38,0.5)] active:scale-95" hover:shadow-red-200">
                        <i class="fa-solid fa-arrow-right-from-bracket"></i>
                        @SharedLocalizer["Shared_Logout"]
                    </button>
                </form>
            </div>
        </nav>
    </aside>
</div>