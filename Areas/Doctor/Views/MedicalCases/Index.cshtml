@model List<IPTS.Models.Entites.MedicalCase>
@{
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    ViewData["Title"] = "Medical Cases";
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<h2 class="mb-4 text-2xl font-bold">@SharedLocalizer["MedCase_Header"] @($"{patient?.User?.FirstName} {patient?.User?.LastName}")</h2>
<div class="mb-6 rounded bg-white p-4 shadow">
    <div class="flex flex-col md:flex-row md:items-center md:justify-between">
        <div>
            @* <div class="font-semibold">@SharedLocalizer["Shared_Identity_Number"]:</div>
            <div class="text-gray-700">@patient?.IdentityNumber</div> *@
            <div class="mt-2 font-semibold">@SharedLocalizer["Shared_Phone"]:</div>
            <div class="text-gray-700">@patient?.User?.PhoneNumber</div>
            <div class="mt-2 font-semibold">@SharedLocalizer["Shared_Email"]:</div>
            <div class="text-gray-700">@patient?.User?.Email</div>
        </div>
        <div class="mt-4 md:mt-0">
            <a href="@Url.Action("Create", "MedicalCases", new { area = "doctor", patientId = patient?.Id })"
               class="rounded bg-green-600 px-6 py-2 font-bold text-white shadow hover:bg-green-700">
                + @SharedLocalizer["Shared_Add_MedicalCase"]
            </a>
        </div>
    </div>
</div>

@if (!Model.Any())
{
    <div class="mb-4 rounded border-l-4 border-yellow-400 bg-yellow-50 p-4">
        <p class="text-yellow-800">@SharedLocalizer["MedCase_NoData"]</p>
    </div>
}
else
{
    <div class="grid gap-6">
        @foreach (var mc in Model)
        {
            var hasFinishedTest = mc.MedicalCaseTests?.Any(t => !string.IsNullOrEmpty(t.Result)) == true;
            <div class="flex flex-col rounded-lg bg-white p-6 shadow md:flex-row md:items-center md:justify-between">
                <div>
                    <div class="mb-1 text-lg font-bold">@mc.Name</div>
                    <div class="mb-1 text-sm text-gray-600">@mc.Description</div>
                    <div class="text-xs text-gray-500">@SharedLocalizer["Shared_Created"]: @mc.CreatedAt.ToString("yyyy-MM-dd")</div>
                </div>
                <div class="mt-4 flex gap-2 md:mt-0">
                    <a href="@Url.Action("Details", "MedicalCases", new { area = "doctor", id = mc.Id })"
                       class="rounded bg-blue-600 px-4 py-2 text-sm text-white hover:bg-blue-700">@SharedLocalizer["Shared_Details"]</a>
                    @if (hasFinishedTest)
                    {
                        <a href="@Url.Action("PrintReport", "MedicalCases", new { area = "doctor", id = mc.Id })"
                           class="rounded bg-gray-700 px-4 py-2 text-sm text-white hover:bg-gray-900">@SharedLocalizer["Shared_Print_Report"]</a>
                    }
                </div>
            </div>
        }
    </div>
}