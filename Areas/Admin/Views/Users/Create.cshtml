@model UserFormViewModel

@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewBag.Title = SharedLocalizer["Users_CreateTitle"] + ViewBag.UserType;
}

<form asp-action="Create" method="post" asp-route-UserType="@ViewBag.UserType">
    <div class="flex flex-col gap-6">

        <div class="rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">
            <div class="mb-6 flex items-center gap-3">
                <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                    <i class="fas fa-id-card"></i>
                </span>
                <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["Users_UserInformation"]</h4>
            </div>

            <div class="grid grid-cols-1 gap-4 md:grid-cols-3">
                <div class="flex flex-col">
                    <label asp-for="UserName" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                            <i class="fas fa-at text-xs"></i>
                        </span>
                        <input asp-for="UserName" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                    </div>
                    <span asp-validation-for="UserName" class="mt-1.5 text-xs text-red-500"></span>
                </div>
                <div class="flex flex-col">
                    <label asp-for="Email" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                            <i class="fas fa-envelope text-xs"></i>
                        </span>
                        <input asp-for="Email" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                    </div>
                    <span asp-validation-for="Email" class="mt-1.5 text-xs text-red-500"></span>
                </div>
                <div class="flex flex-col">
                    <label asp-for="PhoneNumber" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                            <i class="fas fa-phone text-xs"></i>
                        </span>
                        <input asp-for="PhoneNumber" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                    </div>
                    <span asp-validation-for="PhoneNumber" class="mt-1.5 text-xs text-red-500"></span>
                </div>
            </div>

            <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2">
                <div class="flex flex-col">
                    <label asp-for="Password" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                            <i class="fas fa-lock text-xs"></i>
                        </span>
                        <input asp-for="Password" type="password" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                    </div>
                    <span asp-validation-for="Password" class="mt-1.5 text-xs text-red-500"></span>
                </div>
                <div class="flex flex-col">
                    <label asp-for="ConfirmPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                    <div class="relative">
                        <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                            <i class="fas fa-lock text-xs"></i>
                        </span>
                        <input asp-for="ConfirmPassword" type="password" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                    </div>
                    <span asp-validation-for="ConfirmPassword" class="mt-1.5 text-xs text-red-500"></span>
                </div>
            </div>
        </div>

        @switch (ViewBag.UserType)
        {
            case "Admin":
                break;

            case "Customer":
                <div class="rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">
                    <div class="mb-6 flex items-center gap-3">
                        <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                            <i class="fas fa-address-card"></i>
                        </span>
                        <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["Users_CustomerInformation"]</h4>
                    </div>
                    <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                        <div class="flex flex-col">
                            <label asp-for="Customer.FirstName" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                                    <i class="fas fa-user text-xs"></i>
                                </span>
                                <input asp-for="Customer.FirstName" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                            </div>
                            <span asp-validation-for="Customer.FirstName" class="mt-1.5 text-xs text-red-500"></span>
                        </div>
                        <div class="flex flex-col">
                            <label asp-for="Customer.LastName" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-400"></label>
                            <div class="relative">
                                <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                                    <i class="fas fa-id-badge text-xs"></i>
                                </span>
                                <input asp-for="Customer.LastName" class="w-full rounded-lg border border-slate-200 bg-white py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:outline-none focus:ring-4 focus:ring-primary/10" />
                            </div>
                            <span asp-validation-for="Customer.LastName" class="mt-1.5 text-xs text-red-500"></span>
                        </div>
                    </div>
                </div>
                break;

            default:
                break;
        }
    </div>

    <div class="mt-8 flex gap-3">
        <button type="submit"
                class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-primary/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
            <i class="fas fa-check text-xs"></i> @SharedLocalizer["Users_CreateTitle"]
        </button>
        <a href="@Url.Action("Index")"
           class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-5 py-2.5 text-sm font-semibold text-slate-700 transition-all duration-200 hover:bg-slate-50">
            <i class="fas fa-xmark text-xs"></i> @SharedLocalizer["Shared_Cancel"]
        </a>
    </div>
    <div asp-validation-summary="All" class="mt-4 rounded-xl border border-red-200 bg-red-50 p-3 text-sm text-red-500"></div>
</form>
