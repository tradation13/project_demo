@model ForgotPasswordViewModel
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["ForgotPass_PageTitle"];
}

<div class="mx-auto w-full max-w-md rounded-lg bg-white p-8 shadow">
    <h2 class="text-center text-2xl font-bold tracking-wide text-gray-800">
        @SharedLocalizer["Shared__ForgotPassword"]
    </h2>
    <p class="mt-2 text-center text-sm text-gray-600">
        @SharedLocalizer["ForgotPass_Desc"]
    </p>

    <form class="my-8 text-sm" asp-action="ForgotPassword" method="post" novalidate autocomplete="off">
        <div class="my-4 flex flex-col">
            <label asp-for="Email" class="text-gray-700">@SharedLocalizer["Shared_EmailAddress"]</label>
            <input asp-for="Email" type="email"
                   class="mt-2 rounded border-gray-300 py-2 text-sm text-gray-900 focus:border-gray-300 focus:outline-none focus:ring-0"
                   placeholder="@SharedLocalizer["Shared_EnterYourEmail"]" />
            <span asp-validation-for="Email" class="text-sm text-red-500"></span>
        </div>

        <div class="my-4 flex items-center justify-end space-x-4">
            <button type="submit"
                    class="rounded-lg bg-primary px-8 py-2 uppercase text-gray-100 transition duration-150 hover:bg-primary-dark hover:shadow-xl">
                @SharedLocalizer["ForgotPass_SubmitBtn"]
            </button>
        </div>

        @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
    </form>

    <div class="mt-4 flex justify-center">
        <a href="@(Url.Action("Login", "Auth"))"
           class="inline-flex items-center gap-2 rounded-lg border border-primary bg-white px-6 py-2 text-primary transition hover:bg-primary hover:text-white hover:shadow">
            <i class="fas fa-arrow-left rotate-180"></i>
            @SharedLocalizer["Shared_BackToLogin"]
        </a>
    </div>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")