@using IPTS.Models.Sidebar;
@inject LocService Loc

<div x-data="{ menuOpen : true }">

    <!-- start::Black overlay -->
    <div :class="menuOpen ? 'block' : 'hidden'" x-on:click="menuOpen = false" class="fixed inset-0 z-20 bg-black opacity-50 transition-opacity lg:hidden"></div>
    <!-- end::Black overlay -->
    <aside :class="menuOpen ? 'translate-x-0 ease-out' : '-translate-x-full ease-in'"
           class="custom-scrollbar fixed inset-y-0 left-0 z-30 w-64 overflow-y-auto bg-primary-light bg-opacity-10 transition duration-300 lg:inset-0 lg:translate-x-0">
        <!-- start::Logo -->
        <div class="flex h-[210px] flex-col items-center justify-center border-b border-white/20 bg-white/10 backdrop-blur-md">
            <a href="/" class="group flex flex-col items-center">
                <img src="/images/logo.png"
                     alt="IPTS Logo"
                     class="h-auto w-[180px] drop-shadow-lg transition-transform duration-300 group-hover:scale-105 md:w-[180px]">
            </a>
        </div>
        <!-- end::Logo -->
        <!-- start::Navigation -->
        <nav class="custom-scrollbar">
            @*later crate the cusotm scrollbar*@

            <!--start: Dynamic Navigation-->
            @foreach (var group in SidebarProvider.GetSidebarItems(User,Loc))
            {
                <!-- عنوان المجموعة -->
                <p class="mb-2 mt-10 px-6 text-xs uppercase text-gray-600">@group.Title</p>

                @foreach (var item in group.Items)
                {
                    <!-- رابط داخل المجموعة -->
                    <a x-data="{ linkHover: false }"
                       x-on:mouseover="linkHover = true"
                       x-on:mouseleave="linkHover = false"
                       href="@Url.Action(item.Action, item.Controller, new { area = item.Area })"
                       class="flex cursor-pointer items-center px-6 py-3 transition duration-200 hover:bg-black hover:bg-opacity-10">
                        @if (item.Icon.StartsWith("<svg"))
                        {
                            @Html.Raw(item.Icon)
                        }
                        else
                        {
                            <!-- أيقونة باستخدام Font Awesome -->
                            <i class="fa-solid fa-@item.Icon h-5 w-5 text-primary transition duration-200" :class="linkHover ? 'text-gray-100' : ''"></i>
                        }

                        <span class="ml-3 transition duration-200" :class="linkHover ? 'text-primary' : ''">
                            @item.Title 
                        </span>
                    </a>
                }
            }
            <div class="mt-10 px-6">
                <form asp-area="" asp-controller="Auth" asp-action="Logout" method="post">
                    <button type="submit"
                            class="flex w-full items-center justify-center rounded-md bg-red-600 px-4 py-2 text-white transition-colors duration-200 hover:bg-red-700">
                        <i class="fa-solid fa-arrow-right-from-bracket mr-2"></i>
                        @SharedLocalizer["Shared_Logout"]
                    </button>
                </form>
            </div>
        </nav>
        <!-- end::Navigation -->
    </aside>
</div>