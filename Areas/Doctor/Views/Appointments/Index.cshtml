@using IPTS.ViewModels
@model List<AppointmentViewModel>
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div x-data="{ filter: false }" class="custom-scrollbar overflow-x-scroll rounded-lg bg-white px-8 py-6">
    <div class="mb-4 flex items-center justify-between">
    <value>@SharedLocalizer["Appointments"]</value>
        <h4 class="text-xl font-bold">@SharedLocalizer[""]</h4>
        <a href="@Url.Action("SearchPatient", "Appointments", new { area = "doctor" })"
           class="rounded bg-primary px-4 py-1 text-sm text-white transition duration-150 hover:bg-primary-dark">
           @SharedLocalizer["Appt_AddNew"]
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="mb-4 rounded border border-green-400 bg-green-100 p-4 text-green-700">
            @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="mb-4 rounded border border-yellow-400 bg-yellow-100 p-4 text-yellow-700">
            @TempData["WarningMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="mb-4 rounded border border-red-400 bg-red-100 p-4 text-red-700">
            @TempData["ErrorMessage"]
        </div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="mb-4 rounded border border-blue-400 bg-blue-100 p-4 text-blue-700">
            @TempData["InfoMessage"]
        </div>
    }

    <div class="mb-3 mt-8 flex flex-col items-start md:flex-row md:items-center md:justify-between">
        <div class="flex items-center justify-center space-x-4">
            <form class="relative flex items-center">
                <input type="search"
                       name="input_search_without_btn"
                       id="input_search_without_btn"
                       class="flex-1 border-gray-300 py-0.5 pl-10 focus:border-gray-300 focus:outline-none focus:ring-0"
                       placeholder= @SharedLocalizer["Appt_SearchPlaceholder"]>
                <span class="absolute left-2 flex items-center justify-center bg-transparent">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                    </svg>
                </span>
            </form>
            <button x-on:click="filter = !filter"
                    class="font-bold text-primary hover:text-primary-dark hover:underline">
                @SharedLocalizer["Appt_Filters"]
            </button>
        </div>
    </div>

    <div x-show="filter"
         x-collapse.duration.300ms>
        <div class="mb-2 rounded-lg bg-gray-200 px-8 py-4">
            <h5 class="underline">@SharedLocalizer["Appt_FilterResults"]</h5>
            <form class="py-2">
                <div class="my-4 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    <input type="text"
                           name="patient_name"
                           class="flex-1 rounded border-gray-300 py-1 focus:border-gray-300 focus:outline-none focus:ring-0"
                           placeholder=@SharedLocalizer["Appt_PatientName"]>
                    <div class="w-full">
                        <label class="mr-2">@SharedLocalizer["Appt_Status"]:</label>
                        <select class="flex-1 rounded border-gray-300 py-1 focus:border-gray-300 focus:outline-none focus:ring-0">
                            <option></option>
                            <option>@SharedLocalizer["Status_Pending"]</option>
                            <option>@SharedLocalizer["Status_Confirmed"]</option>
                            <option>@SharedLocalizer["Status_Completed"]</option>
                            <option>@SharedLocalizer["Status_Cancelled"]</option>
                        </select>
                    </div>
                </div>
                <div class="my-4 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    <div>
                        <label class="mr-2">@SharedLocalizer["Appt_FromDate"]:</label>
                        <input type="date"
                               name="from_date"
                               class="mt-1 flex-1 rounded border-gray-300 py-1 focus:border-gray-300 focus:outline-none focus:ring-0">
                    </div>
                    <div>
                        <label class="mr-2">@SharedLocalizer["Appt_ToDate"]:</label>
                        <input type="date"
                               name="to_date"
                               class="mt-1 flex-1 rounded border-gray-300 py-1 focus:border-gray-300 focus:outline-none focus:ring-0">
                    </div>
                </div>

                <button class="mt-8 rounded-lg bg-primary px-8 py-1 text-sm text-gray-100 transition duration-150 hover:bg-primary-dark hover:shadow-xl">@SharedLocalizer["Appt_FilterBtn"]</button>
            </form>
        </div>
    </div>

    <table class="mb-8 w-full whitespace-nowrap">
        <thead class="bg-primary font-bold text-white">
            <tr>
                <th>#</th>
                <th>@SharedLocalizer["Appt_PatientName"]</th>
                <th>@SharedLocalizer["Appt_DoctorName"]</th>
                <th>@SharedLocalizer["Appt_ScheduledTime"]</th>
                <th>@SharedLocalizer["Appt_Status"]</th>
                <th>@SharedLocalizer["Appt_Actions"]</th>
            </tr>
        </thead>
        <tbody>
            @{int x = 0;}
                @foreach (var appointment in Model)
                {
                var scheduledUtcIsoStart = DateTime.SpecifyKind(appointment.ScheduledTime, DateTimeKind.Utc).ToString("o");
                var scheduledUtcIsoEnd = DateTime.SpecifyKind(appointment.ScheduledTime.AddMinutes(appointment.TotalDurationMinutes), DateTimeKind.Utc).ToString("o");
                var nowUtc = DateTime.UtcNow;
                var isPast = DateTime.SpecifyKind(appointment.ScheduledTime, DateTimeKind.Utc) <= nowUtc;

                string badgeText = string.Empty;
                string badgeClass = appointment.Status switch
                {
                    AppointmentStatus.Confirmed => "bg-green-100 text-green-800",
                    AppointmentStatus.Pending => "bg-yellow-100 text-yellow-800",
                    AppointmentStatus.Completed => "bg-blue-100 text-blue-800",
                    AppointmentStatus.Cancelled => "bg-red-100 text-red-800",
                    _ => "bg-gray-100 text-gray-800"
                };

                if (isPast && appointment.Status == AppointmentStatus.Pending)
                {
                    badgeText = SharedLocalizer["Appt_Status_Expired"];
                    badgeClass = "bg-orange-100 text-orange-800";
                }
                else if (isPast && appointment.Status == AppointmentStatus.Confirmed)
                {
                    badgeText = SharedLocalizer["Dash_CompletedMonth"];
                    badgeClass = "bg-blue-100 text-blue-800";
                }
                else
                {
                    badgeText = appointment.Status switch
                    {
                        AppointmentStatus.Pending => SharedLocalizer["Status_Pending"],
                        AppointmentStatus.Confirmed => SharedLocalizer["Status_Confirmed"],
                        AppointmentStatus.Completed => SharedLocalizer["Status_Completed"],
                        AppointmentStatus.Cancelled => SharedLocalizer["Status_Cancelled"],
                        _ => appointment.StatusDisplay
                    };
                }

                <tr class="hover:bg-gray-100">
                    <td class="text-center">@(++x)</td>
                    <td class="text-center">@appointment.PatientName</td>
                    <td class="text-center">@appointment.DoctorName</td>
                    <td class="text-center">
                        <span class="appt-datetime" data-utc-start="@scheduledUtcIsoStart" data-utc-end="@scheduledUtcIsoEnd">@appointment.ScheduledTime.ToString("MMM dd, yyyy HH:mm")</span>
                    </td>
                    <td class="text-center">
    <span class="rounded-full px-2 py-1 text-xs font-normal @badgeClass">
        @badgeText
    </span>
</td>
                    <td class="flex items-center justify-center space-x-2 py-3 pl-2 text-center">
                        <a asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.Id" asp-area="doctor">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary hover:text-primary-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </a>
                     @*    <a href="@Url.Action("Edit", "Appointments", new { id = appointment.Id, area = "doctor" })"> *@
                     @*        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-500 hover:text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"> *@
                     @*            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" /> *@
                     @*        </svg> *@
                     @*    </a> *@

                     @*    <form asp-action="Delete" asp-controller="Appointments" asp-route-id="@appointment.Id" asp-area="doctor" method="post" onsubmit="return confirm('Are you sure you want to delete this appointment?');" class="inline"> *@
                     @*        <button type="submit"> *@
                     @*            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 hover:text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"> *@
                     @*                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" *@
                     @*                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4 *@
                     @* a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" /> *@
                     @*            </svg> *@
                     @*        </button> *@
                     @*    </form> *@
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<script>
// Format UTC time to user's browser timezone (dynamic)
const browserTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;

function formatUtcTime(date, options = {}) {
    if (!date || Number.isNaN(date.getTime())) return '';
    const defaults = {
        timeZone: browserTimeZone,
        hour12: false
    };
    return new Intl.DateTimeFormat('en-GB', { ...defaults, ...options }).format(date);
}

document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.appt-datetime').forEach(el => {
        const utcStart = el.getAttribute('data-utc-start');
        const utcEnd = el.getAttribute('data-utc-end');
        if (!utcStart) return;

        const start = new Date(utcStart);
        if (!utcEnd) {
            const datePart = formatUtcTime(start, { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            el.textContent = datePart;
            return;
        }

        const end = new Date(utcEnd);

        // If same day, show date once + time range. Otherwise show full start and end datetimes.
        if (start.toDateString() === end.toDateString()) {
            const datePart = formatUtcTime(start, { year: 'numeric', month: 'short', day: '2-digit' });
            const startTime = formatUtcTime(start, { hour: '2-digit', minute: '2-digit' });
            const endTime = formatUtcTime(end, { hour: '2-digit', minute: '2-digit' });
            el.textContent = `${datePart} ${startTime} - ${endTime}`;
        } else {
            const startFull = formatUtcTime(start, { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            const endFull = formatUtcTime(end, { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            el.textContent = `${startFull} - ${endFull}`;
        }
    });
});
</script>
