@model int

@{
    var statusMap = new Dictionary<int, (string Label, string Color)>
    {
        { 0, (@SharedLocalizer["Status_Active"], "green-500") },
        { 1, (@SharedLocalizer["Status_Inactive"], "yellow-500") },
        { 2, (@SharedLocalizer["Status_Deleted"], "red-500") },
    };

    var (label, color) = statusMap.ContainsKey(Model) ? statusMap[Model] : (@SharedLocalizer["Status_Unknown"], "gray-500");
}

<span class="bg-@color rounded px-2 py-0.5 text-sm text-white">@label</span>