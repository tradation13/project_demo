@model RegisterViewModel
@using IPTS.Models.Entites
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Reg_PageTitle"];
    // كلاس موحد للحقول لسهولة التعديل
    string inputClasses = "mt-1.5 w-full rounded-xl border-gray-200 bg-gray-50/50 px-4 py-3 text-sm text-gray-900 transition-all focus:border-primary focus:bg-white focus:ring-4 focus:ring-primary/10 outline-none";
    string labelClasses = "text-xs font-black uppercase tracking-widest text-gray-500 ml-1";
}

<div class="mx-auto w-full max-w-md rounded-lg border border-gray-50 bg-white p-5 shadow-[0_20px_50px_rgba(0,0,0,0.05)] sm:rounded-[2.5rem] sm:p-8 md:p-10">
    <h2 class="mb-8 text-center text-2xl font-black tracking-tighter text-gray-800 sm:mb-10 sm:text-3xl">
        @SharedLocalizer["Reg_Header"]<span class="text-primary">.</span>
    </h2>

    <form asp-controller="Auth" asp-action="Register" method="post" autocomplete="off" onsubmit="return checkPrivacyConsent()" class="space-y-5">
        @Html.AntiForgeryToken()

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
{
    <div asp-validation-summary="All" class="mb-4 rounded-lg bg-red-50 p-4 text-sm text-red-600 border border-red-200"></div>
}

        <input hidden asp-for="UserTypeName" value="patient" />
        
        @* اسم المستخدم *@
        <div>
            <label asp-for="UserName" class="@labelClasses">@SharedLocalizer["Shared_UserName"]</label>
            <input asp-for="UserName" class="@inputClasses" placeholder="@SharedLocalizer["Reg_Placeholder_User"]" />
            <span asp-validation-for="UserName" class="mt-1 block text-[11px] font-medium text-red-500"></span>
        </div>

        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
            @* الاسم الأول *@
            <div>
                <label asp-for="FirstName" class="@labelClasses">@SharedLocalizer["Shared_FirstName"]</label>
                <input asp-for="FirstName" class="@inputClasses" placeholder="@SharedLocalizer["Reg_Placeholder_FirstName"]" />
                <span asp-validation-for="FirstName" class="mt-1 block text-[11px] font-medium text-red-500"></span>
            </div>

            @* الاسم الأخير *@
            <div>
                <label asp-for="LastName" class="@labelClasses">@SharedLocalizer["Shared_LastName"]</label>
                <input asp-for="LastName" class="@inputClasses" placeholder="@SharedLocalizer["Reg_Placeholder_LastName"]" />
                <span asp-validation-for="LastName" class="mt-1 block text-[11px] font-medium text-red-500"></span>
            </div>
        </div>

        @* الإيميل *@
        <div>
            <label asp-for="Email" class="@labelClasses">@SharedLocalizer["Shared_Email"]</label>
            <input asp-for="Email" class="@inputClasses" placeholder="Leo@gmail.com" />
            <span asp-validation-for="Email" class="mt-1 block text-[11px] font-medium text-red-500"></span>
        </div>

        @* الهاتف *@
        <div>
            <label asp-for="PhoneNumber" class="@labelClasses">@SharedLocalizer["Shared_Phone"]</label>
            <input asp-for="PhoneNumber" class="@inputClasses" placeholder="+49 0X XXX XXXX" />
            <span asp-validation-for="PhoneNumber" class="mt-1 block text-[11px] font-medium text-red-500"></span>
        </div> 

        @* كلمة المرور *@
        <div x-data="{ show: false }">
            <label asp-for="Password" class="@labelClasses">@SharedLocalizer["Shared_Password"]</label>
            <div class="relative">
                <input :type="show ? 'text' : 'password'" asp-for="Password" class="@inputClasses pr-12" placeholder="••••••••" />
                <button x-on:click="show = !show" type="button" class="absolute inset-y-0 right-0 flex items-center pr-4 text-gray-400 transition-colors hover:text-primary">
                    <i class="fa-solid" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                </button>
            </div>
            <span asp-validation-for="Password" class="mt-1 block text-[11px] font-medium text-red-500"></span>
        </div>

        @* تأكيد كلمة المرور *@
        <div x-data="{ show: false }">
            <label asp-for="ConfirmPassword" class="@labelClasses">@SharedLocalizer["Shared_ConfirmPassword"]</label>
            <div class="relative">
                <input :type="show ? 'text' : 'password'" asp-for="ConfirmPassword" class="@inputClasses pr-12" placeholder="••••••••" />
                <button x-on:click="show = !show" type="button" class="absolute inset-y-0 right-0 flex items-center pr-4 text-gray-400 transition-colors hover:text-primary">
                    <i class="fa-solid" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="mt-1 block text-[11px] font-medium text-red-500"></span>
        </div>

        @* رقم الهوية *@
        @* <div>
            <label asp-for="Patient.IdentityNumber" class="@labelClasses">@SharedLocalizer["Shared_Identity_Number"] *</label>
            <input asp-for="Patient.IdentityNumber" class="@inputClasses" placeholder="@SharedLocalizer["Reg_Placeholder_ID"]"  />
            <span asp-validation-for="Patient.IdentityNumber" class="mt-1 block text-[11px] font-medium text-red-500"></span>
        </div> *@

        @* تاريخ الميلاد *@
        <div>
            <label asp-for="Patient.BirthDate" class="@labelClasses">@SharedLocalizer["Shared_Date_Of_Birth"] *</label>
            <input asp-for="Patient.BirthDate" type="date" class="@inputClasses"  />
            <span asp-validation-for="Patient.BirthDate" class="mt-1 block text-[11px] font-medium text-red-500"></span>
        </div>

         <div class="mt-6 text-center text-[11px] leading-relaxed text-gray-400">
            @SharedLocalizer["Reg_LegalConsent_Text"]
            <a href="@Url.Action("Privacy", "Home", new { returnUrl = $"{Context.Request.Path}{Context.Request.QueryString}" })" class="font-bold text-primary hover:underline">
                @SharedLocalizer["Shared_Privacy_Title"]
            </a>
        </div>

        @* Checkbox for privacy consent *@
        <div class="flex items-start gap-2">
            <input asp-for="AcceptPrivacy" type="checkbox" class="h-4 w-4 rounded border-gray-300 text-primary focus:ring-primary" />
            <label asp-for="AcceptPrivacy" class="text-sm text-gray-600">
                @SharedLocalizer["Reg_PrivacyConsent"]
            </label>
        </div>
        <span asp-validation-for="AcceptPrivacy" class="mt-1 block text-[11px] font-medium text-red-500"></span>

        <button type="submit"
                class="w-full rounded-2xl bg-primary py-4 text-sm font-black uppercase tracking-widest text-white shadow-xl shadow-primary/20 transition-all hover:-translate-y-0.5 hover:bg-primary-dark active:scale-95">
            @SharedLocalizer["Reg_SubmitBtn"]
        </button>
    </form>

    <p class="mt-8 text-center text-sm font-medium text-gray-500">
        @SharedLocalizer["Reg_AlreadyHaveAccount"]
        <a href="@Url.Action("Login", "auth")" class="font-bold text-primary transition-colors hover:text-primary-dark">
             @SharedLocalizer["Reg_SignIn_Link"]
        </a>
    </p>
</div>

<!-- Privacy Consent Modal -->
<div id="privacyModal" 
     class="fixed inset-0 z-50 flex hidden items-center justify-center p-4 transition-all duration-300">
    
    <div class="absolute inset-0 bg-white/40 backdrop-blur-md"></div>

    <div class="relative w-[90%] max-w-[340px] transform overflow-hidden rounded-[2.5rem] border border-gray-100 bg-white p-8 shadow-[0_25px_70px_-15px_rgba(0,0,0,0.1)] transition-all">
        
        <div class="text-center">
            <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-full bg-orange-50 text-orange-500">
                <i class="fa-solid fa-shield-halved text-2xl"></i>
            </div>
            
            <h3 class="mb-3 text-xl font-black tracking-tight text-gray-800">
                @SharedLocalizer["Reg_PrivacyModal_Title"]
            </h3>
            
            <p class="mb-8 text-sm leading-relaxed text-gray-500">
                @SharedLocalizer["Reg_PrivacyModal_Message"]
            </p>

            <button onclick="closePrivacyModal()" 
                    class="w-full rounded-2xl bg-gray-900 py-4 text-sm font-bold text-white transition-all hover:bg-gray-800 active:scale-95">
                @SharedLocalizer["Shared_GotIt"] </button>
        </div>

    </div>
</div>

<script>
    function showPrivacyModal() {
        const modal = document.getElementById('privacyModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
    }

    function closePrivacyModal() {
        const modal = document.getElementById('privacyModal');
        modal.classList.add('hidden');
    }

    function checkPrivacyConsent() {
        const checkbox = document.getElementById('AcceptPrivacy');
        if (!checkbox.checked) {
            showPrivacyModal();
            return false;
        }
        return true;
    }
</script>