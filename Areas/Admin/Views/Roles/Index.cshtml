@model List<IdentityRole>
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}
<div class="bg-white rounded-lg px-8 py-6 overflow-x-scroll custom-scrollbar mb-12">
    <div class="flex items-center justify-between mb-4">
        <h4 class="text-xl font-semibold">Roles</h4>
        <a href="@Url.Action("Create")" class="bg-primary text-white text-sm px-4 py-1 rounded hover:bg-primary-dark transition duration-150">Add New</a>
    </div>
    <table class="w-full my-8 whitespace-nowrap">
        <thead class="bg-primary text-gray-100 font-bold">
            <tr>
                <th class="py-2 pl-2">#</th>
                <th class="py-2 pl-2">Id</th>
                <th class="py-2 pl-2">Role Name</th>
                <th class="py-2 pl-2"></th>
            </tr>
        </thead>
        <tbody class="text-sm">
            @for (int i = 0; i < Model.Count; i++)
            {
                <tr class="bg-gray-100 hover:bg-primary hover:bg-opacity-20 transition duration-200">
                    <td class="py-3 text-center pl-2">@(i + 1)</td>
                    <td class="py-3 text-center pl-2">@Model[i].Id</td>
                    <td class="py-3 text-center pl-2">@Model[i].Name</td>
                    <td class="py-3 text-center pl-2 flex gap-2 justify-center items-center">
                        <a href="@Url.Action("Edit", new { id = Model[i].Id })" title="Edit" class="text-yellow-500 hover:text-yellow-600">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                            </svg>
                        </a>

                        <form asp-action="Delete" asp-route-id="@Model[i].Id" method="post" onsubmit="return confirm('Are you sure you want to delete this item?');" class="inline">
                            <button type="submit" title="Delete" class="text-red-500 hover:text-red-600">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 inline" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
