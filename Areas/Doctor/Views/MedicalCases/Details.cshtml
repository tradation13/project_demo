@model IPTS.Models.Entites.MedicalCase
@{
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    ViewData["Title"] = SharedLocalizer["MedCase_Det_Title"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<style>
    @@keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0);    }
    }
    @@keyframes badgePop {
        0%   { transform: scale(0.7); opacity: 0; }
        70%  { transform: scale(1.08);             }
        100% { transform: scale(1);   opacity: 1; }
    }
    @@keyframes formSlide {
        from { opacity: 0; transform: translateY(-6px); }
        to   { opacity: 1; transform: translateY(0);    }
    }

    .page-wrap       { animation: fadeSlideUp .4s ease both; }
    .header-card     { animation: fadeSlideUp .45s .05s ease both; opacity: 0; animation-fill-mode: forwards; }
    .group-section   { animation: fadeSlideUp .45s .1s ease both; opacity: 0; animation-fill-mode: forwards; }
    .test-card       { transition: border-color .2s, transform .2s, box-shadow .2s; }
    .test-card:hover { border-color: #c7d2fe; transform: translateY(-2px); box-shadow: 0 4px 16px rgba(0,0,0,.07); }

    .info-panel {
        background: #f9fafb;
        border: 0.5px solid #e5e7eb;
        border-radius: 12px;
        padding: 1.1rem 1.25rem;
    }

    .avatar-lg {
        width: 48px; height: 48px;
        border-radius: 50%;
        background: #ede9fe;
        color: #5b21b6;
        display: flex; align-items: center; justify-content: center;
        font-size: 16px; font-weight: 600;
        flex-shrink: 0;
    }

    .meta-row { display: flex; align-items: center; gap: 6px; font-size: 13px; color: #6b7280; margin-top: 4px; }
    .meta-row svg { width: 13px; height: 13px; flex-shrink: 0; }
    .meta-row a { color: #4f46e5; text-decoration: none; }
    .meta-row a:hover { text-decoration: underline; }

    .btn-add-test {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 18px; border-radius: 8px;
        font-size: 13px; font-weight: 500;
        background: #ecfdf5; color: #065f46;
        border: 0.5px solid #6ee7b7;
        text-decoration: none;
        transition: background .15s, transform .15s;
    }
    .btn-add-test:hover { background: #d1fae5; transform: translateY(-1px); }
    .btn-add-test:active { transform: scale(.97); }

    .btn-print {
        display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 14px; border-radius: 8px;
        font-size: 13px; font-weight: 500;
        background: #f3f4f6; color: #374151;
        border: 0.5px solid #d1d5db;
        text-decoration: none;
        transition: background .15s, transform .15s;
    }
    .btn-print:hover { background: #e5e7eb; transform: translateY(-1px); }
    .btn-print:active { transform: scale(.97); }

    .group-divider {
        display: flex; align-items: center; gap: 10px;
        margin-bottom: 16px;
    }
    .group-divider-line { flex: 1; height: 0.5px; background: #e5e7eb; }
    .group-label {
        font-size: 12px; font-weight: 600;
        color: #0f766e;
        text-transform: uppercase; letter-spacing: .06em;
        display: flex; align-items: center; gap: 5px;
    }
    .group-count {
        display: inline-flex; align-items: center; justify-content: center;
        width: 20px; height: 20px; border-radius: 50%;
        background: #ccfbf1; color: #0f766e;
        font-size: 11px; font-weight: 600;
    }

    .test-name { font-size: 14px; font-weight: 600; color: #1f2937; margin: 0 0 2px; }
    .test-date { font-size: 11px; color: #9ca3af; margin-top: 4px; display: flex; align-items: center; gap: 4px; }
    .test-date svg { width: 11px; height: 11px; }

    .result-chip {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 10px; border-radius: 999px;
        font-size: 12px; font-weight: 500;
        animation: badgePop .35s ease both;
    }
    .result-set   { background: #dbeafe; color: #1e40af; }
    .result-empty { background: #f3f4f6; color: #6b7280; }

    .btn-toggle {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 5px 12px; border-radius: 6px;
        font-size: 12px; font-weight: 500;
        background: #eef2ff; color: #4338ca;
        border: 0.5px solid #c7d2fe;
        cursor: pointer;
        transition: background .15s, transform .15s;
    }
    .btn-toggle:hover { background: #e0e7ff; transform: translateY(-1px); }
    .btn-toggle:active { transform: scale(.97); }
    .btn-toggle.open { background: #fef2f2; color: #991b1b; border-color: #fca5a5; }

    .btn-save {
        padding: 5px 12px; border-radius: 6px;
        font-size: 12px; font-weight: 500;
        background: #ecfdf5; color: #065f46;
        border: 0.5px solid #6ee7b7;
        cursor: pointer;
        transition: background .15s;
    }
    .btn-save:hover { background: #d1fae5; }

    .btn-delete {
        display: inline-flex; align-items: center; gap: 4px;
        padding: 5px 10px; border-radius: 6px;
        font-size: 12px; font-weight: 500;
        background: #fef2f2; color: #991b1b;
        border: 0.5px solid #fca5a5;
        cursor: pointer;
        transition: background .15s;
    }
    .btn-delete:hover { background: #fee2e2; }

    .inline-form {
        display: none;
        flex-direction: column; gap: 8px;
        margin-top: 8px;
        padding: 10px;
        background: #f9fafb;
        border: 0.5px solid #e5e7eb;
        border-radius: 8px;
        animation: formSlide .2s ease both;
    }
    .inline-form.visible { display: flex; }

    .result-input {
        width: 100%;
        border: 0.5px solid #d1d5db;
        border-radius: 6px;
        padding: 6px 10px;
        font-size: 13px;
        color: #111827;
        background: #fff;
        outline: none;
        transition: border-color .15s;
    }
    .result-input:focus { border-color: #818cf8; box-shadow: 0 0 0 3px rgba(129,140,248,.15); }

    .empty-state {
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        gap: 10px; padding: 2.5rem 1rem;
        background: #fffbeb; border: 0.5px solid #fde68a;
        border-radius: 12px; text-align: center;
        animation: fadeSlideUp .45s ease both;
    }
    .empty-icon { font-size: 28px; }
    .empty-text { font-size: 14px; color: #92400e; font-weight: 500; }
</style>

<div class="page-wrap space-y-6">

    <div class="flex items-center gap-3">
        <div class="avatar-lg">
            @{
                var fullName = $"{patient?.User?.FirstName} {patient?.User?.LastName}".Trim();
                var initials = fullName.Length > 0
                    ? string.Join("", fullName.Split(' ').Take(2).Select(n => n[0].ToString().ToUpper()))
                    : "P";
            }
            @initials
        </div>
        <div>
            <h2 class="text-xl font-semibold text-gray-900 leading-tight">@Model.Name</h2>
            <p class="text-sm text-gray-500 mt-0.5">@SharedLocalizer["MedCase_Det_Title"]</p>
        </div>
    </div>

    <div class="header-card rounded-xl bg-white border border-gray-200 p-5">
        <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">

            <div class="space-y-1">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">@SharedLocalizer["Shared_Patient"] @SharedLocalizer["Shared_Information"]</p>

                <p class="text-base font-semibold text-gray-800">@fullName</p>

                <div class="meta-row">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    @patient?.User?.PhoneNumber
                </div>

                <div class="meta-row">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    <a href="mailto:@patient?.User?.Email">@patient?.User?.Email</a>
                </div>
            </div>

            <div class="flex items-center gap-3 flex-wrap">
                <a href="@Url.Action("AddTest", "MedicalCases", new { area = "doctor", medicalCaseId = Model.Id })"
                   class="btn-add-test">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    @SharedLocalizer["MedCase_Det_AddTest"]
                </a>

                @if (Model.MedicalCaseTests.Count > 0)
                {
                    <a href="@Url.Action("PrintReport", "MedicalCases", new { area = "doctor", id = Model.Id })"
                       class="btn-print">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                        </svg>
                        @SharedLocalizer["Shared_Print_Report"]
                    </a>
                }
            </div>
        </div>
    </div>

    @if (Model.MedicalCaseTests == null || !Model.MedicalCaseTests.Any())
    {
        <div class="empty-state">
            <span class="empty-icon">🧪</span>
            <p class="empty-text">@SharedLocalizer["MedCase_Det_NoTests"]</p>
        </div>
    }
    else
    {
        var grouped = Model.MedicalCaseTests
            .Where(t => t.Test != null && t.Test.TestGroup != null)
            .GroupBy(t => t.Test.TestGroup.Name)
            .OrderBy(g => g.Key);

        foreach (var group in grouped)
        {
            <div class="group-section mb-8">
                <div class="group-divider">
                    <div class="group-divider-line"></div>
                    <span class="group-label">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                        </svg>
                        @group.Key
                        <span class="group-count">@group.Count()</span>
                    </span>
                    <div class="group-divider-line"></div>
                </div>

                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                    @foreach (var test in group.OrderBy(t => t.Test.Name))
                    {
                        var hasResult = !string.IsNullOrWhiteSpace(test.Result);
                        var toggleBtnText = hasResult
                            ? $"{SharedLocalizer["Shared_Update"]} {SharedLocalizer["Shared_Result"]}"
                            : $"{SharedLocalizer["Shared_Add"]} {SharedLocalizer["Shared_Result"]}";
                        var cancelText = $"{SharedLocalizer["Shared_Cancel"]}";

                        <div class="test-card flex flex-col gap-3 rounded-xl border border-gray-200 bg-white p-4">

                            <div class="flex items-start justify-between gap-2">
                                <div class="flex-1">
                                    <p class="test-name">@test.Test.Name</p>
                                    <div class="mt-1">
                                        @if (hasResult)
                                        {
                                            <span class="result-chip result-set">
                                                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                </svg>
                                                @test.Result
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="result-chip result-empty">
                                                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                </svg>
                                                @SharedLocalizer["MedCase_Det_NotSet"]
                                            </span>
                                        }
                                    </div>
                                    <div class="test-date">
                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                        </svg>
                                        @test.CreatedAt.ToString("yyyy-MM-dd")
                                    </div>
                                </div>
                            </div>

                            <div class="flex items-center gap-2 flex-wrap">
                                <button type="button"
                                        class="btn-toggle"
                                        data-target="form-@test.Id"
                                        data-default-text="@toggleBtnText"
                                        data-cancel-text="@cancelText">
                                    <svg class="h-3.5 w-3.5 icon-edit" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                    </svg>
                                    <span class="btn-label">@toggleBtnText</span>
                                </button>

                                <form asp-action="DeleteTest" asp-controller="MedicalCases" asp-area="doctor" method="post" class="inline">
                                    <input type="hidden" name="id" value="@test.Id" />
                                    <button type="submit"
                                            class="btn-delete"
                                            onclick="return confirm('Delete this test?')">
                                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                        </svg>
                                        @SharedLocalizer["Shared_Delete"]
                                    </button>
                                </form>
                            </div>

                            <form id="form-@test.Id"
                                  asp-action="UpdateTestResult"
                                  asp-controller="MedicalCases"
                                  asp-area="doctor"
                                  method="post"
                                  class="inline-form">
                                <input type="hidden" name="id" value="@test.Id" />
                                <input type="text"
                                       name="result"
                                       value="@test.Result"
                                       placeholder="@SharedLocalizer["MedCase_Det_EnterResult"]"
                                       class="result-input" />
                                <button type="submit" class="btn-save">
                                    @SharedLocalizer["Shared_Save"]
                                </button>
                            </form>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".btn-toggle").forEach(btn => {
            btn.addEventListener("click", function () {
                const targetId   = this.getAttribute("data-target");
                const form       = document.getElementById(targetId);
                const defaultTxt = this.getAttribute("data-default-text");
                const cancelTxt  = this.getAttribute("data-cancel-text");
                const label      = this.querySelector(".btn-label");
                const isOpen     = form.classList.contains("visible");

                form.classList.toggle("visible", !isOpen);
                this.classList.toggle("open", !isOpen);
                label.textContent = isOpen ? defaultTxt : cancelTxt;
            });
        });
    });
</script>
