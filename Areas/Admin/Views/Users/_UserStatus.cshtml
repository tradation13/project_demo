@model int

@{
    var statusMap = new Dictionary<int, (string Label, string Bg, string Text)>
    {
        { 0, (@SharedLocalizer["Status_Active"], "bg-green-50", "text-green-600") },
        { 1, (@SharedLocalizer["Status_Inactive"], "bg-yellow-50", "text-yellow-500") },
        { 2, (@SharedLocalizer["Status_Deleted"], "bg-red-50", "text-red-500") },
    };

    var (label, bg, text) = statusMap.ContainsKey(Model)
        ? statusMap[Model]
        : (@SharedLocalizer["Status_Unknown"], "bg-slate-100", "text-slate-600");
}

<span class="inline-flex rounded-full @bg px-3 py-1 text-xs font-semibold @text">@label</span>
