@model List<UserType>
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";

}
<div class="custom-scrollbar mb-12 overflow-x-scroll rounded-lg bg-white px-8 py-6">
    <div class="mb-4 flex items-center justify-between">
        <h4 class="text-xl font-semibold">@SharedLocalizer["UserTypes_Title"]</h4>
        <a href="@Url.Action("Create")"
           class="rounded bg-primary px-4 py-1 text-sm text-white transition duration-150 hover:bg-primary-dark">
            @SharedLocalizer["Shared_Add_New"]
        </a>
    </div>
    <table class="my-8 w-full whitespace-nowrap">
        <thead class="bg-primary font-bold text-gray-100">
            <tr>
                <th class="py-2 pl-2">#</th>
                <th class="py-2 pl-2">@SharedLocalizer["Shared_ID"]</th>
                <th class="py-2 pl-2">@SharedLocalizer["Contact_Label_Name"]</th>
                <th class="py-2 pl-2">@SharedLocalizer["UserTypes_HasDashboard"]</th>
                <th class="py-2 pl-2">@SharedLocalizer["UserTypes_Registerable"]</th>
                <th class="py-2 pl-2">@SharedLocalizer["UserTypes_Area"]</th>
                <th class="py-2 pl-2">@SharedLocalizer["Shared_Controller"]</th>
                <th class="py-2 pl-2">@SharedLocalizer["Shared_Action"]</th>
                <th class="py-2 pl-2"></th>
                <th class="py-2 pl-2"></th>
            </tr>
        </thead>
        <tbody class="text-sm">
            @{
                int i = 0;
            }
            @foreach (var item in Model)
            {
                <tr class="bg-gray-100 transition duration-200 hover:bg-primary hover:bg-opacity-20">
                    <td class="py-3 pl-2 text-center">@(++i)</td>
                    <td class="py-3 pl-2 text-center">@item.Id</td>
                    <td class="py-3 pl-2 text-center">@item.Name</td>
                    <td class="py-3 pl-2 text-center">
                        <span class="@(item.HasDashboard ?"rounded bg-green-500 px-2 py-0.5 text-white" : "bg-red-500")">
                            @(item.HasDashboard ? @SharedLocalizer["Shared_Yes"] : @SharedLocalizer["Shared_No"])
                        </span>
                    </td>
                    <td class="py-3 pl-2 text-center">
                        <span class="@(item.Registerable ?"rounded bg-green-500 px-2 py-0.5 text-white" : "bg-gray-500")">
                            @(item.Registerable ? @SharedLocalizer["Shared_Yes"] : @SharedLocalizer["Shared_No"])
                        </span>
                    </td>
                    <td class="py-3 pl-2 text-center">@(item.DefaultArea ?? "-")</td>
                    <td class="py-3 pl-2 text-center">@(item.DefaultController ?? "-")</td>
                    <td class="py-3 pl-2 text-center">@(item.DefaultAction ?? "-")</td>
                    <td class="py-3 pl-2 text-center">
                        <a href="@Url.Action(action:"UserForm", controller:"Users", values:new{  UserType = item.Name  })"
                           class="rounded bg-secondary px-4 py-1 text-sm text-white transition duration-150 hover:bg-primary-dark">
                            @SharedLocalizer["UserTypes_AddUser"]
                        </a>
                    </td>
                    <td class="flex items-center space-x-2 py-3 pl-2 text-center">
                        <a href="@Url.Action("Edit", new { id = item.Id })" title="Edit">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-500 hover:text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                            </svg>
                        </a>
                        <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="inline">
                            <button type="submit" title="Delete" onclick="return confirm('@SharedLocalizer["Msg_ConfirmDelete"]');">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 hover:text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </form>


                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
