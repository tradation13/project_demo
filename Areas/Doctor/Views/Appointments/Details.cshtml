@using IPTS.ViewModels
@model AppointmentViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="rounded-lg bg-white px-8 py-6">
    <div class="mb-4 flex items-center justify-between">
        <h4 class="text-xl font-bold">@SharedLocalizer["Shared_Appointment"] @SharedLocalizer["Shared_Details"]</h4>
       <div class="flex items-center gap-3">
    @if (Model.Status == AppointmentStatus.Pending)
    {
        <form asp-action="AcceptRequest" asp-controller="Appointments" asp-area="Doctor" method="get" class="inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="flex items-center gap-2 rounded-lg bg-green-600 px-4 py-2 text-sm font-normal text-white transition-all hover:bg-green-700 hover:shadow-lg active:scale-95">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                @SharedLocalizer["Shared_Accept"]
            </button>
        </form>

        <form asp-action="RejectRequest" asp-controller="Appointments" asp-area="Doctor" method="get" class="inline">
            <input type="hidden" name="id" value="@Model.Id" />
            <button type="submit" class="flex items-center gap-2 rounded-lg bg-red-600 px-4 py-2 text-sm font-normal text-white transition-all hover:bg-red-700 hover:shadow-lg active:scale-95">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
                @SharedLocalizer["Shared_Reject"]
            </button>
        </form>

        <div class="mx-1 h-8 w-px bg-gray-200"></div>
    }

    <a href="@Url.Action("Index", "Appointments", new { area = "doctor" })"
       class="flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-4 py-2 text-sm font-normal text-gray-700 transition-all hover:bg-gray-50 hover:shadow-sm active:scale-95">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        @SharedLocalizer["Shared_Back"]
    </a>
</div>
    </div>

    <div class="mt-8 grid grid-cols-1 gap-6 md:grid-cols-2">
        <div class="rounded-lg bg-gray-50 p-4">
            <h5 class="mb-3 font-bold text-gray-700">@SharedLocalizer["Shared_Appointment"] @SharedLocalizer["Shared_Information"]</h5>
            <div class="space-y-3">
                <div>
                    <label class="text-sm font-normal text-gray-600">@SharedLocalizer["Shared_ID"]:</label>
                    <p class="text-gray-900">@Model.Id</p>
                </div>
                <div>
                    <label class="text-sm font-normal text-gray-600">@SharedLocalizer["Appt_Status"]:</label>
                  <span class="@(Model.Status == AppointmentStatus.Confirmed ?"rounded-full px-2 py-1 text-xs bg-green-100 text-green-800" :
                         Model.Status == AppointmentStatus.Pending ? "bg-yellow-100 text-yellow-800" :
                         Model.Status == AppointmentStatus.Completed ? "bg-blue-100 text-blue-800" :
                         "bg-red-100 text-red-800")">
    @SharedLocalizer[$"Status_{Model.Status}"]
</span>
                </div>
                <div>
                    <label class="text-sm font-normal text-gray-600">@SharedLocalizer["Appt_ScheduledTime"]:</label>
                    @{ var startUtc = DateTime.SpecifyKind(Model.ScheduledTime, DateTimeKind.Utc).ToString("o");
                       var endUtc = DateTime.SpecifyKind(Model.ScheduledTime.AddMinutes(Model.TotalDurationMinutes), DateTimeKind.Utc).ToString("o"); }
                    <p class="text-gray-900 appt-datetime" data-utc-start="@startUtc" data-utc-end="@endUtc">@Model.ScheduledTime.ToString("MMMM dd, yyyy 'at' HH:mm")</p>
                </div>
            </div>
        </div>

        <div class="rounded-lg bg-gray-50 p-4">
            <h5 class="mb-3 font-bold text-gray-700">@SharedLocalizer["Shared_People"] @SharedLocalizer["Shared_Information"]</h5>
            <div class="space-y-3">
                <div>
                    <label class="text-sm font-normal text-gray-600">@SharedLocalizer["Shared_Patient"] @SharedLocalizer["Contact_Label_Name"]:</label>
                    <p class="text-gray-900">@Model.PatientName</p>
                </div>
                <div>
                    <label class="text-sm font-normal text-gray-600">@SharedLocalizer["Therapies_Doctor"] @SharedLocalizer["Contact_Label_Name"]:</label>
                    <p class="text-gray-900">@Model.DoctorName</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Additional section for notes and prescription -->
    <div class="mt-6 rounded-lg bg-gray-50 p-4">
        <h5 class="mb-3 font-bold text-gray-700">@SharedLocalizer["Shared_Notes"]</h5>
        <p class="text-gray-900">@(string.IsNullOrWhiteSpace(Model.Notes) ? "-" : Model.Notes)</p>

        @if (!string.IsNullOrWhiteSpace(Model.PrescriptionFileName))
        {
            <div class="mt-4">
                <span class="font-normal">@SharedLocalizer["Shared_Prescription"]:</span>
                <a href="@Url.Action("DownloadPrescription", "Appointments", new { id = Model.Id, area = "Doctor" })" target="_blank" rel="noopener noreferrer" class="ml-1 inline-block rounded bg-blue-100 px-2 py-1 text-blue-700 hover:bg-blue-200">
                    <img src="~/images/logo.png" class="inline-block h-4 w-4" alt="logo" /> @Model.PrescriptionDisplayName
                </a>
            </div>
        }
    </div>
</div>

<script>
// Format UTC time to user's browser timezone (dynamic)
const browserTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;

function formatUtcTime(date, options = {}) {
    if (!date || Number.isNaN(date.getTime())) return '';
    const defaults = {
        timeZone: browserTimeZone,
        hour12: false
    };
    return new Intl.DateTimeFormat('en-GB', { ...defaults, ...options }).format(date);
}

document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.appt-datetime').forEach(el => {
        const utcStart = el.getAttribute('data-utc-start');
        const utcEnd = el.getAttribute('data-utc-end');
        if (!utcStart) return;

        const start = new Date(utcStart);
        if (!utcEnd) {
            const formatted = formatUtcTime(start, { year: 'numeric', month: 'long', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            el.textContent = formatted;
            return;
        }

        const end = new Date(utcEnd);
        if (start.toDateString() === end.toDateString()) {
            const datePart = formatUtcTime(start, { year: 'numeric', month: 'long', day: '2-digit' });
            const startTime = formatUtcTime(start, { hour: '2-digit', minute: '2-digit' });
            const endTime = formatUtcTime(end, { hour: '2-digit', minute: '2-digit' });
            el.textContent = `${datePart} at ${startTime} - ${endTime}`;
        } else {
            const startFull = formatUtcTime(start, { year: 'numeric', month: 'long', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            const endFull = formatUtcTime(end, { year: 'numeric', month: 'long', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            el.textContent = `${startFull} - ${endFull}`;
        }
    });
});
</script>
