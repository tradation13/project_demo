@{
    Layout = "~/Views/Shared/Layouts/_MainLayout.cshtml";
}

<section class="bg-white shadow p-6 rounded mb-10 text-center">
    <h2 class="text-2xl font-semibold mb-4">Forgot Password</h2>
    <p class="text-gray-700 text-base">
        If an account with the provided email exists, we have sent a link to reset your password.
        Please check your inbox (and spam folder).
    </p>

    <div class="mt-6">
        <a href="@Url.Action("Login", "Auth")"
           class="bg-primary hover:bg-primary-dark rounded-lg px-6 py-2 text-white hover:shadow-xl transition duration-150">
            Back to Login
        </a>
    </div>
</section>
