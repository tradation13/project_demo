@model List<IPTS.ViewModels.AppointmentViewModel>
@using IPTS.Models.Entites
@{
    ViewData["Title"] = "My Appointments";
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
    var nowUtc = DateTime.UtcNow;
    string BadgeClass(AppointmentViewModel appt, out string display)
    {
        var isPast = appt.ScheduledTime <= nowUtc;

        display = appt.StatusDisplay;

        if (isPast && appt.Status == AppointmentStatus.Pending)
        {
            display = "Pending (Expired)";
            return "bg-orange-100 text-orange-800";
        }
        if (isPast && appt.Status == AppointmentStatus.Confirmed)
        {
            display = "Completed";
            return "bg-blue-100 text-blue-800";
        }
        return appt.Status switch
        {
            AppointmentStatus.Confirmed => "bg-green-100 text-green-800",
            AppointmentStatus.Pending => "bg-yellow-100 text-yellow-800",
            AppointmentStatus.Completed => "bg-blue-100 text-blue-800",
            AppointmentStatus.Cancelled => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }
}

<div class="max-w-4xl mx-auto py-8">
    <div class="flex items-center justify-between mb-6">
        <h2 class="text-2xl font-bold">My Appointments</h2>
        <a href="/home/therapies"
           class="inline-flex items-center px-4 py-2 bg-green-600 text-white text-sm font-medium rounded-md shadow hover:bg-green-700 transition">
            <i class="fa-solid fa-plus mr-2"></i> New Appointment
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="bg-yellow-50 border-l-4 border-yellow-400 p-4 rounded mb-4">
            <p class="text-yellow-800">You have no appointments yet.</p>
        </div>
    }
    else
    {
        <div class="grid gap-6">
            @foreach (var appt in Model)
            {
                var isPast = appt.ScheduledTime <= nowUtc;
                var badgeText = "";
                var badgeClass = BadgeClass(appt, out badgeText);

                <div class="bg-white rounded-lg shadow p-6 flex flex-col md:flex-row md:items-center md:justify-between">
                    <div>
                        <div class="flex items-center gap-2 mb-2">
                            <span class="font-semibold text-lg">@appt.DoctorName</span>

                            <span class="ml-2 px-3 py-1 rounded-full text-xs font-bold @badgeClass">
                                @badgeText
                            </span>

                            @if (isPast)
                            {
                                <span class="ml-1 px-2 py-0.5 rounded-full text-[10px] bg-gray-100 text-gray-700 border border-gray-200">
                                    Past
                                </span>
                            }
                        </div>

                        <div class="text-gray-600 text-sm mb-1">
                            <span class="font-medium">Date:</span> @appt.ScheduledTime.ToString("MMMM dd, yyyy")
                            <span class="mx-2">|</span>
                            <span class="font-medium">Time:</span> @appt.ScheduledTime.ToString("HH:mm")
                        </div>

                        <div class="text-gray-500 text-xs">
                            Duration: @appt.TotalDurationMinutes min
                        </div>

                        @if (!string.IsNullOrWhiteSpace(appt.Notes))
                        {
                            <div class="mt-2 text-gray-700 text-sm">
                                <span class="font-medium">Notes:</span> @appt.Notes
                            </div>
                        }
                    </div>

                    <div class="flex flex-col md:flex-row gap-2 mt-4 md:mt-0">
                        <a href="@Url.Action("my-appointments", "Appointment", new { area = "Patient", id = appt.Id })"
                           class="px-4 py-2 bg-blue-600 text-white rounded hover:bg-blue-700 text-sm text-center">
                            Details
                        </a>

                        @* نسمح بالتعديل فقط إن كانت الحالة Pending ولم ينته وقت الموعد *@
                        @if (appt.Status == AppointmentStatus.Pending && !isPast)
                        {
                            <a href="@Url.Action("Edit", "Appointment", new { area = "Patient", id = appt.Id })"
                               class="px-4 py-2 bg-yellow-500 text-white rounded hover:bg-yellow-600 text-sm text-center">
                                Edit
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>
