@using System.Collections
@functions {
    List<string> GetMessages(object tempDataValue)
    {
        if (tempDataValue == null) return new List<string>();
        if (tempDataValue is string s) return new List<string> { s };
        if (tempDataValue is IEnumerable<string> list) return list.Cast<string>().ToList();
        return new List<string>();
    }
}

@{
    var alerts = new[]
    {
        new { Messages = GetMessages(TempData["SuccessMessage"]), Title = "Success", Bg = "bg-green-100", Border = "border-green-300", Color = "text-green-600", Icon = "fas fa-check-circle" },
        new { Messages = GetMessages(TempData["WarningMessage"]), Title = "Warning", Bg = "bg-yellow-100", Border = "border-yellow-300", Color = "text-yellow-600", Icon = "fas fa-exclamation-triangle" },
        new { Messages = GetMessages(TempData["ErrorMessage"]), Title = "Error", Bg = "bg-red-100", Border = "border-red-300", Color = "text-red-600", Icon = "fas fa-times-circle" },
        new { Messages = GetMessages(TempData["InfoMessage"]), Title = "Info", Bg = "bg-blue-100", Border = "border-blue-300", Color = "text-blue-600", Icon = "fas fa-info-circle" }
    };
}

<div class="fixed top-20 left-1/2 transform -translate-x-1/2 z-50 space-y-4 w-full max-w-md" x-data>
    @foreach (var alert in alerts)
    { 
        foreach (var text in alert.Messages)
        {
            if (!string.IsNullOrEmpty(text))
            {
                <div x-data="{ show: true }" x-show="show" x-init="setTimeout(() => show = false, 10000)"
                     x-transition:enter="transition ease-out duration-300"
                     x-transition:enter-start="opacity-0 -translate-y-5"
                     x-transition:enter-end="opacity-100 translate-y-0"
                     x-transition:leave="transition ease-in duration-300"
                     x-transition:leave-start="opacity-100 translate-y-0"
                     x-transition:leave-end="opacity-0 -translate-y-5"
                     class="flex items-center justify-between @alert.Bg px-6 py-2 rounded-lg @alert.Border shadow-lg">
                    <div class="flex items-center space-x-4">
                        <i class="@alert.Icon @alert.Color text-xl"></i>
                        <div class="flex flex-col justify-center">
                            <span class="@alert.Color font-bold">@alert.Title</span>
                            <span class="text-sm @alert.Color">@text</span>
                        </div>
                    </div>
                    <button x-on:click ="show = false" class="text-xl text-gray-400 hover:text-gray-500">&#10005;</button>
                </div>
            }
        }
    }
</div>
