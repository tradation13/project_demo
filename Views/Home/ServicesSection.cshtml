@{
    var serviceCards = new[]
    {
        new { Icon = "fas fa-hands-helping", Title = "Patient Support", Desc = "Helpful guidance and care coordination for every step.", IsCta = false },
        new { Icon = "fas fa-running", Title = "Rehab Sessions", Desc = "Targeted sessions to restore movement and reduce pain.", IsCta = false },
        new { Icon = "fas fa-brain", Title = "Neuro Therapy", Desc = "Professional support for recovery and body control.", IsCta = false },
        new { Icon = "fas fa-chart-line", Title = "Progress Tracking", Desc = "Clear reporting to measure improvement over time.", IsCta = false },
        new { Icon = "fas fa-heart-pulse", Title = "Wellness Plans", Desc = "Personalized plans built around your condition and goals.", IsCta = false },
        new { Icon = "fas fa-arrow-right", Title = "Book Now", Desc = "Start with the right service and move forward today.", IsCta = true },
    };
}

<style>
    @@keyframes services-marquee {
        from {
            transform: translateX(0);
        }

        to {
            transform: translateX(-50%);
        }
    }

    .services-marquee {
        overflow: hidden;
        -webkit-mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
        mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
    }

    .services-marquee-track {
        display: flex;
        width: max-content;
        align-items: stretch;
        gap: 1.5rem;
        animation: services-marquee 16s linear infinite;
        will-change: transform;
        padding-bottom: 1.5rem;
    }

    .services-marquee-group {
        display: flex;
        gap: 1.5rem;
        flex: 0 0 auto;
        padding-right: 1.5rem;
    }

    .service-card {
        width: 250px;
        height: 250px;
        flex: 0 0 auto;
    }

    @@media (prefers-reduced-motion: reduce) {
        .services-marquee-track {
            animation: none;
        }
    }
</style>

<section id="services" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-14 text-center">
            <div class="mb-4 flex items-center justify-center gap-3">
                <i class="fas fa-hospital text-3xl text-primary-600"></i>
                <h2 class="text-4xl font-bold tracking-tight text-gray-900">@SharedLocalizer["Services_Title"]</h2>
            </div>
            <p class="mx-auto max-w-2xl text-lg leading-relaxed text-gray-600">
                @SharedLocalizer["Services_Subtitle"]
            </p>
        </div>

        <div class="services-marquee relative mt-10 pb-[30px] sm:mt-14">
            <div class="services-marquee-track">
                @for (var loop = 0; loop < 2; loop++)
                {
                    <div class="services-marquee-group" aria-hidden="@(loop == 1 ? "true" : "false")">
                        @foreach (var card in serviceCards)
                        {
                            <article class="service-card rounded-3xl border border-gray-100 bg-white p-5 shadow-lg">
                                <div class="flex h-full flex-col justify-between gap-4 text-center">
                                    <div class="flex flex-1 flex-col items-center justify-center gap-4">
                                        <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-primary-100 text-primary-600 shadow-sm">
                                            <i class="@card.Icon text-2xl"></i>
                                        </div>
                                        <div>
                                            <h3 class="mb-2 text-base font-bold text-gray-900">@card.Title</h3>
                                            <p class="text-sm leading-relaxed text-gray-600">@card.Desc</p>
                                        </div>
                                    </div>

                                    @if (card.IsCta)
                                    {
                                        <a asp-controller="Home"
                                           asp-action="Therapies"
                                           class="inline-flex items-center justify-center gap-2 rounded-xl bg-primary-600 px-4 py-3 text-sm font-bold text-white">
                                            @SharedLocalizer["Shared_Book_Now"]
                                        </a>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>