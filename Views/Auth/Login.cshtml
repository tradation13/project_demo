@model LoginViewModel
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Login_PageTitle"];
}

<div class="mx-auto max-w-md rounded-lg bg-white p-8 shadow">
    <h2 class="text-center text-2xl font-bold tracking-wide text-gray-800">
        @SharedLocalizer["Shared_SignIn"]
    </h2>
    <p class="mt-2 text-center text-sm text-gray-600">
        @SharedLocalizer["Login_NoAccount"]
        <a href="@Url.Action("Register", "Auth")"
           class="text-primary hover:text-primary-dark hover:underline"
           title="@SharedLocalizer["Login_SignUp_Title"]">
             @SharedLocalizer["Login_SignUp_Link"]
        </a>
    </p>

    <form asp-controller="auth" asp-action="login" method="post" autocomplete="off"
          class="my-8 space-y-6 text-sm">
        <input asp-for="ReturnUrl" type="hidden" />  

       <div class="mb-6"> <label asp-for="UsernameOrEmail" class="ml-1 block font-medium text-gray-700">@SharedLocalizer["Login_Label_UserEmail"]</label>
    <input asp-for="UsernameOrEmail"
           class="mt-2 w-full rounded-xl border-gray-200 px-4 py-3 text-sm text-gray-900 outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary/20"
           placeholder="Leo@gmail.com" />
    <span asp-validation-for="UsernameOrEmail" class="mt-1 block text-xs text-red-500"></span>
</div>

<div class="mb-6"> <label asp-for="Password" class="ml-1 block font-medium text-gray-700">@SharedLocalizer["Shared_Password"]</label>
    <div x-data="{ show: false }" class="relative mt-2 flex items-center">
        <input :type=" show ? 'text': 'password' "
               asp-for="Password"
               class="w-full rounded-xl border-gray-200 px-4 py-3 pr-12 text-sm text-gray-900 outline-none transition-all focus:border-primary focus:ring-1 focus:ring-primary/20"
               placeholder="••••••••" />
        <button x-on:click="show = !show" type="button"
                class="absolute right-4 flex items-center justify-center text-gray-400 transition-colors hover:text-gray-600">
                <i :class="show ? 'fas fa-eye' : 'fas fa-eye-slash'" class="text-sm"></i>
        </button>
    </div>
    <span asp-validation-for="Password" class="mt-1 block text-xs text-red-500"></span>
</div>

        <div class="flex items-center">
            <input asp-for="RememberMe" type="checkbox" id="remember_me"
                   class="mr-2 rounded focus:ring-0">
            <label for="remember_me" class="text-gray-700">@SharedLocalizer["Login_RememberMe"]</label>
        </div>

@* <button type="submit"
        class="w-full rounded bg-green-600 px-6 py-2 font-bold text-white shadow transition duration-150 hover:bg-green-700">
            Login
        </button> *@

        <div class="my-4 flex items-center justify-end space-x-4">
            <a href="@Url.Action("ForgotPassword","auth")"
               class="text-gray-700 hover:text-gray-900 hover:underline">
                @SharedLocalizer["Shared__ForgotPassword"]
            </a>
            <button type="submit"
                    class="rounded-lg bg-primary px-8 py-2 uppercase text-gray-100 transition duration-150 hover:bg-primary-dark hover:shadow-xl">
                @SharedLocalizer["Shared_SignIn"]
            </button>
        </div>

        @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
    </form>

    @* <div class="my-6 flex items-center justify-between">
        <div class="h-[1px] w-full bg-gray-300"></div>
        <span class="mx-6 text-sm uppercase text-gray-400">Or</span>
        <div class="h-[1px] w-full bg-gray-300"></div>
    </div>
 *@
    @* <div class="space-y-2 text-sm">
        <a href="@Url.Action("ExternalLogin", "auth", new { provider = "Google" })"
           class="flex items-center justify-center space-x-2 rounded bg-gray-100 py-2 text-gray-600 hover:bg-gray-200">
            <i class="fab fa-google text-3xl" style="color:#DB4437;"></i>
            <span>Continue with Google</span>
        </a>

        <a href="@Url.Action("ExternalLogin", "auth", new { provider = "Facebook" })"
           class="flex items-center justify-center space-x-2 rounded bg-gray-100 py-2 text-gray-600 hover:bg-gray-200">
            <i class="fab fa-facebook text-3xl" style="color:#1877F2;"></i>
            <span>Continue with Facebook</span>
        </a>

        <a href="@Url.Action("ExternalLogin", "auth", new { provider = "LinkedIn" })"
           class="flex items-center justify-center space-x-2 rounded bg-gray-100 py-2 text-gray-600 hover:bg-gray-200">
            <i class="fab fa-linkedin text-3xl" style="color:#0077B5;"></i>
            <span>Continue with LinkedIn</span>
        </a>
    </div> *@

    <div class="mt-4">
        <a asp-controller="Home" asp-action="Index"
           class="text-green-600 hover:text-green-700 hover:underline">
            ← @SharedLocalizer["Login_BackHome"]
        </a>
    </div>
    @await Html.PartialAsync("_ValidationScriptsPartial")
</div>