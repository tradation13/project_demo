@using IPTS.ViewModels
@model AppointmentEditViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewData["Title"] = $"{SharedLocalizer["Shared_Edit"]} {SharedLocalizer["Shared_Appointment"]}";
}

<div class="prac-page space-y-6 max-w-3xl">

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
            <div class="avatar-lg">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                </svg>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-gray-900 leading-tight">@SharedLocalizer["Shared_Edit"] @SharedLocalizer["Shared_Appointment"]</h2>
                <p class="text-sm text-gray-500 mt-0.5">#@Model.Id</p>
            </div>
        </div>
        <a href="@Url.Action("Index", "Appointments", new { area = "doctor" })" class="btn-prac-secondary">
            @SharedLocalizer["Shared_Back"]
        </a>
    </div>

    <div class="header-card prac-header-card p-5 sm:p-7">
        <form asp-action="Edit" method="post">
            <input type="hidden" asp-for="Id" />

            <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                <div>
                    <label asp-for="PatientId" class="prac-label">@SharedLocalizer["Shared_Patient"] @SharedLocalizer["Shared_ID"]</label>
                    <input asp-for="PatientId" type="number" class="prac-input" />
                    <span asp-validation-for="PatientId" class="mt-1 block text-xs text-red-700"></span>
                </div>
                <div>
                    <label asp-for="DoctorId" class="prac-label">@SharedLocalizer["Therapies_Doctor"] @SharedLocalizer["Shared_ID"]</label>
                    <input asp-for="DoctorId" type="number" class="prac-input" />
                    <span asp-validation-for="DoctorId" class="mt-1 block text-xs text-red-700"></span>
                </div>
                <div>
                    <label asp-for="ScheduledTime" class="prac-label">@SharedLocalizer["Appt_ScheduledTime"]</label>
                    <input asp-for="ScheduledTime" type="datetime-local" class="prac-input" />
                    <span asp-validation-for="ScheduledTime" class="mt-1 block text-xs text-red-700"></span>
                </div>
                <div>
                    <label asp-for="Status" class="prac-label">@SharedLocalizer["Appt_Status"]</label>
                    <select asp-for="Status" asp-items="Html.GetEnumSelectList<AppointmentStatus>()" class="prac-input"></select>
                    <span asp-validation-for="Status" class="mt-1 block text-xs text-red-700"></span>
                </div>
            </div>

            <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row sm:justify-end">
                <a href="@Url.Action("Index", "Appointments", new { area = "doctor" })" class="btn-prac-secondary">
                    @SharedLocalizer["Shared_Cancel"]
                </a>
                <button type="submit" class="btn-add-test">
                    @SharedLocalizer["Shared_Update"] @SharedLocalizer["Shared_Appointment"]
                </button>
            </div>
        </form>
    </div>
</div>
