@model UserFormViewModel

@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewBag.Title = "Create " + ViewBag.UserType;
}
<form asp-action="Create" method="post" asp-route-UserType="@ViewBag.UserType">
    <div class="card mb-4">
        <div class="card-header">
            <h5>User Information</h5>
        </div>
        <div class="card-body">
            <div class="flex flex-wrap gap-4">
                <div class="flex-1 min-w-[200px]">
                    <label asp-for="UserName" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="UserName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm
                        focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="UserName" class="text-red-500 text-sm"></span>
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm
                        focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="PhoneNumber" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm
                        focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="PhoneNumber" class="text-red-500 text-sm"></span>
                </div>
            </div>
            <div class="flex gap-4 mt-4">
                <div class="flex-1 min-w-[200px]">
                    <label asp-for="Password" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="Password" type="password" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm
                        focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="Password" class="text-red-500 text-sm"></span>
                </div>
                <div class="flex-1 min-w-[200px]">
                    <label asp-for="ConfirmPassword" class="block text-sm font-medium text-gray-700"></label>
                    <input asp-for="ConfirmPassword" type="password" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm
                        focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                    <span asp-validation-for="ConfirmPassword" class="text-red-500 text-sm"></span>
                </div>
            </div>
        </div>
    </div>

    @switch (ViewBag.UserType)
    {
        case "Admin":
            // No extra fields for admin
            break;

        case "Customer":
            <div class="card mb-4">
                <div class="card-header">
                    <h5>Customer Information</h5>
                </div>
                <div class="card-body">
                    <div class="flex gap-4">
                        <div class="flex-1 min-w-[200px]">
                            <label asp-for="Customer.FirstName" class="block text-sm font-medium text-gray-700"></label>
                            <input asp-for="Customer.FirstName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm
                                    focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                            <span asp-validation-for="Customer.FirstName" class="text-red-500 text-sm"></span>
                        </div>
                        <div class="flex-1 min-w-[200px]">
                            <label asp-for="Customer.LastName" class="block text-sm font-medium text-gray-700"></label>
                            <input asp-for="Customer.LastName" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm
                                    focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" />
                            <span asp-validation-for="Customer.LastName" class="text-red-500 text-sm"></span>
                        </div>
                    </div>
                </div>
            </div>
            break;

        default:
            break;
    }

    <div class="flex gap-2 mt-6">
        <a href="@Url.Action("Index")"
           class="bg-secondary bg-opacity-20 hover:bg-opacity-40 rounded-lg px-6 py-1.5 text-secondary
                  hover:shadow-xl transition duration-150">
            Cancel
        </a>

        <button type="submit"
                class="bg-primary hover:bg-primary-dark rounded-lg px-6 py-1.5 text-white
                       hover:shadow-xl transition duration-150">
            Create
        </button>
    </div>
    <div asp-validation-summary="All" class="text-red-500 text-sm mb-4"></div>

</form>
