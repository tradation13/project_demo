@{

    ViewData["Title"] = SharedLocalizer["Shared_AboutPhysoTech"];

    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";



    var backUrl = Context.Request.Query["returnUrl"].ToString();

    if (string.IsNullOrWhiteSpace(backUrl))

    {

        backUrl = Context.Request.Headers["Referer"].ToString();

    }



    if (string.IsNullOrWhiteSpace(backUrl) || !Url.IsLocalUrl(backUrl))

    {

        backUrl = Url.Action("Index", "Home") ?? "/";

    }

}



<section class="pa-section relative overflow-hidden bg-white py-16 lg:py-20">



    <!-- خلفية عائمة -->

    <div class="absolute inset-0 pointer-events-none overflow-hidden">

        <i class="pa-float fa-solid fa-heart-pulse absolute left-[4%] top-[10%] text-5xl text-primary-400/10"></i>

        <i class="pa-float pa-fd1 fa-solid fa-heart-pulse absolute right-[6%] bottom-[18%] text-4xl text-primary-400/10"></i>

        <i class="pa-float pa-fd1 fa-solid fa-shield-halved absolute right-[20%] top-[6%] text-5xl text-primary-400/8"></i>



        <div class="pa-orb absolute left-[3%] top-[15%] h-64 w-64 rounded-full bg-primary-100/40 blur-3xl"></div>

        <div class="pa-orb pa-orb2 absolute right-[4%] bottom-[10%] h-72 w-72 rounded-full bg-primary-200/30 blur-3xl"></div>

    </div>



    <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">



        <!-- Hero -->

        <header class="pa-heading mx-auto mb-14 max-w-3xl text-center lg:mb-16">

            <p class="text-sm font-bold uppercase tracking-wide text-primary-600">@SharedLocalizer["Shared_AboutPhysoTech"]</p>

            <h1 class="mt-2 text-4xl font-bold text-gray-900 sm:text-5xl">@SharedLocalizer["PageAbout_MainHeading"]</h1>

            <div class="mx-auto mt-6 h-1 w-16 rounded-full bg-gradient-to-r from-primary-400 to-primary-600"></div>

        </header>



        <!-- Story: image + intro -->

        <div class="mb-16 grid items-center gap-10 lg:mb-20 lg:grid-cols-2 lg:gap-14">



            <div class="pa-img relative order-1">

                <div class="overflow-hidden rounded-2xl border border-gray-100 bg-white shadow-xl">

                    <span class="pa-corner pa-corner-tl"></span>

                    <span class="pa-corner pa-corner-br"></span>

                    <img src="/images/home/hero.svg"
                         alt="@SharedLocalizer["Hero_ImgAlt"]"
                         width="680"
                         height="420"
                         class="h-auto w-full object-contain"
                         style="aspect-ratio: 680 / 420;" />

                </div>

                <div class="absolute -bottom-4 -left-4 hidden h-28 w-28 rounded-2xl bg-primary-100 opacity-60 blur-3xl lg:block"></div>

                <div class="absolute -right-4 -top-4 hidden h-24 w-24 rounded-2xl bg-primary-200 opacity-60 blur-3xl lg:block"></div>

                <span class="pa-ring pa-ring1"></span>

                <span class="pa-ring pa-ring2"></span>

            </div>



            <div class="order-2 space-y-6">

                <p class="pa-para text-lg leading-relaxed text-gray-700">

                    @SharedLocalizer["PageAbout_IntroPara"]

                </p>

                <p class="pa-para pa-para2 text-lg leading-relaxed text-gray-700">

                    @SharedLocalizer["PageAbout_IPTSPara"]

                </p>

            </div>

        </div>



        <!-- Values -->

        <div class="pa-values rounded-3xl  px-5 py-10 sm:px-8 sm:py-12">

            <div class="pa-values-heading mb-10 text-center">

                <div class="mb-3 inline-flex h-12 w-12 items-center justify-center rounded-xl bg-primary-100 text-primary-600 shadow-sm ring-1 ring-primary-200/60">

                    <i class="fa-solid fa-star"></i>

                </div>

                <h2 class="text-2xl font-bold text-gray-900 sm:text-3xl">@SharedLocalizer["Why_Title"]</h2>

            </div>



            <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4 lg:gap-6">

                <article class="about-reveal pa-card flex flex-col rounded-2xl bg-white/90 p-5 text-center shadow-sm" data-delay="0" style="opacity:0; transform:translateY(28px); transition:opacity 0.95s ease, transform 0.95s ease;">

                    <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary-100 text-xl text-primary-600">

                        <i class="fa-solid fa-user-doctor"></i>

                    </div>

                    <p class="font-bold text-gray-900">@SharedLocalizer["PageAbout_Card1_Title"]</p>

                    <p class="mt-2 text-sm leading-relaxed text-gray-600">@SharedLocalizer["PageAbout_Card1_Desc"]</p>

                </article>



                <article class="about-reveal pa-card flex flex-col rounded-2xl bg-white/90 p-5 text-center shadow-sm" data-delay="120" style="opacity:0; transform:translateY(28px); transition:opacity 0.95s ease, transform 0.95s ease;">

                    <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary-100 text-xl text-primary-600">

                        <i class="fa-solid fa-hand-holding-medical"></i>

                    </div>

                    <p class="font-bold text-gray-900">@SharedLocalizer["PageAbout_Card2_Title"]</p>

                    <p class="mt-2 text-sm leading-relaxed text-gray-600">@SharedLocalizer["PageAbout_Card2_Desc"]</p>

                </article>



                <article class="about-reveal pa-card flex flex-col rounded-2xl bg-white/90 p-5 text-center shadow-sm" data-delay="240" style="opacity:0; transform:translateY(28px); transition:opacity 0.95s ease, transform 0.95s ease;">

                    <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary-100 text-xl text-primary-600">

                        <i class="fa-solid fa-chart-line"></i>

                    </div>

                    <p class="font-bold text-gray-900">@SharedLocalizer["PageAbout_Card3_Title"]</p>

                    <p class="mt-2 text-sm leading-relaxed text-gray-600">@SharedLocalizer["PageAbout_Card3_Desc"]</p>

                </article>



                <article class="about-reveal pa-card flex flex-col rounded-2xl bg-white/90 p-5 text-center shadow-sm" data-delay="360" style="opacity:0; transform:translateY(28px); transition:opacity 0.95s ease, transform 0.95s ease;">

                    <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-full bg-primary-100 text-xl text-primary-600">

                        <i class="fa-solid fa-people-group"></i>

                    </div>

                    <p class="font-bold text-gray-900">@SharedLocalizer["PageAbout_Card4_Title"]</p>

                    <p class="mt-2 text-sm leading-relaxed text-gray-600">@SharedLocalizer["PageAbout_Card4_Desc"]</p>

                </article>

            </div>

        </div>

    </div>

</section>



<style>

    @@keyframes paFloat {

        0%,100% { transform:translate3d(0,0,0) rotate(0deg) scale(1); }

        33%      { transform:translate3d(12px,-10px,0) rotate(5deg) scale(1.03); }

        66%      { transform:translate3d(-9px,8px,0) rotate(-4deg) scale(0.97); }

    }

    @@keyframes paOrb {

        0%,100% { transform:translate(0,0) scale(1); }

        50%      { transform:translate(16px,-14px) scale(1.07); }

    }

    @@keyframes paFadeUp {

        from { opacity:0; transform:translateY(32px); }

        to   { opacity:1; transform:translateY(0); }

    }

    @@keyframes paFadeLeft {

        from { opacity:0; transform:translateX(-36px); }

        to   { opacity:1; transform:translateX(0); }

    }

    @@keyframes paFadeRight {

        from { opacity:0; transform:translateX(36px); }

        to   { opacity:1; transform:translateX(0); }

    }

    @@keyframes paRing {

        0%   { transform:scale(0.9); opacity:.3; }

        100% { transform:scale(1.2); opacity:0; }

    }

    @@keyframes paCorner {

        0%,100% { opacity:.35; transform:scale(1); }

        50%      { opacity:.85; transform:scale(1.1); }

    }



    .pa-float { animation:paFloat 14s ease-in-out infinite; will-change:transform; }

    .pa-fd1   { animation-duration:17s; animation-delay:-5s; }

    .pa-fd2   { animation-duration:20s; animation-delay:-9s; }

    .pa-orb   { animation:paOrb 13s ease-in-out infinite; }

    .pa-orb2  { animation-duration:18s; animation-delay:-7s; }



    .pa-heading,

    .pa-para,

    .pa-img,

    .pa-values-heading { opacity:0; }



    .pa-heading.av       { animation:paFadeUp    0.7s cubic-bezier(.22,1,.36,1) forwards; }

    .pa-para.av          { animation:paFadeUp    0.65s cubic-bezier(.22,1,.36,1) .18s forwards; }

    .pa-para2.av         { animation-delay:.30s; }

    .pa-img.av           { animation:paFadeLeft  0.75s cubic-bezier(.22,1,.36,1) .12s forwards; }

    .pa-values-heading.av { animation:paFadeUp   0.65s cubic-bezier(.22,1,.36,1) forwards; }



    .pa-ring {

        position:absolute; inset:-8%;

        border-radius:50%;

        border:2px solid;

        pointer-events:none;

    }

    .pa-ring1 { border-color:rgba(16,185,129,.15); animation:paRing 3s ease-out infinite; }

    .pa-ring2 { border-color:rgba(16,185,129,.08); animation:paRing 3s ease-out 1.5s infinite; }



    .pa-corner {

        position:absolute; width:26px; height:26px;

        border-color:#10b981; border-style:solid;

        animation:paCorner 2.5s ease-in-out infinite;

        pointer-events:none; z-index:2;

    }

    .pa-corner-tl { top:12px; left:12px; border-width:2px 0 0 2px; border-radius:5px 0 0 0; }

    .pa-corner-br { bottom:12px; right:12px; border-width:0 2px 2px 0; border-radius:0 0 5px 0; animation-delay:1.25s; }



    .pa-card {

        transition: opacity 0.95s ease, transform 0.95s ease, box-shadow 0.25s ease !important;

    }

    .pa-card:hover {

        transform: translateY(-4px) !important;

        box-shadow: 0 10px 28px rgba(16,185,129,.13) !important;

    }



    @@media (max-width:1023.98px) {

        .pa-ring { display:none; }

    }

</style>



<script>

    (function () {

        const cards = document.querySelectorAll('.about-reveal');

        if (cards.length) {

            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            if (reduceMotion || !('IntersectionObserver' in window)) {

                cards.forEach(function(card){

                    card.style.opacity = '1';

                    card.style.transform = 'translateY(0)';

                });

            } else {

                const cardObs = new IntersectionObserver(function(entries){

                    entries.forEach(function(entry){

                        const card = entry.target;

                        if (entry.isIntersecting) {

                            const delay = card.getAttribute('data-delay') || '0';

                            card.style.transitionDelay = delay + 'ms';

                            card.style.opacity = '1';

                            card.style.transform = 'translateY(0)';

                        } else {

                            card.style.transitionDelay = '0ms';

                            card.style.opacity = '0';

                            card.style.transform = 'translateY(28px)';

                        }

                    });

                }, { threshold: 0.2, rootMargin: '0px 0px -20px 0px' });

                cards.forEach(function(card){ cardObs.observe(card); });

            }

        }



        const obs = new IntersectionObserver(function(entries){

            entries.forEach(function(e){

                if (e.isIntersecting) {

                    e.target.classList.add('av');

                } else {

                    e.target.classList.remove('av');

                }

            });

        }, { threshold: 0.12 });



        document.querySelectorAll('.pa-heading, .pa-para, .pa-img, .pa-values-heading')

                .forEach(function(el){ obs.observe(el); });

    })();

</script>

