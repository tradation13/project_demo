@model IPTS.Areas.Admin.ViewsModels.ChatConversationDetailsViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["ChatConversations_Details"];
    var typeLabel = SharedLocalizer["ChatbotUserType_" + Model.UserType.ToString()];
    var typeClass = Model.UserType switch
    {
        IPTS.Models.Enums.ChatbotUserType.Patient => "bg-sky-50 text-sky-800 border-sky-100",
        IPTS.Models.Enums.ChatbotUserType.Therapist => "bg-violet-50 text-violet-800 border-violet-100",
        IPTS.Models.Enums.ChatbotUserType.Admin => "bg-amber-50 text-amber-900 border-amber-100",
        _ => "bg-slate-50 text-slate-700 border-slate-200"
    };
}

<div class="mx-auto max-w-4xl space-y-5">

    <div class="flex flex-wrap items-center justify-between gap-3">
        <div>
            <p class="text-xs font-semibold uppercase tracking-wider text-slate-400">@SharedLocalizer["ChatConversations"]</p>
            <h4 class="mt-1 text-2xl font-bold text-slate-800">@SharedLocalizer["ChatConversations_Details"]</h4>
        </div>
        <a asp-action="Index"
           class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">
            <i class="fas fa-arrow-left text-xs"></i> @SharedLocalizer["Shared_Back"]
        </a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-200/80 bg-white shadow-sm">

        <div class="border-b border-slate-100 bg-gradient-to-r from-slate-50 via-white to-primary/5 px-6 py-6 sm:px-8">
            <div class="flex flex-wrap items-start gap-4">
                <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl bg-gradient-to-br from-primary to-indigo-600 text-lg text-white shadow-sm shadow-primary/20">
                    <i class="fas fa-comments"></i>
                </span>
                <div class="min-w-0 flex-1">
                    <div class="flex flex-wrap items-center gap-2">
                        <span class="inline-flex rounded-full border px-3 py-1 text-xs font-bold @typeClass">
                            @typeLabel
                        </span>
                        <span class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-2.5 py-1 text-[11px] font-semibold text-slate-500">
                            <i class="fas fa-lock text-[10px]"></i>
                            @SharedLocalizer["ChatConversations_ReadOnly"]
                        </span>
                        @if (Model.ConsentGiven)
                        {
                            <span class="inline-flex items-center gap-1 rounded-full border border-primary/15 bg-primary/10 px-2.5 py-1 text-[11px] font-semibold text-primary">
                                <i class="fas fa-check text-[10px]"></i>
                                @SharedLocalizer["ChatConversations_ConsentYes"]
                            </span>
                        }
                    </div>
                    <p class="mt-3 text-sm text-slate-500">
                        @SharedLocalizer["ChatConversations_Created"]:
                        <span class="font-semibold text-slate-700">@Model.CreatedAt.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</span>
                        <span class="mx-2 text-slate-300">|</span>
                        @SharedLocalizer["ChatConversations_LastMessage"]:
                        <span class="font-semibold text-slate-700">@Model.LastMessageAt.ToLocalTime().ToString("dd MMM yyyy · HH:mm")</span>
                    </p>
                </div>
            </div>

            <dl class="mt-5 grid gap-3 sm:grid-cols-2">
                <div class="rounded-xl border border-slate-100 bg-white px-4 py-3">
                    <dt class="text-[11px] font-bold uppercase tracking-wide text-slate-400">@SharedLocalizer["ChatConversations_UserId"]</dt>
                    <dd class="mt-1 break-all font-mono text-sm font-medium text-slate-800">@(string.IsNullOrWhiteSpace(Model.UserId) ? "—" : Model.UserId)</dd>
                </div>
                <div class="rounded-xl border border-slate-100 bg-white px-4 py-3">
                    <dt class="text-[11px] font-bold uppercase tracking-wide text-slate-400">@SharedLocalizer["ChatConversations_Ip"]</dt>
                    <dd class="mt-1 font-mono text-sm font-medium text-slate-800">@(string.IsNullOrWhiteSpace(Model.IpAddress) ? "—" : Model.IpAddress)</dd>
                </div>
                <div class="rounded-xl border border-slate-100 bg-white px-4 py-3 sm:col-span-2">
                    <dt class="text-[11px] font-bold uppercase tracking-wide text-slate-400">@SharedLocalizer["ChatConversations_Session"]</dt>
                    <dd class="mt-1 break-all font-mono text-xs font-medium leading-relaxed text-slate-700">@Model.SessionId</dd>
                </div>
                @if (Model.ConsentGiven && Model.ConsentDate.HasValue)
                {
                    <div class="rounded-xl border border-slate-100 bg-white px-4 py-3 sm:col-span-2">
                        <dt class="text-[11px] font-bold uppercase tracking-wide text-slate-400">@SharedLocalizer["ChatConversations_Consent"]</dt>
                        <dd class="mt-1 text-sm font-medium text-slate-700">
                            @Model.ConsentDate.Value.ToLocalTime().ToString("dd MMM yyyy · HH:mm")
                        </dd>
                    </div>
                }
            </dl>
        </div>

        <div class="border-b border-slate-100 bg-slate-50/80 px-6 py-3 sm:px-8">
            <p class="text-xs font-bold uppercase tracking-wider text-slate-500">
                @SharedLocalizer["ChatConversations_Transcript"]
                <span class="ms-2 rounded-full bg-slate-200/80 px-2 py-0.5 text-[10px] font-semibold normal-case tracking-normal text-slate-600">@Model.Messages.Count</span>
            </p>
        </div>

        <div class="max-h-[min(72vh,720px)] space-y-4 overflow-y-auto bg-[linear-gradient(180deg,#f8fafc_0%,#ffffff_40%)] px-4 py-6 sm:px-8">
            @if (Model.Messages.Count == 0)
            {
                <div class="rounded-2xl border border-dashed border-slate-200 bg-white px-4 py-14 text-center">
                    <div class="mx-auto mb-3 flex h-12 w-12 items-center justify-center rounded-2xl bg-slate-50 text-slate-400">
                        <i class="fas fa-comment-slash"></i>
                    </div>
                    <p class="text-sm font-medium text-slate-600">@SharedLocalizer["ChatConversations_NoMessages"]</p>
                </div>
            }
            else
            {
                foreach (var msg in Model.Messages)
                {
                    var isUser = msg.SenderType == IPTS.Models.Enums.ChatbotMessageSender.User;
                    <div class="flex @(isUser ? "justify-start" : "justify-end")">
                        <div class="max-w-[90%] sm:max-w-[78%]">
                            <div class="mb-1.5 flex items-center gap-2 @(isUser ? "" : "justify-end")">
                                <span class="inline-flex items-center gap-1.5 text-[11px] font-bold uppercase tracking-wide @(isUser ? "text-slate-600" : "text-primary")">
                                    <i class="fas @(isUser ? "fa-user" : "fa-robot") text-[10px]"></i>
                                    @(isUser ? SharedLocalizer["ChatConversations_SenderUser"] : SharedLocalizer["ChatConversations_SenderAi"])
                                </span>
                                <span class="text-[11px] tabular-nums text-slate-400">@msg.CreatedAt.ToLocalTime().ToString("dd MMM · HH:mm")</span>
                            </div>
                            <div class="rounded-2xl px-4 py-3.5 text-sm leading-relaxed shadow-sm @(isUser
                                ? "rounded-tl-md border border-slate-200 bg-white text-slate-800"
                                : "rounded-tr-md border border-primary/20 bg-primary/5 text-slate-800")">
                                <p class="whitespace-pre-wrap break-words" dir="auto">@msg.Message</p>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
