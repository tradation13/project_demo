@model EditAdminViewModel

@{
    ViewData["Title"] = SharedLocalizer["Users_EditAdmin"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div>
    <h4 class="mb-4 text-xl capitalize">@SharedLocalizer["Users_EditAdmin"]</h4>

    <form asp-action="EditAdmin" asp-route-id="@Model.Id" method="post" class="space-y-4">
        <div class="flex flex-col">
            <label asp-for="UserName" class="mb-1 font-normal">@SharedLocalizer["Shared_UserName"]</label>
            <input asp-for="UserName" class="rounded border-gray-300 py-1 focus:outline-none focus:ring-0" placeholder=@SharedLocalizer["Patient_Placeholder_User"] />
            <span asp-validation-for="UserName" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Email" class="mb-1 font-normal">@SharedLocalizer["Shared_Email"]</label>
            <input asp-for="Email" class="rounded border-gray-300 py-1 focus:outline-none focus:ring-0" placeholder=@SharedLocalizer["Search_PlaceholderEmail"] />
            <span asp-validation-for="Email" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="PhoneNumber" class="mb-1 font-normal">@SharedLocalizer["Shared_PhoneNumber"]</label>
            <input asp-for="PhoneNumber" class="rounded border-gray-300 py-1 focus:outline-none focus:ring-0" placeholder=@SharedLocalizer["Search_PlaceholderPhone"] />
            <span asp-validation-for="PhoneNumber" class="text-sm text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="Status" class="mb-1 font-normal">@SharedLocalizer["Appt_Status"]</label>
            <select asp-for="Status" class="rounded border-gray-300 py-1 focus:outline-none focus:ring-0">
                <option value="0">@SharedLocalizer["Status_Active"]</option>
                <option value="1">@SharedLocalizer["Status_Inactive"]</option>
            </select>
            <span asp-validation-for="Status" class="text-sm text-red-500"></span>
        </div>

        <div class="mt-6 flex gap-2">
            <a asp-action="Index"
               class="rounded-lg bg-secondary bg-opacity-20 px-6 py-1.5 text-secondary transition duration-150 hover:bg-opacity-40 hover:shadow-xl">
                @SharedLocalizer["Shared_Cancel"]
            </a>
            <button type="submit"
                    class="rounded-lg bg-primary px-6 py-1.5 text-white transition duration-150 hover:bg-primary-dark hover:shadow-xl">
                @SharedLocalizer["Profile_SaveBtn"]
            </button>
        </div>
    </form>
</div>