@model IPTS.Areas.Admin.Controllers.BlogPostListViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["BlogPosts"];
}

<div class="rounded-2xl border border-slate-100 bg-white p-6 shadow-sm">
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div>
            <h2 class="text-xl font-bold text-slate-800">@SharedLocalizer["BlogPosts"]</h2>
            <p class="text-sm text-slate-500">@SharedLocalizer["BlogPosts_Description"]</p>
        </div>
        <a asp-action="Create" class="rounded-xl bg-primary px-5 py-2.5 text-sm font-semibold text-white">@SharedLocalizer["Shared_Add_New"]</a>
    </div>

    <div class="overflow-hidden rounded-2xl border border-slate-100">
        <table class="min-w-full text-sm">
            <thead class="bg-slate-50 text-left">
                <tr>
                    <th class="px-4 py-3">#</th>
                    <th class="px-4 py-3">@SharedLocalizer["Contact_Label_Name"]</th>
                    <th class="px-4 py-3">@SharedLocalizer["Shared_Date"]</th>
                    <th class="px-4 py-3">@SharedLocalizer["Status"]</th>
                    <th class="px-4 py-3 text-center">@SharedLocalizer["Appt_Actions"]</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var post in Model.Posts)
                {
                    <tr class="border-t border-slate-100 hover:bg-slate-50">
                        <td class="px-4 py-3">@post.Id</td>
                        <td class="px-4 py-3 font-semibold text-slate-700">@post.Title</td>
                        <td class="px-4 py-3">@post.PublishedAt.ToString("yyyy-MM-dd")</td>
                        <td class="px-4 py-3"><span class="rounded-full bg-emerald-100 px-2.5 py-1 text-xs font-semibold text-emerald-700">@(post.IsPublished ? SharedLocalizer["Shared_Active"] : SharedLocalizer["Shared_Inactive"])</span></td>
                        <td class="px-4 py-3">
                            <div class="flex justify-center gap-2">
                                <a asp-action="Details" asp-route-id="@post.Id" class="rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-700">@SharedLocalizer["Shared_Details"]</a>
                                <a asp-action="Edit" asp-route-id="@post.Id" class="rounded-full bg-yellow-100 px-3 py-1 text-xs font-semibold text-yellow-700">@SharedLocalizer["Shared_Edit"]</a>
                                <form asp-action="Delete" asp-route-id="@post.Id" method="post" class="inline" onsubmit="return confirm('@SharedLocalizer["Msg_ConfirmDelete"]');">
                                    <button type="submit" class="rounded-full bg-red-100 px-3 py-1 text-xs font-semibold text-red-700">@SharedLocalizer["Shared_Delete"]</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
