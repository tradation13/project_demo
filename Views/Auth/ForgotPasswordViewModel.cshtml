@model ForgotPasswordViewModel
<section class="bg-white shadow p-6 rounded mb-10">
    <h2 class="text-2xl font-semibold mb-6">Forgot Password</h2>

    <form asp-action="ForgotPassword" method="post" class="space-y-4">
        <div>
            <label asp-for="Email" class="block text-sm font-medium text-gray-700"></label>
            <input asp-for="Email" type="email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm
                       focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" placeholder="Enter your email" />
            <span asp-validation-for="Email" class="text-red-500 text-sm"></span>
        </div>
        <button type="submit" class="bg-primary hover:bg-primary-dark rounded-lg px-6 py-1.5 text-white
               hover:shadow-xl transition duration-150">
            Send Reset Link
        </button>
        <div asp-validation-summary="All" class="text-red-500 text-sm mt-4"></div>
    </form>
</section>
