@{
    ViewData["Title"] = SharedLocalizer["Terms_Title"];
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
}

<section class="legal-page relative overflow-hidden bg-gradient-to-b from-white via-emerald-50/30 to-white py-12 sm:py-16">
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -left-20 top-24 h-72 w-72 rounded-full bg-emerald-100/50 blur-3xl"></div>
        <div class="absolute -right-16 bottom-20 h-80 w-80 rounded-full bg-sky-100/40 blur-3xl"></div>
    </div>

    <div class="relative z-10 mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">

        <div class="rounded-[2rem] border border-gray-100 bg-gradient-to-b from-white to-gray-50/50 p-5 shadow-[0_24px_65px_-25px_rgba(15,23,42,0.35)] sm:p-8 lg:p-10">

            <h1 class="pp-title mb-8 border-b border-gray-100 pb-4 text-2xl font-bold tracking-tight text-gray-900 sm:mb-10 sm:text-3xl">
                @SharedLocalizer["Terms_Title"]
            </h1>

            <div class="space-y-8 text-justify leading-relaxed text-gray-700 sm:space-y-9">

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Terms_Section1_Title"]</h2>
                    <p>@SharedLocalizer["Terms_Section1_Text"]</p>
                </section>

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Terms_Section2_Title"]</h2>
                    <p>@SharedLocalizer["Terms_Section2_Text"]</p>
                </section>

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Terms_Section3_Title"]</h2>
                    <p class="mb-3">@SharedLocalizer["Terms_Section3_Text"]</p>
                    <ul class="list-disc space-y-2 pl-5 text-left">
                        <li>@SharedLocalizer["Terms_Section3_Item1"]</li>
                        <li>@SharedLocalizer["Terms_Section3_Item2"]</li>
                        <li>@SharedLocalizer["Terms_Section3_Item3"]</li>
                        <li>@SharedLocalizer["Terms_Section3_Item4"]</li>
                        <li>@SharedLocalizer["Terms_Section3_Item5"]</li>
                    </ul>
                </section>

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Terms_Section4_Title"]</h2>
                    <p>@SharedLocalizer["Terms_Section4_Text"]</p>
                </section>

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Terms_Section5_Title"]</h2>
                    <p>@SharedLocalizer["Terms_Section5_Text"]</p>
                </section>

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Terms_Section6_Title"]</h2>
                    <p>@SharedLocalizer["Terms_Section6_Text"]</p>
                </section>

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Terms_Section7_Title"]</h2>
                    <p>@SharedLocalizer["Terms_Section7_Text"]</p>
                </section>

                <section class="pp-section rounded-2xl border border-gray-100 bg-white/85 p-5 shadow-sm sm:p-6">
                    <h2 class="mb-3 text-xl font-bold text-gray-900">@SharedLocalizer["Terms_Section8_Title"]</h2>
                    <p>@SharedLocalizer["Terms_Section8_Text"]</p>
                </section>

            </div>
        </div>
    </div>
</section>

<style>
    @@keyframes ppFadeUp {
        from { opacity:0; transform:translateY(28px); }
        to   { opacity:1; transform:translateY(0); }
    }
    @@keyframes ppFadeIn {
        from { opacity:0; }
        to   { opacity:1; }
    }
    @@keyframes ppAccent {
        0%,100% { width:32px; opacity:.5; }
        50%      { width:56px; opacity:1; }
    }
    .pp-title {
        opacity: 0;
        animation: ppFadeIn 0.6s cubic-bezier(.22,1,.36,1) .05s forwards;
        position: relative;
    }
    .pp-title::after {
        content:'';
        display:block;
        height:3px;
        width:40px;
        background: #10b981;
        border-radius:2px;
        margin-top:10px;
        animation: ppAccent 2.4s ease-in-out infinite;
    }
    .pp-section {
        opacity: 0;
        transition: box-shadow .25s ease, border-color .25s ease, transform .25s ease;
        position: relative;
        overflow: hidden;
    }
    .pp-section::before {
        content:'';
        position:absolute;
        top:0; left:0;
        width:3px; height:0;
        background: linear-gradient(to bottom, #10b981, #6ee7b7);
        border-radius:2px;
        transition: height .35s ease;
    }
    .pp-section:hover::before { height:100%; }
    .pp-section:hover {
        box-shadow: 0 8px 28px rgba(16,185,129,.10);
        border-color: #d1fae5;
        transform: translateX(3px);
    }
    .pp-section.av {
        animation: ppFadeUp 0.65s cubic-bezier(.22,1,.36,1) forwards;
    }
</style>

<script>
(function(){
    var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
            if(e.isIntersecting){ e.target.classList.add('av'); }
            else { e.target.classList.remove('av'); }
        });
    },{ threshold:0.08 });
    document.querySelectorAll('.pp-section').forEach(function(el){ obs.observe(el); });
})();
</script>
