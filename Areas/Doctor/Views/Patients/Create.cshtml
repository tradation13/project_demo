@model IPTS.Areas.Doctor.ViewsModels.PatientRegistrationViewModel

@{
    ViewData["Title"] = SharedLocalizer["Pat_AddNew"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="prac-page space-y-6 w-full">

    <div class="flex items-center gap-3">
        <div class="avatar-lg">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"/>
            </svg>
        </div>
        <div>
            <h2 class="text-xl font-semibold text-gray-900 leading-tight">@SharedLocalizer["CreatePat_Header"]</h2>
            <p class="text-sm text-gray-500 mt-0.5">@SharedLocalizer["CreatePat_SubHeader"]</p>
        </div>
    </div>

    <div class="header-card prac-header-card p-5 sm:p-7">
        <form asp-area="Doctor" asp-controller="Patients" asp-action="Create" method="post" novalidate>
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="mb-4 text-sm text-red-700"></div>

            <div class="space-y-5">
                <div>
                    <label class="prac-label" asp-for="UserName">@SharedLocalizer["Shared_UserName"]</label>
                    <input asp-for="UserName" class="prac-input" placeholder="johndoe88" />
                    <span asp-validation-for="UserName" class="mt-1 block text-xs text-red-700"></span>
                </div>

                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div>
                        <label class="prac-label" asp-for="FirstName">@SharedLocalizer["Shared_FirstName"]</label>
                        <input asp-for="FirstName" class="prac-input" placeholder="John" />
                        <span asp-validation-for="FirstName" class="mt-1 block text-xs text-red-700"></span>
                    </div>
                    <div>
                        <label class="prac-label" asp-for="LastName">@SharedLocalizer["Shared_LastName"]</label>
                        <input asp-for="LastName" class="prac-input" placeholder="Doe" />
                        <span asp-validation-for="LastName" class="mt-1 block text-xs text-red-700"></span>
                    </div>
                </div>

                <div class="grid grid-cols-1 gap-5 md:grid-cols-2">
                    <div>
                        <label class="prac-label" asp-for="PhoneNumber">@SharedLocalizer["Shared_PhoneNumber"]</label>
                        <input asp-for="PhoneNumber" class="prac-input" placeholder="05xxxxxxxx" />
                        <span asp-validation-for="PhoneNumber" class="mt-1 block text-xs text-red-700"></span>
                    </div>
                    <div>
                        <label class="prac-label" asp-for="DateOfBirth">@SharedLocalizer["Shared_Date_Of_Birth"]</label>
                        <input asp-for="DateOfBirth" type="date" class="prac-input" />
                        <span asp-validation-for="DateOfBirth" class="mt-1 block text-xs text-red-700"></span>
                    </div>
                </div>

                <div>
                    <label class="prac-label" asp-for="Email">@SharedLocalizer["Shared_EmailAddress"]</label>
                    <input asp-for="Email" class="prac-input" placeholder="patient@example.com" />
                    <span asp-validation-for="Email" class="mt-1 block text-xs text-red-700"></span>
                </div>
            </div>

            @{ ViewData["HealthFieldsVariant"] = "prac"; }
            <div class="pt-2">
                <partial name="_PatientHealthFields" />
            </div>

            <div class="mt-6 flex flex-col-reverse gap-3 border-t border-gray-100 pt-5 sm:flex-row sm:justify-end">
                <a href="@Url.Action("Index", "Patients", new { area = "doctor" })" class="btn-prac-secondary">@SharedLocalizer["Shared_Cancel"]</a>
                <button type="submit" class="btn-add-test">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    @SharedLocalizer["CreatePat_RegisterBtn"]
                </button>
            </div>
        </form>
    </div>
</div>
