<!-- Hero Section -->
<section class="relative overflow-hidden bg-gradient-to-br from-primary-100 to-primary-200 py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="grid items-center gap-12 lg:grid-cols-2">
            <!-- Content -->
            <div class="z-10 space-y-8">
                <div class="space-y-6">
                    <h1 class="text-4xl font-bold leading-tight text-gray-900 md:text-5xl">
                        <span class="text-primary-600">PhysoTech</span> @SharedLocalizer["Hero_Slogan"]
                    </h1>
                    <p class="text-xl leading-relaxed text-gray-700">
                      @SharedLocalizer["Hero_Description"]
                    </p>
                </div>
                <div class="flex flex-col gap-4 sm:flex-row">
                    <a asp-controller="Home" asp-action="Therapies"
                       class="group inline-flex transform items-center justify-center rounded-lg bg-primary-600 px-8 py-4 text-lg font-semibold text-white shadow-lg transition-all duration-200 hover:scale-105 hover:bg-primary-700">
                        <i class="fas fa-calendar-check mr-2"></i>
                       @SharedLocalizer["Hero_BtnBook"]
                        <i class="fas fa-arrow-right ml-2 transition-transform group-hover:translate-x-1"></i>
                    </a>
                    <a href="#about"
                       class="inline-flex items-center justify-center rounded-lg border-2 border-primary-600 bg-white px-8 py-4 text-lg font-semibold text-primary-600 transition-all duration-200 hover:bg-gray-50">
                        <i class="fas fa-info-circle mr-2"></i>
                        @SharedLocalizer["Hero_BtnLearnMore"]
                    </a>
                </div>

                <!-- Features -->
                @* <div class="grid grid-cols-3 gap-4 pt-6">
                    <div class="text-center">
                        <div class="mb-2 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-white shadow-md">
                            <i class="fas fa-brain text-xl text-primary-600"></i>
                        </div>
                        <p class="text-sm font-medium text-gray-700">AI-Powered</p>
                    </div>
                    <div class="text-center">
                        <div class="mb-2 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-white shadow-md">
                            <i class="fas fa-chart-line text-xl text-primary-600"></i>
                        </div>
                        <p class="text-sm font-medium text-gray-700">Smart Tracking</p>
                    </div>
                    <div class="text-center">
                        <div class="mb-2 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-white shadow-md">
                            <i class="fas fa-user-md text-xl text-primary-600"></i>
                        </div>
                        <p class="text-sm font-medium text-gray-700">Expert Care</p>
                    </div>
                </div> *@
            </div>

            <!-- Visual -->
            <div class="relative lg:scale-110">
                <div class="relative">
                    <img src="/images/home/hero.svg" 
                         alt="@SharedLocalizer["Hero_ImgAlt"]"
                         class="h-auto w-full"
                </div>

            </div>
        </div>
    </div>

    <!-- Background Decoration -->
    @* <div class="absolute right-0 top-0 h-full w-1/3 opacity-10">
        <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="h-full w-full">
            <path fill="#22C55E" d="M47.1,-57.1C59.9,-45.8,68.5,-29.3,71.4,-11.8C74.3,5.7,71.5,24.2,62.6,38.9C53.7,53.6,38.7,64.5,22.3,68.7C5.9,72.9,-11.9,70.4,-27.5,63.2C-43.1,56,-56.5,44.1,-64.3,28.9C-72.1,13.7,-74.3,-4.8,-69.8,-21C-65.3,-37.2,-54.1,-51.1,-40.4,-62C-26.7,-72.9,-11.1,-80.8,2.8,-84.1C16.7,-87.4,34.3,-68.4,47.1,-57.1Z" transform="translate(100 100)" />
        </svg>
    </div> *@
</section>
