@model IPTS.ViewModels.MedicalCaseViewModel
@{
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    ViewData["Title"] = @SharedLocalizer["MedCase_Create_Title"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<h2 class="mb-4 text-2xl font-bold">@SharedLocalizer["MedCase_Create_Header"] @($"{patient?.User?.FirstName} {patient?.User?.LastName}")</h2>
<form asp-action="Create" method="post" class="max-w-lg rounded bg-white p-6 shadow">
    <input type="hidden" asp-for="PatientId" />
    <div class="mb-4">
        <label asp-for="Name" class="mb-1 block font-semibold">@SharedLocalizer["MedCase_Create_Name"]</label>
        <input asp-for="Name" class="w-full rounded border px-3 py-2" />
        <span asp-validation-for="Name" class="text-sm text-red-500"></span>
    </div>
    <div class="mb-4">
        <label asp-for="Description" class="mb-1 block font-semibold">@SharedLocalizer["MedCase_Create_Desc"]</label>
        <textarea asp-for="Description" class="w-full rounded border px-3 py-2"></textarea>
        <span asp-validation-for="Description" class="text-sm text-red-500"></span>
    </div>
    <div class="mb-4">
        <label asp-for="CreatedAt" class="mb-1 block font-semibold">@SharedLocalizer["MedCase_Create_Date"]</label>
        <input asp-for="CreatedAt" type="date" class="w-full rounded border px-3 py-2" value="@Model.CreatedAt.ToString("yyyy-MM-dd")" />
    </div>
    <button type="submit" class="rounded bg-green-600 px-6 py-2 font-bold text-white shadow hover:bg-green-700">@SharedLocalizer["MedCase_Create_Btn"]</button>
</form>