@model ErrorViewModel
@{
    ViewData["Title"] = SharedLocalizer["Error_Title"];
}

<h1 class="text-danger">@SharedLocalizer["Error_Title"].</h1>
<h2 class="text-danger">@SharedLocalizer["Error_Header"]</h2>

@if (Model.ShowRequestId)
{
    <p>
        <strong>@SharedLocalizer["Error_RequestId"]:</strong> <code>@Model.RequestId</code>
    </p>
}

<h3>@SharedLocalizer["Error_DevMode_Title"]</h3>
<p>
    @SharedLocalizer["Error_DevMode_Desc"]
</p>
<p>
    <strong>@SharedLocalizer["Error_DevMode_Warning"]</strong>
    @SharedLocalizer["Error_DevMode_Info"]
</p>
    