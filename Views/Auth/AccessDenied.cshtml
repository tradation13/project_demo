@{
    ViewData["Title"] = SharedLocalizer["Shared_AccessDenied"];
    Layout = "~/Views/Shared/Layouts/_MainLayout.cshtml";
}

<div class="flex min-h-[80vh] flex-col items-center justify-center bg-gray-100 px-4 text-center">
    <div class="w-full max-w-lg rounded-2xl bg-white p-8 shadow-lg">
        <div class="mb-4 text-7xl text-red-600">
            <i class="fa-solid fa-user-lock"></i>
        </div>

        <h1 class="mb-2 text-3xl font-bold text-gray-800">
            @SharedLocalizer["Shared_AccessDenied"]
        </h1>

        <p class="mb-6 text-lg text-gray-600">
            🚫 @SharedLocalizer["Access_Message"]<br />
            @SharedLocalizer["Access_ContactAdmin"]
        </p>

        <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
            <a href="@Url.Action("Index", "Home")"
               class="inline-flex items-center rounded-lg bg-primary px-6 py-3 font-semibold text-white shadow transition duration-200 hover:bg-primary-dark">
                <i class="fa-solid fa-house mx-2"></i> @SharedLocalizer["Access_GoHome"]
            </a>

            <button type="button" onclick="history.go(-1)"
                    class="inline-flex items-center rounded-lg bg-secondary px-6 py-3 font-semibold text-white shadow transition duration-200 hover:bg-secondary-dark">
                <i class="fa-solid fa-arrow-left mx-2"></i> @SharedLocalizer["Shared_Back"]
            </button>
        </div>
    </div>
</div>