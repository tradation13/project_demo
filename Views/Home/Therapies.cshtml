@model List<DoctorViewModel>
@inject IWebHostEnvironment WebHostEnvironment
@{
    ViewData["Title"] = SharedLocalizer["Therapies_PageTitle"];
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";

    var backUrl = Context.Request.Query["returnUrl"].ToString();
    if (string.IsNullOrWhiteSpace(backUrl))
    {
        backUrl = Context.Request.Headers["Referer"].ToString();
    }

    if (string.IsNullOrWhiteSpace(backUrl) || !Url.IsLocalUrl(backUrl))
    {
        backUrl = Url.Action("Index", "Home") ?? "/";
    }
}

<div class="min-h-screen bg-gray-50">
   <style>
    .therapies-hero {
        background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 50%, #a7f3d0 100%);
        padding: 5rem 0 4rem;
        position: relative;
        overflow: hidden;
    }

    .therapies-hero::before {
        content: '';
        position: absolute;
        top: -60px;
        right: -60px;
        width: 300px;
        height: 300px;
        border-radius: 50%;
        background: rgba(16, 185, 129, 0.08);
    }

    .therapies-hero::after {
        content: '';
        position: absolute;
        bottom: -40px;
        left: -40px;
        width: 200px;
        height: 200px;
        border-radius: 50%;
        background: rgba(16, 185, 129, 0.06);
    }

    .back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: #ffffff;
        border: 1px solid rgba(16, 185, 129, 0.2);
        padding: 10px 18px;
        border-radius: 12px;
        font-size: 0.875rem;
        font-weight: 700;
        color: #374151;
        text-decoration: none;
        transition: all 0.2s ease;
        box-shadow: 0 1px 4px rgba(0, 0, 0, 0.06);
    }

    .back-btn:hover {
        color: #059669;
        border-color: #059669;
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(16, 185, 129, 0.15);
    }

    .hero-title {
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 800;
        color: #064e3b;
        margin-bottom: 1rem;
        line-height: 1.2;
    }

    .hero-desc {
        font-size: 1.15rem;
        color: #065f46;
        max-width: 680px;
        margin: 0 auto;
        line-height: 1.7;
        opacity: 0.85;
    }
</style>

<section class="therapies-hero">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-8">
            <a href="@backUrl" class="back-btn">
                <i class="fas fa-arrow-left"></i>
                <span>@SharedLocalizer["Shared_Back"]</span>
            </a>
        </div>
        <div class="text-center" style="position: relative; z-index: 1;">
            <h1 class="hero-title">
                @SharedLocalizer["Therapies_Hero_Title"]
            </h1>
            <p class="hero-desc">
                @SharedLocalizer["Therapies_Hero_Desc"]
            </p>
        </div>
    </div>
</section>

    <div class="mx-auto max-w-7xl px-4 py-12 sm:px-6 lg:px-8">
        <div class="mb-8">
            <p id="results-summary" class="text-gray-600">
                @SharedLocalizer["Therapies_Showing"] @Model.Count
                @(Model.Count == 1 ? SharedLocalizer["Therapies_Doctor"] : SharedLocalizer["Therapies_Doctors"])
            </p>
        </div>
        
        <div id="doctors-grid" class="mb-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
            @if (Model.Count == 0)
            {
                <div class="col-span-full py-12 text-center">
                    <h3 class="mb-2 text-lg font-bold text-gray-900">@SharedLocalizer["Therapies_NoFound"]</h3>
                    <p class="mb-6 text-gray-600">@SharedLocalizer["Therapies_NoFound_Desc"]</p>
                    <a href="/Home/Therapies" class="rounded-lg bg-green-600 px-6 py-2 text-white transition-colors hover:bg-green-700">
                        @SharedLocalizer["Therapies_ClearFilters"]
                    </a>
                </div>
            }
            else
            {
                @for (int i = 0; i < Model.Count; i++)
                {
                    var doctor = Model[i];
                    if (doctor is null)
                    {
                        continue;
                    }

                    var delay = i * 120;
                    var doctorItem = doctor!;
                    var photoFileName = doctorItem.PhotoUrl?.Trim();
                    var photoFileExists = false;

                    if (!string.IsNullOrWhiteSpace(photoFileName))
                    {
                        var safePhotoFileName = System.IO.Path.GetFileName(photoFileName);
                        var photoFilePath = System.IO.Path.Combine(WebHostEnvironment.ContentRootPath, "InternalStorage", "DoctorPhotos", safePhotoFileName);
                        photoFileExists = System.IO.File.Exists(photoFilePath);
                        photoFileName = safePhotoFileName;
                    }

                    <div class="therapy-reveal rounded-xl bg-white p-6 shadow-lg transition-shadow hover:shadow-xl" data-delay="@delay" style="opacity: 0; transform: translateY(28px); transition: opacity 0.95s ease, transform 0.95s ease;">
                        <div class="text-center">
                            <div class="relative mx-auto mb-4 flex h-24 w-24 items-center justify-center">
                                @if (!photoFileExists)
                                {
                                    <i class="fa-solid fa-user-doctor text-primary-dark" style="font-size: 80px;"></i>
                                }
                                else
                                {
                                    <img src="/InternalStorage/DoctorPhotos/@photoFileName"
                                         alt="@(doctorItem.FullName ?? "Doctor")"
                                         class="h-24 w-24 rounded-full object-cover" />
                                }
                            </div>
                            <h3 class="mb-4 text-xl font-bold text-gray-900">@(doctorItem.FullName ?? SharedLocalizer["Shared_NotAvailable"])</h3>

                            <a href="@Url.Action("Index","Profile", new { id = doctorItem.UserId })"
                               class="bg-primary-50 mb-2 inline-flex w-full items-center justify-center rounded-lg px-4 py-2 text-sm font-bold text-primary-600 transition-colors hover:bg-primary-100">
                                @SharedLocalizer["Therapies_ViewProfile"]
                            </a>
                            <a asp-area="patient"
                               asp-controller="Appointment"
                               asp-action="Index"
                               asp-route-Id="@doctorItem.UserId"
                               class="inline-flex w-full items-center justify-center rounded-lg bg-primary-600 px-4 py-2 text-sm font-bold text-white transition-colors hover:bg-primary-700">
                                @SharedLocalizer["Therapies_BookNow"]
                            </a>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<script>
    (function () {
        const cards = document.querySelectorAll('.therapy-reveal');
        if (!cards.length) return;

        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduceMotion || !('IntersectionObserver' in window)) {
            cards.forEach((card) => {
                card.style.opacity = '1';
                card.style.transform = 'translateY(0)';
            });
            return;
        }

        const observer = new IntersectionObserver((entries) => {
            entries.forEach((entry) => {
                const card = entry.target;
                if (entry.isIntersecting) {
                    const delay = card.getAttribute('data-delay') || '0';
                    card.style.transitionDelay = `${delay}ms`;
                    card.style.opacity = '1';
                    card.style.transform = 'translateY(0)';
                } else {
                    card.style.transitionDelay = '0ms';
                    card.style.opacity = '0';
                    card.style.transform = 'translateY(28px)';
                }
            });
        }, { threshold: 0.25, rootMargin: '0px 0px -30px 0px' });

        cards.forEach((card) => observer.observe(card));
    })();
</script>