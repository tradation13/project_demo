@* ─── PhysioTech Live Chatbot Widget (n8n) ─── *@
@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@{
    var culture = System.Globalization.CultureInfo.CurrentUICulture;
    var isDE = culture.TwoLetterISOLanguageName.Equals("de", StringComparison.OrdinalIgnoreCase);

    var chatName = SharedLocalizer["Chat_Name"].Value;
    var chatStatus = SharedLocalizer["Chat_StatusOnline"].Value;
    var chatWelcome = SharedLocalizer["Chat_Welcome"].Value;
    var chatSub = SharedLocalizer["Chat_Subtitle"].Value;
    var chatPlaceholder = SharedLocalizer["Chat_Placeholder"].Value;
    var chatOpenChat = SharedLocalizer["Chat_Open"].Value;
    var chatClose = SharedLocalizer["Chat_Close"].Value;
    var chatExpand = SharedLocalizer["Chat_Expand"].Value;
    var chatCollapse = SharedLocalizer["Chat_Collapse"].Value;
    var chatSend = SharedLocalizer["Chat_Send"].Value;
    var chatTyping = SharedLocalizer["Chat_Typing"].Value;
    var chatError = SharedLocalizer["Chat_ErrorGeneric"].Value;
    var chatEmpty = SharedLocalizer["Chat_ErrorEmpty"].Value;
    var chatConfig = SharedLocalizer["Chat_ErrorConfig"].Value;

    var webhookUrl = Configuration["N8n:ChatWebhookUrl"] ?? string.Empty;
}

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@@tabler/icons-webfont@3.31.0/dist/tabler-icons.min.css" />

<style>
  .fab-area {
    position: fixed;
    bottom: max(2rem, env(safe-area-inset-bottom, 0px));
    right: max(1.5rem, env(safe-area-inset-right, 0px));
    left: auto;
    z-index: 9999;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 12px;
    direction: ltr;
    font-family: 'Segoe UI', system-ui, sans-serif;
    pointer-events: none;
  }
  .fab-area > * { pointer-events: auto; }

  .chat-panel {
    display: none;
    flex-direction: column;
    width: min(360px, calc(100vw - 1.5rem));
    height: min(560px, calc(100vh - 7rem));
    border-radius: 16px;
    border: 0.5px solid #d1d5db;
    background: #ffffff;
    overflow: hidden;
    transform-origin: bottom right;
    animation: cb-pop .3s cubic-bezier(.22,1,.36,1) forwards;
    box-shadow: 0 12px 40px rgba(0,0,0,.12), 0 2px 8px rgba(0,0,0,.08);
  }
  .chat-panel.open { display: flex; }

  @@keyframes cb-pop {
    from { opacity: 0; transform: scale(.88) translateY(10px); }
    to   { opacity: 1; transform: scale(1)   translateY(0); }
  }

  .cp-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 16px;
    background: #1a7a4a;
    flex-shrink: 0;
  }
  .cp-avatar {
    width: 36px; height: 36px;
    border-radius: 10px;
    background: rgba(255,255,255,.15);
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    font-size: 20px;
    color: #fff;
  }
  .cp-info { flex: 1; min-width: 0; }
  .cp-name  { font-size: 13px; font-weight: 500; color: #fff; }
  .cp-status {
    font-size: 11px;
    color: rgba(255,255,255,.85);
    margin-top: 1px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .cp-status-dot {
    width: 7px; height: 7px;
    border-radius: 50%;
    background: #86efac;
    box-shadow: 0 0 0 3px rgba(134,239,172,.25);
  }
  .cp-close,
  .cp-expand {
    background: none; border: none; cursor: pointer;
    color: rgba(255,255,255,.7);
    width: 28px; height: 28px;
    border-radius: 8px;
    display: flex; align-items: center; justify-content: center;
    transition: background .15s;
    font-size: 15px;
  }
  .cp-expand { margin-right: 6px; }
  .cp-close:hover,
  .cp-expand:hover { background: rgba(255,255,255,.15); color: #fff; }

  .cp-body {
    flex: 1;
    min-height: 0;
    display: flex;
    flex-direction: column;
    background: #f9fafb;
    padding: 0;
  }

  .cb-messages {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 14px 14px 8px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    scroll-behavior: smooth;
  }

  .cb-msg {
    display: flex;
    width: 100%;
  }
  .cb-msg--user { justify-content: flex-end; }
  .cb-msg--ai,
  .cb-msg--system { justify-content: flex-start; }

  .cb-bubble {
    max-width: 88%;
    padding: 10px 12px;
    border-radius: 14px;
    font-size: 13px;
    line-height: 1.55;
    word-wrap: break-word;
    overflow-wrap: anywhere;
    unicode-bidi: plaintext;
    text-align: start;
  }
  .cb-msg--user .cb-bubble {
    background: #1a7a4a;
    color: #fff;
    border-bottom-right-radius: 5px;
  }
  .cb-msg--ai .cb-bubble {
    background: #fff;
    color: #111827;
    border: 1px solid #e5e7eb;
    border-bottom-left-radius: 5px;
    box-shadow: 0 1px 2px rgba(0,0,0,.04);
  }
  .cb-msg--ai .cb-bubble a {
    color: #1a7a4a;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cb-msg--ai .cb-bubble a:hover {
    color: #15663e;
  }
  .cb-msg--system .cb-bubble {
    background: #fff7ed;
    color: #9a3412;
    border: 1px solid #fed7aa;
    font-size: 12px;
  }

  .cb-bubble--typing {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #6b7280;
  }
  .cb-typing-label { font-size: 11px; margin-left: 2px; }
  .cb-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: #9ca3af;
    animation: cb-bounce 1.2s infinite ease-in-out;
  }
  .cb-dot:nth-child(2) { animation-delay: .15s; }
  .cb-dot:nth-child(3) { animation-delay: .3s; }
  @@keyframes cb-bounce {
    0%, 80%, 100% { transform: translateY(0); opacity: .45; }
    40% { transform: translateY(-4px); opacity: 1; }
  }

  .cb-composer {
    flex-shrink: 0;
    border-top: 1px solid #e5e7eb;
    background: #fff;
    padding: 10px 12px 12px;
  }
  .cb-composer-hint {
    font-size: 11px;
    color: #9ca3af;
    margin: 0 0 8px;
    line-height: 1.4;
  }
  .cb-composer-row {
    display: flex;
    align-items: flex-end;
    gap: 8px;
  }
  .cb-input {
    flex: 1;
    resize: none;
    min-height: 40px;
    max-height: 110px;
    border: 1px solid #e5e7eb;
    border-radius: 12px;
    padding: 10px 12px;
    font-size: 13px;
    line-height: 1.4;
    font-family: inherit;
    color: #111827;
    background: #f9fafb;
    outline: none;
    transition: border-color .15s, box-shadow .15s;
  }
  .cb-input:focus {
    border-color: #86efac;
    box-shadow: 0 0 0 3px rgba(26,122,74,.12);
    background: #fff;
  }
  .cb-input:disabled { opacity: .7; }
  .cb-send {
    width: 40px; height: 40px;
    border: none;
    border-radius: 12px;
    background: #1a7a4a;
    color: #fff;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    flex-shrink: 0;
    transition: background .15s, transform .15s, opacity .15s;
  }
  .cb-send:hover { background: #15663e; }
  .cb-send:disabled {
    opacity: .55;
    cursor: not-allowed;
  }
  .cb-send.is-busy { opacity: .7; }

  .fab-btn {
    width: 56px; height: 56px;
    border-radius: 14px;
    border: none;
    background: #1a7a4a;
    color: #fff;
    cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    position: relative;
    transition: transform .25s cubic-bezier(.34,1.56,.64,1), background .2s;
    flex-shrink: 0;
    box-shadow: 0 8px 24px rgba(26,122,74,.4), 0 2px 6px rgba(0,0,0,.12);
  }
  .fab-btn:hover { transform: scale(1.08); background: #15663e; }
  .fab-btn i { font-size: 26px; }
  .fab-btn .ic-bot { display: flex; align-items: center; justify-content: center; }
  .fab-btn.open .ic-bot { display: none; }
  .fab-btn:not(.open) i.ic-x { display: none; }

  .fab-toggle-wrap {
    position: relative;
    display: flex;
    align-self: flex-end;
    margin-left: auto;
  }

  .fab-btn::before {
    content: '';
    position: absolute;
    bottom: -6px; right: 10px;
    width: 12px; height: 12px;
    background: #1a7a4a;
    clip-path: polygon(0 0, 100% 0, 50% 100%);
  }
  .fab-btn.open::before { display: none; }

  .notif-dot {
    position: absolute;
    top: -3px; right: -3px;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: #f59e0b;
    border: 2px solid #fff;
  }

  .chat-panel.expanded {
    width: min(92vw, 780px);
    height: min(88vh, 780px);
  }

  @@media (max-width: 480px) {
    .fab-area {
      bottom: max(1.5rem, env(safe-area-inset-bottom, 0px));
      right: max(1.25rem, env(safe-area-inset-right, 0px));
      left: auto;
      align-items: flex-end;
    }
    .chat-panel {
      width: min(360px, calc(100vw - 1.2rem));
      height: min(72vh, 560px);
    }
    .chat-panel.expanded {
      width: min(360px, calc(100vw - 1.2rem));
      height: min(88vh, 720px);
    }
  }
</style>

<div id="cbRoot"
     class="fab-area"
     data-webhook-url="@webhookUrl"
     data-i18n-expand="@chatExpand"
     data-i18n-collapse="@chatCollapse"
     data-i18n-typing="@chatTyping"
     data-i18n-error="@chatError"
     data-i18n-empty="@chatEmpty"
     data-i18n-config="@chatConfig"
     lang="@(isDE ? "de" : "en")">

  <div class="chat-panel" id="cbPanel" role="dialog" aria-modal="true" aria-label="@chatName">
    <div class="cp-head">
      <div class="cp-avatar"><i class="ti ti-robot" aria-hidden="true"></i></div>
      <div class="cp-info">
        <div class="cp-name" id="cbName">@chatName</div>
        <div class="cp-status" id="cbStatus">
          <span class="cp-status-dot" aria-hidden="true"></span>
          @chatStatus
        </div>
      </div>
      <button type="button" class="cp-expand" id="cbExpand" aria-label="@chatExpand">
        <i class="ti ti-maximize"></i>
      </button>
      <button type="button" class="cp-close" id="cbClose" aria-label="@chatClose">
        <i class="ti ti-x"></i>
      </button>
    </div>

    <div class="cp-body">
      <div id="cbMessages" class="cb-messages" aria-live="polite">
        <div class="cb-msg cb-msg--ai">
          <div class="cb-bubble" dir="auto">@Html.Raw(chatWelcome.Replace("\n", "<br />"))</div>
        </div>
      </div>

      <form id="cbForm" class="cb-composer" autocomplete="off">
        <p class="cb-composer-hint">@chatSub</p>
        <div class="cb-composer-row">
          <textarea id="cbInput"
                    class="cb-input"
                    rows="1"
                    maxlength="4000"
                    placeholder="@chatPlaceholder"
                    aria-label="@chatPlaceholder"></textarea>
          <button type="submit" class="cb-send" id="cbSend" aria-label="@chatSend" title="@chatSend">
            <i class="ti ti-send" aria-hidden="true"></i>
          </button>
        </div>
      </form>
    </div>
  </div>

  <div class="fab-toggle-wrap">
    <button type="button" class="fab-btn" id="cbToggle" aria-label="@chatOpenChat" aria-expanded="false" aria-controls="cbPanel">
      <span class="ic-bot" aria-hidden="true">
        <i class="ti ti-robot"></i>
      </span>
      <i class="ti ti-x ic-x" aria-hidden="true"></i>
    </button>
    <div class="notif-dot" id="cbNotif"></div>
  </div>
</div>

<script src="~/js/chatbot.js" asp-append-version="true"></script>
