@model ForgotPasswordViewModel

<section class="mb-10 rounded bg-white p-6 shadow">
    <h2 class="mb-6 text-2xl font-semibold">@SharedLocalizer["Shared_ForgotPassword"]</h2>

    <form asp-action="ForgotPassword" method="post" class="space-y-4">
        <div>
            <label asp-for="Email" class="block text-sm font-medium text-gray-700">@SharedLocalizer["Shared_Email"]</label>
            <input asp-for="Email" type="email" 
                   class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-primary focus:ring-primary sm:text-sm" 
                   placeholder="@SharedLocalizer["Forgot_Placeholder_Email"]" />
            <span asp-validation-for="Email" class="text-sm text-red-500"></span>
        </div>

        <button type="submit" class="rounded-lg bg-primary px-6 py-1.5 text-white transition duration-150 hover:bg-primary-dark hover:shadow-xl">
            @SharedLocalizer["Forgot_SubmitBtn"]
        </button>

        <div asp-validation-summary="All" class="mt-4 text-sm text-red-500"></div>
    </form>
</section>