@*
   PhysioTech — Blogs Section
   Multi-language: EN / DE based on ViewBag.Lang or CultureInfo
   Self-contained Partial — no @section needed
*@

@inject IPTS.Services.BlogPostService BlogPostService

@{
    var lang = (string)(ViewBag.Lang ?? System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName);
    bool isDE = lang?.ToLower() == "de";

    var t_eyebrow  = isDE ? "NEUESTE BEITRÄGE"                    : "LATEST UPDATES";
    var t_title1   = isDE ? "PhysioTech"                          : "PhysioTech";
    var t_title2   = isDE ? " Einblicke"                          : " Insights";
    var t_subtitle = isDE ? "Bleiben Sie informiert — moderne Technik, intelligente Pflege und spezialisiertes Fachwissen aus unserer Klinik."
                          : "Stay informed with the latest from our clinic — modern technology, intelligent care, and specialized expertise.";

    var posts = (await BlogPostService.GetAllAsync(true))
        .Where(x => x.IsPublished)
        .Select(x =>
        {
            var articleImages = (x.Images ?? Enumerable.Empty<IPTS.Models.Entites.BlogPostImage>())
                .Where(i => !string.IsNullOrWhiteSpace(i.FileName))
                .Select(i => $"/InternalStorage/BlogsImages/{i.FileName}")
                .ToList();

            var preferredMainImage = string.IsNullOrWhiteSpace(x.MainImagePath)
                ? null
                : (x.MainImagePath.StartsWith("/InternalStorage/BlogsImages/", StringComparison.OrdinalIgnoreCase)
                    ? x.MainImagePath
                    : $"/InternalStorage/BlogsImages/{x.MainImagePath}");

            var mainImageUrl = articleImages.Contains(preferredMainImage, StringComparer.OrdinalIgnoreCase)
                ? preferredMainImage
                : articleImages.FirstOrDefault() ?? "/images/blog-devices.png";

            return new
            {
                Id = x.Id,
                Tag = x.PostType switch
                {
                    IPTS.Models.Enums.EnBlogPostType.Team => isDE ? "Unser Team" : "Our Team",
                    IPTS.Models.Enums.EnBlogPostType.News => isDE ? "Neuigkeiten" : "News",
                    IPTS.Models.Enums.EnBlogPostType.Technology => isDE ? "Technologie" : "Technology",
                    IPTS.Models.Enums.EnBlogPostType.Offers => isDE ? "Angebote" : "Offers",
                    IPTS.Models.Enums.EnBlogPostType.Services => isDE ? "Dienstleistungen" : "Services",
                    IPTS.Models.Enums.EnBlogPostType.Training => isDE ? "Training" : "Training",
                    IPTS.Models.Enums.EnBlogPostType.Health => isDE ? "Gesundheit" : "Health",
                    _ => isDE ? "Aktualisierung" : "Update"
                },
                Date = x.PublishedAt.ToString(isDE ? "dd.MM.yyyy" : "MMMM dd, yyyy"),
                Title = string.IsNullOrWhiteSpace(x.Title) ? (isDE ? "Neuer Beitrag" : "New article") : x.Title,
                Excerpt = string.IsNullOrWhiteSpace(x.ShortDescription) ? (string.IsNullOrWhiteSpace(x.LongDescription) ? "" : x.LongDescription) : x.ShortDescription,
                ImageUrl = mainImageUrl,
                Url = Url.Action("Treatments", "Home", new { articleId = x.Id }),
                PublishedAt = x.PublishedAt
            };
        })
        .OrderByDescending(x => x.PublishedAt)
        .Take(3)
        .ToList();

    var t_read     = isDE ? "Artikel lesen" : "Read Article";
    var t_viewall  = isDE ? "Alle Artikel anzeigen" : "View All Articles";
}

<style>
.blogs-section {
    padding: 70px 0 60px;
    background: #f4fbf7;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
}

/* ── Header ── */
.blogs-header {
    text-align: center;
    margin-bottom: 64px;
    padding: 0 20px;
}

.blogs-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #1a9e50;
    font-size: 11.5px;
    font-weight: 800;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    margin-bottom: 20px;
}

.blogs-eyebrow::before,
.blogs-eyebrow::after {
    content: '';
    display: block;
    width: 36px;
    height: 1.5px;
    background: #1a9e50;
    opacity: 0.45;
    border-radius: 2px;
}

.blogs-title {
    font-family: 'Inter', 'Montserrat', 'Segoe UI', sans-serif;
    font-size: clamp(32px, 4.5vw, 54px);
    font-weight: 800;
    color: #0d1e14; /* لون داكن عميق وغني */
    margin: 0 0 18px;
    line-height: 1.1;
    letter-spacing: -0.04em; /* تضييق المسافات يمنح الخط طابعاً عصرياً وفخماً */
    text-transform: capitalize;
}

.blogs-hl { color: #1a9e50; }

.blogs-subtitle {
    font-size: 16.5px;
    color: #5a7a65;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.75;
}

/* ── Grid ── */
.blogs-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 13px;
    width: 100%;
    max-width: 1340px;
    margin: 0 auto;
    padding: 0 28px;
    box-sizing: border-box;
}

/* ── Card ── */
.blog-card {
    background: #fff;
    border-radius: 20px;
    border: 1px solid #e0f2e9;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    position: relative;
    transition: transform 0.45s cubic-bezier(0.34,1.56,0.64,1),
                box-shadow  0.4s ease;
    will-change: transform;
}

.blog-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 20px;
    border: 2px solid transparent;
    transition: border-color 0.35s ease;
    pointer-events: none;
    z-index: 1;
}

.blog-card:hover { transform: translateY(-12px) scale(1.015); box-shadow: 0 32px 64px rgba(26,158,80,0.13), 0 8px 24px rgba(0,0,0,0.04); }
@* .blog-card:hover::after { border-color: #2ecc71; }
.blog-card.featured { border-color: #2ecc71; box-shadow: 0 4px 28px rgba(46,204,113,0.10); } *@

/* ── Image ── */
.blog-img-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: 5 / 4;
    max-height: 280px;
    background: linear-gradient(135deg, #e8f8f0, #c5f0d8);
}

.blog-img {
    width: 100%; height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.55s cubic-bezier(0.25,0.8,0.25,1);
}

.blog-card:hover .blog-img { transform: scale(1.06); }

.blog-card-link {
    display: flex;
    flex-direction: column;
    min-height: 100%;
    color: inherit;
    text-decoration: none;
}

.blog-card-link:focus-visible {
    outline: 3px solid rgba(74,222,128,.55);
    outline-offset: 4px;
}

.blog-body {
    padding: 20px 22px 22px;
}

.blog-card-title {
    font-size: 15.5px;
}

.blog-excerpt {
    font-size: 13px;
    line-height: 1.75;
}

.blog-read-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: #1a9e50;
    font-size: 13px;
    font-weight: 700;
    margin-top: 10px;
    letter-spacing: 0.01em;
}

.blog-read-more svg {
    width: 16px;
    height: 16px;
    transition: transform 0.35s ease;
}

.blog-card-link:hover .blog-read-more svg {
    transform: translateX(3px);
}

.blog-img-placeholder i { font-size: 52px; color: #1a9e50; opacity: 0.3; }

/* ── Tag ── */
.blog-tag {
    position: absolute;
    top: 14px; left: 14px;
    z-index: 2;
    background: #1a9e50;
    color: #fff;
    font-size: 10px;
    font-weight: 800;
    padding: 5px 13px;
    border-radius: 100px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
}

.blog-tag.ai-tag   { background: #064e36; }
.blog-tag.team-tag { background: #1a4d8e; }

/* ══════════════════════════════
   VIEW ALL BUTTON — احترافي
══════════════════════════════ */
.blogs-footer {
    display: flex;
    justify-content: center;
    margin-top: 56px;
}

.blogs-all-btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: #0f1f15;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    padding: 16px 36px;
    border-radius: 100px;
    text-decoration: none;
    letter-spacing: 0.04em;
    overflow: hidden;
    transition: transform 0.4s cubic-bezier(0.34,1.56,0.64,1),
                box-shadow 0.35s ease;
    box-shadow: 0 4px 20px rgba(15,31,21,0.18);
}

/* shine sweep */
.blogs-all-btn::before {
    content: '';
    position: absolute;
    top: 0; left: -75%;
    width: 50%;
    height: 100%;
    background: linear-gradient(120deg, transparent, rgba(255,255,255,0.18), transparent);
    transition: left 0.55s ease;
}

.blogs-all-btn:hover { transform: translateY(-4px) scale(1.03); box-shadow: 0 16px 40px rgba(15,31,21,0.22); }
.blogs-all-btn:hover::before { left: 130%; }

.blogs-all-btn .btn-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px; height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.12);
    flex-shrink: 0;
    transition: background 0.3s ease, transform 0.4s cubic-bezier(0.34,1.56,0.64,1);
}

.blogs-all-btn:hover .btn-icon { background: rgba(255,255,255,0.22); transform: rotate(-8deg) scale(1.15); }
.blogs-all-btn .btn-icon i { font-size: 17px; }

/* count badge */
.blogs-all-btn .btn-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #1a9e50;
    color: #fff;
    font-size: 11px;
    font-weight: 800;
    min-width: 22px;
    height: 22px;
    padding: 0 6px;
    border-radius: 100px;
    letter-spacing: 0;
    transition: background 0.3s ease;
}

.blogs-all-btn:hover .btn-badge { background: #2ecc71; }

/* ══════════════════════════════
   ANIMATIONS
══════════════════════════════ */
.banim-ey   { opacity:0; transform:scaleX(0.5) translateY(10px); transition:opacity .6s ease, transform .6s cubic-bezier(0.22,1,0.36,1); }
.banim-h    { opacity:0; transform:translateY(36px);              transition:opacity .75s cubic-bezier(0.22,1,0.36,1), transform .75s cubic-bezier(0.22,1,0.36,1); }
.banim-card { opacity:0; transform:translateY(56px) scale(0.97);  transition:opacity .7s cubic-bezier(0.22,1,0.36,1), transform .7s cubic-bezier(0.22,1,0.36,1); }
.banim-foot { opacity:0; transform:translateY(20px);              transition:opacity .6s ease, transform .6s ease; }

.banim-ey.bv,
.banim-h.bv,
.banim-card.bv,
.banim-foot.bv { opacity:1; transform:none; }

/* ── Responsive ── */
@@media (max-width: 960px) {
    .blogs-grid { grid-template-columns:1fr 1fr; padding:0 28px; gap:12px; }
}
@@media (max-width: 600px) {
    .blogs-section { padding:64px 0 56px; }
    .blogs-grid    { grid-template-columns:1fr; padding:0 18px; gap:10px; }
    .blogs-title   { font-size:28px; }
}
@@media (prefers-reduced-motion:reduce) {
    .banim-ey,.banim-h,.banim-card,.banim-foot,
    .blog-card,.blog-img,.blog-read-more,.blogs-all-btn {
        transition:none!important; transform:none!important; opacity:1!important;
    }
}
</style>

<section class="blogs-section" id="blogs">

    <div class="blogs-header">
        <div class="blogs-eyebrow banim-ey">@t_eyebrow</div>
        <h2 class="blogs-title banim-h"><span class="blogs-hl">@t_title1</span>@t_title2</h2>
        <p class="blogs-subtitle banim-h" style="transition-delay:.1s">@t_subtitle</p>
    </div>

    <div class="blogs-grid">
        @foreach (var post in posts)
        {
            <article class="blog-card banim-card" data-bd="0">
                <a class="blog-card-link" href="@post.Url" aria-label="@post.Title">
                    <div class="blog-img-wrap">
                        <img src="@post.ImageUrl" alt="@post.Title" class="blog-img" loading="lazy"
                             onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" />
                        <div class="blog-img-placeholder" style="display:none">
                            <i class="ti ti-news" aria-hidden="true"></i>
                        </div>
                        <span class="blog-tag">@post.Tag</span>
                    </div>
                    <div class="blog-body">
                        <div class="blog-meta">
                            <i class="ti ti-calendar-event" aria-hidden="true"></i>
                            <time datetime="@post.Date">@post.Date</time>
                        </div>
                        <h3 class="blog-card-title">@post.Title</h3>
                        <p class="blog-excerpt">@post.Excerpt</p>
                        <span class="blog-read-more">
                            <span>@t_read</span>
                            <svg viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                                <path d="M7 5l5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    </div>
                </a>
            </article>
        }
    </div>

  <div class="blogs-footer banim-foot" data-bd="360">
    <a asp-controller="Home" asp-action="Treatments" class="blogs-all-btn">

        @t_viewall
    </a>
</div>

</section>

<script>
(function () {
    var IO = window.IntersectionObserver;
    if (!IO) {
        document.querySelectorAll('.banim-ey,.banim-h,.banim-card,.banim-foot')
            .forEach(function(el){ el.classList.add('bv'); });
        return;
    }
    function watch(sel, margin) {
        var obs = new IO(function(entries){
            entries.forEach(function(e){
                if (!e.isIntersecting) return;
                var el = e.target;
                var d  = parseInt(el.getAttribute('data-bd')||'0',10);
                setTimeout(function(){ el.classList.add('bv'); }, d);
                obs.unobserve(el);
            });
        },{ threshold:0.12, rootMargin: margin||'0px' });
        document.querySelectorAll(sel).forEach(function(el){ obs.observe(el); });
    }
    watch('.banim-ey',  '-30px');
    watch('.banim-h',   '-30px');
    watch('.banim-card','-10px');
    watch('.banim-foot','0px');
})();
</script>
