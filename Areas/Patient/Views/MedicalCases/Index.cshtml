@model List<IPTS.Models.Entites.MedicalCase>
@{
    ViewData["Title"] = @SharedLocalizer["Shared_Medical_Cases"];
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
}

<section class="py-16" aria-label=@SharedLocalizer["Shared_Medical_Cases"]>
    <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">

        <!-- Title + Back Button -->
        <div class="mb-12 flex items-center justify-between rounded-2xl border border-slate-200 bg-white/90 p-5 shadow-sm">
            <h2 class="text-3xl font-bold tracking-tight text-slate-800">@SharedLocalizer["Shared_Medical_Cases"]</h2>
            <a href="@Url.Action("Index", "Panel", new { area = "Patient" })"
               class="inline-block rounded-xl border border-green-500 bg-green-600 px-6 py-2 font-bold text-white shadow-sm transition hover:bg-green-700">
                @SharedLocalizer["Shared_Back"]
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="mx-auto w-1/2 rounded-2xl border border-yellow-300 bg-yellow-50 p-6 text-center shadow-sm">
                <p class="text-yellow-800">@SharedLocalizer["MedCase_NoData"]</p>
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
                @foreach (var mc in Model)
                {
                    var hasFinishedTest = mc.MedicalCaseTests?.Any(t => !string.IsNullOrEmpty(t.Result)) == true;
                    var printReportText = SharedLocalizer["Shared_Print_Report"].Value?.Trim();
                    if (string.IsNullOrWhiteSpace(printReportText))
                    {
                        printReportText = "Print Report";
                    }

                        // جلب أحدث تقرير محفوظ لهذه الحالة
                        var latestReport = mc.MedicalReportHistories?
                                             .OrderByDescending(r => r.CreatedAt)
                                             .FirstOrDefault();
                        var latestReportFileExists = latestReport != null
                            && !string.IsNullOrWhiteSpace(latestReport.ReportUrl)
                            && System.IO.File.Exists(System.IO.Path.Combine(
                                Directory.GetCurrentDirectory(),
                                "InternalStorage",
                                "MedicalReports",
                                latestReport.ReportUrl));

                    <article class="group flex h-full flex-col rounded-2xl border border-slate-200 bg-white p-6 shadow-md transition duration-200 hover:-translate-y-1 hover:shadow-xl">
                        <div class="mb-4 min-h-[88px]">
                            <h3 class="mb-2 line-clamp-2 text-center text-xl font-bold text-slate-800">@mc.Name</h3>
                            <p class="line-clamp-3 text-center text-sm leading-6 text-gray-600">
                                @(string.IsNullOrWhiteSpace(mc.Description) ? SharedLocalizer["Appt_NoNotes"].Value : mc.Description)
                            </p>
                        </div>

                        <div class="mb-2.5 flex justify-center">
                            <span class="mb-4 rounded-full bg-slate-100 px-3 py-1 text-xs font-normal tracking-wide text-slate-600">
                                @SharedLocalizer["Shared_Created"]: @mc.CreatedAt.ToString("yyyy-MM-dd")
                            </span>
                        </div>

                        <div class="mt-auto">
                                <div class="grid grid-cols-1 gap-2">
                                    <a href="@Url.Action("Details", "MedicalCases", new { area = "Patient", id = mc.Id })"
                                       class="inline-flex items-center justify-center rounded-xl border border-blue-500 bg-blue-600 px-4 py-2 text-center text-sm font-bold text-white shadow-sm transition hover:bg-blue-700">
                                        @SharedLocalizer["Shared_Details"]
                                    </a>

                                    @* زر عرض آخر تقرير - يظهر فقط إذا كان الملف موجوداً فعلياً *@
                                    @if (latestReport != null)
                                    {
                                        if (latestReportFileExists)
                                        {
                                            <a asp-action="ViewReport"
                                               asp-controller="MedicalCases"
                                               asp-route-fileName="@latestReport.ReportUrl"
                                               target="_blank"
                                               style="background-color: #0d9488 !important; color: white !important;"
                                               class="flex items-center justify-center gap-2 rounded-md bg-[#0d9488] px-4 py-2 text-sm font-bold text-white shadow-sm transition-all hover:bg-[#0f766e] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0d9488] active:scale-95">
                                                <span class="flex items-center justify-center w-full">
                                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                                    </svg>
                                                    <span style="display:inline-block;text-align:center;">@SharedLocalizer["Shared_View_Latest_Report"]</span>
                                                </span>
                                            </a>
                                        }
                                        else
                                        {
                                            <p class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-2 text-center text-sm text-amber-800">
                                                @SharedLocalizer["Shared_Report_FileNotFound"]
                                            </p>
                                        }
                                    }

                                </div>
                        </div>
                    </article>
                }
            </div>
        }
    </div>
</section>
