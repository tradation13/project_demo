@using IPTS.ViewModels
@model List<UserListViewModel>
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";

}
<div x-data="{ filter: false }" class="custom-scrollbar overflow-x-scroll rounded-lg bg-white px-8 py-6">
    <div class="mb-4 flex items-center justify-between">
        <h4 class="text-xl font-semibold">@SharedLocalizer["Users"]</h4>
        <a href=@Url.Action(action:"Index", controller: "UsersTypes")
           class="rounded bg-primary px-4 py-1 text-sm text-white transition duration-150 hover:bg-primary-dark">
            @SharedLocalizer["Shared_Add_New"]
        </a>
    </div>    <div class="mb-3 mt-8 flex flex-col items-start md:flex-row md:items-center md:justify-between">
        @* <div class="flex items-center justify-center space-x-4"> *@
        @*     <form class="relative flex items-center"> *@
        @*         <input type="search" *@
        @*                name="input_search_without_btn" *@
        @*                id="input_search_without_btn" *@
        @*                class="flex-1 border-gray-300 py-0.5 pl-10 focus:border-gray-300 focus:outline-none focus:ring-0" *@
        @*                placeholder="Search..."> *@
        @*         <span class="absolute left-2 flex items-center justify-center bg-transparent" x-on:Click ="show = !show"> *@
        @*             <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg> *@
        @*         </span> *@
        @*     </form> *@
        @*     <button x-on:click ="filter = !filter" *@
        @*             class="font-semibold text-primary hover:text-primary-dark hover:underline"> *@
        @*         Filters *@
        @*     </button> *@
        @* </div> *@
        
        @* <div class="mt-4 md:mt-0"> *@
        @*     <form> *@
        @*         <label>Order By:</label> *@
        @*         <select class="ml-1 py-0.5 text-sm"> *@
        @*             <option></option> *@
        @*             <option>Name</option> *@
        @*             <option>Name DESC</option> *@
        @*             <option>Price</option> *@
        @*             <option>Price DESC</option> *@
        @*         </select> *@
        @*     </form> *@
        @* </div> *@
    </div>
    <div x-show="filter"
         x-collapse.duration.300ms>
        <div class="mb-2 rounded-lg bg-gray-200 px-8 py-4">
            <h5 class="underline">@SharedLocalizer["Appt_FilterResults"]</h5>
            <form class="py-2">
                <div class="my-4 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    <input type="text"
                           name="order_id"
                           class="flex-1 rounded border-gray-300 py-1 focus:border-gray-300 focus:outline-none focus:ring-0"
                           placeholder=@SharedLocalizer["Users_OrderID"]>
                    <input type="text"
                           name="customer_name"
                           class="flex-1 rounded border-gray-300 py-1 focus:border-gray-300 focus:outline-none focus:ring-0"
                           placeholder=@SharedLocalizer["Users_CustomerName"]>
                    <div class="w-full">
                        <label class="mr-2">@SharedLocalizer["Appt_Status"]:</label>
                        <select class="flex-1 rounded border-gray-300 py-1 focus:border-gray-300 focus:outline-none focus:ring-0">
                            <option></option>
                            <option>@SharedLocalizer["Status_Pending"]</option>
                            <option>@SharedLocalizer["Status_Shipped"]</option>
                            <option>@SharedLocalizer["Status_Paid"]</option>
                            <option>@SharedLocalizer["Status_Canceled"]</option>
                        </select>
                    </div>
                </div>
                <div class="my-4 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    <input type="number"
                           name="min_price"
                           class="flex-1 rounded border-gray-300 py-1 focus:border-gray-300 focus:outline-none focus:ring-0"
                           placeholder=@SharedLocalizer["Users_MinPrice"]>
                    <input type="number"
                           name="max_price"
                           class="flex-1 rounded border-gray-300 py-1 focus:border-gray-300 focus:outline-none focus:ring-0"
                           placeholder=@SharedLocalizer["Users_MaxPrice"]>
                </div>
                <div class="my-4 grid grid-cols-1 gap-8 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
                    <div>
                        <label class="mr-2">@SharedLocalizer["Appt_From"] @SharedLocalizer["Shared_Date"]:</label>
                        <input type="date"
                               name="from_date"
                               class="mt-1 flex-1 rounded border-gray-300 py-1 focus:border-gray-300 focus:outline-none focus:ring-0">
                    </div>
                    <div>
                        <label class="mr-2">@SharedLocalizer["Appt_To"] @SharedLocalizer["Shared_Date"]:</label>
                        <input type="date"
                               name="to_date"
                               class="mt-1 flex-1 rounded border-gray-300 py-1 focus:border-gray-300 focus:outline-none focus:ring-0">
                    </div>
                </div>

                <button class="mt-8 rounded-lg bg-primary px-8 py-1 text-sm text-gray-100 transition duration-150 hover:bg-primary-dark hover:shadow-xl">@SharedLocalizer["Logs_Btn_Filter"]</button>
            </form>
        </div>
    </div>
    <table class="mb-8 w-full whitespace-nowrap">
        <thead class="bg-primary font-bold text-white">
            <tr>
                <th>#</th>
                <th>@SharedLocalizer["Shared_ID"]</th>
                <th>@SharedLocalizer["Users_AccountType"]</th>
                <th>@SharedLocalizer["Shared_UserName"]</th>
                <th>@SharedLocalizer["Shared_Email"]</th>
                <th>@SharedLocalizer["Appt_Status"]</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @{int x = 0;}
            @foreach (var user in Model)
            {
                <tr class="hover:bg-gray-100">
                    <td class="text-center">@(++x)</td>
                    <td class="text-center">@user.Id</td>
                    <td class="text-center">@user.UserTypeName</td>
                    <td class="text-center">@user.UserName</td>
                    <td class="text-center">@user.Email</td>
                    <td class="text-center">
                        <partial name="_UserStatus.cshtml" model=@((int)user.Status) />

                    <td class="flex items-center justify-center space-x-2 py-3 pl-2 text-center">
                        <a asp-controller="Profile" asp-action="Index" asp-route-id="@user.Id" asp-area="">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary hover:text-primary-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                            </svg>
                        </a>
                        <a href="@Url.Action("UserForm", "Users", new { id = user.Id, UserType = user.UserTypeName })">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-yellow-500 hover:text-yellow-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
                            </svg>
                        </a>

                        <form asp-action="Delete" asp-controller="Users" asp-route-id="@user.Id" method="post" onsubmit="return confirm('@SharedLocalizer["Msg_AreYouSure"]');" class="inline">
                            <button type="submit">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-red-500 hover:text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4
                     a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                                </svg>
                            </button>
                        </form>
                        <!-- Send Reset Password Link -->
                        <form asp-controller="Users" asp-action="SendRestPasswordLink" method="post" class="inline" onsubmit="return confirm('@SharedLocalizer["Msg_AreYouSure"]');">
                            <input type="hidden" name="Email" value="@user.Email" />
                            <button type="submit" title="Send Reset Password Link" class="hover:text-green-600">
                                <!-- أيقونة سهم ملفوف من Heroicons -->
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-blue-500 hover:text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v6h6M20 20v-6h-6M16 8l4-4-4-4M8 16L4 20l4 4" />
                                </svg>
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>