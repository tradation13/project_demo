@* Location & Contact Section *@
<section id="contact" class="bg-white py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-10 text-center">
            <div class="mb-3 flex items-center justify-center gap-3">
                <i class="fas fa-map-marker-alt text-3xl text-primary-600"></i>
                <h2 class="text-4xl font-bold text-gray-900">@SharedLocalizer["Contact_Title"]</h2>
            </div>
            <p class="text-lg text-gray-600">@SharedLocalizer["Contact_Subtitle"]</p>
        </div>

        <div class="grid items-start gap-8 lg:grid-cols-2">
            <!-- Contact Details -->
            <div class="space-y-4">
                <div class="flex items-start gap-3 rounded-xl border border-gray-100 bg-gray-50 p-4 shadow-sm">
                    <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-primary-100 text-xl text-primary-600">
                        <i class="fas fa-map-pin"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-500">@SharedLocalizer["Shared_Address"]</p>
                        <p class="text-base text-primary-600">Venloer Straße 305, 50823 Köln-Ehrenfeld</p>
                    </div>
                </div>

                <div class="flex items-start gap-3 rounded-xl border border-gray-100 bg-gray-50 p-4 shadow-sm">
                    <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-primary-100 text-xl text-primary-600">
                        <i class="fas fa-phone"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-500">@SharedLocalizer["Shared_Phone"]</p>
                        <a href="tel:0172 8758302" class="font-semibold text-primary-600 hover:text-primary-700">0172 8758302</a>
                    </div>
                </div>

                <div class="flex items-start gap-3 rounded-xl border border-gray-100 bg-gray-50 p-4 shadow-sm">
                    <div class="flex h-11 w-11 items-center justify-center rounded-lg bg-primary-100 text-xl text-primary-600">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div>
                        <p class="text-sm font-semibold text-gray-500">@SharedLocalizer["Shared_Email"]</p>
                        <a href="mailto:muhammadkalumian@gmail.com" class="font-semibold text-primary-600 hover:text-primary-700">kurtogluahmet18@gmail.com</a>
                    </div>
                </div>
            </div>

            <!-- Map / Placeholder -->
           <div class="w-full">
    <div class="relative overflow-hidden rounded-2xl border border-gray-200 shadow-md">
        <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2513.844788326759!2d6.9208479!3d50.9450953!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47bf213dfedc01bd%3A0x633f0f91127667ba!2sVenloer%20Str.%20305%2C%2050823%20K%C3%B6ln%2C%20Germany!5e0!3m2!1sen!2s!4v1700000000000!5m2!1sen!2s"
            width="100%"
            height="360"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
    <p class="mt-3 text-sm text-gray-500">@SharedLocalizer["Contact_Map_Hint"]</p>
</div>
        </div>
    </div>
</section>
