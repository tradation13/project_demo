@model IPTS.ViewModels.DoctorScheduleViewModel
@{
    var fieldCls = "mt-1 w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 text-sm text-slate-800 outline-none transition focus:border-blue-600 focus:ring-2 focus:ring-blue-600/15";
    var labelCls = "mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500";
    var checkboxCls = "mt-1 h-4 w-4 rounded border-slate-300 text-blue-600 focus:ring-blue-600";
}

<div id="guestBookingModal"
     class="fixed inset-0 z-[80] hidden items-center justify-center p-4"
     role="dialog"
     aria-modal="true"
     aria-labelledby="guestBookingModalTitle">
    <div class="absolute inset-0 bg-slate-900/50" data-guest-modal-close></div>
    <div class="relative flex max-h-[min(92vh,760px)] w-full max-w-lg flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-2xl">
        <div class="h-1 bg-blue-600"></div>
        <div class="flex items-start justify-between gap-3 border-b border-slate-100 px-5 py-4">
            <div>
                <h2 id="guestBookingModalTitle" class="text-lg font-semibold text-slate-800">
                    @SharedLocalizer["GuestBooking_Title"]
                </h2>
                <p id="guestBookingModalSubtitle" class="mt-1 text-sm text-slate-500">
                    @SharedLocalizer["GuestBooking_Subtitle"]
                </p>
            </div>
            <button type="button"
                    class="rounded-lg p-2 text-slate-400 transition hover:bg-slate-100 hover:text-slate-700"
                    data-guest-modal-close
                    aria-label="@SharedLocalizer["Chat_Close"]">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>

        <div class="overflow-y-auto px-5 py-5">
            <div id="guestAuthError" class="mb-4 hidden rounded-lg border border-red-200 bg-red-50 p-3 text-sm text-red-700"></div>

            <form id="guestLoginForm" class="space-y-4" autocomplete="off">
                <div>
                    <label class="@labelCls" for="guestLoginIdentity">@SharedLocalizer["Login_Label_UserEmail"]</label>
                    <input id="guestLoginIdentity" name="usernameOrEmail" class="@fieldCls" />
                </div>
                <div>
                    <label class="@labelCls" for="guestLoginPassword">@SharedLocalizer["Shared_Password"]</label>
                    <input id="guestLoginPassword" name="password" type="password" class="@fieldCls" />
                </div>
                <label class="flex items-center gap-2 text-sm text-slate-600">
                    <input id="guestLoginRemember" type="checkbox" class="@checkboxCls" />
                    <span>@SharedLocalizer["Login_RememberMe"]</span>
                </label>
                <button type="submit"
                        class="inline-flex w-full items-center justify-center rounded-lg bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700">
                    @SharedLocalizer["Shared_SignIn"]
                </button>
            </form>

            <p id="guestRegisterLinkWrap" class="pt-5 text-center text-sm text-slate-500">
                @SharedLocalizer["Login_NoAccount"]
                <a id="guestRegisterLink"
                   asp-area=""
                   asp-controller="Auth"
                   asp-action="Register"
                   asp-route-doctorUserId="@Model.Doctor?.UserId"
                   class="font-semibold text-blue-700 hover:underline">
                    @SharedLocalizer["Login_SignUp_Link"]
                </a>
            </p>

            <div id="guestConfirmEmailPanel" class="hidden text-center">
                <div class="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-blue-700">
                    <i class="fa-solid fa-envelope-circle-check text-xl"></i>
                </div>
                <p id="guestConfirmEmailMessage" class="text-sm leading-6 text-slate-600"></p>
                <button type="button" id="guestResendEmailBtn"
                        class="mt-5 inline-flex w-full items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-2.5 text-sm font-semibold text-slate-700 transition hover:bg-slate-50">
                    @SharedLocalizer["GuestBooking_ResendEmail"]
                </button>
            </div>

            <form id="guestCompleteProfileForm" class="hidden space-y-4" autocomplete="off">
                <p class="text-sm text-slate-600">@SharedLocalizer["GuestBooking_CompleteProfileHint"]</p>
                <div>
                    <label class="@labelCls" for="guestProfileBirthDate">@SharedLocalizer["Shared_Date_Of_Birth"]</label>
                    <input id="guestProfileBirthDate" name="birthDate" type="date" max="@DateTime.Today.ToString("yyyy-MM-dd")" class="@fieldCls" />
                </div>
                <div>
                    <label class="@labelCls" for="guestProfilePhone">@SharedLocalizer["Shared_Phone"]</label>
                    <input id="guestProfilePhone" name="phoneNumber" class="@fieldCls" placeholder="+49..." />
                </div>
                <button type="submit"
                        class="inline-flex w-full items-center justify-center rounded-lg bg-blue-600 px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-blue-700">
                    @SharedLocalizer["GuestBooking_SaveAndBook"]
                </button>
            </form>
        </div>
    </div>
</div>

<div id="guestBookingLoading"
     class="fixed inset-0 z-[90] hidden items-center justify-center bg-slate-900/50 p-4">
    <div class="flex w-full max-w-sm flex-col items-center rounded-2xl border border-slate-200 bg-white px-6 py-8 text-center shadow-xl">
        <i class="fa-solid fa-circle-notch mb-4 animate-spin text-3xl text-blue-600"></i>
        <p class="text-sm font-semibold text-slate-800">@SharedLocalizer["GuestBooking_Finishing"]</p>
    </div>
</div>
