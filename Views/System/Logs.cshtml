@model List<LogViewModel>
@using IPTS.ViewModels

@{
    Layout = ViewBag.HasDashboard == true
        ? "~/Views/Shared/Layouts/_DashboardLayout.cshtml"
        : "~/Views/Shared/Layouts/_AuthLayout.cshtml";
}

<style>
    @@keyframes fadeSlideUp {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .animate-fade-slide-up {
        animation: fadeSlideUp 0.4s ease-out both;
    }
</style>

<div x-data="{ filter: false, systemSection: '' }" class="custom-scrollbar overflow-x-auto rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">

    <!-- Header -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-secondary/10 text-secondary">
                <i class="fas fa-clipboard-list"></i>
            </span>
            <h2 class="text-xl font-bold text-slate-800">@SharedLocalizer["Logs_Title"]</h2>
        </div>
        <button x-on:click="filter = !filter"
                class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-primary to-indigo-600 px-5 py-2.5 text-sm font-semibold text-white shadow-md shadow-primary/20 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-lg">
            <i class="fas fa-filter text-xs"></i>
            @SharedLocalizer["Logs_Btn_ToggleFilter"]
            <i class="fas fa-chevron-down text-xs transition-transform duration-200" x-bind:class="filter ? 'rotate-180' : ''"></i>
        </button>
    </div>

    <div class="mb-6">
        <form method="get" class="flex flex-wrap items-center gap-3">
            <div class="relative">
                <span class="pointer-events-none absolute inset-y-0 start-0 flex items-center ps-3 text-slate-300">
                    <i class="fas fa-magnifying-glass text-xs"></i>
                </span>
                <input type="text"
                       name="systemSection"
                       value="@(Context.Request.Query["systemSection"])"
                       class="w-64 rounded-lg border border-slate-200 bg-slate-50/50 py-2 ps-9 pe-3 text-sm text-slate-700 transition-all focus:border-primary focus:bg-white focus:outline-none focus:ring-4 focus:ring-primary/10"
                       placeholder=@SharedLocalizer["Logs_Placeholder_Section"]>
            </div>
            <button type="submit"
                    class="inline-flex items-center gap-2 rounded-lg bg-secondary px-5 py-2 text-sm font-semibold text-white shadow-sm transition-all duration-150 hover:-translate-y-0.5 hover:bg-primary-dark hover:shadow-md">
                <i class="fas fa-magnifying-glass text-xs"></i>
                @SharedLocalizer["Logs_Btn_Filter"]
            </button>
        </form>
    </div>

    <!-- Logs Table -->
    <div class="overflow-hidden rounded-2xl border border-slate-100">
        <table class="w-full table-auto whitespace-nowrap text-sm">
            <thead class="bg-gradient-to-r from-secondary to-primary text-white">
                <tr>
                    <th class="px-4 py-3 text-center font-semibold">#</th>
                    <th class="px-4 py-3 text-center font-semibold">@SharedLocalizer["Logs_Table_Level"]</th>
                    <th class="px-4 py-3 text-start font-semibold">@SharedLocalizer["Logs_Table_Description"]</th>
                    <th class="px-4 py-3 text-start font-semibold">@SharedLocalizer["Logs_Table_User"]</th>
                    <th class="px-4 py-3 text-start font-semibold">@SharedLocalizer["Logs_Table_Section"]</th>
                    <th class="px-4 py-3 text-center font-semibold">@SharedLocalizer["Logs_Table_Time"]</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-slate-100">
                @{
                    int x = 0;
                    foreach (var log in Model)
                    {
                        var levelColor = log.Level switch
                        {
                            "5" => "bg-red-100 text-red-700",
                            "4" => "bg-red-500 text-white",
                            "3" => "bg-yellow-100 text-yellow-700",
                            "2" => "bg-blue-100 text-blue-700",
                            "1" => "bg-slate-100 text-slate-600",
                            _ => "bg-slate-50 text-slate-400"
                        };
                        x++;

                        <tr class="animate-fade-slide-up transition-colors hover:bg-slate-50" style="animation-delay:@(x * 25)ms">
                            <td class="px-4 py-3 text-center text-slate-400">@x</td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex rounded-full px-3 py-1 text-xs font-semibold @levelColor">@log.Level</span>
                            </td>
                            <td class="px-4 py-3 text-slate-700">@log.Description</td>
                            <td class="px-4 py-3 font-medium text-slate-600">@(!string.IsNullOrEmpty(log.UserName) ? log.UserName : log.UserId)</td>
                            <td class="px-4 py-3">
                                <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">@log.SystemSection</span>
                            </td>
                            <td class="px-4 py-3 text-center text-slate-500">@log.Timestamp.ToString("g")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
