@{
    var serviceCards = new[]
    {
        new { Icon = "fas fa-hands-helping", Title = "Patient Support", Desc = "Helpful guidance and care coordination for every step.", IsCta = false },
        new { Icon = "fas fa-running",        Title = "Rehab Sessions",  Desc = "Targeted sessions to restore movement and reduce pain.",  IsCta = false },
        new { Icon = "fas fa-brain",          Title = "Neuro Therapy",   Desc = "Professional support for recovery and body control.",     IsCta = false },
        new { Icon = "fas fa-chart-line",     Title = "Progress Tracking", Desc = "Clear reporting to measure improvement over time.",    IsCta = false },
        new { Icon = "fas fa-heart-pulse",    Title = "Wellness Plans",  Desc = "Personalized plans built around your condition and goals.", IsCta = false },
        new { Icon = "fas fa-arrow-right",    Title = "Book Now",        Desc = "Start with the right service and move forward today.",   IsCta = true  },
    };
}

<style>
    /* ── Grid: 3 cols on md+, 2 on sm, 1 on xs ── */
    .services-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1.25rem;
    }

    @@media (max-width: 767px) {
        .services-grid { grid-template-columns: repeat(2, 1fr); }
    }

    @@media (max-width: 479px) {
        .services-grid { grid-template-columns: 1fr; }
    }

    /* ── Base card ── */
    .service-card {
        border: 1px solid #d1fae5;          /* green-100 border */
        border-radius: 16px;
        padding: 1.4rem;
        background: #fff;
        display: flex;
        flex-direction: column;
        gap: 12px;
        opacity: 0;
        transform: translateY(22px);
        transition: opacity 0.45s ease, transform 0.45s ease,
                    border-color 0.2s ease, box-shadow 0.2s ease;
    }

    .service-card.visible {
        opacity: 1;
        transform: translateY(0);
    }

    .service-card:hover {
        border-color: #6ee7b7;              /* green-300 */
        box-shadow: 0 6px 20px rgba(16, 185, 129, 0.10);
    }

    /* ── Icon bubble ── */
    .service-card__icon {
        width: 48px;
        height: 48px;
        border-radius: 14px;
        /* green-50 tint matching the site's card icons */
        background: #ecfdf5;
        color: #059669;                     /* emerald-600 */
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        transition: background 0.2s, color 0.2s;
    }

    .service-card:hover .service-card__icon {
        background: #d1fae5;
        color: #047857;
    }

    /* ── Text ── */
    .service-card__title {
        font-size: 15px;
        font-weight: 700;
        color: #111827;
        margin: 0 0 4px;
    }

    .service-card__desc {
        font-size: 13px;
        color: #6b7280;
        line-height: 1.65;
        margin: 0;
        flex: 1;
    }

    /* ── CTA card: gradient matching PhysioTech green→teal palette ── */
    .service-card--cta {
        background: linear-gradient(135deg, #059669 0%, #0d9488 100%);
        border-color: transparent;
    }

    .service-card--cta:hover {
        border-color: transparent;
        box-shadow: 0 6px 24px rgba(5, 150, 105, 0.35);
    }

    .service-card--cta .service-card__icon {
        background: rgba(255, 255, 255, 0.22);
        color: #fff;
    }

    .service-card--cta:hover .service-card__icon {
        background: rgba(255, 255, 255, 0.32);
        color: #fff;
    }

    .service-card--cta .service-card__title,
    .service-card--cta .service-card__desc {
        color: #fff;
    }

    .service-card__btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 4px;
        font-size: 13px;
        font-weight: 700;
        color: #059669;
        background: #fff;
        border: none;
        border-radius: 8px;
        padding: 9px 16px;
        text-decoration: none;
        width: fit-content;
        transition: background 0.15s, color 0.15s;
    }

    .service-card__btn:hover {
        background: #ecfdf5;
        color: #047857;
        text-decoration: none;
    }

    @@media (prefers-reduced-motion: reduce) {
        .service-card {
            opacity: 1;
            transform: none;
            transition: none;
        }
    }
</style>

<section id="services" class="bg-white py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">

        <div class="mb-14 text-center">
            <div class="mb-4 flex items-center justify-center gap-3">
                <i class="fas fa-hospital text-3xl text-primary-600"></i>
                <h2 class="text-4xl font-bold tracking-tight text-gray-900">@SharedLocalizer["Services_Title"]</h2>
            </div>
            <p class="mx-auto max-w-2xl text-lg leading-relaxed text-gray-600">
                @SharedLocalizer["Services_Subtitle"]
            </p>
        </div>

        <div class="services-grid mt-10" id="servicesGrid">
            @foreach (var card in serviceCards)
            {
                <article class="service-card @(card.IsCta ? "service-card--cta" : "")">
                    <div class="service-card__icon">
                        <i class="@card.Icon"></i>
                    </div>
                    <div>
                        <h3 class="service-card__title">@card.Title</h3>
                        <p class="service-card__desc">@card.Desc</p>
                    </div>
                    @if (card.IsCta)
                    {
                        <a asp-controller="Home"
                           asp-action="Therapies"
                           class="service-card__btn">
                            @SharedLocalizer["Shared_Book_Now"]
                            <i class="fas fa-arrow-right"></i>
                        </a>
                    }
                </article>
            }
        </div>

    </div>
</section>

<script>
    (function () {
        var cards = document.querySelectorAll('#servicesGrid .service-card');

        if ('IntersectionObserver' in window) {
            var observer = new IntersectionObserver(function (entries) {
                entries.forEach(function (entry) {
                    if (entry.isIntersecting) {
                        var card = entry.target;
                        var index = Array.prototype.indexOf.call(cards, card);
                        setTimeout(function () {
                            card.classList.add('visible');
                        }, index * 75);
                        observer.unobserve(card);
                    }
                });
            }, { threshold: 0.1 });

            cards.forEach(function (card) { observer.observe(card); });
        } else {
            cards.forEach(function (card) { card.classList.add('visible'); });
        }
    })();
</script>
