@model List<IPTS.Models.Entites.MedicalCase>
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Shared_Medical_Cases"];
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    var fullName = $"{patient?.User?.FirstName} {patient?.User?.LastName}".Trim();
}

<div class="custom-scrollbar overflow-x-auto rounded-2xl border border-slate-100 bg-white px-8 py-7 shadow-sm shadow-slate-100">

    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
        <div class="flex items-center gap-3">
            <span class="flex h-10 w-10 items-center justify-center rounded-xl bg-primary/10 text-primary">
                <i class="fas fa-notes-medical"></i>
            </span>
            <div>
                <h4 class="text-xl font-bold text-slate-800">@SharedLocalizer["Shared_Medical_Cases"]</h4>
                <p class="mt-0.5 text-sm text-slate-500">@fullName</p>
            </div>
        </div>
        <a asp-area="admin" asp-controller="Users" asp-action="Index"
           class="inline-flex items-center gap-2 rounded-xl border border-slate-200 bg-white px-4 py-2.5 text-sm font-semibold text-slate-700 shadow-sm transition hover:border-slate-300 hover:bg-slate-50">
            <i class="fas fa-arrow-left text-xs"></i>
            @SharedLocalizer["Shared_Back"]
        </a>
    </div>

    <div class="mb-6 grid gap-3 sm:grid-cols-2">
        <div class="rounded-xl border border-slate-100 bg-slate-50/80 px-4 py-3">
            <p class="text-[11px] font-bold uppercase tracking-wide text-slate-400">@SharedLocalizer["Shared_Email"]</p>
            <p class="mt-1 text-sm font-medium text-slate-700">@(patient?.User?.Email ?? "—")</p>
        </div>
        <div class="rounded-xl border border-slate-100 bg-slate-50/80 px-4 py-3">
            <p class="text-[11px] font-bold uppercase tracking-wide text-slate-400">@SharedLocalizer["Shared_PhoneNumber"]</p>
            <p class="mt-1 text-sm font-medium text-slate-700">@(patient?.User?.PhoneNumber ?? "—")</p>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="rounded-2xl border border-amber-200 bg-amber-50 px-6 py-10 text-center text-amber-800">
            @SharedLocalizer["MedCase_NoData"]
        </div>
    }
    else
    {
        <div class="w-full overflow-auto rounded-2xl border border-slate-100">
            <table class="mb-0 w-full whitespace-nowrap text-sm">
                <thead class="sticky top-0 z-10 bg-gradient-to-r from-primary to-indigo-600 text-white">
                    <tr>
                        <th class="px-4 py-3 font-semibold">#</th>
                        <th class="px-4 py-3 font-semibold">@SharedLocalizer["Contact_Label_Name"]</th>
                        <th class="px-4 py-3 font-semibold">@SharedLocalizer["Shared_Created"]</th>
                        <th class="px-4 py-3 font-semibold">@SharedLocalizer["Tests"]</th>
                        <th class="px-4 py-3 text-center font-semibold">@SharedLocalizer["Appt_Actions"]</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    @{ int x = 0; }
                    @foreach (var mc in Model)
                    {
                        x++;
                        var hasFinishedTest = mc.MedicalCaseTests?.Any(t => !string.IsNullOrEmpty(t.Result)) == true;
                        var latestReport = mc.MedicalReportHistories?.OrderByDescending(r => r.CreatedAt).FirstOrDefault();
                        var latestReportFileExists = latestReport != null
                            && !string.IsNullOrWhiteSpace(latestReport.ReportUrl)
                            && System.IO.File.Exists(System.IO.Path.Combine(
                                Directory.GetCurrentDirectory(),
                                "InternalStorage",
                                "MedicalReports",
                                latestReport.ReportUrl));
                        var testCount = mc.MedicalCaseTests?.Count ?? 0;

                        <tr class="transition-colors hover:bg-slate-50">
                            <td class="px-4 py-3 text-center text-slate-400">@x</td>
                            <td class="px-4 py-3">
                                <p class="font-semibold text-slate-800">@mc.Name</p>
                                @if (!string.IsNullOrWhiteSpace(mc.Description))
                                {
                                    <p class="mt-0.5 max-w-xs truncate text-xs text-slate-500">@mc.Description</p>
                                }
                            </td>
                            <td class="px-4 py-3 text-center text-slate-500">@mc.CreatedAt.ToString("yyyy-MM-dd")</td>
                            <td class="px-4 py-3 text-center">
                                <span class="inline-flex rounded-full bg-slate-100 px-3 py-1 text-xs font-semibold text-slate-600">@testCount</span>
                            </td>
                            <td class="px-4 py-3">
                                <div class="flex flex-wrap items-center justify-center gap-1.5">
                                    <a href="@Url.Action("Details", "MedicalCases", new { area = "admin", id = mc.Id })"
                                       title="@SharedLocalizer["Shared_Details"]"
                                       class="inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-primary/10">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-primary" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                                        </svg>
                                    </a>

                                    @if (latestReport != null && latestReportFileExists)
                                    {
                                        <a asp-action="ViewReport"
                                           asp-controller="MedicalCases"
                                           asp-route-fileName="@latestReport.ReportUrl"
                                           target="_blank"
                                           title="@SharedLocalizer["Shared_View_Latest_Report"]"
                                           class="inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-teal-50">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                            </svg>
                                        </a>
                                    }

                                    @if (hasFinishedTest)
                                    {
                                        <a href="@Url.Action("PrintReport", "MedicalCases", new { area = "admin", id = mc.Id })"
                                           title="@SharedLocalizer["Shared_Print_Report"]"
                                           class="inline-flex h-8 w-8 items-center justify-center rounded-full transition-colors hover:bg-indigo-50">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z" />
                                            </svg>
                                        </a>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
