@model IPTS.ViewModels.ResetPasswordConfirmViewModel
@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Shared_ResetPassword"];
}

<div class="mx-auto w-full max-w-md overflow-hidden rounded-lg border border-slate-200 bg-white shadow-sm">
    <div class="h-1 bg-[#0D7A62]"></div>

    <div class="px-7 py-8 sm:px-9 sm:py-10">
        <div class="mb-8 border-b border-slate-100 pb-6">
            <h1 class="text-xl font-semibold tracking-tight text-slate-800 sm:text-2xl">
                @SharedLocalizer["Shared_ResetPassword"]
            </h1>
        </div>

        <form class="space-y-5 text-sm" asp-action="ResetPasswordConfirm" method="post" autocomplete="off">
            <input asp-for="Token" type="hidden" />
            <input asp-for="Email" type="hidden" />

            <div>
                <label asp-for="NewPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                    @SharedLocalizer["Shared_NewPassword"]
                </label>
                <div x-data="{ show: false }" class="relative">
                    <input :type="show ? 'text' : 'password'"
                           asp-for="NewPassword"
                           class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 pe-11 text-sm text-slate-800 outline-none transition focus:border-[#0D7A62] focus:ring-2 focus:ring-[#0D7A62]/15" />
                    <button x-on:click="show = !show" type="button"
                            class="absolute inset-y-0 end-0 flex w-11 items-center justify-center text-slate-400 transition hover:text-slate-600"
                            aria-label="@SharedLocalizer["Shared_NewPassword"]">
                        <i class="fa-solid text-sm" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="mt-1.5 block text-xs text-red-600"></span>
            </div>

            <div>
                <label asp-for="ConfirmPassword" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-slate-500">
                    @SharedLocalizer["Shared_ConfirmPassword"]
                </label>
                <div x-data="{ show: false }" class="relative">
                    <input :type="show ? 'text' : 'password'"
                           asp-for="ConfirmPassword"
                           class="w-full rounded-lg border border-slate-200 bg-white px-3.5 py-2.5 pe-11 text-sm text-slate-800 outline-none transition focus:border-[#0D7A62] focus:ring-2 focus:ring-[#0D7A62]/15" />
                    <button x-on:click="show = !show" type="button"
                            class="absolute inset-y-0 end-0 flex w-11 items-center justify-center text-slate-400 transition hover:text-slate-600"
                            aria-label="@SharedLocalizer["Shared_ConfirmPassword"]">
                        <i class="fa-solid text-sm" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                    </button>
                </div>
                <span asp-validation-for="ConfirmPassword" class="mt-1.5 block text-xs text-red-600"></span>
            </div>

            <div class="flex flex-col gap-3 pt-2">
                <button type="submit"
                        class="inline-flex w-full items-center justify-center rounded-lg bg-[#0D7A62] px-6 py-2.5 text-sm font-semibold text-white transition hover:bg-[#0a6350]">
                    @SharedLocalizer["Shared_ResetPassword"]
                </button>

                <a href="@Url.Action("Login", "Auth")"
                   class="inline-flex w-full items-center justify-center rounded-lg border border-slate-200 bg-white px-6 py-2.5 text-sm font-medium text-slate-600 transition hover:bg-slate-50 hover:text-slate-800">
                    @SharedLocalizer["Shared_BackToLogin"]
                </a>
            </div>

            @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
        </form>
    </div>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")
