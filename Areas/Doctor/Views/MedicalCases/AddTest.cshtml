@model IPTS.ViewModels.MedicalCaseTestViewModel
@{
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    var tests = ViewBag.Tests as List<IPTS.Models.Entites.Test> ?? new List<IPTS.Models.Entites.Test>();
    var searchPlaceholder = SharedLocalizer["AddTest_SearchPlaceholder"]?.ToString() ?? "Search";
    ViewData["Title"] = SharedLocalizer["MedCase_Det_AddTest"]?.ToString() ?? "Add Test";
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<h2 class="mb-4 text-2xl font-bold">
    @SharedLocalizer["AddTest_Header"] @($"{patient?.User?.FirstName} {patient?.User?.LastName}")
</h2>

<form asp-action="AddTest" method="post" class="max-w-lg rounded bg-white p-6 shadow">
    <input type="hidden" asp-for="MedicalCaseId" />

    <!-- حقل البحث -->
    <div class="relative mb-4">
        <label class="mb-1 block font-semibold">@SharedLocalizer["AddTest_SearchLabel"]</label>
        <input type="text" id="testSearch" placeholder="@searchPlaceholder"
               class="w-full rounded border px-3 py-2" autocomplete="off" />

        <!-- قائمة الاقتراحات -->
        <ul id="suggestions"
            class="absolute z-10 mt-1 hidden max-h-48 w-full overflow-y-auto rounded border bg-white shadow">
            @if (tests != null && tests.Any())
            {
                @foreach (var t in tests)
                {
                    <li data-id="@t.Id" data-name="@t.Name" data-group="@t.TestGroup?.Name"
                        class="cursor-pointer px-3 py-2 hover:bg-green-100">
                        @($"{t.TestGroup?.Name} - {t.Name}")
                    </li>
                }
            }
        </ul>
    </div>

    <!-- الحقول الفعلية -->
    <input type="hidden" asp-for="TestId" id="selectedTestId" />
    <input type="hidden" asp-for="TestName" id="selectedTestName" />
    <span asp-validation-for="TestId" class="text-sm text-red-500"></span>
    <span asp-validation-for="TestName" class="text-sm text-red-500"></span>

    <div class="mb-4">
        <label asp-for="Result" class="mb-1 block font-semibold">@SharedLocalizer["Shared_Result"] @SharedLocalizer["Shared_Optional"]</label>
        <input asp-for="Result" class="w-full rounded border px-3 py-2" />
    </div>

    <div class="mb-4">
        <label class="mb-1 block font-semibold">@SharedLocalizer["MedCase_Create_Date"]</label>
        <input asp-for="CreatedAt" type="date" class="w-full rounded border px-3 py-2"
               value="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>

    <button type="submit"
            class="rounded bg-green-600 px-6 py-2 font-bold text-white shadow hover:bg-green-700">
        @SharedLocalizer["MedCase_Det_AddTest"]
    </button>
</form>

<script>
    const searchInput = document.getElementById("testSearch");
    const suggestionBox = document.getElementById("suggestions");
    const hiddenInput = document.getElementById("selectedTestId");

    // عند الكتابة يتم فلترة النتائج
    searchInput.addEventListener("input", function () {
        const filter = this.value.toLowerCase();
        const items = suggestionBox.getElementsByTagName("li");
        let visibleCount = 0;

        for (let item of items) {
            const text = item.textContent.toLowerCase();
            if (text.includes(filter) && filter.length > 0) {
                item.style.display = "";
                visibleCount++;
            } else {
                item.style.display = "none";
            }
        }

        suggestionBox.style.display = visibleCount > 0 ? "block" : "none";
        hiddenInput.value = ""; // مسح الاختيار عند تعديل البحث
    });

    // عند اختيار عنصر
    suggestionBox.addEventListener("click", function (e) {
        const li = e.target.closest("li");
        if (!li) return;
        const testName = li.textContent.trim();
        const testId = li.getAttribute("data-id");
        const testNameInput = document.getElementById("selectedTestName");

        searchInput.value = testName;
        hiddenInput.value = testId;
        testNameInput.value = testName;

        suggestionBox.style.display = "none";
    });

    // إغلاق القائمة عند فقدان التركيز
    document.addEventListener("click", function (e) {
        if (!suggestionBox.contains(e.target) && e.target !== searchInput) {
            suggestionBox.style.display = "none";
        }
    });
</script>
