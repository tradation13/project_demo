@model IdentityRole
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Roles_AddNew"];
}

<style>
    @@keyframes fadeInUp { from { opacity: 0; transform: translateY(24px) scale(.99); } to { opacity: 1; transform: translateY(0) scale(1); } }
    @@keyframes floatBlob {
        0%, 100% { transform: translateY(0) scale(1); }
        50%      { transform: translateY(-16px) scale(1.05); }
    }

    .form-card { animation: fadeInUp 750ms cubic-bezier(.2,.85,.25,1) both; }
    .form-field { opacity: 0; animation: fadeInUp 600ms cubic-bezier(.2,.85,.25,1) both; animation-delay: .08s; }

    .blob { filter: blur(60px); animation: floatBlob 11s ease-in-out infinite; }

    .btn-shine { position: relative; overflow: hidden; isolation: isolate; }
    .btn-shine::after {
        content: "";
        position: absolute;
        top: 0; left: -75%;
        width: 50%; height: 100%;
        background: linear-gradient(120deg, rgba(255,255,255,0) 0%, rgba(255,255,255,.45) 50%, rgba(255,255,255,0) 100%);
        transform: skewX(-20deg);
        transition: left .6s ease;
    }
    .btn-shine:hover::after { left: 125%; }

    @@media (prefers-reduced-motion: reduce) {
        .form-card, .form-field, .blob, .btn-shine::after {
            animation: none !important;
            transition: none !important;
        }
    }
</style>

<div class="relative overflow-hidden px-4 py-8 sm:px-6 lg:px-8">
    <div class="blob pointer-events-none absolute -left-16 -top-16 h-64 w-64 rounded-full bg-primary/10"></div>
    <div class="blob pointer-events-none absolute -right-12 bottom-0 h-64 w-64 rounded-full bg-indigo-200/30" style="animation-delay:-4s;"></div>

    <div class="relative mx-auto ">
        <div class="form-card relative overflow-hidden rounded-[1.75rem] border border-slate-100 bg-white/95 p-5 shadow-[0_30px_80px_-30px_rgba(15,23,42,0.25)] backdrop-blur-sm sm:p-8">
            <div class="pointer-events-none absolute inset-x-0 top-0 h-1.5 bg-gradient-to-r from-primary via-indigo-400 to-indigo-600"></div>

            <div class="mb-6 flex items-center gap-3 sm:mb-8">
                <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-primary/10 text-primary sm:h-14 sm:w-14">
                    <i class="fa-solid fa-user-shield text-lg sm:text-xl" aria-hidden="true"></i>
                </div>
                <h4 class="text-xl font-bold capitalize tracking-tight text-slate-800 sm:text-2xl">@SharedLocalizer["Roles_AddNew"]</h4>
            </div>

            <form asp-action="Create" method="post">
                <div class="form-field flex flex-col">
                    <label asp-for="Name" class="mb-1.5 text-sm font-bold text-slate-700"></label>
                    <div class="relative">
                        <i class="fa-solid fa-tag pointer-events-none absolute left-4 top-1/2 -translate-y-1/2 text-slate-400"></i>
                        <input asp-for="Name" class="w-full rounded-2xl border border-slate-300 px-4 py-2.5 pl-11 outline-none transition-all duration-200 focus:border-primary focus:ring-4 focus:ring-primary/10" placeholder=@SharedLocalizer["Roles_Name"] />
                    </div>
                    <span asp-validation-for="Name" class="mt-1.5 text-xs text-red-500"></span>
                </div>

                <div class="form-field mt-8 flex gap-3" style="animation-delay:.16s;">
                    <a href="@Url.Action("Index")"
                       class="inline-flex items-center justify-center gap-2 rounded-2xl border border-slate-300 bg-slate-100 px-6 py-2.5 font-bold text-slate-800 transition-all duration-200 hover:-translate-y-0.5 hover:bg-slate-200 active:scale-95">
                        <i class="fa-solid fa-xmark"></i> @SharedLocalizer["Shared_Cancel"]
                    </a>
                    <button type="submit"
                            class="btn-shine bg-gradient-to-r from-primary to-indigo-600 inline-flex items-center justify-center gap-2 rounded-2xl px-6 py-2.5 font-bold text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:-translate-y-0.5 active:scale-95">
                        <i class="fa-solid fa-check"></i> @SharedLocalizer["Shared_Submit"]
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
