@using IPTS.ViewModels
@model IPTS.Areas.Doctor.ViewsModels.AppointmentListViewModel
@{
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Appointments"];
}

<div class="prac-page space-y-6" x-data="{ filter: false }">

    <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="flex items-center gap-3">
            <div class="avatar-lg">
                <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
            </div>
            <div>
                <h2 class="text-xl font-semibold text-gray-900 leading-tight">@SharedLocalizer["Appointments"]</h2>
                <p class="text-sm text-gray-500 mt-0.5">@SharedLocalizer["Appt_ActiveMembers"]</p>
            </div>
        </div>
        <a href="@Url.Action("SearchPatient", "Appointments", new { area = "doctor" })" class="btn-add-test">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
            </svg>
            @SharedLocalizer["Appt_AddNew"]
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["WarningMessage"] != null)
    {
        <div class="rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">@TempData["WarningMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">@TempData["ErrorMessage"]</div>
    }
    @if (TempData["InfoMessage"] != null)
    {
        <div class="rounded-xl border border-blue-200 bg-blue-50 px-4 py-3 text-sm text-blue-800">@TempData["InfoMessage"]</div>
    }

    <div class="header-card prac-header-card p-5">
        <button type="button" x-on:click="filter = !filter" class="btn-prac-indigo">
            <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2a1 1 0 01.293.707l-6 6V21l-4-2v-8l-6-6A1 1 0 013 6V4z"/>
            </svg>
            @SharedLocalizer["Appt_Filters"]
        </button>

        <div x-show="filter" x-cloak class="mt-4">
            <div class="prac-filter">
                <p class="prac-label mb-3">@SharedLocalizer["Appt_FilterResults"]</p>
                <form method="get" asp-action="Index" class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    <div>
                        <label class="prac-label">@SharedLocalizer["Appt_PatientName"]</label>
                        <input type="text" name="patientName" value="@Model.PatientName" placeholder="@SharedLocalizer["Appt_PatientName"]" class="prac-input" />
                    </div>
                    <div>
                        <label class="prac-label">@SharedLocalizer["Appt_Status"]</label>
                        <select name="status" class="prac-input">
                            <option value="">@SharedLocalizer["Appt_Status_Select"]</option>
                            @if (Model.Status == "Pending") { <option value="Pending" selected>@SharedLocalizer["Status_Pending"]</option> } else { <option value="Pending">@SharedLocalizer["Status_Pending"]</option> }
                            @if (Model.Status == "Confirmed") { <option value="Confirmed" selected>@SharedLocalizer["Status_Confirmed"]</option> } else { <option value="Confirmed">@SharedLocalizer["Status_Confirmed"]</option> }
                            @if (Model.Status == "Completed") { <option value="Completed" selected>@SharedLocalizer["Status_Completed"]</option> } else { <option value="Completed">@SharedLocalizer["Status_Completed"]</option> }
                            @if (Model.Status == "Cancelled") { <option value="Cancelled" selected>@SharedLocalizer["Status_Cancelled"]</option> } else { <option value="Cancelled">@SharedLocalizer["Status_Cancelled"]</option> }
                        </select>
                    </div>
                    <div>
                        <label class="prac-label">@SharedLocalizer["Appt_FromDate"]</label>
                        <input type="date" name="fromDate" value="@Model.FromDate" class="prac-input" />
                    </div>
                    <div>
                        <label class="prac-label">@SharedLocalizer["Appt_ToDate"]</label>
                        <input type="date" name="toDate" value="@Model.ToDate" class="prac-input" />
                    </div>
                    <div class="sm:col-span-2 lg:col-span-4 flex flex-wrap items-center gap-3">
                        <button type="submit" class="btn-add-test">@SharedLocalizer["Appt_FilterBtn"]</button>
                        <a href="@Url.Action("Index")" class="btn-prac-secondary">@SharedLocalizer["Appt_ClearFilters"]</a>
                    </div>
                </form>
            </div>
        </div>
    </div>

    @if (Model.Items == null || !Model.Items.Any())
    {
        <div class="empty-state">
            <span class="empty-icon">📅</span>
            <p class="empty-text">@SharedLocalizer["Appointments"]</p>
        </div>
    }
    else
    {
        <div class="prac-section">
            <div class="group-divider">
                <div class="group-divider-line"></div>
                <span class="group-label">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                    </svg>
                    @SharedLocalizer["Appointments"]
                    <span class="group-count">@Model.TotalCount</span>
                </span>
                <div class="group-divider-line"></div>
            </div>

            <div class="prac-list">
                @{ int x = (Model.Page - 1) * Model.PageSize; }
                @foreach (var appointment in Model.Items)
                {
                    var scheduledUtcIsoStart = DateTime.SpecifyKind(appointment.ScheduledTime, DateTimeKind.Utc).ToString("o");
                    var scheduledUtcIsoEnd = DateTime.SpecifyKind(appointment.ScheduledTime.AddMinutes(appointment.TotalDurationMinutes), DateTimeKind.Utc).ToString("o");
                    var nowUtc = DateTime.UtcNow;
                    var isPast = DateTime.SpecifyKind(appointment.ScheduledTime, DateTimeKind.Utc) <= nowUtc;

                    string badgeText;
                    string badgeClass;

                    if (isPast && appointment.Status == AppointmentStatus.Pending)
                    {
                        badgeText = SharedLocalizer["Appt_Status_Expired"];
                        badgeClass = "status-expired";
                    }
                    else if (isPast && appointment.Status == AppointmentStatus.Confirmed)
                    {
                        badgeText = SharedLocalizer["Status_Confirmed"];
                        badgeClass = "status-confirmed";
                    }
                    else
                    {
                        badgeClass = appointment.Status switch
                        {
                            AppointmentStatus.Confirmed => "status-confirmed",
                            AppointmentStatus.Pending => "status-pending",
                            AppointmentStatus.Completed => "status-completed",
                            AppointmentStatus.Cancelled => "status-cancelled",
                            _ => "result-empty"
                        };
                        badgeText = appointment.Status switch
                        {
                            AppointmentStatus.Pending => SharedLocalizer["Status_Pending"],
                            AppointmentStatus.Confirmed => SharedLocalizer["Status_Confirmed"],
                            AppointmentStatus.Completed => SharedLocalizer["Status_Completed"],
                            AppointmentStatus.Cancelled => SharedLocalizer["Status_Cancelled"],
                            _ => appointment.StatusDisplay
                        };
                    }

                    var initials = string.IsNullOrWhiteSpace(appointment.PatientName)
                        ? "P"
                        : string.Join("", appointment.PatientName.Split(' ', StringSplitOptions.RemoveEmptyEntries).Take(2).Select(w => w[0].ToString().ToUpper()));

                    <div class="prac-row">
                        <div class="prac-row-main">
                            <div class="avatar-sm">@initials</div>
                            <div class="prac-row-body">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="test-name !mb-0">@appointment.PatientName</p>
                                    <span class="status-chip @badgeClass">@badgeText</span>
                                    <span class="text-xs text-gray-400 font-medium">#@(++x)</span>
                                </div>
                                <div class="test-date mt-1.5">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                    </svg>
                                    <span class="appt-datetime" data-utc-start="@scheduledUtcIsoStart" data-utc-end="@scheduledUtcIsoEnd">
                                        @appointment.ScheduledTime.ToString("MMM dd, yyyy HH:mm")
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="prac-row-actions">
                            <a asp-controller="Appointments" asp-action="Details" asp-route-id="@appointment.Id" asp-area="doctor"
                               class="btn-toggle">
                                <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/>
                                </svg>
                                @SharedLocalizer["Shared_Details"]
                            </a>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-1.5 pt-2">
            @if (Model.Page > 1)
            {
                <a class="prac-page-btn" href="@Url.Action("Index", new { page = Model.Page - 1, patientName = Model.PatientName, status = Model.Status, fromDate = Model.FromDate, toDate = Model.ToDate })">&lt;</a>
            }
            else
            {
                <span class="prac-page-btn disabled">&lt;</span>
            }

            @for (int p = 1; p <= Model.TotalPages; p++)
            {
                if (p == Model.Page)
                {
                    <span class="prac-page-btn active">@p</span>
                }
                else
                {
                    <a class="prac-page-btn" href="@Url.Action("Index", new { page = p, patientName = Model.PatientName, status = Model.Status, fromDate = Model.FromDate, toDate = Model.ToDate })">@p</a>
                }
            }

            @if (Model.Page < Model.TotalPages)
            {
                <a class="prac-page-btn" href="@Url.Action("Index", new { page = Model.Page + 1, patientName = Model.PatientName, status = Model.Status, fromDate = Model.FromDate, toDate = Model.ToDate })">&gt;</a>
            }
            else
            {
                <span class="prac-page-btn disabled">&gt;</span>
            }
        </div>
    }
</div>

<script>
const browserTimeZone = Intl.DateTimeFormat().resolvedOptions().timeZone;

function formatUtcTime(date, options = {}) {
    if (!date || Number.isNaN(date.getTime())) return '';
    return new Intl.DateTimeFormat('en-GB', { timeZone: browserTimeZone, hour12: false, ...options }).format(date);
}

document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.appt-datetime').forEach(el => {
        const utcStart = el.getAttribute('data-utc-start');
        const utcEnd = el.getAttribute('data-utc-end');
        if (!utcStart) return;

        const start = new Date(utcStart);
        if (!utcEnd) {
            el.textContent = formatUtcTime(start, { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            return;
        }

        const end = new Date(utcEnd);
        if (start.toDateString() === end.toDateString()) {
            const datePart = formatUtcTime(start, { year: 'numeric', month: 'short', day: '2-digit' });
            const startTime = formatUtcTime(start, { hour: '2-digit', minute: '2-digit' });
            const endTime = formatUtcTime(end, { hour: '2-digit', minute: '2-digit' });
            el.textContent = `${datePart} ${startTime} - ${endTime}`;
        } else {
            const startFull = formatUtcTime(start, { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            const endFull = formatUtcTime(end, { year: 'numeric', month: 'short', day: '2-digit', hour: '2-digit', minute: '2-digit' });
            el.textContent = `${startFull} - ${endFull}`;
        }
    });
});
</script>
