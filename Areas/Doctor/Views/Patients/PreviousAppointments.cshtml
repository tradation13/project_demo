@model List<IPTS.Models.Entites.Appointment>
@{
    ViewData["Title"] = @SharedLocalizer["PrevAppt_Header"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<h2 class="mb-6 text-2xl font-bold">@SharedLocalizer["PrevAppt_Header"]</h2>
@if (!Model.Any())
{
    <div class="mb-4 rounded border-l-4 border-yellow-400 bg-yellow-50 p-4">
        <p class="text-yellow-800">@SharedLocalizer["PrevAppt_NoData"]</p>
    </div>
}
else
{
    <table class="min-w-full rounded bg-white shadow">
        <thead>
            <tr>
                <th class="px-4 py-2 text-left">@SharedLocalizer["Shared_Date"]</th>
                <th class="px-4 py-2 text-left">@SharedLocalizer["Shared_Time"]</th>
                <th class="px-4 py-2 text-left">@SharedLocalizer["Appt_Status"]</th>
                <th class="px-4 py-2 text-left">@SharedLocalizer["Shared_Notes"]</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var a in Model)
            {
                <tr class="border-b">
                    <td class="px-4 py-2">@a.ScheduledTime.ToString("yyyy-MM-dd")</td>
                    <td class="px-4 py-2">@a.ScheduledTime.ToString("HH:mm")</td>
                    <td class="px-4 py-2">
    @{
        // نحدد اللون بناءً على حالة الموعد ليعطي شكلاً احترافياً
        var colorClass = a.Status.ToString() switch
        {
            "Pending" => "bg-yellow-100 text-yellow-800",
            "Confirmed" => "bg-blue-100 text-blue-800",
            "Completed" => "bg-green-100 text-green-800",
            "Cancelled" => "bg-red-100 text-red-800",
            _ => "bg-gray-100 text-gray-800"
        };
    }
    @* هنا السحر: نستدعي الترجمة بناءً على اسم الحالة *@
    <span class="@colorClass rounded-full px-3 py-1 text-xs font-bold">
        @SharedLocalizer[$"Status_{a.Status}"]
    </span>
</td>
                    
                    <td class="px-4 py-2">@a.Notes</td>
                </tr>
            }
        </tbody>
    </table>
}
