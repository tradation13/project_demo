@using IPTS.Areas.Doctor.ViewsModels
@model AcceptAppointmentViewModel
@{
    ViewData["Title"] = "Confirm Appointment";
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}
<h2 class="mb-4 text-xl font-bold">@SharedLocalizer["Appt_Confirm_Title"] @Model.PatientName</h2>
<form asp-action="AcceptRequest" method="post">
    <input type="hidden" asp-for="AppointmentId" />
    <input type="hidden" asp-for="DoctorId" />
    <input type="hidden" asp-for="ScheduledDate" />
    <div class="mb-4">
        <label class="mb-2 block font-medium">@SharedLocalizer["Appt_Confirm_SelectSlots"]</label>
        <div class="grid grid-cols-2 gap-2 md:grid-cols-4">
            @foreach (var slot in Model.AvailableSlots)
            {
                <label class="block">
                    <input type="checkbox" name="SelectedSlots" value="@slot.SlotIndex"
                    @(Model.SelectedSlots.Contains(slot.SlotIndex) ? "checked" : "")
                    @(slot.IsAvailable || Model.SelectedSlots.Contains(slot.SlotIndex) ? "" : "disabled") />
                    <span class="ml-2">@slot.Time (@(slot.IsAvailable ? @SharedLocalizer["Shared_Available"] : @SharedLocalizer["Shared_Booked"]))</span>
                </label>
            }
        </div>
    </div>
   <div class="mt-6 flex gap-3">
    <button type="button" onclick="history.back()" class="flex items-center gap-2 rounded-lg border border-gray-300 bg-white px-5 py-2.5 text-sm font-medium text-gray-700 transition-all hover:bg-gray-50 active:scale-95">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
        </svg>
        @SharedLocalizer["Shared_Cancel"]
    </button>

    <button type="submit" class="flex items-center gap-2 rounded-lg bg-green-600 px-5 py-2.5 text-sm font-medium text-white transition-all hover:bg-green-700 hover:shadow-md active:scale-95">
        <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
        </svg>
        @SharedLocalizer["Appt_Confirm_BtnSubmit"]
    </button>
</div>
</form>
