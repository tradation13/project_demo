@{
    Layout = "~/Views/Shared/Layouts/_MainLayout.cshtml";
    var areaName = ViewContext.RouteData.Values["area"]?.ToString();
    var isDoctor = string.Equals(areaName, "Doctor", StringComparison.OrdinalIgnoreCase);
    var contentBg = isDoctor ? "bg-gray-50" : "bg-slate-50";
}

<div class="min-h-screen lg:grid lg:grid-cols-[16rem_minmax(0,1fr)]">
    <div class="lg:row-span-2">
        <partial name="Dashboard/_SidebarMenu" />
    </div>

    <div class="min-w-0 lg:col-start-2 lg:flex lg:min-h-screen lg:flex-col">
        <div class="shrink-0">
            <partial name="Dashboard/_DashboardTopbar" />
        </div>

        <div class="min-h-0 flex-1 @contentBg p-4 sm:p-6 lg:p-8">
            @RenderBody()
        </div>
    </div>
</div>

