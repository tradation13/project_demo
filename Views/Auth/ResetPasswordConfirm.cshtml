@model IPTS.ViewModels.ResetPasswordConfirmViewModel

@{
    Layout = "~/Views/Shared/Layouts/_MainLayout.cshtml";
}

<div class="flex min-h-[calc(100vh-8rem)] items-center justify-center px-4 py-8">
    <div class="mx-auto w-full max-w-md rounded-[2rem] border border-gray-100 bg-white/95 p-5 shadow-[0_24px_65px_-25px_rgba(15,23,42,0.35)] backdrop-blur-sm sm:p-8">
    <div class="mb-6 text-center sm:mb-8">
        <div class="mx-auto mb-4 flex h-14 w-14 items-center justify-center rounded-2xl bg-primary/10 text-primary shadow-sm sm:h-16 sm:w-16">
            <i class="fa-solid fa-key text-xl sm:text-2xl"></i>
        </div>

        <h2 class="text-2xl font-bold tracking-tight text-gray-800 sm:text-3xl">
            @SharedLocalizer["Shared_ResetPassword"]
        </h2>
    </div>

        <form class="space-y-6 text-left sm:space-y-7" asp-action="ResetPasswordConfirm" method="post" autocomplete="off">
        <input asp-for="Token" type="hidden" />
        <input asp-for="Email" type="hidden" />

        <div class="flex flex-col">
            <label asp-for="NewPassword" class="mb-1.5 block text-sm font-bold text-gray-700">
                @SharedLocalizer["Shared_NewPassword"]
            </label>
            <div x-data="{ show: false }" class="relative">
                <input :type="show ? 'text' : 'password'"
                       asp-for="NewPassword"
                       class="w-full rounded-2xl border border-gray-200 bg-gray-50/70 px-4 py-3 pr-12 text-sm text-gray-900 shadow-sm outline-none transition-all duration-200 placeholder:text-gray-400 hover:border-gray-300 focus:border-primary focus:bg-white focus:ring-4 focus:ring-primary/10"
                       placeholder="@SharedLocalizer["Shared_EnterNewPassword"]" />
                <button x-on:click="show = !show" type="button"
                        class="absolute inset-y-0 right-0 flex items-center justify-center pr-4 text-gray-400 transition-colors hover:text-primary">
                    <i class="fa-solid" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                </button>
            </div>
            <span asp-validation-for="NewPassword" class="mt-1.5 block text-xs font-normal text-red-500"></span>
        </div>

        <div class="flex flex-col">
            <label asp-for="ConfirmPassword" class="mb-1.5 block text-sm font-bold text-gray-700">
                @SharedLocalizer["Shared_ConfirmPassword"]
            </label>
            <div x-data="{ show: false }" class="relative">
                <input :type="show ? 'text' : 'password'"
                       asp-for="ConfirmPassword"
                       class="w-full rounded-2xl border border-gray-200 bg-gray-50/70 px-4 py-3 pr-12 text-sm text-gray-900 shadow-sm outline-none transition-all duration-200 placeholder:text-gray-400 hover:border-gray-300 focus:border-primary focus:bg-white focus:ring-4 focus:ring-primary/10"
                       placeholder="@SharedLocalizer["Shared_ConfirmNewPassword"]" />
                <button x-on:click="show = !show" type="button"
                        class="absolute inset-y-0 right-0 flex items-center justify-center pr-4 text-gray-400 transition-colors hover:text-primary">
                    <i class="fa-solid" :class="show ? 'fa-eye' : 'fa-eye-slash'"></i>
                </button>
            </div>
            <span asp-validation-for="ConfirmPassword" class="mt-1.5 block text-xs font-normal text-red-500"></span>
        </div>

            <button type="submit"
                    class="w-full rounded-2xl bg-primary py-3.5 text-sm font-bold uppercase tracking-widest text-white shadow-lg shadow-primary/25 transition-all duration-200 hover:-translate-y-0.5 hover:bg-primary-dark active:scale-95">
                @SharedLocalizer["Shared_ResetPassword"]
            </button>

            @await Html.PartialAsync("_ValidationSummary", ViewData.ModelState)
        </form>
    </div>
</div>

@await Html.PartialAsync("_ValidationScriptsPartial")