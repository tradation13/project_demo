@* Doctors Highlight Section *@
<section id="doctors" class="bg-gray-50 py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="mb-12 text-center">
            <div class="mb-4 flex items-center justify-center gap-3">
                <i class="fas fa-user-md text-3xl text-primary-600"></i>
                <h2 class="text-4xl font-bold text-gray-900">@SharedLocalizer["Docs_Title"]</h2>
            </div>
            <p class="mx-auto max-w-2xl text-lg text-gray-600">
                @SharedLocalizer["Docs_Subtitle"]
            </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-4">
            <div class="flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-md transition-shadow duration-300 hover:shadow-xl">
                <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary-100 text-3xl text-primary-600">
                    <i class="fas fa-user-md"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-900">@SharedLocalizer["Docs_D1_Name"]</h3>
                <p class="mb-2 text-sm font-semibold text-primary-600">@SharedLocalizer["Docs_D1_Title"]</p>
                <p class="text-sm text-gray-600">@SharedLocalizer["Docs_D1_Bio"]</p>
            </div>

            <div class="flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-md transition-shadow duration-300 hover:shadow-xl">
                <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary-100 text-3xl text-primary-600">
                    <i class="fas fa-user-md"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-900">@SharedLocalizer["Docs_D2_Name"]</h3>
                <p class="mb-2 text-sm font-semibold text-primary-600">@SharedLocalizer["Docs_D2_Title"]</p>
                <p class="text-sm text-gray-600">@SharedLocalizer["Docs_D2_Bio"]</p>
            </div>

            <div class="flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-md transition-shadow duration-300 hover:shadow-xl">
                <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary-100 text-3xl text-primary-600">
                    <i class="fas fa-user-md"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-900">@SharedLocalizer["Docs_D3_Name"]</h3>
                <p class="mb-2 text-sm font-semibold text-primary-600">@SharedLocalizer["Docs_D3_Title"]</p>
                <p class="text-sm text-gray-600">@SharedLocalizer["Docs_D3_Bio"]</p>
            </div>

            <div class="flex flex-col items-center rounded-2xl border border-gray-100 bg-white p-6 text-center shadow-md transition-shadow duration-300 hover:shadow-xl">
                <div class="mb-4 flex h-16 w-16 items-center justify-center rounded-full bg-primary-100 text-3xl text-primary-600">
                    <i class="fas fa-user-md"></i>
                </div>
                <h3 class="text-xl font-bold text-gray-900">@SharedLocalizer["Docs_D4_Name"]</h3>
                <p class="mb-2 text-sm font-semibold text-primary-600">@SharedLocalizer["Docs_D4_Title"]</p>
                <p class="text-sm text-gray-600">@SharedLocalizer["Docs_D4_Bio"]</p>
            </div>
        </div>

        <div class="mt-10 text-center">
           <a asp-controller="Home" 
   asp-action="Therapies" 
   asp-area="" 
   class="inline-flex items-center gap-2 rounded-lg bg-primary-600 px-6 py-3 font-semibold text-white shadow-lg transition-all duration-200 hover:bg-primary-700 hover:shadow-xl">
    @SharedLocalizer["Shared_Book_Now"]
    <i class="fas fa-arrow-right"></i>
</a>
        </div>
    </div>
</section>
