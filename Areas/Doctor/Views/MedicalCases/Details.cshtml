@model IPTS.Models.Entites.MedicalCase
@{
    var patient = ViewBag.Patient as IPTS.Models.Entites.Patient;
    ViewData["Title"] = SharedLocalizer["MedCase_Det_Title"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
    var chartPayload = new List<object>();
}

<div class="prac-page space-y-6">

    <div class="flex items-center gap-3">
        <div class="avatar-lg">
            @{
                var fullName = $"{patient?.User?.FirstName} {patient?.User?.LastName}".Trim();
                var initials = fullName.Length > 0
                    ? string.Join("", fullName.Split(' ').Take(2).Select(n => n[0].ToString().ToUpper()))
                    : "P";
            }
            @initials
        </div>
        <div>
            <h2 class="text-xl font-semibold text-gray-900 leading-tight">@Model.Name</h2>
            <p class="text-sm text-gray-500 mt-0.5">@SharedLocalizer["MedCase_Det_Title"]</p>
        </div>
    </div>

    <div class="header-card prac-header-card p-5">
        <div class="flex flex-col gap-5 md:flex-row md:items-start md:justify-between">

            <div class="space-y-1">
                <p class="text-xs font-semibold uppercase tracking-wide text-gray-400 mb-2">@SharedLocalizer["Shared_Patient"] @SharedLocalizer["Shared_Information"]</p>

                <p class="text-base font-semibold text-gray-800">@fullName</p>

                <div class="meta-row">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                    </svg>
                    @patient?.User?.PhoneNumber
                </div>

                <div class="meta-row">
                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                    </svg>
                    <a href="mailto:@patient?.User?.Email">@patient?.User?.Email</a>
                </div>
            </div>

            <div class="flex items-center gap-3 flex-wrap">
                <a href="@Url.Action("AddTest", "MedicalCases", new { area = "doctor", medicalCaseId = Model.Id })"
                   class="btn-add-test">
                    <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                    </svg>
                    @SharedLocalizer["MedCase_Det_AddTest"]
                </a>

                @if (Model.MedicalCaseTests.Count > 0)
                {
                    <a href="@Url.Action("PrintReport", "MedicalCases", new { area = "doctor", id = Model.Id })"
                       class="btn-print">
                        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 17h2a2 2 0 002-2v-4a2 2 0 00-2-2H5a2 2 0 00-2 2v4a2 2 0 002 2h2m2 4h6a2 2 0 002-2v-4a2 2 0 00-2-2H9a2 2 0 00-2 2v4a2 2 0 002 2zm8-12V5a2 2 0 00-2-2H9a2 2 0 00-2 2v4h10z"/>
                        </svg>
                        @SharedLocalizer["Shared_Print_Report"]
                    </a>
                }
            </div>
        </div>
    </div>

    @if (Model.MedicalCaseTests == null || !Model.MedicalCaseTests.Any())
    {
        <div class="empty-state">
            <span class="empty-icon">🧪</span>
            <p class="empty-text">@SharedLocalizer["MedCase_Det_NoTests"]</p>
        </div>
    }
    else
    {
        var grouped = Model.MedicalCaseTests
            .Where(t => t.Test != null && t.Test.TestGroup != null)
            .GroupBy(t => t.Test.TestGroup.Name)
            .OrderBy(g => g.Key);

        foreach (var group in grouped)
        {
            var testsByName = group
                .GroupBy(t => t.Test.Name)
                .OrderBy(t => t.Key);

            <div class="prac-section mb-8">
                <div class="group-divider">
                    <div class="group-divider-line"></div>
                    <span class="group-label">
                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"/>
                        </svg>
                        @group.Key
                        <span class="group-count">@group.Count()</span>
                    </span>
                    <div class="group-divider-line"></div>
                </div>

                <div class="space-y-8">
                    @foreach (var testGroup in testsByName)
                    {
                        var ordered = testGroup
                            .Where(t => !string.IsNullOrWhiteSpace(t.Result))
                            .OrderBy(t => t.CreatedAt)
                            .ToList();

                        var numericValues = ordered
                            .Select(t => double.TryParse(t.Result, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.InvariantCulture, out var v)
                                ? (double?)v
                                : (double.TryParse(t.Result, System.Globalization.NumberStyles.Any, System.Globalization.CultureInfo.CurrentCulture, out var v2) ? (double?)v2 : null))
                            .Where(v => v.HasValue)
                            .Select(v => v!.Value)
                            .ToList();

                        var standardValue = testGroup
                            .Where(t => t.StandardValue.HasValue)
                            .OrderByDescending(t => t.CreatedAt)
                            .Select(t => (double?)t.StandardValue!.Value)
                            .FirstOrDefault();

                        var hasNumericSeries = numericValues.Count >= 1;
                        var chartId = $"doc-chart-{group.Key.GetHashCode():X}-{testGroup.Key.GetHashCode():X}";

                        <div class="overflow-hidden rounded-2xl border border-gray-200 bg-white shadow-sm">
                            <div class="border-b border-gray-100 bg-gradient-to-r from-teal-50 to-white px-5 py-4">
                                <h4 class="text-center text-lg font-bold text-gray-800">@testGroup.Key</h4>
                            </div>

                            <div class="p-5">
                                @if (hasNumericSeries)
                                {
                                    var maxVal = numericValues.Max();
                                    var minVal = numericValues.Min();
                                    var avgVal = numericValues.Average();
                                    var statCols = standardValue.HasValue ? "sm:grid-cols-4" : "sm:grid-cols-3";

                                    <div class="mb-5 grid grid-cols-1 gap-3 @statCols">
                                        <div class="rounded-xl border border-emerald-100 bg-emerald-50 px-4 py-3 text-center">
                                            <div class="text-[10px] font-bold uppercase tracking-wide text-emerald-700/80">@SharedLocalizer["MedCase_Det_Highest"]</div>
                                            <div class="mt-1 text-xl font-bold text-emerald-800">@maxVal.ToString("F1")</div>
                                        </div>
                                        <div class="rounded-xl border border-rose-100 bg-rose-50 px-4 py-3 text-center">
                                            <div class="text-[10px] font-bold uppercase tracking-wide text-rose-700/80">@SharedLocalizer["MedCase_Det_Lowest"]</div>
                                            <div class="mt-1 text-xl font-bold text-rose-800">@minVal.ToString("F1")</div>
                                        </div>
                                        <div class="rounded-xl border border-sky-100 bg-sky-50 px-4 py-3 text-center">
                                            <div class="text-[10px] font-bold uppercase tracking-wide text-sky-700/80">@SharedLocalizer["MedCase_Det_Average"]</div>
                                            <div class="mt-1 text-xl font-bold text-sky-800">@avgVal.ToString("F1")</div>
                                        </div>
                                        @if (standardValue.HasValue)
                                        {
                                            <div class="rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-center">
                                                <div class="text-[10px] font-bold uppercase tracking-wide text-amber-700/80">@SharedLocalizer["MedCase_Det_StandardValue"]</div>
                                                <div class="mt-1 text-xl font-bold text-amber-800">@standardValue.Value.ToString("F1")</div>
                                            </div>
                                        }
                                    </div>

                                    @if (numericValues.Count > 1)
                                    {
                                        var firstVal = numericValues.First();
                                        var lastVal = numericValues.Last();
                                        var diff = lastVal - firstVal;
                                        var percent = firstVal != 0 ? (diff / firstVal) * 100 : 0;
                                        var statusText = diff > 0
                                            ? SharedLocalizer["MedCase_Det_Increased"].Value
                                            : (diff < 0 ? SharedLocalizer["MedCase_Det_Decreased"].Value : SharedLocalizer["MedCase_Det_Stable"].Value);
                                        var statusClass = diff > 0 ? "text-emerald-700" : (diff < 0 ? "text-rose-700" : "text-sky-700");
                                        var arrow = diff > 0 ? "↑" : (diff < 0 ? "↓" : "↔");
                                        var firstTestDate = ordered.First().CreatedAt.ToString("yyyy-MM-dd");

                                        chartPayload.Add(new
                                        {
                                            id = chartId,
                                            labels = ordered.Select(t => t.CreatedAt.ToString("MM-dd")).ToList(),
                                            values = numericValues,
                                            standardValue = standardValue,
                                            standardLabel = SharedLocalizer["MedCase_Det_StandardValue"].Value
                                        });

                                        <div class="mb-5 flex flex-col gap-2 rounded-xl border border-gray-100 bg-gray-50 px-4 py-4 sm:flex-row sm:items-center sm:justify-between">
                                            <div>
                                                <div class="text-[11px] font-bold uppercase tracking-wide text-gray-400">@SharedLocalizer["MedCase_Det_OverallProgress"]</div>
                                                <div class="mt-1 text-lg font-bold text-gray-800">
                                                    @statusText @SharedLocalizer["MedCase_Det_By"]
                                                    <span class="@statusClass">@Math.Abs(percent).ToString("F1")%</span>
                                                    <span class="@statusClass">@arrow</span>
                                                </div>
                                                @if (standardValue.HasValue)
                                                {
                                                    var gap = Math.Abs(lastVal - standardValue.Value);
                                                    <div class="mt-1 text-sm text-amber-700">
                                                        @SharedLocalizer["MedCase_Det_DistanceToTarget"]: @gap.ToString("F1")
                                                    </div>
                                                }
                                            </div>
                                            <div class="text-xs text-gray-400 sm:text-right">
                                                @SharedLocalizer["MedCase_Det_SinceFirstTest"] (@firstTestDate)
                                            </div>
                                        </div>

                                        <div class="mb-5 h-56 rounded-xl border border-gray-100 bg-white p-3 sm:p-4">
                                            <canvas id="@chartId" aria-label="@SharedLocalizer["MedCase_Det_ProgressChart"]"></canvas>
                                        </div>
                                    }
                                    else if (standardValue.HasValue)
                                    {
                                        <div class="mb-5 rounded-xl border border-amber-100 bg-amber-50 px-4 py-3 text-center text-sm text-amber-800">
                                            @SharedLocalizer["MedCase_Det_StandardValue"]: <strong>@standardValue.Value.ToString("F1")</strong>
                                            · @SharedLocalizer["MedCase_Det_DistanceToTarget"]:
                                            <strong>@Math.Abs(numericValues.First() - standardValue.Value).ToString("F1")</strong>
                                        </div>
                                    }
                                }

                                <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                                    @foreach (var test in testGroup.OrderBy(t => t.CreatedAt))
                                    {
                                        var hasResult = !string.IsNullOrWhiteSpace(test.Result);
                                        var toggleBtnText = hasResult
                                            ? $"{SharedLocalizer["Shared_Update"]} {SharedLocalizer["Shared_Result"]}"
                                            : $"{SharedLocalizer["Shared_Add"]} {SharedLocalizer["Shared_Result"]}";
                                        var cancelText = $"{SharedLocalizer["Shared_Cancel"]}";

                                        <div class="test-card flex flex-col gap-3 p-4">

                                            <div class="flex items-start justify-between gap-2">
                                                <div class="flex-1">
                                                    <p class="test-name">@test.Test.Name</p>
                                                    <div class="mt-1 flex flex-wrap gap-1.5">
                                                        @if (hasResult)
                                                        {
                                                            <span class="result-chip result-set">
                                                                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                                </svg>
                                                                @test.Result
                                                            </span>
                                                        }
                                                        else
                                                        {
                                                            <span class="result-chip result-empty">
                                                                <svg class="h-3 w-3" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                                                                </svg>
                                                                @SharedLocalizer["MedCase_Det_NotSet"]
                                                            </span>
                                                        }
                                                        @if (test.StandardValue.HasValue)
                                                        {
                                                            <span class="inline-flex items-center gap-1 rounded-full border border-amber-200 bg-amber-50 px-2 py-0.5 text-xs font-medium text-amber-800">
                                                                @SharedLocalizer["MedCase_Det_StandardShort"]: @test.StandardValue.Value.ToString("G29")
                                                            </span>
                                                        }
                                                    </div>
                                                    <div class="test-date">
                                                        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                                                        </svg>
                                                        @test.CreatedAt.ToString("yyyy-MM-dd")
                                                    </div>
                                                </div>
                                            </div>

                                            <div class="flex items-center gap-2 flex-wrap">
                                                <button type="button"
                                                        class="btn-toggle"
                                                        data-target="form-@test.Id"
                                                        data-default-text="@toggleBtnText"
                                                        data-cancel-text="@cancelText">
                                                    <svg class="h-3.5 w-3.5 icon-edit" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"/>
                                                    </svg>
                                                    <span class="btn-label">@toggleBtnText</span>
                                                </button>

                                                <form asp-action="DeleteTest" asp-controller="MedicalCases" asp-area="doctor" method="post" class="inline">
                                                    <input type="hidden" name="id" value="@test.Id" />
                                                    <button type="submit"
                                                            class="btn-delete"
                                                            onclick="return confirm('Delete this test?')">
                                                        <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                                                        </svg>
                                                        @SharedLocalizer["Shared_Delete"]
                                                    </button>
                                                </form>
                                            </div>

                                            <form id="form-@test.Id"
                                                  asp-action="UpdateTestResult"
                                                  asp-controller="MedicalCases"
                                                  asp-area="doctor"
                                                  method="post"
                                                  class="inline-form space-y-2">
                                                <input type="hidden" name="id" value="@test.Id" />
                                                <input type="text"
                                                       name="result"
                                                       value="@test.Result"
                                                       placeholder="@SharedLocalizer["MedCase_Det_EnterResult"]"
                                                       class="result-input" />
                                                <input type="number"
                                                       step="any"
                                                       name="standardValue"
                                                       value="@(test.StandardValue?.ToString(System.Globalization.CultureInfo.InvariantCulture))"
                                                       placeholder="@SharedLocalizer["MedCase_Det_StandardValue"]"
                                                       class="result-input" />
                                                <button type="submit" class="btn-save">
                                                    @SharedLocalizer["Shared_Save"]
                                                </button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        document.querySelectorAll(".btn-toggle").forEach(btn => {
            btn.addEventListener("click", function () {
                const targetId   = this.getAttribute("data-target");
                const form       = document.getElementById(targetId);
                const defaultTxt = this.getAttribute("data-default-text");
                const cancelTxt  = this.getAttribute("data-cancel-text");
                const label      = this.querySelector(".btn-label");
                const isOpen     = form.classList.contains("visible");

                form.classList.toggle("visible", !isOpen);
                this.classList.toggle("open", !isOpen);
                label.textContent = isOpen ? defaultTxt : cancelTxt;
            });
        });
    });
</script>

@if (chartPayload.Any())
{
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script>
        (function () {
            const charts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(chartPayload));
            const standardLabelFallback = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(SharedLocalizer["MedCase_Det_StandardValue"].Value));

            charts.forEach(function (item) {
                const canvas = document.getElementById(item.id);
                if (!canvas || typeof Chart === 'undefined') return;

                const datasets = [{
                    label: 'Result',
                    data: item.values,
                    borderColor: '#00695c',
                    backgroundColor: 'rgba(0, 191, 165, 0.12)',
                    borderWidth: 3,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#00796b',
                    pointBorderWidth: 3,
                    pointRadius: 5,
                    pointHoverRadius: 7,
                    fill: true,
                    tension: 0.35
                }];

                if (item.standardValue != null) {
                    datasets.push({
                        label: item.standardLabel || standardLabelFallback,
                        data: item.labels.map(function () { return item.standardValue; }),
                        borderColor: '#f59e0b',
                        backgroundColor: 'transparent',
                        borderWidth: 2,
                        borderDash: [8, 4],
                        pointRadius: 0,
                        pointHoverRadius: 0,
                        fill: false,
                        tension: 0
                    });
                }

                new Chart(canvas, {
                    type: 'line',
                    data: {
                        labels: item.labels,
                        datasets: datasets
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                display: item.standardValue != null,
                                position: 'bottom',
                                labels: { boxWidth: 12, font: { size: 11 } }
                            },
                            tooltip: {
                                backgroundColor: '#004d40',
                                titleColor: '#e0f2f1',
                                bodyColor: '#fff',
                                padding: 10,
                                cornerRadius: 8
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { color: '#94a3b8', font: { size: 11 } }
                            },
                            y: {
                                grid: { color: '#f1f5f9', drawBorder: false },
                                ticks: { color: '#94a3b8', font: { size: 11 } }
                            }
                        }
                    }
                });
            });
        })();
    </script>
}
