@model IPTS.Areas.Patient.ViewsModels.PatientPanelViewModel
@{
    ViewData["Title"] = "Patient Panel";
    Layout = "~/Views/Shared/Layouts/_PublicSideLayout.cshtml";
}

<div class="mx-auto max-w-4xl px-4 py-6 sm:px-6 sm:py-10 lg:px-8">
    <div class="mb-8 rounded-3xl border border-slate-200 bg-white/90 p-5 shadow-sm backdrop-blur-sm sm:p-6">
        <h2 class="mb-2 flex items-center gap-2 text-2xl font-bold text-gray-800 sm:text-3xl">
            <i class="fas fa-user-circle text-primary"></i>
            @SharedLocalizer["Panel_Title"]
        </h2>
        <p class="text-gray-600">@SharedLocalizer["Panel_Subtitle"]</p>
    </div>

    <div class="mb-10 grid grid-cols-1 gap-4 sm:grid-cols-2 sm:gap-6">
        <div class="flex items-center gap-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
            <div class="rounded-full bg-blue-100 p-3 text-blue-600 sm:p-4">
                <i class="fas fa-calendar-check fa-2x"></i>
            </div>
            <div>
                <div class="text-2xl font-bold leading-none text-slate-900 sm:text-3xl">@Model.AppointmentsCount</div>
                <div class="text-gray-700">@SharedLocalizer["Appointments"]</div>
            </div>
        </div>
        <div class="flex items-center gap-4 rounded-3xl border border-slate-200 bg-white p-5 shadow-sm sm:p-6">
            <div class="rounded-full bg-green-100 p-3 text-green-600 sm:p-4">
                <i class="fas fa-notes-medical fa-2x"></i>
            </div>
            <div>
                <div class="text-2xl font-bold leading-none text-slate-900 sm:text-3xl">@Model.MedicalCasesCount</div>
                <div class="text-gray-700">@SharedLocalizer["Shared_Medical_Cases"]</div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4 sm:gap-5">
        <a href="@Url.Action("my-appointments", "Appointment", new { area = "patient" })"
           class="group flex min-h-36 flex-col items-center justify-center rounded-3xl border border-red-500 bg-red-600 p-5 text-center text-white shadow-sm transition hover:bg-red-700 hover:text-white sm:p-6">
            <i class="fas fa-calendar-alt fa-2x mb-2 transition group-hover:scale-110"></i>
            <span class="font-bold">@SharedLocalizer["Appointments"]</span>
        </a>

        <a href="@Url.Action("Index", "MedicalCases", new { area = "patient" })"
           class="group flex min-h-36 flex-col items-center justify-center rounded-3xl border border-green-500 bg-green-600 p-5 text-center text-white shadow-sm transition hover:bg-green-700 sm:p-6">
            <i class="fas fa-notes-medical fa-2x mb-2 transition group-hover:scale-110"></i>
            <span class="font-bold">@SharedLocalizer["Shared_Medical_Cases"]</span>
        </a>
        <a href="@Url.Action("Index", "Profile", new { area = "" })"
           class="group flex min-h-36 flex-col items-center justify-center rounded-3xl border border-blue-500 bg-blue-600 p-5 text-center text-white shadow-sm transition hover:bg-blue-700 sm:p-6">
            <i class="fas fa-user-cog fa-2x mb-2 transition group-hover:scale-110"></i>
            <span class="font-bold">@SharedLocalizer["Panel_Account"]</span>
        </a>
        <a href="@Url.Action("Index", "Home", new { area = "" })"
           class="group flex min-h-36 flex-col items-center justify-center rounded-3xl border border-slate-500 bg-gray-600 p-5 text-center text-white shadow-sm transition hover:bg-gray-700 sm:p-6">
            <i class="fas fa-home fa-2x mb-2 transition group-hover:scale-110"></i>
            <span class="font-bold">@SharedLocalizer["Shared_Home"]</span>
        </a>
    </div>
</div>
