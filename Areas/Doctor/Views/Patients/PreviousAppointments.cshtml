@model List<IPTS.Models.Entites.Appointment>
@{
    ViewData["Title"] = SharedLocalizer["PrevAppt_Header"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}

<div class="prac-page space-y-6">

    <div class="flex items-center gap-3">
        <div class="avatar-lg">
            <svg class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
            </svg>
        </div>
        <div>
            <h2 class="text-xl font-semibold text-gray-900 leading-tight">@SharedLocalizer["PrevAppt_Header"]</h2>
            <p class="text-sm text-gray-500 mt-0.5">@SharedLocalizer["Appt_Header"]</p>
        </div>
    </div>

    @if (!Model.Any())
    {
        <div class="empty-state">
            <span class="empty-icon">📅</span>
            <p class="empty-text">@SharedLocalizer["PrevAppt_NoData"]</p>
        </div>
    }
    else
    {
        <div class="prac-section">
            <div class="group-divider">
                <div class="group-divider-line"></div>
                <span class="group-label">
                    <svg class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                    </svg>
                    @SharedLocalizer["PrevAppt_Header"]
                    <span class="group-count">@Model.Count</span>
                </span>
                <div class="group-divider-line"></div>
            </div>

            <div class="prac-list">
                @foreach (var a in Model)
                {
                    var badgeClass = a.Status.ToString() switch
                    {
                        "Pending" => "status-pending",
                        "Confirmed" => "status-confirmed",
                        "Completed" => "status-completed",
                        "Cancelled" => "status-cancelled",
                        _ => "result-empty"
                    };

                    <div class="prac-row">
                        <div class="prac-row-main">
                            <div class="prac-row-body">
                                <div class="flex flex-wrap items-center gap-2">
                                    <p class="test-name !mb-0">@a.ScheduledTime.ToString("yyyy-MM-dd")</p>
                                    <span class="status-chip @badgeClass">@SharedLocalizer[$"Status_{a.Status}"]</span>
                                </div>
                                <div class="test-date mt-1.5">
                                    <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <circle cx="12" cy="12" r="10" stroke-width="2"/>
                                        <path stroke-linecap="round" stroke-width="2" d="M12 6v6l4 2"/>
                                    </svg>
                                    @a.ScheduledTime.ToString("HH:mm")
                                </div>
                            </div>
                        </div>

                        <div class="prac-row-actions">
                            <p class="text-sm text-gray-500 leading-relaxed max-w-md text-start md:text-end">
                                @if (!string.IsNullOrWhiteSpace(a.Notes))
                                {
                                    @a.Notes
                                }
                                else
                                {
                                    <span class="text-gray-300">—</span>
                                }
                            </p>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
