@using IPTS.Areas.Doctor.ViewsModels
@model RejectAppointmentViewModel
@{
    ViewData["Title"] = "Reject Appointment";
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";
}
<h2 class="mb-4 text-xl font-bold">@SharedLocalizer["Appt_Reject_Title"] @Model.PatientName</h2>
<form asp-action="RejectRequest" method="post">
    <input type="hidden" asp-for="AppointmentId" />
    <input type="hidden" asp-for="PatientEmail" />
    <div class="mb-4">
        <label asp-for="RejectReason" class="mb-2 block font-medium">@SharedLocalizer["Appt_Reject_ReasonLabel"]</label>
        <textarea asp-for="RejectReason" class="w-full rounded border p-2" rows="4"></textarea>
        <span asp-validation-for="RejectReason" class="text-red-500"></span>
    </div>
    <div class="mt-6 flex gap-3">
        <a asp-action="Requests" class="rounded bg-gray-500 px-4 py-2 text-white">@SharedLocalizer["Shared_Cancel"]</a>
        <button type="submit" class="rounded bg-red-600 px-4 py-2 text-white">@SharedLocalizer["Appt_Reject_BtnSubmit"]</button>
    </div>
</form>
