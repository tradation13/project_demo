<!-- Hero Section -->
<section class="hero-section relative overflow-hidden bg-gradient-to-br from-primary-100 to-primary-200 py-20">

    <!-- خلفية عائمة -->
    <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <i class="hero-float fa-solid fa-heart-pulse absolute left-[6%] top-[12%] text-5xl text-primary-400/10"></i>
        <i class="hero-float hero-float-d1 fa-solid fa-heart-pulse absolute right-[8%] bottom-[20%] text-4xl text-primary-400/10"></i>
        <i class="hero-float hero-float-d2 fa-solid fa-stethoscope absolute left-[20%] bottom-[10%] text-6xl text-primary-400/10"></i>
        <i class="hero-float hero-float-d1 fa-solid fa-stethoscope absolute right-[18%] top-[8%] text-5xl text-primary-400/10"></i>
        <i class="hero-float hero-float-d2 fa-solid fa-shield-halved absolute left-[45%] top-[5%] text-4xl text-primary-400/10"></i>

        <div class="hero-orb absolute left-[2%] top-[20%] h-64 w-64 rounded-full bg-primary-300/20 blur-3xl"></div>
        <div class="hero-orb hero-orb-2 absolute right-[5%] bottom-[10%] h-80 w-80 rounded-full bg-primary-400/15 blur-3xl"></div>
        <div class="hero-orb hero-orb-3 absolute left-[40%] bottom-[5%] h-48 w-48 rounded-full bg-white/30 blur-3xl"></div>
    </div>

    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid items-center gap-12 lg:grid-cols-2">

            <!-- Content -->
            <div class="z-10 space-y-8">
                <div class="space-y-6">
                    <h1 class="hero-title text-4xl font-bold leading-tight text-gray-900 md:text-5xl">
                        <span class="text-primary-600">PhysioTech</span> @SharedLocalizer["Hero_Slogan"]
                    </h1>
                    <p class="hero-desc text-xl leading-relaxed text-gray-700">
                        @SharedLocalizer["Hero_Description"]
                    </p>
                </div>

                <div class="hero-btns flex flex-col gap-4 sm:flex-row sm:items-center">
                    <a asp-controller="Home" asp-action="Therapies"
                       class="group inline-flex min-w-max transform items-center justify-center whitespace-nowrap rounded-xl bg-primary px-6 py-4 text-base font-bold text-white shadow-lg transition-all duration-200 hover:scale-[1.02] hover:bg-primary-dark active:scale-95">
                        <i class="fas fa-calendar-check mr-2 text-sm"></i>
                        <span class="shrink-0">@SharedLocalizer["Hero_BtnBook"]</span>
                        <i class="fas fa-arrow-right ml-2 text-sm transition-transform group-hover:translate-x-1"></i>
                    </a>
                    <a href="#about"
                       class="inline-flex min-w-max items-center justify-center whitespace-nowrap rounded-xl border-2 border-primary bg-white px-6 py-4 text-base font-bold text-primary transition-all duration-200 hover:bg-gray-50 active:scale-95">
                        <i class="fas fa-info-circle mr-2 text-sm"></i>
                        <span class="shrink-0">@SharedLocalizer["Hero_BtnLearnMore"]</span>
                    </a>
                </div>

                <!-- Features -->
                <div class="grid grid-cols-3 gap-4 pt-6">
                    <div class="hero-feat text-center">
                        <div class="mb-2 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-white shadow-md">
                            <i class="fas fa-brain text-xl text-primary-600 hero-icon-pulse"></i>
                        </div>
                        <p class="text-sm font-normal text-gray-700">@SharedLocalizer["Shared_AI_Powered"]</p>
                    </div>
                    <div class="hero-feat hero-feat-d1 text-center">
                        <div class="mb-2 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-white shadow-md">
                            <i class="fas fa-chart-line text-xl text-primary-600 hero-icon-rise"></i>
                        </div>
                        <p class="text-sm font-normal text-gray-700">@SharedLocalizer["Shared_SmartTracking"]</p>
                    </div>
                    <div class="hero-feat hero-feat-d2 text-center">
                        <div class="mb-2 inline-flex h-12 w-12 items-center justify-center rounded-lg bg-white shadow-md">
                            <i class="fas fa-user-md text-xl text-primary-600 hero-icon-float"></i>
                        </div>
                        <p class="text-sm font-normal text-gray-700">@SharedLocalizer["Shared_ExpertCare"]</p>
                    </div>
                </div>
            </div>

            <!-- Visual -->
            <div class="hero-img relative lg:scale-110">
                <div class="relative">
                    <!-- حلقات خلف الصورة -->
                    <span class="hero-ring hero-ring-1"></span>
                    <span class="hero-ring hero-ring-2"></span>

                    <img src="/images/home/hero.svg"
                         alt="@SharedLocalizer["Hero_ImgAlt"]"
                         class="h-auto w-full hero-svg" />
                </div>
            </div>

        </div>
    </div>
</section>

<style>
    /* ══ Keyframes ══ */
    @@keyframes heroFloat {
        0%,100% { transform:translate3d(0,0,0) rotate(0deg) scale(1); }
        33%      { transform:translate3d(14px,-12px,0) rotate(5deg) scale(1.03); }
        66%      { transform:translate3d(-10px,10px,0) rotate(-4deg) scale(0.97); }
    }
    @@keyframes orbDrift {
        0%,100% { transform:translate(0,0) scale(1); }
        50%      { transform:translate(18px,-16px) scale(1.07); }
    }
    @@keyframes fadeUp {
        from { opacity:0; transform:translateY(32px); }
        to   { opacity:1; transform:translateY(0); }
    }
    @@keyframes fadeLeft {
        from { opacity:0; transform:translateX(40px); }
        to   { opacity:1; transform:translateX(0); }
    }
    @@keyframes featPop {
        0%   { opacity:0; transform:scale(0.7) translateY(14px); }
        70%  { transform:scale(1.07) translateY(-2px); }
        100% { opacity:1; transform:scale(1) translateY(0); }
    }
    /* دائمة */
    @@keyframes brainPulse {
        0%,100% { transform:scale(1); opacity:1; }
        50%      { transform:scale(1.25); opacity:.75; }
    }
    @@keyframes chartRise {
        0%,100% { transform:translateY(0); }
        50%      { transform:translateY(-5px); }
    }
    @@keyframes iconFloat {
        0%,100% { transform:translateY(0) rotate(0deg); }
        50%      { transform:translateY(-5px) rotate(4deg); }
    }
    @@keyframes ringExpand {
        0%   { transform:scale(0.88); opacity:.35; }
        100% { transform:scale(1.18); opacity:0; }
    }
    @@keyframes svgLevitate {
        0%,100% { transform:translateY(0); }
        50%      { transform:translateY(-10px); }
    }

    /* ══ خلفية ══ */
    .hero-float { animation:heroFloat 14s ease-in-out infinite; will-change:transform; }
    .hero-float-d1 { animation-duration:17s; animation-delay:-5s; }
    .hero-float-d2 { animation-duration:20s; animation-delay:-9s; }

    .hero-orb   { animation:orbDrift 13s ease-in-out infinite; }
    .hero-orb-2 { animation-duration:17s; animation-delay:-6s; }
    .hero-orb-3 { animation-duration:21s; animation-delay:-10s; }

    /* ══ Entrance — مخفية بالبداية ══ */
    .hero-title,
    .hero-desc,
    .hero-btns,
    .hero-feat,
    .hero-img { opacity:0; }

    .hero-title.av { animation:fadeUp   0.7s cubic-bezier(.22,1,.36,1) forwards; }
    .hero-desc.av  { animation:fadeUp   0.7s cubic-bezier(.22,1,.36,1) .15s forwards; }
    .hero-btns.av  { animation:fadeUp   0.7s cubic-bezier(.22,1,.36,1) .28s forwards; }
    .hero-feat.av       { animation:featPop 0.55s cubic-bezier(.22,1,.36,1) .38s forwards; }
    .hero-feat-d1.av    { animation-delay:.50s; }
    .hero-feat-d2.av    { animation-delay:.62s; }
    .hero-img.av   { animation:fadeLeft 0.8s cubic-bezier(.22,1,.36,1) .1s forwards; }

    /* ══ أنيميشن دائمة ══ */
    .hero-icon-pulse { display:inline-block; animation:brainPulse 2s ease-in-out infinite; }
    .hero-icon-rise  { display:inline-block; animation:chartRise  2.4s ease-in-out infinite; animation-delay:.6s; }
    .hero-icon-float { display:inline-block; animation:iconFloat   2.8s ease-in-out infinite; animation-delay:1.2s; }

    .hero-svg { animation:svgLevitate 4s ease-in-out infinite; }

    /* حلقات خلف الصورة */
    .hero-ring {
        position:absolute;
        inset:-12%;
        border-radius:50%;
        border:2px solid;
        pointer-events:none;
    }
    .hero-ring-1 {
        border-color: rgba(16,185,129,.18);
        animation:ringExpand 3s ease-out infinite;
    }
    .hero-ring-2 {
        border-color: rgba(16,185,129,.10);
        animation:ringExpand 3s ease-out 1.5s infinite;
    }

    @@media (max-width:1023.98px) {
        .hero-ring { display:none; }
    }
</style>

<script>
(function(){
    var obs = new IntersectionObserver(function(entries){
        entries.forEach(function(e){
            if(e.isIntersecting){
                e.target.classList.add('av');
            } else {
                e.target.classList.remove('av');
            }
        });
    },{ threshold:0.1 });

    document.querySelectorAll(
        '.hero-title,.hero-desc,.hero-btns,.hero-feat,.hero-img'
    ).forEach(function(el){ obs.observe(el); });
})();
</script>