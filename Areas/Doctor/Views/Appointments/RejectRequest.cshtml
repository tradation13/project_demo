@using IPTS.Areas.Doctor.ViewsModels
@model RejectAppointmentViewModel
@{
    ViewData["Title"] = SharedLocalizer["Appt_Reject_Title"];
    Layout = "~/Views/Shared/Layouts/_DashboardLayout.cshtml";

    var backUrl = Context.Request.Query["returnUrl"].ToString();
    if (string.IsNullOrWhiteSpace(backUrl))
    {
        backUrl = Context.Request.Headers["Referer"].ToString();
    }

    if (string.IsNullOrWhiteSpace(backUrl) || !Url.IsLocalUrl(backUrl))
    {
        backUrl = Url.Action("Index", "Appointments", new { area = "Doctor" }) ?? "/Doctor/Appointments";
    }
}

<style>
    .reject-wrapper {
        animation: fadeSlideIn 0.4s ease both;
    }

    @@keyframes fadeSlideIn {
        from {
            opacity: 0;
            transform: translateY(16px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .reject-card {
        background: #ffffff;
        border: 1px solid #fee2e2;
        border-radius: 16px;
        padding: 2rem;
        box-shadow: 0 4px 24px rgba(220, 38, 38, 0.06);
        transition: box-shadow 0.3s ease;
    }

    .reject-card:hover {
        box-shadow: 0 6px 32px rgba(220, 38, 38, 0.1);
    }

    .reject-icon-wrap {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 48px;
        height: 48px;
        background: #fee2e2;
        border-radius: 12px;
        margin-bottom: 1rem;
        animation: pulseIcon 2.5s ease-in-out infinite;
    }

    @@keyframes pulseIcon {
        0%, 100% { box-shadow: 0 0 0 0 rgba(220, 38, 38, 0.15); }
        50%       { box-shadow: 0 0 0 8px rgba(220, 38, 38, 0); }
    }

    .reject-title {
        font-size: 1.2rem;
        font-weight: 700;
        color: #111827;
        margin: 0;
    }

    .reject-label {
        display: block;
        font-size: 0.875rem;
        font-weight: 500;
        color: #374151;
        margin-bottom: 0.5rem;
    }

    .reject-textarea {
        width: 100%;
        border: 1.5px solid #e5e7eb;
        border-radius: 10px;
        padding: 0.75rem 1rem;
        font-size: 0.9rem;
        color: #111827;
        resize: vertical;
        transition: border-color 0.2s ease, box-shadow 0.2s ease;
        outline: none;
        background: #fafafa;
        box-sizing: border-box;
    }

    .reject-textarea:focus {
        border-color: #ef4444;
        box-shadow: 0 0 0 3px rgba(239, 68, 68, 0.12);
        background: #fff;
    }

    .reject-error {
        font-size: 0.78rem;
        color: #dc2626;
        margin-top: 0.35rem;
        display: block;
    }

    .btn-cancel {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.25rem;
        border: 1.5px solid #d1d5db;
        border-radius: 10px;
        background: #fff;
        color: #374151;
        font-size: 0.875rem;
        font-weight: 500;
        text-decoration: none;
        transition: background 0.2s, border-color 0.2s, transform 0.15s;
    }

    .btn-cancel:hover {
        background: #f9fafb;
        border-color: #9ca3af;
    }

    .btn-cancel:active {
        transform: scale(0.97);
    }

    .btn-reject {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 1.4rem;
        border: 1px solid #fca5a5;
        border-radius: 8px;
        background: #fef2f2;
        color: #991b1b;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s, transform 0.15s;
    }

    .btn-reject:hover {
        background: #fee2e2;
        transform: translateY(-1px);
    }

    .btn-reject:active {
        transform: scale(0.97);
    }

    @@media (max-width: 640px) {
        .reject-card {
            padding: 1.25rem;
        }

        .reject-actions {
            flex-direction: column;
        }

        .btn-cancel,
        .btn-reject {
            width: 100%;
            justify-content: center;
        }
    }
</style>

<div class="prac-page reject-wrapper" style="width: 100%; padding: 1.5rem;">

    <div class="reject-card">
        <div class="reject-icon-wrap">
            <svg width="22" height="22" fill="none" stroke="#dc2626" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </div>

        <h2 class="reject-title" style="margin-bottom: 0.25rem;">
            @SharedLocalizer["Appt_Reject_Title"]
        </h2>
        <p style="font-size:0.875rem; color:#6b7280; margin-top:0.2rem; margin-bottom:1.5rem;">
            @Model.PatientName
        </p>

        <form asp-action="RejectRequest" method="post">
            <input type="hidden" asp-for="AppointmentId" />
            <input type="hidden" asp-for="PatientName" />
            <input type="hidden" asp-for="PatientEmail" />

            <div style="margin-bottom: 1.25rem;">
                <label asp-for="RejectReason" class="reject-label">
                    @SharedLocalizer["Appt_Reject_ReasonLabel"]
                </label>
                <textarea asp-for="RejectReason" class="reject-textarea" rows="4"></textarea>
                <span asp-validation-for="RejectReason" class="reject-error"></span>
            </div>

            <div class="reject-actions" style="display:flex; gap:0.75rem; margin-top:1.5rem;">
                <a href="@backUrl" class="btn-cancel">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    @SharedLocalizer["Shared_Cancel"]
                </a>

                <button type="submit" class="btn-reject">
                    <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                    </svg>
                    @SharedLocalizer["Appt_Reject_BtnSubmit"]
                </button>
            </div>
        </form>
    </div>

</div>