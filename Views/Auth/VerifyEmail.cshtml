@{
    Layout = "~/Views/Shared/Layouts/_AuthLayout.cshtml";
    ViewData["Title"] = SharedLocalizer["Verify_PageTitle"];
}

<h2 class="text-center text-2xl font-bold tracking-wide text-gray-800">
    @SharedLocalizer["Verify_Header"]
</h2>

<p class="mt-2 text-center text-sm text-gray-600">
    @SharedLocalizer["Verify_Description"]
</p>

<div class="items-center justify-between sm:flex">
    <form asp-action="ResendVerificationEmail" method="post" class="my-8 text-sm">
        <button class="w-full rounded-lg bg-primary px-8 py-2 uppercase text-gray-100 transition duration-150 hover:bg-primary-dark hover:shadow-xl sm:w-auto">
            @SharedLocalizer["Verify_ResendBtn"]
        </button>
    </form>

    <form asp-action="Logout" method="post" class="flex items-center justify-center">
        <button class="text-sm text-gray-600 underline hover:text-gray-800" title="@SharedLocalizer["Shared_Logout"]">
            @SharedLocalizer["Shared_Logout"]
        </button>
    </form>
</div>